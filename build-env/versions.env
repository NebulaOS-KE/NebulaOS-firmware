# Pinned identities for the unified NebulaOS build image
# (ghcr.io/nebulaos-ke/nebulaos-build). Sourced by build-env/Dockerfile.
#
# This is a build-IMAGE manifest, not a build-INPUT manifest - it pins what
# the factory is made of (base OS, compilers, host tools), never project
# source. Project source stays pinned in manifests/dependencies.conf, one
# level up, and is fetched fresh by 00-fetch-vendor-sources.sh regardless of
# which image built it.

# --- Base image ---
# Ubuntu 22.04 chosen to match the currently-preserved GuppyScreen toolchain
# image's own base (ghcr.io/coreflake1/guppydev was already Ubuntu 22.04) -
# one fewer variable while proving Migration A. Pellcorp's own image was
# Ubuntu 20.04, but nothing in the actual build scripts depends on anything
# 20.04-specific (see build-env/README.md's "why not 20.04" note).
BASE_IMAGE=ubuntu
BASE_IMAGE_TAG=22.04
BASE_IMAGE_DIGEST=sha256:3b06811b2afd352be909dd088a004166d665dc76d38b13eada33522a9d915c6f

# --- GuppyScreen Migration-A toolchain (Bootlin mips32el musl) ---
# Pinned identically to NebulaOS-guppyscreen/docker/Dockerfile's own ARGs -
# Migration A's whole point is preserving this exact toolchain, not changing
# it. See that Dockerfile for the authoritative source of these values.
GUPPYSCREEN_MIPS_TOOLCHAIN=mips32el--musl--stable-2024.02-1
GUPPYSCREEN_MIPS_URL=https://toolchains.bootlin.com/downloads/releases/toolchains/mips32el/tarballs/mips32el--musl--stable-2024.02-1.tar.bz2
GUPPYSCREEN_MIPS_SHA256=25c0b3217df1bf1a7bae2cc4f56cdeab9fec98b172bbf0b336b2e8fe41d3ee4e

# --- GuppyScreen aarch64 toolchain (Arm GNU) ---
# Only needed if the unified image is also used for GuppyScreen's aarch64 CI
# matrix leg (other-board builds) - not needed for the Ender-3 V3 KE image
# itself, kept for CI-environment parity per Task 25.
GUPPYSCREEN_ARM_TOOLCHAIN=gcc-arm-10.2-2020.11-x86_64-aarch64-none-linux-gnu
GUPPYSCREEN_ARM_URL=https://developer.arm.com/-/media/Files/downloads/gnu-a/10.2-2020.11/binrel/gcc-arm-10.2-2020.11-x86_64-aarch64-none-linux-gnu.tar.xz
GUPPYSCREEN_ARM_SHA256=fe7f72330216612de44891ebe5e228eed7c0c051ac090c395b2b33115c6f5408

# --- What this image deliberately does NOT pin ---
# pellcorp/k1-bash-build bundled an Ingenic mips-gcc720-glibc229 toolchain
# at /opt/toolchains/mips-gcc720-glibc229 - audited (Task 2) and confirmed
# UNUSED by any current build script. Every kernel/rootfs/native-app compile
# already uses Buildroot's own self-bootstrapped mipsel-buildroot-linux-gnu-*
# toolchain (built from source during Stage 03, from Buildroot's own pinned
# BUILDROOT_PIN - see manifests/dependencies.conf), invoked either directly
# by Buildroot's own make, or via explicit PATH=/buildroot-output/host/bin
# overrides for chelper/ustreamer/v4l2-ctl. This image does not need to
# bundle or reproduce the Ingenic toolchain at all - it was never
# load-bearing, just present in pellcorp's image and unused.
