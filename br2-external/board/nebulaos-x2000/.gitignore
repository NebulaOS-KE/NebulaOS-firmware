# because baseline-difference-gate.sh and assert-baseline-config.sh diff them
# verbatim against the qualified baseline tag - moving them would silently stop
# those gates matching a real file.
overlay/
post-build.sh
nebulaos-kernel-buildenv.config
halley5-nebulaos-busybox-fragment.config
