/dts-v1/;

/ {
	#address-cells = <0x01>;
	#size-cells = <0x01>;
	compatible = "ingenic,halley5", "ingenic,x2000";

	ahb0 {
		#address-cells = <0x01>;
		#size-cells = <0x01>;
		compatible = "simple-bus";
		ranges;

		cim@13060000 {
			clock-names = "div_cim", "gate_cim", "gate_mipi", "gate_cim_mclk";
			clocks = <0x06 0x30 0x06 0x45 0x06 0x5e 0x06 0x7a>;
			compatible = "ingenic,x2000-cim";
			interrupt-parent = <0x05>;
			interrupts = <0x1e>;
			reg = <0x13060000 0x10000>;
			status = "disable";
		};

		dpu@13050000 {
			compatible = "ingenic,dpu";
			composer-support;
			dsi-host-reg = <0x10075000>;
			dsi-phy-reg = <0x10077000>;
			interrupt-parent = <0x05>;
			interrupts = <0x1f 0x0a>;
			reg = <0x13050000 0x10000>;
			status = "okay";
		};

		felix@13300000 {
			compatible = "ingenic,x2000-felix";
			interrupt-parent = <0x05>;
			interrupts = <0x3f>;
			memory-region = <0x21>;
			reg = <0x13300000 0x100000>;
			status = "okay";
		};

		helix@13200000 {
			compatible = "ingenic,x2000-helix";
			interrupt-parent = <0x05>;
			interrupts = <0x3e>;
			memory-region = <0x21>;
			reg = <0x13200000 0x100000>;
			status = "okay";
		};

		isp-camera@0 {
			#address-cells = <0x01>;
			#size-cells = <0x01>;
			compatible = "ingenic,x2000-isp-camera";
			memory-region = <0x21>;
			ranges;
			status = "okay";

			csi@10074000 {
				clock-names = "gate_csi";
				clocks = <0x06 0x5e>;
				compatible = "ingenic,x2000-csi";
				interrupt-parent = <0x05>;
				interrupts = <0x0c>;
				reg = <0x10074000 0x1000>;
			};

			isp@13700000 {
				clock-names = "div_isp", "gate_isp0", "power_isp0";
				clocks = <0x06 0x32 0x06 0x76 0x06 0x7f>;
				compatible = "ingenic,x2000-isp";
				ingenic,bit_ack = <0x17>;
				ingenic,bit_sr = <0x19>;
				ingenic,bit_stp = <0x18>;
				ingenic,cpm_reset = <0xb00000c4>;
				interrupt-parent = <0x05>;
				interrupts = <0x15>;
				reg = <0x13700000 0x2300>;
				status = "ok";
			};

			mscaler@13702300 {
				compatible = "ingenic,x2000-mscaler";
				reg = <0x13702300 0x400>;
				status = "disabled";
			};

			port {

				endpoint@0 {
				};
			};

			vic@13710000 {
				compatible = "ingenic,x2000-vic";
				interrupt-parent = <0x05>;
				interrupts = <0x13>;
				reg = <0x13710000 0x10000>;
				status = "ok";
			};
		};

		isp-camera@1 {
			#address-cells = <0x01>;
			#size-cells = <0x01>;
			compatible = "ingenic,x2000-isp-camera";
			memory-region = <0x21>;
			ranges;
			status = "okay";

			csi@10073000 {
				clock-names = "gate_csi";
				clocks = <0x06 0x5e>;
				compatible = "ingenic,x2000-csi";
				interrupt-parent = <0x05>;
				interrupts = <0x1c>;
				reg = <0x10073000 0x1000>;
			};

			isp@13800000 {
				clock-names = "div_isp", "gate_isp1", "power_isp1";
				clocks = <0x06 0x32 0x06 0x75 0x06 0x80>;
				compatible = "ingenic,x2000-isp";
				ingenic,bit_ack = <0x14>;
				ingenic,bit_sr = <0x16>;
				ingenic,bit_stp = <0x15>;
				ingenic,cpm_reset = <0xb00000c4>;
				interrupt-parent = <0x05>;
				interrupts = <0x14>;
				reg = <0x13800000 0x2300>;
				status = "ok";
			};

			mscaler@13802300 {
				compatible = "ingenic,x2000-mscaler";
				reg = <0x13802300 0x400>;
				status = "disabled";
			};

			port {

				endpoint@0 {
				};
			};

			vic@13810000 {
				compatible = "ingenic,x2000-vic";
				interrupt-parent = <0x05>;
				interrupts = <0x12>;
				reg = <0x13810000 0x10000>;
				status = "ok";
			};
		};

		rotate@13070000 {
			compatible = "ingenic,x2000-rotate";
			interrupt-parent = <0x05>;
			interrupts = <0x1d>;
			memory-region = <0x21>;
			reg = <0x13070000 0x10000>;
			status = "okay";
		};

		simple_vic@13710000 {
			clock-names = "div_isp", "gate_isp0", "power_isp0", "gate_csi";
			clocks = <0x06 0x32 0x06 0x76 0x06 0x7f 0x06 0x5e>;
			compatible = "ingenic,x2000-simple-vic";
			interrupt-parent = <0x05>;
			interrupts = <0x13>;
			mipi_iobase = <0x10074000 0x10073000 0x10076000>;
			reg = <0x13710000 0x10000>;
			status = "disable";
			vic,bus_type = "mipi";
			vic,dvp_gpio_mode = "low_10bit";
			vic,dvp_hsync_polarity = "high_active";
			vic,dvp_img_scan_mode = "progress";
			vic,dvp_pclk_polarity = "sample_rising";
			vic,dvp_timing_mode = "href_mode";
			vic,dvp_vsync_polarity = "high_active";
			vic,dvp_yuv_data_order = "order_1_2_3_4";
			vic,isp_clk_rate = <0x8f0d180>;
			vic,mipi_clk_settle_time = <0x78>;
			vic,mipi_data_lanes = <0x02>;
			vic,mipi_data_settle_time = <0x82>;
			vic,video_device_num = <0x14>;
			vic_index = <0x00>;

			port {

				endpoint@0 {
				};
			};
		};

		simple_vic@13810000 {
			clock-names = "div_isp", "gate_isp1", "power_isp1", "gate_csi";
			clocks = <0x06 0x32 0x06 0x75 0x06 0x80 0x06 0x5e>;
			compatible = "ingenic,x2000-simple-vic";
			interrupt-parent = <0x05>;
			interrupts = <0x12>;
			mipi_iobase = <0x10074000 0x10073000 0x10076000>;
			reg = <0x13810000 0x10000>;
			status = "disable";
			vic,bus_type = "mipi";
			vic,dvp_gpio_mode = "low_10bit";
			vic,dvp_hsync_polarity = "high_active";
			vic,dvp_img_scan_mode = "progress";
			vic,dvp_pclk_polarity = "sample_rising";
			vic,dvp_timing_mode = "href_mode";
			vic,dvp_vsync_polarity = "high_active";
			vic,dvp_yuv_data_order = "order_1_2_3_4";
			vic,isp_clk_rate = <0x8f0d180>;
			vic,mipi_clk_settle_time = <0x78>;
			vic,mipi_data_lanes = <0x02>;
			vic,mipi_data_settle_time = <0x82>;
			vic,video_device_num = <0x15>;
			vic_index = <0x01>;

			port {

				endpoint@0 {
				};
			};
		};
	};

	ahb1 {
		#address-cells = <0x01>;
		#size-cells = <0x01>;
		compatible = "simple-bus";
		ranges;
	};

	ahb2 {
		#address-cells = <0x01>;
		#size-cells = <0x01>;
		compatible = "simple-bus";
		ranges;

		aes@13430000 {
			compatible = "ingenic,aes";
			interrupt-parent = <0x05>;
			interrupts = <0x17>;
			reg = <0x13430000 0x10000>;
			status = "ok";
		};

		as {
			#address-cells = <0x01>;
			#size-cells = <0x01>;
			compatible = "simple-bus";
			ranges;

			as-baic {
				compatible = "ingenic,as-baic";
				ingenic,clk-rname = "div_i2s0", "div_i2s0", "div_i2s2", "no_clk", "mux_pcm";
				ingenic,clk-split = <0x01 0x01 0x01 0x01 0x00>;
				ingenic,clk-tname = "div_i2s1", "div_i2s1", "no_clk", "div_i2s3", "mux_pcm";
				ingenic,dai-array = <0x00 0x01 0x02 0x03 0x04>;
				ingenic,dai-mode = <0x73f 0x73f 0xfcf 0x17cf 0x73f>;
				ingenic,data-pin-num = <0x01 0x01 0x04 0x04 0x01>;
				ingenic,num-dais = <0x05>;
				ingenic,pcm-clk-parent = "div_i2s2";
				reg = <0x134d5000 0x5000>;
				status = "disabled";
			};

			as-dmic {
				compatible = "ingenic,as-dmic";
				ingenic,clk-name = "mux_dmic";
				ingenic,clk-parent = "div_i2s3";
				reg = <0x134da000 0x10>;
				status = "disabled";
			};

			as-dsp {
				compatible = "ingenic,as-dsp";
				ingenic,cap-dai-bm = <0x3e0>;
				ingenic,li-port = <0x00 0x01 0x02 0x03 0x04 0x06 0x07 0x08 0x09 0x0a 0x0b 0x0c>;
				ingenic,lo-port = <0x00 0x01 0x02 0x03 0x04 0x05 0x06 0x07 0x08 0x09 0x0a 0x0b>;
				ingenic,num-dais = <0x0a>;
				reg = <0x134d4000 0x30>;
				status = "disabled";
			};

			as-fmtcov {
				compatible = "ingenic,as-fmtcov";
				reg = <0x134d2000 0x28>;
				status = "disabled";
			};

			as-mixer {
				compatible = "ingenic,as-mixer";
				ingenic,num-mixers = <0x01>;
				reg = <0x134dc000 0x08>;
				status = "disabled";
			};

			as-platform {
				compatible = "ingenic,as-platform";
				ingenic,fifo-size = <0x1000>;
				ingenic,fth_quirk;
				interrupt-parent = <0x05>;
				interrupts = <0x00>;
				reg = <0x134d0000 0x114 0x134d1000 0x100>;
				reg-names = "dma", "fifo";
				status = "disabled";
			};

			as-spdif {
				compatible = "ingenic,as-spdif";
				ingenic,clk-name = "mux_spdif";
				ingenic,clk-parent = "div_i2s2";
				reg = <0x134db000 0x14 0x134db100 0x14>;
				reg-names = "out", "in";
				status = "disabled";
			};

			as-virtual-fe {
				compatible = "ingenic,as-vir-fe";
				ingenic,cap-dai-bm = <0x0c>;
				ingenic,num-dais = <0x04>;
				reg = <0x00 0x00>;
				status = "disabled";
			};
		};

		dma@13420000 {
			#dma-cells = <0x01>;
			#dma-channels = <0x20>;
			compatible = "ingenic,x2000-pdma";
			ingenic,reserved-chs = <0x03>;
			interrupt-names = "pdma", "pdmad";
			interrupt-parent = <0x05>;
			interrupts = <0x03 0x04>;
			phandle = <0x11>;
			reg = <0x13420000 0x10000>;
			status = "okay";
		};

		efuse@13540000 {
			compatible = "ingenic,x2000-efuse";
			reg = <0x13540000 0x10000>;
			status = "okay";
		};

		hash@13470000 {
			compatible = "ingenic,hash";
			interrupt-parent = <0x05>;
			interrupts = <0x16>;
			reg = <0x13470000 0x10000>;
			status = "ok";
		};

		mac@134a0000 {
			compatible = "ingenic,x2000-mac";
			ingenic,mac-mode = <0x01>;
			ingenic,mode-reg = <0xb00000e8>;
			ingenic,rst-delay-ms = <0x0f>;
			ingenic,rst-gpio = <0x0a 0x10 0x01 0x00>;
			ingenic,rst-ms = <0x0a>;
			ingenic,rx-clk-delay = <0x00>;
			ingenic,tx-clk-delay = <0x3f>;
			interrupt-parent = <0x05>;
			interrupts = <0x35>;
			pinctrl-0 = <0x1b 0x1c>;
			pinctrl-1 = <0x1d 0x1c>;
			pinctrl-names = "default", "reset";
			reg = <0x134a0000 0x2000>;
			status = "disabled";
		};

		mac@134b0000 {
			compatible = "ingenic,x2000-mac";
			ingenic,rst-ms = <0x0a>;
			interrupt-parent = <0x05>;
			interrupts = <0x37>;
			reg = <0x134b0000 0x2000>;
			status = "disabled";
		};

		mcu@13420000 {
			compatible = "ingenic,x2000-mcu";
			ingenic,tcsm_size = <0x4000>;
			interrupt-names = "pdmam";
			interrupt-parent = <0x05>;
			interrupts = <0x05>;
			reg = <0x13420000 0x10000>;
		};

		msc@13450000 {
			bus-width = <0x08>;
			cap-mmc-highspeed;
			compatible = "ingenic,sdhci";
			ingenic,cd-gpios = <0x00>;
			ingenic,rst-gpios = <0x00>;
			ingenic,wp-gpios = <0x00>;
			interrupt-parent = <0x05>;
			interrupts = <0x25>;
			max-frequency = <0x5f5e100>;
			mmc-hs200-1_8v;
			non-removable;
			pinctrl-0 = <0x15>;
			pinctrl-names = "default";
			reg = <0x13450000 0x10000>;
			status = "okay";
			voltage-ranges = <0x708 0xce4>;
		};

		msc@13460000 {
			bus-width = <0x04>;
			cap-sd-highspeed;
			cap-sdio-irq;
			compatible = "ingenic,sdhci";
			ingenic,removal-manual;
			ingenic,rst-gpios = <0x00>;
			ingenic,sdio_clk = <0x01>;
			ingenic,sdr-gpios = <0x00>;
			interrupt-parent = <0x05>;
			interrupts = <0x24>;
			keep-power-in-suspend;
			max-frequency = <0x5f5e100>;
			non-removable;
			pinctrl-0 = <0x16>;
			pinctrl-1 = <0x17>;
			pinctrl-2 = <0x18>;
			pinctrl-names = "default", "enable", "disable";
			reg = <0x13460000 0x10000>;
			sd-uhs-sdr104;
			status = "okay";
			vmmc-supply = <0x19>;
			voltage-ranges = <0x708 0xce4>;
			wlan-reg-on-gpios = <0x07 0x04 0x00 0x00>;

			bcmdhd_wlan {
				compatible = "android,bcmdhd_wlan";
				gpio_wl_host_wake = <0x0b 0x02 0x00 0x00>;
				gpio_wl_reg_on = <0x07 0x04 0x01 0x00>;
			};
		};

		msc@13490000 {
			bus-width = <0x04>;
			cd-gpio = <0x08 0x0c 0x01 0x00>;
			compatible = "ingenic,sdhci";
			ingenic,rst-gpio = <0x00>;
			ingenic,sdr-gpio = <0x08 0x00 0x00 0x00>;
			interrupt-parent = <0x05>;
			interrupts = <0x30>;
			max-frequency = <0xbebc200>;
			pinctrl-0 = <0x1a>;
			pinctrl-names = "default";
			reg = <0x13490000 0x10000>;
			sd-uhs-sdr104;
			status = "disabled";
			voltage-ranges = <0x708 0xce4>;
			wp-gpio = <0x00>;
		};

		nemc@13410000 {
			#address-cells = <0x02>;
			#size-cells = <0x01>;
			compatible = "ingenic,x2000-nemc";
			pinctrl-0 = <0x13 0x14>;
			pinctrl-names = "default";
			ranges = <0x01 0x00 0x1b000000 0x1000000 0x02 0x00 0x1a000000 0x1000000>;
			reg = <0x13410000 0x1000>;
			status = "disable";

			nand@1 {
				ingenic,nemc-bus-width = <0x10>;
				ingenic,nemc-tAH = <0x0a>;
				ingenic,nemc-tAS = <0x0f>;
				ingenic,nemc-tAW = <0x05>;
				ingenic,nemc-tBP = <0x0a>;
				ingenic,nemc-tSTRV = <0x64>;
				reg = <0x01 0x00 0x1000000>;
			};
		};

		otg@13500000 {
			clock-names = "gate_otg";
			clocks = <0x06 0x58>;
			compatible = "ingenic,x2000-dwc2-hsotg";
			device-using-dma = <0x01>;
			dr_mode = "otg";
			g-np-tx-fifo-size = <0x200>;
			g-rx-fifo-size = <0x448>;
			g-tx-fifo-size = <0x10 0x10 0x10 0x80 0x100 0x100 0x200 0x300>;
			ingenic,usbphy = <0x20>;
			interrupt-parent = <0x05>;
			interrupts = <0x01>;
			otg-rev = <0x200>;
			reg = <0x13500000 0x40000>;
			status = "okay";
		};

		pwm@134c0000 {
			#pwm-cells = <0x02>;
			compatible = "ingenic,x2000-pwm";
			interrupt-parent = <0x05>;
			interrupts = <0x06>;
			phandle = <0x22>;
			pinctrl-0 = <0x1f>;
			pinctrl-names = "default";
			reg = <0x134c0000 0x10000>;
			status = "okay";
		};

		rsa@13480000 {
			compatible = "ingenic,rsa";
			interrupt-parent = <0x05>;
			interrupts = <0x18>;
			reg = <0x13480000 0x10000>;
			status = "ok";
		};

		sfc@13440000 {
			compatible = "ingenic,x2000-sfc";
			ingenic,sfc-init-frequency = <0xbebc200>;
			ingenic,sfc-max-frequency = <0x17d78400>;
			ingenic,spiflash_param_offset = <0x00>;
			ingenic,use_ofpart_info = [00];
			interrupt-parent = <0x05>;
			interrupts = <0x07>;
			pinctrl-0 = <0x1e>;
			pinctrl-names = "default";
			reg = <0x13440000 0x10000>;
			status = "disabled";

			nandflash@1 {

				partitions {
					#address-cells = <0x01>;
					#size-cells = <0x01>;
					compatible = "fixed-partitions";

					partition@0 {
						label = "uboot";
						reg = <0x00 0x100000>;
					};

					partition@100000 {
						label = "kernel";
						reg = <0x100000 0x800000>;
					};

					partition@900000 {
						label = "rootfs";
						reg = <0x900000 0xf700000>;
					};
				};
			};

			norflash@0 {

				partitions {
					#address-cells = <0x01>;
					#size-cells = <0x01>;
					compatible = "fixed-partitions";

					kernel@40000 {
						label = "kernel";
						reg = <0x40000 0x300000>;
					};

					rootfs@360000 {
						label = "rootfs";
						reg = <0x360000 0xca0000>;
					};

					uboot@0 {
						label = "uboot";
						reg = <0x00 0x40000>;
					};
				};
			};
		};
	};

	aliases {
		i2c0 = "/apb/i2c@10050000";
		i2c1 = "/apb/i2c@10051000";
		i2c2 = "/apb/i2c@10052000";
		i2c3 = "/apb/i2c@10053000";
		i2c4 = "/apb/i2c@10054000";
		i2c5 = "/apb/i2c@10055000";
		mac0 = "/ahb2/mac@134b0000";
		mac1 = "/ahb2/mac@134a0000";
		mmc0 = "/ahb2/msc@13450000";
		mmc1 = "/ahb2/msc@13460000";
		mmc2 = "/ahb2/msc@13490000";
		pwm = "/ahb2/pwm@134c0000";
		spi0 = "/apb/spi@10043000";
		spi1 = "/apb/spi@10044000";
		spi2 = "/spi_gpio_adxl345";
		uart0 = "/apb/serial@10030000";
		uart1 = "/apb/serial@10031000";
		uart2 = "/apb/serial@10032000";
		uart3 = "/apb/serial@10033000";
		uart4 = "/apb/serial@10034000";
		uart5 = "/apb/serial@10035000";
		uart6 = "/apb/serial@10036000";
		uart7 = "/apb/serial@10037000";
		uart8 = "/apb/serial@10038000";
		uart9 = "/apb/serial@10039000";
	};

	apb {
		#address-cells = <0x01>;
		#size-cells = <0x01>;
		compatible = "simple-bus";
		ranges;

		clock-controller@10000000 {
			#clock-cells = <0x01>;
			clock-names = "ext", "rtc_ext";
			clocks = <0x03 0x04>;
			compatible = "ingenic,x2000-clocks";
			little-endian;
			phandle = <0x06>;
			reg = <0x10000000 0x100>;
		};

		dtrng@10072000 {
			compatible = "ingenic,dtrng";
			interrupt-parent = <0x05>;
			interrupts = <0x22>;
			reg = <0x10072000 0x100>;
			status = "okay";
		};

		i2c@10050000 {
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			clk-always-enable;
			compatible = "ingenic,x2000-i2c";
			interrupt-parent = <0x05>;
			interrupts = <0x3d>;
			reg = <0x10050000 0x1000>;
			status = "disabled";
		};

		i2c@10051000 {
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			clk-always-enable;
			compatible = "ingenic,x2000-i2c";
			interrupt-parent = <0x05>;
			interrupts = <0x3c>;
			reg = <0x10051000 0x1000>;
			status = "disabled";
		};

		i2c@10052000 {
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			clk-always-enable;
			compatible = "ingenic,x2000-i2c";
			interrupt-parent = <0x05>;
			interrupts = <0x3b>;
			pinctrl-0 = <0x0f>;
			pinctrl-names = "default";
			reg = <0x10052000 0x1000>;
			status = "okay";

