					ingenic,pinmux-funcsel = <0x00>;
				};

				pwm5_pc {
					ingenic,pinmux = <0x08 0x05 0x05>;
					ingenic,pinmux-funcsel = <0x00>;
				};

				pwm6_pc {
					ingenic,pinmux = <0x08 0x06 0x06>;
					ingenic,pinmux-funcsel = <0x00>;
				};

				pwm7_pc {
					ingenic,pinmux = <0x08 0x07 0x07>;
					ingenic,pinmux-funcsel = <0x00>;
				};

				pwm8_pc {
					ingenic,pinmux = <0x08 0x08 0x08>;
					ingenic,pinmux-funcsel = <0x00>;
				};

				pwm9_pc {
					ingenic,pinmux = <0x08 0x09 0x09>;
					ingenic,pinmux-funcsel = <0x00>;
				};
			};

			rtc32k-pins {

				rtc32k-disable {
					ingenic,pinmux = <0x0b 0x17 0x17>;
					ingenic,pinmux-funcsel = <0x05>;
					phandle = <0x18>;
				};

				rtc32k-enable {
					ingenic,pinmux = <0x0b 0x17 0x17>;
					ingenic,pinmux-funcsel = <0x00>;
					phandle = <0x17>;
				};
			};

			scc-pc {
				ingenic,pinmux = <0x08 0x03 0x04>;
				ingenic,pinmux-funcsel = <0x03>;
			};

			sfc-pin {

				sfc-pd_4bit {
					ingenic,pinmux = <0x07 0x11 0x16>;
					ingenic,pinmux-funcsel = <0x01>;
				};

				sfc-pd_8bit {
					ingenic,pinmux = <0x07 0x11 0x1a>;
					ingenic,pinmux-funcsel = <0x01>;
				};

				sfc-pe {
					ingenic,pinmux = <0x0b 0x10 0x15>;
					ingenic,pinmux-funcsel = <0x00>;
					phandle = <0x1e>;
				};
			};

			spdif-pc {
				ingenic,pincfg = <0x08 0x0e 0x0e 0x70009>;
				ingenic,pinmux = <0x08 0x0d 0x0e>;
				ingenic,pinmux-funcsel = <0x02>;
			};

			spdif-pc-in {
				ingenic,pinmux = <0x08 0x0d 0x0d>;
				ingenic,pinmux-funcsel = <0x02>;
			};

			spdif-pc-out {
				ingenic,pincfg = <0x08 0x0e 0x0e 0x70009>;
				ingenic,pinmux = <0x08 0x0e 0x0e>;
				ingenic,pinmux-funcsel = <0x02>;
			};

			spi0-pb {
				ingenic,pinmux = <0x0a 0x1c 0x1f>;
				ingenic,pinmux-funcsel = <0x01>;
				phandle = <0x12>;
			};

			spi0-pc {
				ingenic,pinmux = <0x08 0x09 0x0c>;
				ingenic,pinmux-funcsel = <0x02>;
			};

			tcu-pin {

				tcu0_pc {
					ingenic,pinmux = <0x08 0x00 0x01>;
					ingenic,pinmux-funcsel = <0x00>;
				};

				tcu1_pc {
					ingenic,pinmux = <0x08 0x02 0x03>;
					ingenic,pinmux-funcsel = <0x00>;
				};

				tcu2_pc {
					ingenic,pinmux = <0x08 0x04 0x05>;
					ingenic,pinmux-funcsel = <0x00>;
				};

				tcu3_pc {
					ingenic,pinmux = <0x08 0x06 0x07>;
					ingenic,pinmux-funcsel = <0x00>;
				};

				tcu4_pc {
					ingenic,pinmux = <0x08 0x08 0x09>;
					ingenic,pinmux-funcsel = <0x00>;
				};

				tcu5_pc {
					ingenic,pinmux = <0x08 0x0a 0x0b>;
					ingenic,pinmux-funcsel = <0x00>;
				};

				tcu5_pe {
					ingenic,pinmux = <0x0b 0x10 0x11>;
					ingenic,pinmux-funcsel = <0x01>;
				};

				tcu6_pc {
					ingenic,pinmux = <0x08 0x0c 0x0d>;
					ingenic,pinmux-funcsel = <0x00>;
				};

				tcu6_pe {
					ingenic,pinmux = <0x0b 0x12 0x13>;
					ingenic,pinmux-funcsel = <0x01>;
				};

				tcu7_pc {
					ingenic,pinmux = <0x08 0x0e 0x0f>;
					ingenic,pinmux-funcsel = <0x00>;
				};

				tcu7_pe {
					ingenic,pinmux = <0x0b 0x14 0x15>;
					ingenic,pinmux-funcsel = <0x01>;
				};
			};

			uart0-pin {

				uart0-pd {
					ingenic,pinmux = <0x07 0x17 0x1a>;
					ingenic,pinmux-funcsel = <0x02>;
				};
			};

			uart1-pin {

				uart1-pc {
					ingenic,pinmux = <0x08 0x15 0x18>;
					ingenic,pinmux-funcsel = <0x01>;
				};

				uart1-pc-txrx {
					ingenic,pinmux = <0x08 0x17 0x18>;
					ingenic,pinmux-funcsel = <0x01>;
					phandle = <0x0c>;
				};
			};

			uart2-pin {

				uart2-pd {
					ingenic,pinmux = <0x07 0x1e 0x1f>;
					ingenic,pinmux-funcsel = <0x00>;
				};
			};

			uart3-pin {

				uart3-pc {
					ingenic,pinmux = <0x08 0x19 0x1a>;
					ingenic,pinmux-funcsel = <0x00>;
					phandle = <0x0d>;
				};

				uart3-pd {
					ingenic,pinmux = <0x07 0x00 0x03>;
					ingenic,pinmux-funcsel = <0x01>;
				};
			};

			uart4-pin {

				uart4-pa {
					ingenic,pinmux = <0x09 0x02 0x03>;
					ingenic,pinmux-funcsel = <0x01>;
					phandle = <0x0e>;
				};

				uart4-pc {
					ingenic,pinmux = <0x08 0x09 0x0c>;
					ingenic,pinmux-funcsel = <0x03>;
				};
			};

			uart5-pin {

				uart5-pa {
					ingenic,pinmux = <0x09 0x04 0x05>;
					ingenic,pinmux-funcsel = <0x01>;
				};

				uart5-pc {
					ingenic,pinmux = <0x08 0x05 0x06>;
					ingenic,pinmux-funcsel = <0x03>;
				};
			};

			uart6-pin {

				uart6-pa {
					ingenic,pinmux = <0x09 0x06 0x07>;
					ingenic,pinmux-funcsel = <0x01>;
				};

				uart6-pc {
					ingenic,pinmux = <0x08 0x07 0x08>;
					ingenic,pinmux-funcsel = <0x03>;
				};
			};

			uart7-pin {

				uart7-pa {
					ingenic,pinmux = <0x09 0x08 0x09>;
					ingenic,pinmux-funcsel = <0x01>;
				};

				uart7-pc {
					ingenic,pinmux = <0x08 0x01 0x02>;
					ingenic,pinmux-funcsel = <0x03>;
				};
			};

			uart8-pin {

				uart8-pb {
					ingenic,pinmux = <0x0a 0x1c 0x1d>;
					ingenic,pinmux-funcsel = <0x03>;
				};
			};

			uart9-pin {

				uart9-pb {
					ingenic,pinmux = <0x0a 0x1e 0x1f>;
					ingenic,pinmux-funcsel = <0x03>;
				};
			};

			vic-pin {

				vic-pa-12bit {
					ingenic,pinmux = <0x09 0x00 0x0e>;
					ingenic,pinmux-funcsel = <0x00>;
				};

				vic-pa-high-10bit {
					ingenic,pinmux = <0x09 0x02 0x0e>;
					ingenic,pinmux-funcsel = <0x00>;
				};

				vic-pa-high-8bit {
					ingenic,pinmux = <0x09 0x04 0x0b 0x09 0x0c 0x0e>;
					ingenic,pinmux-funcsel = <0x00>;
				};

				vic-pa-low-10bit {
					ingenic,pinmux = <0x09 0x00 0x09 0x09 0x0c 0x0e>;
					ingenic,pinmux-funcsel = <0x00>;
				};

				vic-pa-low-8bit {
					ingenic,pinmux = <0x09 0x00 0x07 0x09 0x0c 0x0e>;
					ingenic,pinmux-funcsel = <0x00>;
				};
			};
		};

		rtc@10003000 {
			compatible = "ingenic,rtc";
			interrupt-parent = <0x05>;
			interrupts = <0x20>;
			power-on-press-ms = <0x3e8>;
			reg = <0x10003000 0x4c>;
			status = "ok";
			system-power-controller;
		};

		sadc@10070000 {
			compatible = "ingenic,x2000-sadc";
			interrupt-parent = <0x05>;
			interrupts = <0x0b>;
			reg = <0x10070000 0x32>;
			status = "ok";
		};

		scc@10040000 {
			compatible = "ingenic,scc";
			interrupt-parent = <0x05>;
			interrupts = <0x23>;
			reg = <0x10040000 0x100>;
			status = "disabled";
		};

		serial@10030000 {
			clock-names = "uart0";
			clocks = <0x06 0x4d>;
			compatible = "ingenic,8250-uart";
			interrupt-parent = <0x05>;
			interrupts = <0x2f>;
			reg = <0x10030000 0x100>;
			reg-shift = <0x02>;
			status = "disable";
		};

		serial@10031000 {
			clock-names = "uart1";
			clocks = <0x06 0x4c>;
			compatible = "ingenic,8250-uart";
			interrupt-parent = <0x05>;
			interrupts = <0x2e>;
			pinctrl-0 = <0x0c>;
			pinctrl-names = "default";
			reg = <0x10031000 0x100>;
			reg-shift = <0x02>;
			status = "okay";
		};

		serial@10032000 {
			clock-names = "uart2";
			clocks = <0x06 0x4b>;
			compatible = "ingenic,8250-uart";
			interrupt-parent = <0x05>;
			interrupts = <0x2d>;
			reg = <0x10032000 0x100>;
			reg-shift = <0x02>;
			status = "disable";
		};

		serial@10033000 {
			clock-names = "uart3";
			clocks = <0x06 0x69>;
			compatible = "ingenic,8250-uart";
			interrupt-parent = <0x05>;
			interrupts = <0x2c>;
			pinctrl-0 = <0x0d>;
			pinctrl-names = "default";
			reg = <0x10033000 0x100>;
			reg-shift = <0x02>;
			status = "disabled";

			bluetooth {
				compatible = "openke,bcm4343x-bt";
			};
		};

		serial@10034000 {
			clock-names = "uart4";
			clocks = <0x06 0x68>;
			compatible = "ingenic,8250-uart";
			interrupt-parent = <0x05>;
			interrupts = <0x2b>;
			pinctrl-0 = <0x0e>;
			pinctrl-names = "default";
			reg = <0x10034000 0x100>;
			reg-shift = <0x02>;
			status = "okay";
		};

		serial@10035000 {
			clock-names = "uart5";
			clocks = <0x06 0x67>;
			compatible = "ingenic,8250-uart";
			interrupt-parent = <0x05>;
			interrupts = <0x2a>;
			reg = <0x10035000 0x100>;
			reg-shift = <0x02>;
			status = "disabled";
		};

		serial@10036000 {
			clock-names = "uart6";
			clocks = <0x06 0x66>;
			compatible = "ingenic,8250-uart";
			interrupt-parent = <0x05>;
			interrupts = <0x29>;
			reg = <0x10036000 0x100>;
			reg-shift = <0x02>;
			status = "disabled";
		};

		serial@10037000 {
			clock-names = "uart7";
			clocks = <0x06 0x65>;
			compatible = "ingenic,8250-uart";
			interrupt-parent = <0x05>;
			interrupts = <0x28>;
			reg = <0x10037000 0x100>;
			reg-shift = <0x02>;
			status = "disabled";
		};

		serial@10038000 {
			clock-names = "uart8";
			clocks = <0x06 0x64>;
			compatible = "ingenic,8250-uart";
			interrupt-parent = <0x05>;
			interrupts = <0x27>;
			reg = <0x10038000 0x100>;
			reg-shift = <0x02>;
			status = "disabled";
		};

		serial@10039000 {
			clock-names = "uart9";
			clocks = <0x06 0x63>;
			compatible = "ingenic,8250-uart";
			interrupt-parent = <0x05>;
			interrupts = <0x26>;
			reg = <0x10039000 0x100>;
			reg-shift = <0x02>;
			status = "disabled";
		};

		spi@10043000 {
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			clock-names = "gate_ssi0", "div_ssi";
			clocks = <0x06 0x48 0x06 0x2f>;
			compatible = "ingenic,x2000-spi";
			cs-gpios = <0x00 0x00>;
			dma-names = "tx", "rx";
			dmas = <0x11 0x16 0x11 0x17>;
			ingenic,allow_cs_same = <0x01>;
			ingenic,bus_num = <0x00>;
			ingenic,chnl = <0x00>;
			ingenic,has_dma_support = <0x00>;
			ingenic,spi-src-clk = <0x01>;
			interrupt-parent = <0x05>;
			interrupts = <0x09>;
			num-cs = <0x02>;
			pinctrl-0 = <0x12>;
			pinctrl-names = "default";
			reg = <0x10043000 0x1000>;
			spi-max-frequency = <0x337f980>;
			status = "disable";

			spidev@0 {
				compatible = "rohm,dh2228fv";
				reg = <0x00>;
				spi-max-frequency = <0x989680>;
			};
		};

		spi@10044000 {
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			clock-names = "gate_ssi1", "div_ssi";
			clocks = <0x06 0x41 0x06 0x2f>;
			compatible = "ingenic,x2000-spi";
			dma-names = "tx", "rx";
			dmas = <0x11 0x18 0x11 0x19>;
			interrupt-parent = <0x05>;
			interrupts = <0x08>;
			reg = <0x10044000 0x1000>;
			status = "disabled";
		};

		tcu@10002000 {
			clock-names = "gate_tcu";
			clocks = <0x06 0x49>;
			compatible = "ingenic,tcu";
			interrupt-names = "default";
			interrupt-parent = <0x05>;
			interrupts = <0x1b>;
			reg = <0x10002000 0x1000>;
			status = "ok";
		};

		watchdog@10002000 {
			compatible = "ingenic,watchdog";
			interrupt-parent = <0x05>;
			interrupts = <0x1b>;
			reg = <0x10002000 0x40>;
			status = "ok";
		};
	};

	bt_power {
		compatible = "ingenic,bt_power";
		ingenic,reg-on-gpio = <0x07 0x14 0x00 0x00>;
		ingenic,wake-gpio = <0x07 0x15 0x00 0x00>;
	};

	cam_regulator_avdd {
		compatible = "regulator-fixed";
		regulator-always-on;
		regulator-boot-on;
		regulator-max-microvolt = <0x2ab980>;
		regulator-min-microvolt = <0x2ab980>;
		regulator-name = "cam_avdd";
	};

	cam_regulator_dovdd {
		compatible = "regulator-fixed";
		regulator-always-on;
		regulator-boot-on;
		regulator-max-microvolt = <0x1b7740>;
		regulator-min-microvolt = <0x1b7740>;
		regulator-name = "cam_dovdd";
	};

	cam_regulator_dvdd {
		compatible = "regulator-fixed";
		regulator-always-on;
		regulator-boot-on;
		regulator-max-microvolt = <0x124f80>;
		regulator-min-microvolt = <0x124f80>;
		regulator-name = "cam_dvdd";
	};

	core-intc@12300000 {
		#interrupt-cells = <0x01>;
		compatible = "ingenic,core-intc";
		cpu-intc-map = <0x00 0x00 0x01 0x100>;
		interrupt-controller;
		interrupt-names = "intc";
		interrupt-parent = <0x02>;
		interrupts = <0x02>;
		phandle = <0x05>;
		reg = <0x12300000 0x1000 0x10001000 0x1000>;
	};

	core-ost@12000000 {
		compatible = "ingenic,core-ost";
		cpu-ost-map = <0x00 0x00 0x01 0x100>;
		interrupt-names = "sys_ost";
		interrupt-parent = <0x02>;
		interrupts = <0x04>;
		reg = <0x12000000 0x10000 0x12100000 0x10000>;
	};

	cpufreq-dt {
		compatible = "ingenic,x2000-cpufreq";
		operating-points = <0x124f80 0xdbba0 0xb71b0 0xdbba0 0x927c0 0xdbba0 0x7a120 0xdbba0 0x61a80 0xdbba0 0x5b8d8 0xdbba0 0x493e0 0xdbba0 0x30d40 0xdbba0>;
		status = "okay";
	};

	cpus {
		#address-cells = <0x01>;
		#size-cells = <0x00>;

		cpu@0 {
			clock-frequency = <0x2faf0800>;
			compatible = "ingenic,xburst2";
			cpu-idle-states = <0x01>;
			device_type = "cpu";
			reg = <0x00>;
		};

		cpu@1 {
			clock-frequency = <0x2faf0800>;
			compatible = "ingenic,xburst2";
			cpu-idle-states = <0x01>;
			device_type = "cpu";
			reg = <0x01>;
		};

		idle-states {

			pd {
				compatible = "ingenic,idle-state";
				entry-latency-us = <0x05>;
				exit-latency-us = <0x05>;
				idle-state-name = "idle pd";
				min-residency-us = <0x0a>;
				phandle = <0x01>;
			};
		};
	};

	extclk {
		#clock-cells = <0x00>;
		clock-frequency = <0x16e3600>;
		clock-output-names = "ext";
		compatible = "ingenic,fixed-clock";
		phandle = <0x03>;
	};

	gpio_keys {
		compatible = "gpio-keys";

		power {
			gpio-key,wakeup;
			gpios = <0x0b 0x1f 0x01 0x00>;
			label = "Power";
			linux,code = <0x74>;
		};
	};

	interrupt-controller {
		#address-cells = <0x00>;
		#interrupt-cells = <0x01>;
		compatible = "ingenic,cpu-interrupt-controller";
		interrupt-controller;
		phandle = <0x02>;
	};

	nebulaos_backlight_final {
		backlight-gpios = <0x08 0x00 0x00 0x00>;
		compatible = "nebulaos,backlight-final-controller";
		enable-gpios = <0x08 0x16 0x00 0x00>;
		pinctrl-0 = <0x23>;
		pinctrl-names = "pwm-active";
		pwms = <0x22 0x00 0x4e20>;
		status = "okay";
	};

	openke_panel {
		compatible = "openke,general-480x272";
		ingenic,rst-gpio = <0x0a 0x10 0x00 0x00>;
	};

	pm {
		compatible = "ingenic,x2000-pm";
		status = "disable";
	};

	reserved-memory {
		#address-cells = <0x01>;
		#size-cells = <0x01>;
		ranges;

		reserved_mem@6000000 {
			compatible = "shared-dma-pool";
			phandle = <0x21>;
			reg-128M = <0x6000000 0x2000000>;
			reg-256M = <0xe000000 0x2000000>;
			reg-64M = <0x3000000 0x1000000>;
		};
	};

	rtcclk {
		#clock-cells = <0x00>;
		clock-frequency = <0x8000>;
		clock-output-names = "rtc_ext";
		compatible = "ingenic,fixed-clock";
		phandle = <0x04>;
	};

	sound {
		compatible = "ingenic,x2000-sound";
		ingenic,model = "halley5_v30";
		status = "disabled";
	};

	spi_gpio {
		#address-cells = <0x01>;
		#size-cells = <0x00>;
		compatible = "spi-gpio";
		cs-gpios = <0x0a 0x1f 0x01 0x00>;
		gpio-miso = <0x0a 0x1d 0x01 0x00>;
		gpio-mosi = <0x0a 0x1e 0x01 0x00>;
		gpio-sck = <0x0a 0x1c 0x01 0x00>;
		num-chipselects = <0x01>;
		status = "disable";

		spidev1@0 {
			compatible = "rohm,dh2228fv";
			reg = <0x00>;
			spi-max-frequency = <0x7a120>;
			status = "disable";
		};
	};

	spi_gpio_adxl345 {
		#address-cells = <0x01>;
		#size-cells = <0x00>;
		compatible = "spi-gpio";
		cs-gpios = <0x0b 0x15 0x01 0x00>;
		miso-gpios = <0x0b 0x12 0x00 0x00>;
		mosi-gpios = <0x0b 0x11 0x00 0x00>;
		num-chipselects = <0x01>;
		sck-gpios = <0x0b 0x10 0x00 0x00>;
		status = "okay";

		spidev@0 {
			compatible = "rohm,dh2228fv";
			reg = <0x00>;
			spi-max-frequency = <0x4c4b40>;
			status = "okay";
		};
	};

	wifi_bt_power_regulator {
		compatible = "regulator-fixed";
		gpio = <0x09 0x01 0x01 0x00>;
		phandle = <0x19>;
		regulator-always-on;
		regulator-boot-on;
		regulator-max-microvolt = <0x325aa0>;
		regulator-min-microvolt = <0x325aa0>;
		regulator-name = "wifi_bt_power";
	};
};
