# Read by S01syslogd (Buildroot). G24 (2026-10-12): the system log is kept on
# /usr/data, in Moonraker's logs folder, so it survives reboots and shows up in
# Mainsail and on the screen's Logs page: system.log, rotated at 512 KiB, two
# older copies (system.log.0, system.log.1) - at most about 1.5 MiB.
#
# S01syslogd runs after S01persistent-datastore (alphabetical within S01), so
# /opt/printer_data is the persistent bind by now, and it stops before it at
# shutdown, so the file is closed before /usr/data is unmounted.
NEBULAOS_SYSLOG=/opt/printer_data/logs/system.log
# G60 (2026-10-16): the general log level (Settings > System), one of
# info | warning | debug, stored by nebulaos-osconfig. BusyBox -l N keeps
# messages more urgent than N: warning -> 5, info -> 7, debug -> 8.
NEBULAOS_LOG_LEVEL_FILE="${NEBULAOS_LOG_LEVEL_FILE:-/usr/data/nebulaos/system/log-level}"
case "$(cat "$NEBULAOS_LOG_LEVEL_FILE" 2>/dev/null)" in
	warning) NEBULAOS_SYSLOG_L=5 ;;
	debug) NEBULAOS_SYSLOG_L=8 ;;
	*) NEBULAOS_SYSLOG_L=7 ;;
esac
SYSLOGD_ARGS="-O $NEBULAOS_SYSLOG -s 512 -b 2 -l $NEBULAOS_SYSLOG_L"

# Readers that still look in the old place (/var/log -> /tmp, RAM).
mkdir -p /var/log "$(dirname "$NEBULAOS_SYSLOG")" 2>/dev/null
[ -e /var/log/messages ] && [ ! -L /var/log/messages ] && rm -f /var/log/messages
ln -sfn "$NEBULAOS_SYSLOG" /var/log/messages 2>/dev/null

# G68 (2026-10-16): syslogd stamps every line with the host name it sees at
# start, and S01wifi (which sets the saved name) runs after it - so the whole
# log said "buildroot". Set the saved host name first (read-only lookup, the
# default "nebulaos" when there is no saved one).
NEBULAOS_NETWORK_LIB="${NEBULAOS_NETWORK_LIB:-/etc/nebulaos-network.sh}"
if [ -r "$NEBULAOS_NETWORK_LIB" ]; then
	( . "$NEBULAOS_NETWORK_LIB" && { nnet_load >/dev/null 2>&1; hostname "$NNET_HOSTNAME"; } ) 2>/dev/null
fi
