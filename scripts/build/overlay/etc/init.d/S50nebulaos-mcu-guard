#!/bin/sh
#
# S50nebulaos-mcu-guard - MCU identity verification before Klipper
#
# Phase 1.8B Workstream B: READ-ONLY identity check service. Runs before
# S55klipper (same S50 prefix as S50webcam; alphabetical sort guarantees
# this script runs first) and queries the GD32F303 MCU's bootloader
# identity via creality_flash.py's serial-magic protocol. Logs the
# finding, writes a machine-readable state file to /run/ (tmpfs), and
# sets an exit code that downstream services can check.
#
# SAFETY CONTRACT:
#   - This service NEVER flashes the MCU (no erase, no write, no
#     flash_image, no flash subcommand).
#   - This service NEVER writes to /dev/mmcblk0p1 or any block device.
#   - This service NEVER calls write_ota_marker or modifies any
#     persistent storage.
#   - The Python helper ALWAYS calls app_start() after querying identity,
#     returning the MCU to its application firmware.
#   - The only serial interaction is: enter_bootloader -> get_version ->
#     app_start (all read-only from the MCU's perspective).
#
# CORRECTED DESIGN (offline pre-build review, superseding the original
# bootloader-hw-id-only version of this service): mcu_identity_check.py now
# delegates to mcu_lifecycle.py, which checks APPLICATION identity (which
# firmware is running - via a pre-Klippy Klipper-protocol identify handshake)
# separately from HARDWARE identity (which physical MCU - via the bootloader
# protocol). The two are NOT the same thing: the bootloader hardware ID has
# been observed identical whether candidate-001 or stock firmware is
# installed, so the original hw-id-only check could never actually prove
# candidate-001 was the running application. See mcu_lifecycle.py.
#
# STATE MACHINE (mcu_lifecycle.py / mcu_restore.py):
#   SUPPORTED_HW_NATIVE_APP       -> PASS, start Klipper, no flash
#   SUPPORTED_HW_KNOWN_STOCK_APP  -> restore authorized (mcu_restore.py runs
#                                     ONE bounded flash attempt, gated by a
#                                     pinned SHA256 + hardware allow-list)
#   SUPPORTED_HW_UNKNOWN_APP      -> WARN, let Klipper try, NEVER auto-flash
#   UNSUPPORTED_HW                -> FAIL, block Klipper, NEVER flash
#   MCU_UNREACHABLE               -> WARN, let Klipper try (its own retry
#                                     logic is the second line of defense),
#                                     no stock fallback, bounded (one attempt)
#
# See docs/MCU_LIFECYCLE_GUARD.md for the full design document.

MCU_GUARD_STATE="${MCU_GUARD_STATE:-/run/nebulaos-mcu-guard.state}"
MCU_IDENTITY_CHECK="${MCU_IDENTITY_CHECK:-/etc/nebulaos/mcu_identity_check.py}"
PYTHON3="${MCU_GUARD_PYTHON3:-/usr/bin/python3}"
EXPECTED_HW_ID="mcu0_001_G32"

log() {
    echo "S50nebulaos-mcu-guard: $1"
}

# Phase 2 overnight convergence mission (2026-09-09): MCU_GUARD_DETAIL is
# the one field here that carries mcu_identity_check.py's free-text
# MCU_LIFECYCLE_DETAIL message, which legitimately contains shell
# metacharacters - a real device found live with MCU_GUARD_RESULT=WARN
# carried the detail "application_identify_failed
# (identify_handshake_timeout); hardware_check_also_unreachable
# (version_query_failed_after_bootloader_entry)". Writing that unquoted
# made `nebulaos-mcu status`'s `. "$state"` sourcing fail outright with a
# shell syntax error - not a warning, a hard crash, on a device where the
# MCU guard itself had already correctly recorded a WARN and let Klipper
# proceed. Every OTHER field here is one of this project's own fixed,
# enum-like tokens (PASS/WARN/FAIL, a version string, a lifecycle-state
# name) with no metacharacters ever observed or expected, and existing
# tooling (tests/mcu-guard-tests.sh, nebulaos-mcu itself) greps/sources
# them unquoted - only MCU_GUARD_DETAIL is quoted, to fix the real bug
# without changing the format of every other field. single_quote() is the
# same `'\''`-splice technique used throughout this project's other shell
# scripts for a value that must round-trip through `.` sourcing.
single_quote() {
    printf "%s" "$1" | sed "s/'/'\\\\''/g"
}

write_state() {
    _result="$1"
    _identity="${2:-unknown}"
    _detail="${3:-}"
    _ts=$(date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || echo "unknown")
    cat > "$MCU_GUARD_STATE" <<-EOF
	MCU_GUARD_RESULT=$_result
	MCU_IDENTITY=$_identity
	MCU_GUARD_DETAIL='$(single_quote "$_detail")'
	MCU_GUARD_TIMESTAMP=$_ts
	MCU_GUARD_EXPECTED=$EXPECTED_HW_ID
	MCU_LIFECYCLE_STATE=${_lifecycle_state:-unknown}
	MCU_APPLICATION_IDENTITY=${_application_identity:-unknown}
	MCU_APPLICATION_CLASS=${_application_class:-unknown}
	MCU_HW_ID_STATUS=${_hw_id_status:-not_checked}
	MCU_RESTORE_RESULT=${_restore_result:-not_attempted}
	EOF
    mcu_unreachable_notice "$_result"
}

# G76 (Run 12, 2026-10-18): on ke-dev, after an install that switched from
# the Creality slot with a software reboot, neither the MCU firmware nor its
# bootloader answered until the printer was switched off and on. There is no
# software path to reset the MCU (bootloader entry goes over the same serial
# link; no SoC GPIO is wired to its reset in the device tree), so the screen
# tells the user what fixes it - one notice (the G65 notice mechanism),
# removed again as soon as the MCU answers.
MCU_UNREACHABLE_NOTICE="${MCU_UNREACHABLE_NOTICE:-/usr/data/nebulaos/system/notices/mcu-unreachable.txt}"
mcu_unreachable_notice() {
    _nd=$(dirname "$MCU_UNREACHABLE_NOTICE")
    [ -d "$(dirname "$_nd")" ] || return 0
    if [ "${_lifecycle_state:-}" = MCU_UNREACHABLE ]; then
        mkdir -p "$_nd" 2>/dev/null
        printf '%s\n' "The printer's mainboard is not answering. Switch the printer off, wait 10 seconds and switch it on again." \
            > "$MCU_UNREACHABLE_NOTICE" 2>/dev/null
    elif [ "$1" = PASS ]; then
        rm -f "$MCU_UNREACHABLE_NOTICE" 2>/dev/null
    fi
    return 0
}

do_check() {
    log "starting MCU identity verification"

    # Preflight: the Python helper must exist and be readable.
    if [ ! -f "$MCU_IDENTITY_CHECK" ]; then
        log "WARNING: identity check helper not found at $MCU_IDENTITY_CHECK"
        log "allowing Klipper to start (helper not deployed yet)"
        write_state "WARN" "unknown" "helper_not_found"
        exit 0
    fi

    if [ ! -x "$PYTHON3" ]; then
        log "WARNING: Python interpreter not found at $PYTHON3"
        write_state "WARN" "unknown" "python_not_found"
        exit 0
    fi

    # Run the identity check helper. It prints key=value pairs on stdout
    # and exits 0 on success, non-zero on failure. Capture its output.
    check_output=$("$PYTHON3" "$MCU_IDENTITY_CHECK" 2>&1) || true
    check_exit=$?

    # Parse the result from the helper output. mcu_identity_check.py's
    # final line is always MCU_GUARD_RESULT=PASS|WARN|FAIL (take the LAST
    # match, since the restore path prints an earlier provisional line
    # before mcu_restore.py's outcome is known).
    _guard_result=$(echo "$check_output" | sed -n 's/^MCU_GUARD_RESULT=//p' | tail -1)
    _detail=$(echo "$check_output" | sed -n 's/^MCU_LIFECYCLE_DETAIL=//p' | head -1)
    _lifecycle_state=$(echo "$check_output" | sed -n 's/^MCU_LIFECYCLE_STATE=//p' | head -1)
    _application_identity=$(echo "$check_output" | sed -n 's/^MCU_APPLICATION_IDENTITY=//p' | head -1)
    _application_class=$(echo "$check_output" | sed -n 's/^MCU_APPLICATION_CLASS=//p' | head -1)
    _hw_id_status=$(echo "$check_output" | sed -n 's/^MCU_HW_ID_STATUS=//p' | head -1)
    _restore_result=$(echo "$check_output" | sed -n 's/^MCU_RESTORE_RESULT=//p' | head -1)

    # If the helper produced no parseable output at all, treat as a warning
    # (timing issue, import error, etc.) - do not block Klipper.
    if [ -z "$_guard_result" ]; then
        log "WARNING: identity check helper produced no parseable result"
        log "helper output: $check_output"
        log "allowing Klipper to start (identity check inconclusive)"
        write_state "WARN" "unknown" "helper_no_output"
        exit 0
    fi

    log "lifecycle_state=$_lifecycle_state application_class=$_application_class hw_id_status=$_hw_id_status restore_result=$_restore_result"

    # Decision logic based on the helper's structured result. The helper
    # (mcu_identity_check.py, delegating to mcu_lifecycle.py/mcu_restore.py)
    # always prints exactly one of PASS/WARN/FAIL as its final
    # MCU_GUARD_RESULT line - the detailed reasoning (which state, which
    # identity, whether a restore was attempted) is in the fields already
    # captured above and persisted to the state file below.
    case "$_guard_result" in
        PASS)
            log "MCU lifecycle check passed: $_lifecycle_state ($_detail)"
            write_state "PASS" "$_application_identity" "$_detail"
            exit 0
            ;;
        WARN)
            log "WARNING: $_lifecycle_state ($_detail) - allowing Klipper to start"
            write_state "WARN" "$_application_identity" "$_detail"
            exit 0
            ;;
        FAIL)
            log "ERROR: $_lifecycle_state ($_detail) - blocking Klipper start"
            write_state "FAIL" "$_application_identity" "$_detail"
            exit 1
            ;;
        *)
            log "WARNING: unrecognized check result '$_guard_result'"
            write_state "WARN" "$_application_identity" "unrecognized_result"
            exit 0
            ;;
    esac
}

case "$1" in
    start)
        do_check
        ;;
    stop)
        :
        ;;
    restart)
        "$0" start
        ;;
    *)
        echo "Usage: $0 {start|stop|restart}"
        exit 1
        ;;
esac
exit 0
