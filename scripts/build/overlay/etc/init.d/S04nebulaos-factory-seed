#!/bin/sh
#
# NebulaOS mutable-runtime mission, Phase 4: idempotent, offline-only
# first-boot seeding of the mutable Klipper/extensions/Moonraker/Mainsail
# checkouts
# under /usr/data/nebulaos/apps/*, from the immutable real-history git
# archives and static-release copy baked into the read-only squashfs at
# /opt/nebulaos-seeds. Never touches GitHub/PyPI/DNS - this must work with
# no network at all, so a wiped or first-time namespace can always recover.
#
# Must run after S02nebulaos-namespace (needs the directory layout to
# already exist). Like S02, this script does NOT cut any running service
# over to the seeded copies - Phase 5's activation manager does that. This
# is purely "make sure a valid, verified mutable copy exists on disk."
#
# NebulaOS auto-updates-camera-complete mission (2026-07-28, see
# docs/NEBULAOS_MOONRAKER_UPDATE_AND_CAMERA_ANALYSIS.md): the seeded
# Klipper/Moonraker checkouts are now REAL git repositories extracted
# directly from a tar archive of the actual vendor checkout's `.git`
# directory + working tree (04-cross-compile-app-stack.sh's
# make_seed_archive) - no bundle, no `git clone`, no synthetic commit.
# This replaces the prior "flattened single-commit snapshot" approach,
# whose synthetic commit shared no ancestry with the real
# coreflake1/NebulaOS-klipper or Arksine/moonraker history on GitHub and
# made Moonraker's `git merge-base --is-ancestor HEAD origin/<branch>`
# check permanently fail (diverged=true -> is_valid=false), blocking every
# real update on every freshly-seeded device. The archived HEAD commit is
# now genuinely reachable from the real remote's branch tip, so the first
# real `/machine/update/status?refresh=true` fetch resolves cleanly with
# no special-case reset required - ordinary `git fetch`/pull semantics
# apply from the very first boot.
#
# Phase 1 no-fork migration (2026-08-17): a THIRD git component is seeded
# here, apps/nebulaos-klipper-extensions, through the same seed_git_app()
# with no new machinery - it is deliberately an ordinary image-owned
# component, not a special case. Klipper's own origin also changes here,
# from the retired coreflake1/NebulaOS-klipper fork to official
# Klipper3d/klipper, and that origin is genuinely verified against the
# seeded checkout below rather than assumed. Klipper and the extensions are
# treated as one pair for generation-recording purposes: a half-seeded pair
# records no generation at all, so the next boot retries.

# Overridable via env for tests/factory-seed-git-tests.sh (same
# fixture-path convention as scripts/flash-spare-slot.sh's DEV_PREFIX) -
# real boot never sets these, so ":=" always resolves to the real paths.
SEEDS="${SEEDS:-/opt/nebulaos-seeds}"

# Audit F-10. Six fixed /tmp log paths lived here. Fixed names collide
# between runs, survive across boots as stale content, and are not writable
# in every environment this script is exercised in (they made
# tests/factory-seed-git-tests.sh fail 2 of 32 under a read-only /tmp).
#
# One validated private directory per run replaces them. The validation is
# not ceremony: an unchecked mktemp leaves an EMPTY variable, and an empty
# path reaching a redirection or a mutating command is the exact class that
# previously let `git -C ""` retarget the caller's own repository (see
# tests/test-harness-repo-safety-tests.sh). seed_log() therefore never
# returns an empty string - it degrades to /dev/null instead.
#
# Deliberately NOT cleaned up: these are diagnostic logs the rest of this
# boot may need, and they live under a tmpfs that clears on reboot anyway.
# That preserves the previous runtime semantics.
SEED_LOGDIR=$(mktemp -d "${TMPDIR:-/tmp}/nebulaos-factory-seed.XXXXXX" 2>/dev/null) || SEED_LOGDIR=""
if [ -z "${SEED_LOGDIR:-}" ] || [ ! -d "${SEED_LOGDIR:-}" ]; then
	SEED_LOGDIR=""
fi

seed_log() {
	if [ -n "$SEED_LOGDIR" ]; then
		printf '%s\n' "$SEED_LOGDIR/$1.log"
	else
		printf '%s\n' "/dev/null"
	fi
}
APPS="${APPS:-/usr/data/nebulaos/apps}"
SYSTEM="${SYSTEM:-/usr/data/nebulaos/system}"
OSCONFIG="${OSCONFIG:-/usr/libexec/nebulaos/nebulaos-osconfig}"
ENVS="${ENVS:-/usr/data/nebulaos/envs}"
LOCKDIR="${LOCKDIR:-/usr/data/nebulaos/updates/locks}"
# Overridable for tests (points fixtures at the same real, tracked shared
# gate this script actually ships - see that file's own header).
GATE_LIB="${GATE_LIB:-/etc/nebulaos-maintenance-gate.sh}"

# NebulaOS Memory Resilience Gate (docs/NEBULAOS_MEMORY_RESILIENCE.md): this
# is the "most expendable during maintenance" process tier - it should be
# the OOM-killer's first choice, well before Klipper/Moonraker/GuppyScreen.
# Applied to this shell itself so every child (git, cp) inherits it.
echo 500 > "/proc/self/oom_score_adj" 2>/dev/null

# Low-memory git settings for this 208MB-RAM device
# (docs/NEBULAOS_MEMORY_RESILIENCE.md sec 11). Seeding no longer runs
# `git clone` at all (real-history archives are extracted with plain tar,
# removing the index-pack step the OOM-killer was originally observed
# killing) - kept as defense in depth for the lightweight git commands
# seed_git_app's own verification still runs (symbolic-ref, status,
# log, rev-parse) and for any other git usage inheriting this shell's env.
export GIT_CONFIG_COUNT=4
export GIT_CONFIG_KEY_0=pack.threads GIT_CONFIG_VALUE_0=1
export GIT_CONFIG_KEY_1=core.packedGitWindowSize GIT_CONFIG_VALUE_1=1m
export GIT_CONFIG_KEY_2=core.deltaBaseCacheLimit GIT_CONFIG_VALUE_2=8m
export GIT_CONFIG_KEY_3=gc.auto GIT_CONFIG_VALUE_3=0

log() {
	echo "S04nebulaos-factory-seed: $1"
}

# Per this mission's maintenance-safety-gate requirement: heavy seeding
# must not proceed while a print is active, an update transaction is
# unresolved, or memory resilience is unavailable (the exact condition
# that caused the original OOM kill this whole sub-mission exists to
# fix). A read-only query only - no state-changing action taken here.
# maintenance_gate_ok() itself now lives in the shared $GATE_LIB (Final
# Baseline Closure mission, 2026-08-08) - see that file's own header for
# why it moved and the stale-lock fix it carries. Uses this script's own
# log()/$APPS/$LOCKDIR directly.
. "$GATE_LIB"

# Shared seed-manifest reader (F-06). Same extraction rationale as
# $GATE_LIB: identical logic in both S04 scripts, kept in one file.
SEED_MANIFEST_LIB="${SEED_MANIFEST_LIB:-/etc/nebulaos-seed-manifest.sh}"
# Sourced tolerantly. On a real device the overlay always ships it; if it
# is ever absent, seed_manifest_branch() is simply undefined, the call
# sites get an empty branch and REFUSE to seed with a named error, which
# is the correct fail-closed outcome. Sourcing it unconditionally would
# instead abort the whole script before any of that reasoning runs.
if [ -f "$SEED_MANIFEST_LIB" ]; then
	. "$SEED_MANIFEST_LIB"
fi

pause_expendable_services() {
	log "pausing expendable services for memory-heavy seeding (nebulascreen, webcam)"
	/etc/init.d/S58nebulascreen stop 2>/dev/null
	/etc/init.d/S50webcam stop 2>/dev/null
}

resume_expendable_services() {
	log "resuming paused services"
	/etc/init.d/S50webcam start 2>/dev/null
	/etc/init.d/S58nebulascreen start 2>/dev/null
}

seed_git_app() {
	name="$1"
	archive="$SEEDS/$name.tar.gz"
	dest="$APPS/$name"
	branch="$2"
	origin="$3"
	# Real bug found live (Mode B pre-qualification, 2026-07-31): the archive
	# side (scripts/build/lib/make-seed-archive.sh) deliberately excludes
	# klippy/chelper/c_helper.so from ITS OWN dirty-tree check, because the
	# real cross-compiled MIPS binary the build pipeline bakes in always
	# differs from whatever is tracked in git for that path (see that
	# script's own comments). This check never carried the same exclusion,
	# so every real seed archive for klipper was rejected here as "dirty" -
	# confirmed live, first genuine fresh-namespace test this whole seed
	# mechanism has ever had. $4 mirrors make_seed_archive()'s own
	# sparse_exclude-style opt-in, empty for every caller except klipper.
	dirty_exclude="${4:-}"

	if [ -e "$dest/.git" ]; then
		log "$name already seeded ($dest/.git exists) - skipping"
		return 0
	fi
	if [ ! -f "$archive" ]; then
		log "ERROR: seed archive missing ($archive) - cannot seed $name"
		return 1
	fi

	log "seeding $name from offline archive $archive (real git history, no clone needed)"
	rm -rf "$dest.partial"
	mkdir -p "$dest.partial"
	# Real bug found live (first genuinely successful fresh-boot attempt,
	# 2026-07-28): this device's real BusyBox tar has no -z support at all
	# ("tar: invalid option -- 'z'") - `tar -xzf` failed outright on every
	# single fresh-boot test this whole mission ran, on every rebuild,
	# which is what actually made klipper/moonraker's app directories come
	# up empty every time (the sparse-checkout and S01wifi fixes earlier
	# this mission were both still real, valid improvements, but neither
	# one was the true blocker). BusyBox's own `-a` (extension-based
	# auto-detect) also failed live ("invalid tar magic") - it does not
	# apply to extraction the way GNU tar's does. The portable fix that
	# works identically on both BusyBox (device) and GNU tar (this
	# project's own tests, run on a normal Linux host): decompress with
	# the separate, universally-available `gzip` applet/binary, then feed
	# plain tar data to a tar invocation neither implementation needs any
	# format-specific flag for. `-o` (no-same-owner) is the second real
	# fix this same test uncovered: extracted files otherwise keep the
	# archive-creation host's original UID, which made git itself refuse
	# to operate on the result ("detected dubious ownership") - confirmed
	# this exact failure live before adding `-o`.
	if ! sh -c "gzip -dc '$archive' | tar -xo -C '$dest.partial'"; then
		log "ERROR: tar extraction failed for $name - leaving no partial state"
		rm -rf "$dest.partial"
		return 1
	fi
	sync

	# Verify the seeded checkout landed on the exact expected branch and
	# real origin before it is considered valid - an interrupted or
	# corrupted archive extraction must never silently become "seeded."
	actual_branch=$(git -C "$dest.partial" symbolic-ref --short HEAD 2>/dev/null)
	if [ "$actual_branch" != "$branch" ]; then
		log "ERROR: $name seeded checkout is on branch '$actual_branch', expected '$branch' - rejecting"
		rm -rf "$dest.partial"
		return 1
	fi
	actual_origin=$(git -C "$dest.partial" remote get-url origin 2>/dev/null)
	if [ "$actual_origin" != "$origin" ]; then
		log "ERROR: $name seeded checkout has origin '$actual_origin', expected '$origin' - rejecting"
		rm -rf "$dest.partial"
		return 1
	fi
	if [ -n "$dirty_exclude" ]; then
		dirty_status=$(git -C "$dest.partial" status --porcelain -- . ":!$dirty_exclude" 2>/dev/null)
	else
		dirty_status=$(git -C "$dest.partial" status --porcelain 2>/dev/null)
	fi
	if [ -n "$dirty_status" ]; then
		log "ERROR: $name seeded checkout has a dirty working tree - rejecting"
		rm -rf "$dest.partial"
		return 1
	fi
	if git -C "$dest.partial" log --all --format=%s 2>/dev/null | grep -q "NebulaOS factory seed snapshot"; then
		log "ERROR: $name seeded checkout contains a synthetic wrapper commit - rejecting"
		rm -rf "$dest.partial"
		return 1
	fi

	# Real bug found live (docs/NEBULAOS_MEMORY_RESILIENCE.md sec 5): $dest
	# already exists as an empty directory (S02nebulaos-namespace's own
	# `mkdir -p .../apps/klipper`) by the time this runs. `mv srcdir
	# destdir` when destdir already exists moves srcdir INSIDE it rather
	# than replacing it - confirmed with a local reproduction - producing
	# apps/klipper/klipper.partial instead of a seeded apps/klipper. This
	# was mistaken for a memory/OOM issue at first because it kept leaving
	# the exact same-looking ".partial" trail; it is unrelated to memory -
	# it reproduced identically even after zram/disk swap were both
	# confirmed correctly active with zero OOM events. A plain `rmdir`
	# (only-if-empty) was tried first and verified to work in an isolated
	# manual test - but still left the same nesting live, meaning $dest
	# was not always genuinely empty at this point (most likely leftover
	# debris from an earlier failed attempt this same boot, not yet fully
	# explained). `rm -rf` here is safe regardless of what is inside -
	# the `-e "$dest/.git"` check above already proved $dest holds no
	# valid seeded checkout, so its content (empty or partial debris) is
	# always safe to discard right before mv replaces it.
	rm -rf "$dest"
	mv "$dest.partial" "$dest"
	log "$name seeded successfully (branch $branch, $(git -C "$dest" rev-parse HEAD))"
}

seed_mainsail() {
	dest="$APPS/mainsail"
	if [ -e "$dest/index.html" ]; then
		log "mainsail already seeded ($dest/index.html exists) - skipping"
		return 0
	fi
	if [ ! -d /usr/share/mainsail ]; then
		log "ERROR: immutable Mainsail source /usr/share/mainsail missing - cannot seed"
		return 1
	fi
	log "seeding mainsail from immutable /usr/share/mainsail"
	rm -rf "$dest.partial"
	mkdir -p "$dest.partial"
	cp -a /usr/share/mainsail/. "$dest.partial/"
	if [ ! -e "$dest.partial/index.html" ]; then
		log "ERROR: mainsail copy incomplete (no index.html) - rejecting"
		rm -rf "$dest.partial"
		return 1
	fi
	rm -rf "$dest"
	mv "$dest.partial" "$dest"
	log "mainsail seeded successfully"
}

# NebulaOS mutable-runtime mission, Phase 7: writable Moonraker Python
# environment. Confirmed live (docs/NEBULAOS_MEMORY_RESILIENCE.md sec 7's
# companion investigation) that every one of Moonraker's real dependencies
# (scripts/moonraker-requirements.txt in the vendored checkout) already
# imports successfully against the system Python - Buildroot's own python
# packages plus this project's existing pywheels-flatten step
# (04-cross-compile-app-stack.sh) already cover the full set, including
# the C-extension ones (numpy, streaming_form_data) that would otherwise
# need on-device compilation. `--system-site-packages` means this venv
# starts out fully functional immediately, with zero new package
# installs required - "reproducible on MIPS" is satisfied by reuse, not
# by a fragile on-device pip/compile step. Future updates (Phase 10) can
# still `pip install` into this venv specifically without touching the
# system-wide Python.
#
# Confirmed live this takes ~59s of CPU time (not memory - no swap use
# observed) on this device - accounted for by running inside the same
# maintenance-gate/expendable-oom-priority window as the rest of this
# script's work, not because it is itself memory-heavy.
# Production optimization mission, Phase 11 (2026-07-30): try extracting
# the prebuilt venv seed (04-cross-compile-app-stack.sh) first - a plain
# tar extraction of a handful of small text files/symlinks, seconds
# instead of the ~59s `python3 -m venv` (mostly ensurepip) takes live on
# this device. Falls back to the original on-device creation path on ANY
# failure - missing seed archive, extraction failure, or a failed import
# smoke test - so a bad or missing seed can never leave the printer
# unusable. $1: seed archive filename under $SEEDS. $2: envdir. $3: python
# import smoke-test expression (same ones already used below).
# Persistent-venv compatibility helpers (venv_is_usable,
# recover_torn_venv, swap_venv_into_place) live in one shared file so that
# S05nebulaos-activate applies the SAME predicate this script does.
# Locate the shared persistent-venv helpers.
#
# The same expression has to work in two places. On the device this script is
# /etc/init.d/S04nebulaos-factory-seed and the library is
# /usr/libexec/nebulaos-venv-lib.sh. In the overlay source tree - which is what
# every test harness runs against - they are <overlay>/etc/init.d/... and
# <overlay>/usr/libexec/... So `<dir of this script>/../../usr/libexec/...`
# resolves correctly in BOTH, and an absolute /usr/libexec path resolves only
# on the device.
#
# An earlier revision hardcoded the absolute path and hard-failed when it was
# missing. That was fail-closed in the right direction but it broke seven test
# suites that stage the init script without a full rootfs - the script aborted
# before doing any of its real work. Try the override, then the device path,
# then the script-relative path; fail closed only if none exists.
# $0 is not reliable here: the test harnesses source this script inside
# `sh -c ". <path>"`, where $0 is empty and `dirname ""` errors out. Guard it.
if [ -n "${0:-}" ]; then _venv_lib_dir=$(dirname "$0"); else _venv_lib_dir=.; fi
for _cand in \
	"${NEBULAOS_VENV_LIB:-}" \
	/usr/libexec/nebulaos-venv-lib.sh \
	"$_venv_lib_dir/../../usr/libexec/nebulaos-venv-lib.sh"; do
	[ -n "$_cand" ] && [ -r "$_cand" ] || continue
	NEBULAOS_VENV_LIB=$_cand
	break
done
if [ -n "${NEBULAOS_VENV_LIB:-}" ] && [ -r "$NEBULAOS_VENV_LIB" ]; then
	. "$NEBULAOS_VENV_LIB"
else
	log "FATAL: nebulaos-venv-lib.sh not found - cannot validate persistent venvs safely"
	exit 1
fi

try_venv_seed() {
	seed_file="$1"; envdir="$2"; smoke_test="$3"
	seed_path="$SEEDS/$seed_file"
	[ -f "$seed_path" ] || return 1
	rm -rf "$envdir.partial"
	mkdir -p "$envdir.partial"
	if ! sh -c "gzip -dc '$seed_path' | tar -xo -C '$envdir.partial'" 2>"$(seed_log venv-seed-extract-error)"; then
		log "WARNING: venv seed extraction failed ($seed_path) - see $(seed_log venv-seed-extract-error) - falling back to on-device venv creation"
		rm -rf "$envdir.partial"
		return 1
	fi
	if ! "$envdir.partial/bin/python3" -c "$smoke_test" 2>"$(seed_log venv-seed-smoke-error)"; then
		log "WARNING: venv seed failed its own import smoke test ($seed_path) - see $(seed_log venv-seed-smoke-error) - falling back to on-device venv creation"
		rm -rf "$envdir.partial"
		return 1
	fi
	swap_venv_into_place "$envdir" || return 1
	return 0
}

setup_moonraker_env() {
	envdir="$ENVS/moonraker"
	# streaming_form_data.targets, not the bare package: that is the module
	# Moonraker imports, and the one that imports smart_open. The bare
	# `import streaming_form_data` passed on an image missing smart_open while
	# Moonraker died at import.
	moonraker_smoke="import tornado, numpy, streaming_form_data.targets"
	recover_torn_venv "$envdir" "$moonraker_smoke"
	if venv_validated_usable "$envdir" "$moonraker_smoke"; then
		log "moonraker venv already present and matches this image's python ($envdir) - skipping"
		return 0
	fi
	if try_venv_seed "moonraker-venv-seed.tar.gz" "$envdir" "import tornado, numpy, streaming_form_data.targets"; then
		log "moonraker venv seeded from prebuilt archive and verified successfully"
		return 0
	fi
	log "creating writable Moonraker Python environment at $envdir"
	rm -rf "$envdir.partial"
	if ! python3 -m venv --system-site-packages "$envdir.partial" 2>"$(seed_log moonraker-venv-error)"; then
		log "ERROR: venv creation failed - see $(seed_log moonraker-venv-error) - leaving no partial state"
		rm -rf "$envdir.partial"
		return 1
	fi
	if ! "$envdir.partial/bin/python3" -c "import tornado, numpy, streaming_form_data.targets" 2>"$(seed_log moonraker-venv-error)"; then
		log "ERROR: moonraker venv failed its own import smoke test - see $(seed_log moonraker-venv-error) - rejecting"
		rm -rf "$envdir.partial"
		return 1
	fi
	swap_venv_into_place "$envdir" || return 1
	log "moonraker venv created and verified successfully"
}

# NebulaOS mutable-runtime closure mission (2026-07-27): writable Klippy
# Python environment, added late after discovering live that Moonraker's
# update_manager component hardcodes its "klipper" slot's virtualenv
# detection from Klippy's own reported executable (get_base_configuration()
# in vendor/moonraker's update_manager/common.py) with no config override
# available - running klippy under bare /usr/bin/python3 (this build's
# original S55klipper invocation) makes Moonraker infer a bogus venv root
# at "/usr" and raise a ConfigError that crashes the *entire*
# update_manager component (Moonraker's and Mainsail's own update-manager
# entries included, not just klipper's), confirmed live 2026-07-27. Exactly
# the same `--system-site-packages` reasoning as setup_moonraker_env()
# above applies: klippy's real dependencies (vendor/klipper/scripts/
# klippy-requirements.txt - greenlet, cffi, Jinja2, pyserial, python-can,
# msgspec) already import successfully against the system Python this
# build ships, so this venv starts out fully functional with zero new
# package installs, matching S56moonraker's own identical venv pattern
# (S55klipper prefers this venv's python the same way).
setup_klipper_env() {
	envdir="$ENVS/klipper"
	klipper_smoke="import greenlet, cffi, jinja2, serial, can"
	recover_torn_venv "$envdir" "$klipper_smoke"
	if venv_validated_usable "$envdir" "$klipper_smoke"; then
		log "klipper venv already present and matches this image's python ($envdir) - skipping"
		return 0
	fi
	if try_venv_seed "klipper-venv-seed.tar.gz" "$envdir" "import greenlet, cffi, jinja2, serial, can"; then
		log "klipper venv seeded from prebuilt archive and verified successfully"
		return 0
	fi
	log "creating writable Klippy Python environment at $envdir"
	rm -rf "$envdir.partial"
	if ! python3 -m venv --system-site-packages "$envdir.partial" 2>"$(seed_log klipper-venv-error)"; then
		log "ERROR: venv creation failed - see $(seed_log klipper-venv-error) - leaving no partial state"
		rm -rf "$envdir.partial"
		return 1
	fi
	if ! "$envdir.partial/bin/python3" -c "import greenlet, cffi, jinja2, serial, can" 2>"$(seed_log klipper-venv-error)"; then
		log "ERROR: klipper venv failed its own import smoke test - see $(seed_log klipper-venv-error) - rejecting"
		rm -rf "$envdir.partial"
		return 1
	fi
	swap_venv_into_place "$envdir" || return 1
	log "klipper venv created and verified successfully"
}

record_known_good() {
	# Phase 8's rollback/health-check machinery consumes this - record the
	# very first known-good version for each component right after a
	# successful seed, so there is always a "previous known good" to fall
	# back to even before any real update has ever happened.
	# Real bug found live: a plain "write once, never again" guard
	# (`[ -e "$kg" ] && return 0`) can record "unseeded" permanently if
	# this function ever runs before seeding has actually finished (seen
	# live on a boot where the recorded file predated real .git content
	# by seconds - start()'s own call ordering runs this last, but the
	# guard means an earlier, premature write from the same boot's
	# history is never corrected). Only skip if the existing file already
	# reflects real seeded commits, not just any prior file.
	kg="$SYSTEM/known-good.json"
	if [ -e "$kg" ] && ! grep -q '"commit": "unseeded"' "$kg"; then
		return 0
	fi
	klipper_commit=$( [ -d "$APPS/klipper/.git" ] && git -C "$APPS/klipper" rev-parse HEAD 2>/dev/null || echo "unseeded")
	extensions_commit=$( [ -d "$APPS/nebulaos-klipper-extensions/.git" ] && git -C "$APPS/nebulaos-klipper-extensions" rev-parse HEAD 2>/dev/null || echo "unseeded")
	moonraker_commit=$( [ -d "$APPS/moonraker/.git" ] && git -C "$APPS/moonraker" rev-parse HEAD 2>/dev/null || echo "unseeded")
	now=$(date -u +%Y-%m-%dT%H:%M:%SZ)
	cat > "$kg" <<EOF
{
  "recorded_at": "$now",
  "recorded_at_caveat": "may read as an early-epoch date if this boot occurred before NTP sync",
  "klipper": {"commit": "$klipper_commit", "source": "factory_seed"},
  "nebulaos-klipper-extensions": {"commit": "$extensions_commit", "source": "factory_seed"},
  "klipper_stack": {
    "klipper_commit": "$klipper_commit",
    "extensions_commit": "$extensions_commit",
    "source": "factory_seed",
    "note": "validated and rolled back as one pair - see /etc/nebulaos-update-supervisor.sh"
  },
  "moonraker": {"commit": "$moonraker_commit", "source": "factory_seed"},
  "mainsail": {"source": "factory_seed"}
}
EOF
	log "recorded initial known-good versions ($kg)"
}

start() {
	[ -d "$APPS" ] || { log "namespace not present yet ($APPS missing) - S02 should have created it, skipping"; exit 0; }

	# BOOT-03: an explicit revalidation request (maintenance/revalidate-venvs)
	# discards every venv validation stamp, so this boot and S05 run the full
	# import checks. One-shot: consumed here, the stamps it removed are
	# rewritten only by checks that pass.
	if [ -e "$VENV_REVALIDATE_MARKER" ]; then
		log "revalidation requested - discarding venv validation stamps"
		venv_validation_reset
		rm -f "$VENV_REVALIDATE_MARKER" 2>/dev/null || true
	fi

	# Nothing to do - already fully seeded from a prior boot. Skip the
	# gate/pause/resume dance entirely rather than pausing services for
	# no reason on every normal boot after the first.
	#
	# Phase 1 no-fork migration: the extension checkout is part of this
	# condition, not an afterthought. A device seeded by an older image has
	# klipper but no extensions, and must NOT short-circuit here - it needs
	# a real seeding pass to gain the third component, and the whole point
	# of checking each component individually is that a partially-seeded
	# namespace is a state this device can genuinely be in.
	if [ -e "$APPS/klipper/.git" ] && [ -e "$APPS/nebulaos-klipper-extensions/.git" ] \
		&& [ -e "$APPS/moonraker/.git" ] && [ -e "$APPS/mainsail/index.html" ] \
		&& venv_validated_usable "$ENVS/moonraker" "import tornado, numpy, streaming_form_data.targets" \
		&& venv_validated_usable "$ENVS/klipper" "import greenlet, cffi, jinja2, serial, can"; then
		log "all components already seeded - nothing to do"
		return 0
	fi

	maintenance_gate_ok || return 0

	# Pausing is a genuine no-op on a normal first boot (S04 runs at
	# position 4, well before S50/S58 have ever started) - kept anyway so
	# a later re-invocation (namespace-recovery-after-normal-boot, or
	# Phase 7 reusing this same pattern) gets the same protection.
	pause_expendable_services

	# Serialized, one component at a time - each step's own subprocess
	# memory is fully released (process exit) before the next begins;
	# `sync` after each step flushes rather than leaving dirty pages to
	# compete with the next step's own memory needs.
	# Phase 1 no-fork migration: official Klipper, and no dirty_exclude.
	# The old fork tracked klippy/chelper/c_helper.so, so the real
	# cross-compiled MIPS binary the build bakes in always differed from
	# what git had for that path and every seed archive was rejected here
	# as dirty - hence the exclusion. Official Klipper's own .gitignore
	# contains "*.so", so the prebuilt artifact is simply ignored and the
	# tree is genuinely clean. The exclusion is not merely unnecessary now,
	# it would be a hole: it exempted a real path from the clean-tree check
	# for no remaining reason.
	seed_git_app klipper master "https://github.com/Klipper3d/klipper.git"
	klipper_seeded=$?
	setup_klipper_env
	# F-06: the expected branch comes from the seed manifest this image
	# shipped, never from a literal. The build writes it there from the
	# same $KLIPPER_EXTENSIONS_BRANCH that drives make_seed_archive, so
	# manifest and archive cannot disagree. Three hardcoded "main"
	# literals here previously rejected every "production" archive, and
	# because the check compares branch NAMES, main==production never
	# masked it. See /etc/nebulaos-seed-manifest.sh.
	#
	# The ORIGIN stays a literal deliberately: the branch is a format
	# claim about the archive (safe to derive), the origin is an identity
	# claim about WHICH repository. Deriving that would let a build
	# pointed at the wrong repo validate itself.
	extensions_branch=$(seed_manifest_branch "$SEEDS/seed-manifest.json" \
		nebulaos-klipper-extensions)
	if [ -z "$extensions_branch" ]; then
		log "ERROR: cannot determine the expected extensions branch from $SEEDS/seed-manifest.json - refusing to seed nebulaos-klipper-extensions rather than guessing a branch name (is $SEED_MANIFEST_LIB present?)"
		extensions_seeded=1
	else
		seed_git_app nebulaos-klipper-extensions "$extensions_branch" \
			"https://github.com/NebulaOS-KE/NebulaOS-klipper-extensions.git"
		extensions_seeded=$?
	fi
	seed_git_app moonraker master "https://github.com/Arksine/moonraker.git"
	setup_moonraker_env
	seed_mainsail
	sync

	resume_expendable_services
	record_known_good

	# Klipper and its extensions are ONE unit. If either half failed to
	# seed, do not record a generation: recording one would tell
	# S04nebulaos-migrate that this image's content is already installed,
	# and the missing half would never be provisioned on any later boot.
	# Leaving the generation unrecorded makes the next boot retry - the
	# same "generation is not advanced on partial success" rule the
	# migration path already relies on.
	if [ "$klipper_seeded" = "0" ] && [ "$extensions_seeded" = "0" ]; then
		record_initial_generation
	else
		log "ERROR: the Klipper stack did not seed completely (klipper rc=$klipper_seeded, extensions rc=$extensions_seeded) - NOT recording an app generation, so the next boot retries rather than treating this partial state as provisioned"
	fi
}

# Clean-Update + Virgin Baseline mission, Phase 4 (2026-08-08): record the
# app-generation baseline the moment THIS script performs a real fresh
# seed, not later in S04nebulaos-migrate's own boot slot (same S04
# position, runs immediately after this one - filename ordering places
# "factory-seed" before "migrate"). Without this, migrate would see
# content it did not itself install, with no generation recorded yet, and
# treat that as a real mismatch - immediately backing up and re-seeding
# the exact same content this script just verified and put in place.
# Harmless (identical source, idempotent), but wasteful I/O on literally
# every first boot, and leaves a spurious backup directory nobody asked
# for. No-op on any image that predates migration_version entirely (the
# grep simply finds nothing) - S04nebulaos-migrate's own fallback path
# still covers seeding-failed/partial cases correctly either way.
record_initial_generation() {
	manifest="$SEEDS/seed-manifest.json"
	[ -f "$manifest" ] || return 0
	version=$(grep -o '"migration_version"[[:space:]]*:[[:space:]]*"[^"]*"' "$manifest" | \
		sed -E 's/.*"([^"]*)"$/\1/' | head -1)
	[ -n "$version" ] || return 0
	[ -e "$SYSTEM/app-generation.json" ] && return 0
	# G116 (Run 21): a fresh install starts with the shipped Blueprint logo
	# as its boot screen (the packaged power-on logo is the same picture).
	# Never changes a printer that already has a boot display setting; a
	# failure only leaves the built-in logo.
	if [ -x "$OSCONFIG" ]; then
		"$OSCONFIG" boot-display fresh-default >/dev/null 2>&1 \
			|| log "boot logo: fresh-install default not applied (built-in logo stays)"
	fi
	mkdir -p "$SYSTEM"
	klipper_commit=$( [ -d "$APPS/klipper/.git" ] && git -C "$APPS/klipper" rev-parse HEAD 2>/dev/null || echo "unseeded")
	extensions_commit=$( [ -d "$APPS/nebulaos-klipper-extensions/.git" ] && git -C "$APPS/nebulaos-klipper-extensions" rev-parse HEAD 2>/dev/null || echo "unseeded")
	moonraker_commit=$( [ -d "$APPS/moonraker/.git" ] && git -C "$APPS/moonraker" rev-parse HEAD 2>/dev/null || echo "unseeded")
	now=$(date -u +%Y-%m-%dT%H:%M:%SZ)
	cat > "$SYSTEM/app-generation.json" <<EOF
{
  "migration_version": "$version",
  "recorded_at": "$now",
  "klipper_commit": "$klipper_commit",
  "extensions_commit": "$extensions_commit",
  "moonraker_commit": "$moonraker_commit"
}
EOF
	log "recorded initial app generation ($version) immediately after fresh seed"
}

# S04NEBULAOS_FACTORY_SEED_NO_AUTORUN=1 lets tests/factory-seed-git-tests.sh
# source this script (same convention as scripts/flash-spare-slot.sh's
# FLASH_SPARE_SLOT_NO_AUTORUN) to call seed_git_app() directly against
# fixture archives, without also running the init-script dispatch below.
if [ -z "${S04NEBULAOS_FACTORY_SEED_NO_AUTORUN:-}" ]; then
	case "$1" in
		start)
			start
			;;
		*)
			;;
	esac
	exit 0
fi
