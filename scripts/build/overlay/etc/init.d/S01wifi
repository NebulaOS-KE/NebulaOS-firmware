#!/bin/sh
#
# OpenKE addition (FIRMWARE.md sec 17/18, sec 60): starts wpa_supplicant on
# wlan0 against real credentials.
#
# NebulaOS auto-updates-camera-complete mission (2026-07-28): renumbered
# from S39 to S01 (real bug found live on a fresh-namespace boot). At S39
# this ran AFTER S04nebulaos-factory-seed - a step that writes real,
# previously-uncommitted-scale amounts of data (Klipper's real git
# history, two Python venvs) and can legitimately take several minutes on
# this hardware. With WiFi gated behind that, a device had zero network/
# SSH reachability for the entire factory-seed window - the only way in
# was GuppyScreen's touchscreen, and its own WiFi panel needs
# wpa_supplicant already running to configure anything, a real chicken-
# and-egg lockout. Two real hard-reboots happened live specifically
# because of this - an operator with no way to check progress assumed the
# device was stuck and power-cycled it mid-seed, which is what actually
# left Klipper/Moonraker's app directories incompletely seeded (not a
# WiFi defect in itself - see S04nebulaos-factory-seed's own history for
# the real fix to that half of the incident).
#
# S01 is the earliest safe position: this script's only real dependency
# is S01persistent-datastore's mount of /usr/data (needed before
# seed_default_conf() below can create $CONF) - it needs nothing from
# S02nebulaos-namespace, S03nebulaos-diskswap, or S04's factory seed at
# all. Same S-number as S01persistent-datastore is intentional and safe
# (this project's own precedent: S00revert-safety/S00zram-swap already
# share a number) - conflicts resolve alphabetically ("persistent-
# datastore" < "wifi"), so the mount always completes first.
#
# Still runs before S40nebulaos-ntpsync's `ifup -a`-equivalent bring-up,
# so wlan0 has already associated by the time udhcpc tries it (this
# script also explicitly re-runs `ifup wlan0` itself after associating,
# as a real belt-and-suspenders rather than relying on ordering alone).
#
# ctrl_interface=/var/run/wpa_supplicant in the config already matches what
# GuppyScreen's own guppyconfig.json expects for its WiFi panel (confirmed
# directly from its own config key and wpa_event.cpp's directory-scan logic,
# not guessed).
#
# Lives under /usr/data/nebulaos/ (S01persistent-datastore's DATA_ROOT)
# rather than /usr/data/wpa_supplicant.conf directly - real, persistent
# storage now (mmcblk0p10), kept in this build's own namespace rather than
# the shared partition's top level, same as everything else this build owns.
# NebulaOS mutable-runtime closure mission (2026-07-27): this previously
# lived under /usr/data/openke/, a separate legacy path now fully retired -
# relocated into the single authoritative NebulaOS namespace instead.
#
# Phase 1.5 persistent-namespace mission (2026-08): the canonical path
# moved one level deeper, into /usr/data/nebulaos/network/, for the same
# reason printer_data/database/certs/etc already have their own
# subdirectories rather than sitting loose at the namespace root. Because
# Wi-Fi is also this device's primary SSH access path, this is not a
# simple rename - see /etc/nebulaos-wifi-migrate.sh for the full safe
# migration algorithm (never destroys a working credential file before a
# verified replacement exists) and tests/nebulaos-wifi-migrate-tests.sh
# for its test matrix. The OLD path
# (/usr/data/nebulaos/wpa_supplicant.conf) is kept as a symlink into the
# new location - both paths are inside /usr/data/nebulaos, so this is a
# compatibility convenience, not a namespace-ownership exception.
#
# Pre-qualification mission Phase A3 (2026-07-31): also stabilizes wlan0's
# MAC address before wpa_supplicant/DHCP ever run - see
# /etc/nebulaos-stable-mac.sh's own header for the real bug this fixes
# (the shipped Wi-Fi firmware's placeholder NVRAM MAC fields make
# brcmfmac generate a fresh random MAC every boot).
#
# GUI workstream sec 60: the original version of this script skipped
# starting wpa_supplicant entirely when $CONF didn't exist yet - correct
# for a placeholder-safety default on an untested image, but backwards for
# a device meant to be configured through GuppyScreen's own WiFi panel: the
# daemon must be running (with no saved network) before GuppyScreen can
# scan, and SAVE_CONFIG (which GuppyScreen sends after ADD_NETWORK/
# SET_NETWORK/ENABLE_NETWORK - confirmed from wifi_panel.cpp) silently does
# nothing unless update_config=1 is already in the config file. Seeds a
# minimal, credential-free default config on first boot only (never
# overwrites a real saved config) - structurally modeled on stock's own
# real, live /usr/data/wpa_supplicant.conf (ctrl_interface + update_config
# confirmed identical directives; stock's real SSID/PSK/country entries are
# this device owner's private data and are deliberately not reproduced
# here - a fresh device ships with zero saved networks, exactly like stock
# does out of the box).

# Phase 1.5 persistent-namespace mission (2026-08): CONF is no longer a
# fixed literal - it is whatever /etc/nebulaos-wifi-migrate.sh's
# nebulaos_wifi_migrate() decides is the right, safe, already-verified
# config path for this boot (normally the new canonical
# /usr/data/nebulaos/network/wpa_supplicant.conf; the old
# /usr/data/nebulaos/wpa_supplicant.conf only on a migration failure, so
# this boot still has working Wi-Fi/SSH rather than none). 0600 mode and
# the credential-free virgin skeleton are still exactly what they were
# before - that logic now lives in the migration script so the same code
# path is exercised by both a real boot and the offline test suite.
PIDFILE=/var/run/wpa_supplicant-wlan0.pid

# GUI/service readiness mission (2026-10-09): persistent hostname and
# DHCP/static IPv4 (see /etc/nebulaos-network.sh). nnet_boot_prepare sets the
# hostname and writes /run/nebulaos/network/interfaces, which `ifup -i` uses;
# if it cannot, the read-only /etc/network/interfaces (DHCP) is used exactly
# as before. A static address whose gateway stays silent falls back to DHCP
# for this boot, in the background.
NNET_LIB="${NNET_LIB:-/etc/nebulaos-network.sh}"

start() {
	CONF=""
	if [ -f /etc/nebulaos-wifi-migrate.sh ]; then
		. /etc/nebulaos-wifi-migrate.sh
		nebulaos_wifi_migrate
		CONF="$NEBULAOS_WIFI_CONF"
	else
		echo "S01wifi: /etc/nebulaos-wifi-migrate.sh missing - cannot safely determine the Wi-Fi config path, not starting wpa_supplicant"
	fi
	if [ -z "$CONF" ] || [ ! -f "$CONF" ]; then
		echo "S01wifi: no usable Wi-Fi config path, skipping"
		return 0
	fi
	# BOOT-06: brcmfmac registers wlan0 asynchronously, and the kernel no
	# longer holds root for 2 s after the SDIO insert, so userspace can get
	# here first (measured before the change: wlan0 up at ~1.7 s, root at
	# 3.1 s; after it root mounts at ~1.1 s). Wait for the interface, bounded
	# to 10 s; never hold the boot on Wi-Fi.
	_wlan_sysfs="${NEBULAOS_WLAN_SYSFS:-/sys/class/net/wlan0}"
	_wlan_wait=0
	while [ ! -e "$_wlan_sysfs" ] && [ "$_wlan_wait" -lt "${NEBULAOS_WLAN_WAIT_TENTHS:-100}" ]; do
		sleep 0.1
		_wlan_wait=$((_wlan_wait + 1))
	done
	if [ -e "$_wlan_sysfs" ]; then
		[ "$_wlan_wait" -gt 0 ] && echo "S01wifi: waited $((_wlan_wait / 10)).$((_wlan_wait % 10)) s for wlan0"
	else
		echo "S01wifi: wlan0 did not appear within $((_wlan_wait / 10)) s - continuing (Wi-Fi may be unavailable this boot)"
	fi
	NNET_READY=0
	if [ -f "$NNET_LIB" ]; then
		. "$NNET_LIB"
		nnet_boot_prepare && NNET_READY=1
	fi
	if [ -f /etc/nebulaos-stable-mac.sh ]; then
		. /etc/nebulaos-stable-mac.sh
		nebulaos_stabilize_iface_mac wlan0 || true
	fi
	if [ -f /etc/nebulaos-wifi-power-save.sh ]; then
		. /etc/nebulaos-wifi-power-save.sh
		nebulaos_wifi_ps_apply wlan0 || true
	fi
	echo "Starting wpa_supplicant on wlan0"
	mkdir -p /var/run/wpa_supplicant
	# G22 (2026-10-12): Wi-Fi events into the system log - but only when this
	# wpa_supplicant was built with syslog support; an unknown -s would make it
	# refuse to start, and then there is no Wi-Fi at all.
	WPA_LOG=""
	/usr/sbin/wpa_supplicant -h 2>&1 | grep -q -- "-s = log output to syslog" && WPA_LOG="-s"
	start-stop-daemon -S -b -m -p "$PIDFILE" \
		-x /usr/sbin/wpa_supplicant -- \
		-i wlan0 -c "$CONF" $WPA_LOG
	# BOOT-02: fixed 2 s settle by default; a one-shot maintenance marker
	# selects the bounded event-driven wait for exactly one boot.
	if [ -f /etc/nebulaos-wifi-boot-wait.sh ]; then
		. /etc/nebulaos-wifi-boot-wait.sh
		nebulaos_wifi_boot_wait wlan0 || true
	else
		sleep 2
	fi
	if [ "$NNET_READY" = 1 ]; then
		/sbin/ifup -i "$NNET_IFACES" wlan0 2>/dev/null
	else
		/sbin/ifup wlan0 2>/dev/null
	fi
	ifup_rc=$?
	if [ "$NNET_READY" = 1 ] && [ "$NNET_MODE" = static ]; then
		nnet_static_probe >/dev/null 2>&1 &
	fi
	if command -v nebulaos_wifi_boot_wait_record_ifup >/dev/null 2>&1; then
		nebulaos_wifi_boot_wait_record_ifup "$ifup_rc"
	fi
	return 0
}

stop() {
	echo "Stopping wpa_supplicant"
	if [ -f /run/nebulaos/network/interfaces ]; then
		/sbin/ifdown -i /run/nebulaos/network/interfaces wlan0 2>/dev/null
	else
		/sbin/ifdown wlan0 2>/dev/null
	fi
	start-stop-daemon -K -p "$PIDFILE"
}

case "$1" in
	start)
		start
		;;
	stop)
		stop
		;;
	restart)
		stop
		start
		;;
	*)
		echo "Usage: $0 {start|stop|restart}"
		exit 1
		;;
esac

exit 0
