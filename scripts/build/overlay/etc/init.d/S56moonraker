#!/bin/sh
#
# OpenKE addition (FIRMWARE.md sec 13): starts Moonraker. Must come after
# S55klipper - connects to klippy's API-server Unix socket as a client via
# moonraker.conf's [server] klippy_uds_address, which already correctly
# points at klippy.sock.
#
# UNIXSOCKET below is a completely different thing: moonraker.py's own
# -u/--unixsocket flag sets its *own* "extensions" agent-socket server
# (components/extensions.py's create_unix_server), unrelated to the
# klippy connection. This previously pointed at klippy.sock itself, which
# made Moonraker bind a second listening socket directly on top of
# Klipper's own socket path - moonraker's own extensions server replaced
# Klipper's real socket file, so any *new* connection attempt to that path
# (including moonraker's own klippy_connection reconnect logic) landed on
# moonraker's extensions listener instead of real Klipper, producing a
# continuous flood of "JSON-RPC Request Error -32600, Invalid Request" and
# "Unknown method received: notify_proc_stat_update" and leaving Moonraker
# permanently stuck before the Klippy-ready handshake (GuppyScreen/Mainsail
# stuck on "waiting for printer to initialize" forever, even though Klipper
# itself was fully connected to the real MCU). Fixed by giving Moonraker's
# own extensions socket its own separate path.
MOONRAKER=/opt/moonraker/moonraker/moonraker.py
CONFIG=/opt/printer_data/config/moonraker.conf
DATAPATH=/opt/printer_data
LOGFILE=/opt/printer_data/logs/moonraker.log
UNIXSOCKET=/opt/printer_data/comms/moonraker.sock
PIDFILE="${MOONRAKER_PIDFILE:-/var/run/moonraker.pid}"
# BOOT-05: pid of the background first-start update_manager check.
RECOVERY_PIDFILE="${MOONRAKER_RECOVERY_PIDFILE:-/var/run/moonraker-recovery.pid}"

# NebulaOS mutable-runtime mission, Phase 7: prefer the writable venv
# S04nebulaos-factory-seed creates at /usr/data/nebulaos/envs/moonraker
# (matches this same path in moonraker.conf's own
# [update_manager moonraker] virtualenv: setting) - falls back to the
# system interpreter if the venv doesn't exist yet (e.g. a freshly wiped
# namespace on its very first boot, before S04 has run) so this script
# never fails to start Moonraker over a missing venv.
PYTHON3=/usr/bin/python3
[ -x /usr/data/nebulaos/envs/moonraker/bin/python3 ] && PYTHON3=/usr/data/nebulaos/envs/moonraker/bin/python3

# Final Baseline Closure mission (2026-08-08): a genuine first-boot
# startup race, distinct from (but related to) S55klipper's own
# already-documented venv-discovery bug above. Root-caused by reading the
# pinned Moonraker source directly (moonraker/components/update_manager/
# update_manager.py's PackageUpdateManager.__init__ ->
# common.get_base_configuration(); moonraker/components/app_deploy.py's
# _configure_virtualenv; moonraker/server.py's load_components/
# load_component):
#
#   - update_manager reads Klipper's reserved-slot path/executable from
#     KlippyConnection's in-memory _path/_executable fields SYNCHRONOUSLY
#     at Moonraker's own component-load time (server.load_components(),
#     called once, at startup, before Moonraker has ever attempted to
#     connect to Klippy's own socket) - there is no retry.
#   - Those fields are seeded from KlippyConnection.load_saved_state(),
#     which restores whatever was last persisted to Moonraker's own
#     database from a PREVIOUS successful identify - or, if none has ever
#     been recorded (a genuinely fresh moonraker.db), from hardcoded
#     class defaults (~/klippy-env/bin/python).
#   - If that value is wrong at the exact instant update_manager reads it
#     - because Klippy hasn't identified even once yet this boot, or
#     because an earlier boot recorded a bad value (e.g. Klippy having
#     had to fall back to bare /usr/bin/python3 - see S55klipper's own
#     comment) - update_manager raises a ConfigError. server.py's
#     load_component() catches this for optional/non-core components
#     (update_manager is loaded via that path) and does NOT crash the
#     rest of Moonraker: Klipper connectivity, Mainsail, GuppyScreen all
#     keep working, but update_manager is permanently added to
#     self.failed_components for that process's entire lifetime (no
#     component reload mechanism exists) - confirmed live 2026-08-08,
#     recovered with a single `S56moonraker restart`. That single restart
#     works because, by the time it runs, Klippy has already connected
#     and identified during the FIRST (still-running) Moonraker process,
#     persisting the now-correct value to the database for the new
#     process's own load_saved_state() to pick up.
#
# Fix: after every start, poll Moonraker's own /server/info (same
# unauthenticated-from-localhost convention nebulaos-maintenance-gate.sh's
# maintenance_gate_ok() already uses) for up to
# $MOONRAKER_INFO_POLL_TIMEOUT seconds, and if update_manager shows up in
# its failed_components list, restart Moonraker exactly once - this is
# the identical recovery a human was doing by hand, now automatic and
# bounded (never loops/retries a second time, so a genuine persistent
# misconfiguration still surfaces as a real, visible failed_components
# entry rather than restart-looping forever).
MOONRAKER_INFO_URL="${MOONRAKER_INFO_URL:-http://127.0.0.1:7125/server/info}"
MOONRAKER_INFO_POLL_TIMEOUT="${MOONRAKER_INFO_POLL_TIMEOUT:-30}"
MOONRAKER_INFO_POLL_INTERVAL="${MOONRAKER_INFO_POLL_INTERVAL:-1}"

# OOM priority policy (MEM-T07); without it, services still start, unadjusted.
NEBULAOS_OOM_POLICY="${NEBULAOS_OOM_POLICY:-/etc/nebulaos-oom-policy.sh}"
if [ -r "$NEBULAOS_OOM_POLICY" ]; then . "$NEBULAOS_OOM_POLICY"; else nebulaos_start_with_adj() { shift; "$@"; }; fi

log() {
	echo "S56moonraker: $1"
}

# MEM-T04: Moonraker's upload and other temporary files go to eMMC-backed
# /opt/printer_data instead of the RAM-backed /tmp. Python's tempfile
# honours TMPDIR, so a 200 MB G-code upload no longer costs 200 MB of RAM.
# Leftovers from a previous run are cleared, but never while a Moonraker
# instance is still alive (a restart's stop does not wait for the exit).
# An unwritable directory falls back to /tmp, which MEM-T02 bounds.
MOONRAKER_TMPDIR="${MOONRAKER_TMPDIR:-/opt/printer_data/.nebulaos-tmp/moonraker}"
prepare_tmpdir() {
	mkdir -p "$MOONRAKER_TMPDIR" 2>/dev/null
	if ! ( : > "$MOONRAKER_TMPDIR/.w" ) 2>/dev/null; then
		log "WARNING: $MOONRAKER_TMPDIR not writable - Moonraker temp falls back to RAM /tmp (bounded by MEM-T02)"
		return 0
	fi
	rm -f "$MOONRAKER_TMPDIR/.w"
	_pid=$(cat "$PIDFILE" 2>/dev/null)
	if [ -z "$_pid" ] || [ ! -d "/proc/$_pid" ]; then
		find "$MOONRAKER_TMPDIR" -mindepth 1 -maxdepth 1 -exec rm -rf {} + 2>/dev/null
	fi
	export TMPDIR="$MOONRAKER_TMPDIR"
}

# GUI/service readiness mission (2026-10-09): re-compose the [nebulaos]
# component on every start - an update_manager hard recover re-clones the
# checkout and would otherwise drop it until the next reboot (see the lib).
# Also allows machine.services.* on guppyscreen (moonraker.asvc), which
# Moonraker reads once at start.
NEBULAOS_MOONRAKER_COMPOSE_LIB="${NEBULAOS_MOONRAKER_COMPOSE_LIB:-/etc/nebulaos-moonraker-compose.sh}"
NEBULAOS_MOONRAKER_APP="${NEBULAOS_MOONRAKER_APP:-/usr/data/nebulaos/apps/moonraker}"

compose_component() {
	[ -f "$NEBULAOS_MOONRAKER_COMPOSE_LIB" ] || return 0
	( . "$NEBULAOS_MOONRAKER_COMPOSE_LIB" && compose_moonraker_component "$NEBULAOS_MOONRAKER_APP" \
		&& allow_moonraker_service "$DATAPATH" guppyscreen ) || true
}

start_daemon() {
	prepare_tmpdir
	compose_component
	# MEM-T08: Moonraker's git (update_manager) resolves through PATH; the
	# NebulaOS wrapper sets its OOM priority and keeps network git out of a
	# running print and out of memory pressure.
	export PATH="/usr/libexec/nebulaos/bin:$PATH"
	echo "Starting moonraker (using $PYTHON3)"
	# OOM priority at birth (MEM-T07): Moonraker coordinates updates and
	# rollback - protected, but below Klipper.
	nebulaos_start_with_adj "$NEBULAOS_ADJ_MOONRAKER" \
		start-stop-daemon -S -b -m -p "$PIDFILE" \
		-x "$PYTHON3" -- \
		"$MOONRAKER" -d "$DATAPATH" -c "$CONFIG" -l "$LOGFILE" \
		-u "$UNIXSOCKET"
}

stop() {
	cancel_pending_recovery
	echo "Stopping moonraker"
	start-stop-daemon -K -p "$PIDFILE" && rm -f "$PIDFILE"
}

# BOOT-05: an explicit stop (or a new start) cancels a still-pending
# background update_manager check, so it can never restart a Moonraker
# someone else stopped. The check itself runs with _IN_RECOVERY set and
# never cancels itself. A pid is only killed while it is still this script.
cancel_pending_recovery() {
	[ -n "${_IN_RECOVERY:-}" ] && return 0
	_rp=$(cat "$RECOVERY_PIDFILE" 2>/dev/null)
	if [ -n "$_rp" ] && kill -0 "$_rp" 2>/dev/null \
		&& grep -q 'S56moonraker' "/proc/$_rp/cmdline" 2>/dev/null; then
		kill "$_rp" 2>/dev/null && log "cancelled the pending first-start update_manager check (pid $_rp)"
	fi
	rm -f "$RECOVERY_PIDFILE" 2>/dev/null
}

# Waits for Moonraker's HTTP API to answer at all (it takes a few seconds
# to come up), then returns its /server/info body on stdout. Returns
# non-zero (nothing on stdout) if it never answers within the timeout -
# treated as "can't tell, don't second-guess it" by the caller, not as a
# failure signal in itself.
wait_for_server_info() {
	elapsed=0
	while [ "$elapsed" -lt "$MOONRAKER_INFO_POLL_TIMEOUT" ]; do
		info=$(wget -q -O - --timeout=2 "$MOONRAKER_INFO_URL" 2>/dev/null)
		if [ -n "$info" ]; then
			echo "$info"
			return 0
		fi
		sleep "$MOONRAKER_INFO_POLL_INTERVAL"
		elapsed=$((elapsed + MOONRAKER_INFO_POLL_INTERVAL))
	done
	return 1
}

# $1 (optional): the Moonraker pid this check belongs to. When given, the
# restart only happens if that exact instance is still the running one.
recover_update_manager_if_needed() {
	_rum_expected="${1:-}"
	info=$(wait_for_server_info) || {
		log "server/info did not respond within ${MOONRAKER_INFO_POLL_TIMEOUT}s - skipping the first-boot update_manager recovery check (Moonraker may still be starting; nothing further this script can safely do)"
		return 0
	}
	failed=$(printf '%s' "$info" | grep -o '"failed_components"[[:space:]]*:[[:space:]]*\[[^]]*\]')
	case "$failed" in
		*'"update_manager"'*)
			if [ -n "$_rum_expected" ] && [ "$(cat "$PIDFILE" 2>/dev/null)" != "$_rum_expected" ]; then
				log "update_manager failed on start, but Moonraker was restarted meanwhile (pid $_rum_expected is gone) - leaving the new instance alone"
				return 0
			fi
			log "update_manager failed to load on this start (known first-boot venv-discovery race - see this script's own header) - restarting once so it re-reads Klipper's now-identified venv path"
			stop
			start_daemon
			;;
		*)
			;;
	esac
}

# BOOT-05 (2026-10-05): the first-start update_manager check used to run
# synchronously, so rcS held S57/S58 (and the screen) for ~9.7 s on every
# boot until /server/info answered. It now runs in the background with the
# same bounded wait and the same one-restart decision. GuppyScreen does not
# need Moonraker to be up when it starts: its websocket client reconnects
# forever with a 200 ms - 2 s backoff and shows its init overlay until
# Moonraker and Klippy report ready; the S57 seeders already retry with
# their own bounded backoff.
start() {
	start_daemon
	_started=$(cat "$PIDFILE" 2>/dev/null)
	cancel_pending_recovery
	(
		_IN_RECOVERY=1
		trap '' HUP
		recover_update_manager_if_needed "$_started"
		rm -f "$RECOVERY_PIDFILE" 2>/dev/null
	) < /dev/null &
	echo $! > "$RECOVERY_PIDFILE" 2>/dev/null
	return 0
}

if [ -z "${S56MOONRAKER_NO_AUTORUN:-}" ]; then
	case "$1" in
		start)
			start
			;;
		stop)
			stop
			;;
		restart)
			stop
			start
			;;
		*)
			echo "Usage: $0 {start|stop|restart}"
			exit 1
			;;
	esac
	exit 0
fi
