#!/bin/sh
#
# NebulaOS mutable-runtime mission, Phase 3: idempotent creation of the
# /usr/data/nebulaos namespace (mutable apps, envs, printer state, updates,
# backups, maintenance) - the single authoritative NebulaOS data root.
#
# IMPORTANT - this script does NOT cut any running service over to the new
# namespace by itself. S01persistent-datastore's own bind mount of
# $NEBULAOS_ROOT/printer_data -> /opt/printer_data (a genuine fallback, not
# just an early seed) means printer_data is already live and writable before
# this script even runs; activating the OTHER apps (klipper/moonraker/
# mainsail) is Phase 5's activation manager - this script only ever creates
# the structure, so it is safe to run on every boot without affecting
# anything currently in production.
#
# NebulaOS mutable-runtime closure mission (2026-07-27): this script
# previously also migrated data out of a separate legacy path,
# /usr/data/openke/printer_data, left over from before this namespace
# existed. That path has been fully retired (no deployed OpenKE user base
# to migrate from), and the one-time migration this script's own
# migrate_openke_data() performed has already completed and been verified
# on every device that needed it - the function has been removed rather
# than kept as permanent, unused migration-compatibility code for devices
# that will never need it.
#
# Must run after S01persistent-datastore (needs /usr/data already mounted,
# and DATA_ROOT/printer_data already seeded) and before anything that might
# depend on the namespace existing later (nothing does yet - reserved
# numbering for that future dependency).

NEBULAOS_ROOT="${NEBULAOS_ROOT:-/usr/data/nebulaos}"
# Bumped to 2 by the Phase 1 no-fork migration, which adds a third
# image-owned source component (apps/nebulaos-klipper-extensions). The
# manifest is informational - nothing gates on its contents - but a device
# upgraded into this generation would otherwise keep advertising a layout
# that no longer describes what is on disk, and that is exactly the kind of
# quiet drift this file exists to prevent.
SCHEMA_VERSION=2
PRINTER_DATA_CONFIG_SEED="${PRINTER_DATA_CONFIG_SEED:-/opt/nebulaos-seeds/printer_data-config}"
PRINTER_DATA_CONFIG_MARKER="$NEBULAOS_ROOT/system/printer-data-config-seeded.json"

log() {
	echo "S02nebulaos-namespace: $1"
}

create_layout() {
	mkdir -p \
		"$NEBULAOS_ROOT/apps/klipper" \
		"$NEBULAOS_ROOT/apps/nebulaos-klipper-extensions" \
		"$NEBULAOS_ROOT/apps/moonraker" \
		"$NEBULAOS_ROOT/apps/mainsail" \
		"$NEBULAOS_ROOT/apps/guppyscreen" \
		"$NEBULAOS_ROOT/envs/moonraker" \
		"$NEBULAOS_ROOT/envs/klipper" \
		"$NEBULAOS_ROOT/printer_data/config/uploads/boot-logo" \
		"$NEBULAOS_ROOT/printer_data/config/uploads/mainboard-firmware" \
		"$NEBULAOS_ROOT/printer_data/config/uploads/system-image" \
		"$NEBULAOS_ROOT/printer_data/logs" \
		"$NEBULAOS_ROOT/printer_data/database" \
		"$NEBULAOS_ROOT/printer_data/certs" \
		"$NEBULAOS_ROOT/printer_data/comms" \
		"$NEBULAOS_ROOT/printer_data/timelapse" \
		"$NEBULAOS_ROOT/printer_data/misc" \
		"$NEBULAOS_ROOT/system" \
		"$NEBULAOS_ROOT/updates/staging" \
		"$NEBULAOS_ROOT/updates/locks" \
		"$NEBULAOS_ROOT/updates/klipper" \
		"$NEBULAOS_ROOT/updates/nebulaos-klipper-extensions" \
		"$NEBULAOS_ROOT/updates/klipper-stack" \
		"$NEBULAOS_ROOT/updates/moonraker" \
		"$NEBULAOS_ROOT/updates/mainsail" \
		"$NEBULAOS_ROOT/backups/klipper" \
		"$NEBULAOS_ROOT/backups/nebulaos-klipper-extensions" \
		"$NEBULAOS_ROOT/backups/moonraker" \
		"$NEBULAOS_ROOT/backups/mainsail" \
		"$NEBULAOS_ROOT/backups/printer_config" \
		"$NEBULAOS_ROOT/maintenance/logs"

	# apps/guppyscreen is reserved-only per this mission's own scope - a
	# marker file documents why it's intentionally empty, so a future
	# reader (or this project's own retention manager) doesn't mistake it
	# for an abandoned/incomplete directory.
	if [ ! -e "$NEBULAOS_ROOT/apps/guppyscreen/.reserved-not-implemented" ]; then
		cat > "$NEBULAOS_ROOT/apps/guppyscreen/.reserved-not-implemented" <<'EOF'
GuppyScreen stays served from the immutable /opt/guppyscreen copy for this
mission. This directory is reserved layout only - GuppyScreen's own update
mechanism is explicitly a separate, future mission per the governing brief.
EOF
	fi
}

# Real bug found live (auto-updates-camera-complete mission addendum,
# 2026-07-28): a genuinely wiped /usr/data/nebulaos/printer_data/config
# left Klipper and Moonraker crash-looping forever with no printer.cfg or
# moonraker.conf at all - the only code that had ever populated these
# files was a migration from a legacy /usr/data/openke path, removed in an
# earlier closure mission believing no fresh device would ever need it
# again. Every earlier "fresh boot" pass was a false positive: the
# development device always still had these files carried over from that
# original migration, and nobody had ever actually wiped them before.
#
# Marker-guarded exactly like S57nebulaos-camera-seed's already-qualified
# pattern: seed once, from the immutable /opt/nebulaos-seeds/
# printer_data-config/ copy (a build-time duplicate of the same tracked
# defaults that ship at /opt/printer_data/config/ - duplicated because
# S01persistent-datastore's own bind mount shadows that path with the
# persistent copy before this script even runs, the identical problem
# klipper.tar.gz/moonraker.tar.gz already solve for the app checkouts).
# Once the marker exists, this never touches printer_data/config again,
# regardless of what the user later edits, renames, or deletes - matching
# every other seed in this project (respects deliberate user deletion,
# does not turn into a continuous reconciliation loop).
seed_printer_data_config() {
	dest="$NEBULAOS_ROOT/printer_data/config"
	[ -e "$PRINTER_DATA_CONFIG_MARKER" ] && return 0

	if [ -e "$dest/printer.cfg" ] && [ -e "$dest/moonraker.conf" ]; then
		# Already has real content (e.g. carried over from before this
		# marker existed, or a prior migration) - just record the marker,
		# do not touch a single byte of it.
		write_printer_data_config_marker "already_present"
		log "printer_data/config already has printer.cfg and moonraker.conf - marker recorded, nothing copied"
		return 0
	fi

	if [ ! -f "$PRINTER_DATA_CONFIG_SEED/printer.cfg" ] || [ ! -f "$PRINTER_DATA_CONFIG_SEED/moonraker.conf" ]; then
		log "ERROR: immutable seed $PRINTER_DATA_CONFIG_SEED missing printer.cfg/moonraker.conf - cannot seed, Klipper/Moonraker will fail to start until this is corrected"
		return 1
	fi

	cp -a "$PRINTER_DATA_CONFIG_SEED/." "$dest/"

	if [ ! -e "$dest/printer.cfg" ] || [ ! -e "$dest/moonraker.conf" ]; then
		log "ERROR: printer_data/config seed copy incomplete - not writing marker, will retry next boot"
		return 1
	fi

	write_printer_data_config_marker "seeded_from_immutable_defaults"
	log "printer_data/config seeded from immutable Ender-3 V3 KE factory defaults"
}

write_printer_data_config_marker() {
	now=$(date -u +%Y-%m-%dT%H:%M:%SZ)
	cat > "$PRINTER_DATA_CONFIG_MARKER" <<EOF
{
  "seeded_at": "$now",
  "result": "$1"
}
EOF
}

write_manifest() {
	manifest="$NEBULAOS_ROOT/system/layout-manifest.json"
	# Phase 1 no-fork migration: previously an unconditional
	# "already exists, never touch it again". That was right while the
	# layout was frozen, but a device upgraded into a generation that adds
	# a whole new app would keep advertising the old layout forever, and
	# the manifest's entire job is to describe what is actually on disk.
	# Rewrite when it predates the current schema, leave it alone
	# otherwise - still no reconciliation loop, still one write per real
	# layout change.
	if [ -e "$manifest" ]; then
		recorded=$(grep -o '"schema_version"[[:space:]]*:[[:space:]]*[0-9]*' "$manifest" 2>/dev/null | \
			sed -E 's/.*:[[:space:]]*([0-9]*)$/\1/' | head -1)
		[ "$recorded" = "$SCHEMA_VERSION" ] && return 0
		log "layout manifest records schema $recorded, this image expects $SCHEMA_VERSION - refreshing it"
	fi
	now=$(date -u +%Y-%m-%dT%H:%M:%SZ)
	cat > "$manifest" <<EOF
{
  "schema_version": $SCHEMA_VERSION,
  "compatibility_version": 1,
  "created_at": "$now",
  "created_at_caveat": "may read as an early-epoch date if this boot occurred before NTP sync - see docs/NEBULAOS_RETENTION_POLICY.md sec 2.6",
  "layout": {
    "apps": ["klipper", "nebulaos-klipper-extensions", "moonraker", "mainsail", "guppyscreen"],
    "klipper_stack": ["klipper", "nebulaos-klipper-extensions"],
    "klipper_stack_note": "validated, updated and rolled back as one pair - see /etc/nebulaos-update-supervisor.sh",
    "guppyscreen_status": "reserved_not_implemented",
    "envs": ["moonraker", "klipper"],
    "printer_data": "private",
    "shared_gcode_path": "/usr/data/printer_data/gcodes"
  }
}
EOF
	log "wrote layout manifest ($manifest)"
}

start() {
	mkdir -p "$NEBULAOS_ROOT"
	create_layout
	seed_printer_data_config
	write_manifest
}

# S02NEBULAOS_NAMESPACE_NO_AUTORUN=1 lets tests/nebulaos-printerdata-seed-
# tests.sh source this script (same convention as S04nebulaos-factory-
# seeds own S04NEBULAOS_FACTORY_SEED_NO_AUTORUN) to call
# seed_printer_data_config() directly against fixture directories, without
# also running the init-script dispatch below.
if [ -z "${S02NEBULAOS_NAMESPACE_NO_AUTORUN:-}" ]; then
	case "$1" in
		start)
			start
			;;
		*)
			;;
	esac
	exit 0
fi
