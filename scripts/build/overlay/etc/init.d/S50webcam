#!/bin/sh
#
# OpenKE addition: starts pellcorp/k1-ustreamer against the real UVC webcam,
# mirroring Creality's own S50webcam pattern (see FIRMWARE.md sec 6/11) but
# using an open replacement instead of their closed cam_app + proprietary
# Helix/Felix encoder. "--encoder=HW" means the webcam's own onboard ISP does
# the MJPEG compression - this never touches Ingenic's hardware encoder at
# all, the same approach any generic USB-UVC-webcam Klipper printer uses.
#
# USB/webcam stock-parity mission (2026-07-26): the old version of this
# script hardcoded /dev/video0 and just skipped if it was absent. Real
# hardware testing (first time this project ever had an actual USB webcam
# physically attached) showed that assumption was wrong: this SoC's own
# rotation/H.264-encode/H.264-decode M2M blocks claim /dev/video0-2
# unconditionally at boot (ingenic-rot, helix-venc, felix-vdec), regardless
# of whether any USB webcam is even connected - the real webcam always
# enumerates at /dev/video3 or later. Also found: ustreamer itself never
# actually ran before this mission - a real MIPS ABI mismatch between
# pellcorp's own k1-camera-build toolchain and this project's Buildroot
# toolchain (see 04-cross-compile-app-stack.sh's own comment) meant the
# binary could never load at all, independent of this script.
#
# This version discovers the real UVC capture node dynamically via v4l2-ctl
# (now actually packaged - see 00-fetch-vendor-sources.sh/
# 04-cross-compile-app-stack.sh), and runs as a small supervising loop
# (bounded 5s poll, not a busy loop) so a webcam that enumerates late, or
# is unplugged/replugged later, is picked up without a reboot. mdev/hotplug
# event wiring would be the more "correct" event-driven approach, but this
# system doesn't currently wire the kernel hotplug sysctl to mdev at all -
# doing that is a bigger, more invasive change to how this whole image
# manages devices than this mission's actual scope, so the supervising loop
# (explicitly listed as an acceptable option) is the smaller, safer choice.

PIDFILE=/var/run/ustreamer-supervisor.pid
USTREAMER_PIDFILE=/var/run/ustreamer.pid
V4L2CTL=/usr/bin/v4l2-ctl
USTREAMER=/usr/bin/ustreamer
POLL_INTERVAL=5
SYSFS_ROOT="${SYSFS_ROOT:-/sys}"
PROC_ROOT="${PROC_ROOT:-/proc}"
# MEM-T15: memguard's camera shed marker, and the crash-loop backoff.
SHED_MARKER="${SHED_MARKER:-/run/nebulaos/shed/camera}"
BACKOFF_START=10
BACKOFF_MAX=300
CRASH_WINDOW=60

# USB/webcam+MCU-recovery mission (2026-07-26): the real webcam (v4l2-ctl
# --list-formats-ext on the real UVC node) advertises native MJPEG up to
# 1920x1080 @ 30fps - the original 640x480 here was never a hardware
# limit, just an unexamined conservative default picked when this script
# was first written. An initial pass landed on 15fps as a conservative
# choice; a later, rigorous qualification pass (a real 5-minute measured
# stream, not just a short spot check) found 1920x1080 @ 30fps clears
# every acceptance threshold with real margin, so 30 replaces 15 here:
#   - real delivered rate over 5 minutes: 29.69fps average, 28.10fps
#     minimum in any 10s window (>= the 27fps acceptance floor), vs
#     12.45fps average actually delivered at the "15fps" setting itself
#     (ustreamer's own frame-pacing math undershoots a requested rate
#     that is not the camera's native max; asking for the camera's own
#     true native 30fps ceiling avoids that pacing entirely)
#   - CPU: 6.9-7.6% average/peak at 30fps vs 3.3-3.6% at 15fps -
#     --encoder=HW means the camera's own onboard ISP does the JPEG
#     compression, not this SoC's CPU, so even the higher figure is
#     trivial on a 2-core system
#   - memory: ~16.5MB RSS at 30fps, statistically identical to ~16.7MB
#     at 15fps
#   - zero dmesg USB/UVC errors, zero stream stalls (max inter-frame gap
#     0.14s at 30fps, tighter than 15fps's own 0.18s) over the full
#     5-minute measurement
#   - zero measurable impact on Klipper/Moonraker: a real printer-object
#     query averaged 246ms with the 30fps stream active vs 236ms with no
#     webcam running at all - the two are statistically indistinguishable
#     (that ~240ms figure is this endpoint's own baseline Tornado/Python
#     round-trip cost, not webcam-related)
#   - reading a real 7.4MB file from the USB flash drive while streaming
#     30fps completed in 0.37s with no errors, and the stream kept
#     serving real frames immediately afterward
#   - two simultaneous stream clients each still received ~28.9fps with
#     no degradation
RESOLUTION=1920x1080
DESIRED_FPS=30

# Camera quality presets (2026-08-04): end-user-selectable via the
# SET_CAMERA_QUALITY_LOW/MED/HIGH macros (see
# opt/printer_data/config/camera-quality.cfg), which show up as one-click
# buttons in both Mainsail's macro panel and GuppyScreen's macros screen
# with no separate per-UI wiring. Supersedes the earlier fps-only C1
# marker from Pre-qualification mission Phase A7 - HIGH is that same,
# already-qualified 30fps default above, unchanged.
#
# LOW/MED deliberately do NOT request a capped fps (they pass 0, meaning
# "no limit" - see _capture_open_hw_fps() and the decimation guard in
# ustreamer's own stream.c, both gated on desired_fps > 0). A real source
# trace of vendor/k1-ustreamer found that requesting any fps ustreamer
# doesn't consider the camera's native max causes it to ask the V4L2
# driver for ~1.5x headroom (fps + fps/2 + 1), which this camera's
# discrete-only frame-interval steps round UP past the requested value
# (e.g. requesting ~23 rounds to 25, not down to the true 15 step) - this
# is exactly the "12.45fps actual at the '15fps' setting" undershoot this
# file's own 30fps qualification above already found and rejected at
# 1920x1080. Whether 640x480/1280x720 have the same discrete steps as
# 1080p is NOT yet verified, so leaving fps uncapped avoids reintroducing
# a known-bad pattern at untested resolutions - if a real need for a
# capped rate at these resolutions comes up, it should get its own live
# v4l2-ctl --list-frameintervals check first, not a guessed value.
#
# The real point of LOW/MED is not local CPU/memory - encoder=HW means
# resolution barely moves either (see this file's own 30fps-vs-15fps
# figures above, both trivial on this 2-core SoC) - it's a smaller JPEG
# payload crossing the WiFi hop, which is the actual constrained link
# (see docs/NEBULAOS_WIFI_CAMERA_IRQ_CONTENTION_REPORT.md).
CAMERA_QUALITY_MODE_MARKER=/usr/data/nebulaos/maintenance/camera-quality-mode
case "$(cat "$CAMERA_QUALITY_MODE_MARKER" 2>/dev/null)" in
	LOW)
		RESOLUTION=640x480
		DESIRED_FPS=0
		;;
	MED)
		RESOLUTION=1280x720
		DESIRED_FPS=0
		;;
	*)
		# HIGH, or marker missing/unrecognized - the qualified default
		# already set above (1920x1080 @ 30fps).
		;;
esac

# Any webcam, not only the Nebula Camera (2026-10-30: an old non-UVC
# Logitech, gspca driver, JPEG only, gave no picture). A camera is a node
# that is:
#   - index 0 of a USB device: not one of the SoC's own M2M nodes, and not
#     the metadata-only sibling a UVC camera exposes (index 1, same driver);
#     any driver (uvcvideo, gspca_*, ...)
#   - a Video Capture node per its own "Device Caps" block
#   - able to produce a format ustreamer can stream (webcam_format)
# sysfs only, does not open the node (CAM-01: used on every poll).
usb_capture_node() {
	n=${1#/dev/}
	[ -e "$SYSFS_ROOT/class/video4linux/$n" ] || return 1
	idx=$(cat "$SYSFS_ROOT/class/video4linux/$n/index" 2>/dev/null)
	[ "$idx" = 0 ] || return 1
	readlink -f "$SYSFS_ROOT/class/video4linux/$n/device" 2>/dev/null | grep -q '/usb[0-9]'
}

# The ustreamer --format for a node: compressed first (the camera does the
# JPEG work), then the raw formats ustreamer encodes itself. Prints nothing
# and returns 1 when the camera offers none of them.
webcam_format() {
	_fmts=$("$V4L2CTL" -d "$1" --list-formats 2>/dev/null) || return 1
	for _f in MJPG:MJPEG JPEG:JPEG YUYV:YUYV UYVY:UYVY YVYU:YVYU YU12:YUV420 YV12:YVU420 \
		RGBP:RGB565 RGB3:RGB24 BGR3:BGR24 GREY:GREY; do
		if echo "$_fmts" | grep -q "'${_f%%:*}'"; then
			echo "${_f#*:}"
			return 0
		fi
	done
	return 1
}

# Print the /dev/videoN path of the first camera; nothing and 1 if none.
discover_webcam() {
	for dev in /dev/video*; do
		[ -e "$dev" ] || continue
		usb_capture_node "$dev" || continue

		info=$("$V4L2CTL" -d "$dev" --info 2>/dev/null) || continue
		# Isolate just the "Device Caps" block (up to the next blank-ish
		# section) so we don't match the combined summary line that both
		# the real capture node and its metadata-only sibling both show.
		device_caps=$(echo "$info" | sed -n '/^\tDevice Caps/,/^[A-Za-z]/p')
		echo "$device_caps" | grep -q 'Video Capture' || continue

		webcam_format "$dev" >/dev/null || continue

		echo "$dev"
		return 0
	done
	return 1
}

# G121 (Run 22): the Nebula Camera keeps no setting over a reboot, power cycle
# or USB re-enumeration, so the saved ones (nebulaos-osconfig camera, camera/
# camera.json) are applied again whenever the served node's USB device
# changes (busnum:devnum - boot, replug, a camera reset; also when the same
# /dev name comes back, which the CAM-01 shortcut otherwise never notices).
# sysfs only (does not wake a suspended camera); the apply runs in the
# background and refuses itself for any other camera (USB id check).
OSCONFIG="${NEBULAOS_OSCONFIG:-/usr/libexec/nebulaos/nebulaos-osconfig}"
camera_identity() {
	n=${1#/dev/}
	b=$(cat "$SYSFS_ROOT/class/video4linux/$n/device/../busnum" 2>/dev/null)
	d=$(cat "$SYSFS_ROOT/class/video4linux/$n/device/../devnum" 2>/dev/null)
	[ -n "$b" ] && [ -n "$d" ] && echo "$b:$d"
}
# Only the Nebula Camera has settings to apply. Checked here, in sysfs: a
# camera that keeps re-enumerating (2026-10-30: an old USB 1.1 webcam, every
# ~10 s) otherwise started a Python process each time.
NEBULA_CAMERA_USB_ID=a108:2231
camera_usb_id() {
	n=${1#/dev/}
	v=$(cat "$SYSFS_ROOT/class/video4linux/$n/device/../idVendor" 2>/dev/null)
	p=$(cat "$SYSFS_ROOT/class/video4linux/$n/device/../idProduct" 2>/dev/null)
	echo "$v:$p"
}
apply_camera_settings_once() {
	id=$(camera_identity "$1")
	[ -n "$id" ] || return 0
	[ "$id" = "${applied_id:-}" ] && return 0
	applied_id=$id
	[ "$(camera_usb_id "$1")" = "$NEBULA_CAMERA_USB_ID" ] || return 0
	[ -x "$OSCONFIG" ] || return 0
	echo "S50webcam: camera $1 ($id) - applying the saved camera settings"
	( "$OSCONFIG" camera apply --device "$1" >/dev/null 2>&1 & )
}

ustreamer_running_on() {
	dev="$1"
	[ -f "$USTREAMER_PIDFILE" ] || return 1
	pid=$(cat "$USTREAMER_PIDFILE" 2>/dev/null)
	[ -n "$pid" ] && [ -d "/proc/$pid" ] || return 1
	# Confirm it's actually still serving the same device node, not a
	# stale pidfile pointing at an unrelated recycled PID.
	tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null | grep -q -- "--device=$dev "
}

# OOM priority policy (MEM-T07); without it, services still start, unadjusted.
NEBULAOS_OOM_POLICY="${NEBULAOS_OOM_POLICY:-/etc/nebulaos-oom-policy.sh}"
if [ -r "$NEBULAOS_OOM_POLICY" ]; then . "$NEBULAOS_OOM_POLICY"; else nebulaos_start_with_adj() { shift; "$@"; }; fi

# A camera without (M)JPEG: ustreamer encodes on the CPU, which this
# real-time printer shares with Klipper - one worker, at most 640x480, 10 fps.
RAW_RESOLUTION=640x480
RAW_FPS=10

start_ustreamer() {
	dev="$1"
	fmt=$(webcam_format "$dev") || fmt=MJPEG
	case "$fmt" in
		MJPEG|JPEG) enc="--encoder=HW" res=$RESOLUTION fps=$DESIRED_FPS ;;
		*) enc="--encoder=CPU --workers=1" res=$RAW_RESOLUTION fps=$RAW_FPS ;;
	esac
	echo "S50webcam: starting ustreamer on $dev ($fmt, $res)"
	# OOM priority at birth (MEM-T07): optional media, expendable.
	# A camera that cannot do $res gets the nearest size its driver offers
	# (ustreamer asks again with it).
	# shellcheck disable=SC2086
	nebulaos_start_with_adj "$NEBULAOS_ADJ_USTREAMER" \
		start-stop-daemon -S -b -m -p "$USTREAMER_PIDFILE" -N 5 \
		-x "$USTREAMER" -- \
		--device="$dev" --format="$fmt" $enc \
		--resolution="$res" --desired-fps="$fps" \
		--host=127.0.0.1 --port=8080 --tcp-nodelay
	# NebulaOS WiFi/camera IRQ contention mission (2026-08-03/04): live
	# frame-timing measurement (JPEG SOI/EOI-boundary timestamps, not just
	# aggregate throughput) found the stream socket's default Nagle
	# behavior added real per-frame latency specifically over the network
	# path (local/loopback median frame interval 33ms, matching the
	# requested 30fps exactly; the same measurement over the real WiFi
	# hop degraded to a 48-62ms median with frequent >100ms gaps and
	# occasional 1s+ stalls). --tcp-nodelay (an existing, documented
	# ustreamer flag - see its own --help) sets TCP_NODELAY on the
	# client /stream socket, disabling Nagle's algorithm; confirmed
	# across repeated live trials to consistently eliminate the
	# worst-case 1s+ stalls and modestly reduce typical latency. Does
	# NOT fully eliminate WiFi-path jitter on its own - see this
	# mission's own report for the fuller picture (this flag plus the
	# separate mmc1 IRQ priority fix and brcmfmac roamoff=1 change
	# together address every machine-side contributor found; residual
	# jitter beyond these three is attributed to real-time WiFi signal
	# conditions, out of this mission's scope).
}

stop_ustreamer() {
	[ -f "$USTREAMER_PIDFILE" ] || return 0
	start-stop-daemon -K -p "$USTREAMER_PIDFILE" 2>/dev/null
	rm -f "$USTREAMER_PIDFILE"
}

# Supervisor loop: bounded poll, not a hotplug event - see header comment
# for why. Runs as the process start-stop-daemon itself tracks via
# $PIDFILE, so `stop`/`restart`/`status` below all act on this loop, which
# in turn owns the actual ustreamer child via $USTREAMER_PIDFILE.
uptime_s() {
	read -r _up _ < "$PROC_ROOT/uptime" 2>/dev/null || _up=0
	echo "${_up%%.*}"
}

ustreamer_alive() {
	[ -f "$USTREAMER_PIDFILE" ] || return 1
	_pid=$(cat "$USTREAMER_PIDFILE" 2>/dev/null)
	[ -n "$_pid" ] && [ -d "$PROC_ROOT/$_pid" ]
}

supervise_tick() {
	now=$(uptime_s)
	# MEM-T15: under memory pressure memguard asks for the camera to go away;
	# stop ustreamer and start nothing while the marker exists.
	if [ -e "$SHED_MARKER" ]; then
		if [ -f "$USTREAMER_PIDFILE" ]; then
			echo "S50webcam: memory shed - stopping ustreamer"
			stop_ustreamer
		fi
		started_at=
		return 0
	fi
	# MEM-T15: a ustreamer that died on its own (crash, OOM kill) within
	# CRASH_WINDOW of starting backs off 10, 20, 40 ... 300 s before the
	# next start; 300 s of continuous running resets the backoff.
	if [ -n "${started_at:-}" ]; then
		if ustreamer_alive; then
			[ $((now - started_at)) -ge "$BACKOFF_MAX" ] && backoff=0
		else
			if [ $((now - started_at)) -lt "$CRASH_WINDOW" ]; then
				if [ "${backoff:-0}" -eq 0 ]; then backoff=$BACKOFF_START; else backoff=$((backoff * 2)); fi
				[ "$backoff" -gt "$BACKOFF_MAX" ] && backoff=$BACKOFF_MAX
				hold_until=$((now + backoff))
				echo "S50webcam: ustreamer exited after $((now - started_at)) s - backing off ${backoff} s"
			fi
			started_at=
			rm -f "$USTREAMER_PIDFILE"
		fi
	fi
	# CAM-01: while ustreamer serves a node that is still present, do not
	# re-open it for discovery.
	if [ -n "$last_dev" ] && ustreamer_running_on "$last_dev" && usb_capture_node "$last_dev"; then
		apply_camera_settings_once "$last_dev"
		return 0
	fi
	dev=$(discover_webcam)
	[ -n "$dev" ] && last_dev=$dev
	if [ -n "$dev" ]; then
		if ! ustreamer_running_on "$dev"; then
			# Either nothing running yet, or the previously-served
			# device went away and a (possibly renumbered) one came
			# back - clean up any stale instance before restarting.
			stop_ustreamer
			started_at=
			if [ "$now" -lt "${hold_until:-0}" ]; then
				return 0
			fi
			start_ustreamer "$dev"
			started_at=$now
			apply_camera_settings_once "$dev"
		fi
	else
		# No webcam right now - if something is still running (e.g.
		# device just unplugged), stop it rather than serve a dead
		# node until the next poll notices.
		if [ -f "$USTREAMER_PIDFILE" ]; then
			echo "S50webcam: webcam no longer present, stopping ustreamer"
			stop_ustreamer
			started_at=
		fi
	fi
}

supervise() {
	last_dev=
	while true; do
		supervise_tick
		sleep "$POLL_INTERVAL"
	done
}

start() {
	if [ ! -x "$V4L2CTL" ] || [ ! -x "$USTREAMER" ]; then
		echo "S50webcam: v4l2-ctl or ustreamer missing, skipping"
		return 0
	fi
	echo "Starting S50webcam supervisor"
	start-stop-daemon -S -b -m -p "$PIDFILE" \
		-x /bin/sh -- "$0" __supervise
}

stop() {
	echo "Stopping S50webcam supervisor"
	start-stop-daemon -K -p "$PIDFILE" 2>/dev/null
	rm -f "$PIDFILE"
	stop_ustreamer
}

status() {
	if [ -f "$PIDFILE" ] && [ -d "/proc/$(cat "$PIDFILE" 2>/dev/null)" ]; then
		echo "S50webcam supervisor: RUNNING"
	else
		echo "S50webcam supervisor: STOPPED"
	fi
	if [ -f "$USTREAMER_PIDFILE" ] && [ -d "/proc/$(cat "$USTREAMER_PIDFILE" 2>/dev/null)" ]; then
		echo "ustreamer: RUNNING ($(cat "$USTREAMER_PIDFILE"))"
	else
		echo "ustreamer: STOPPED"
	fi
}

[ -n "${S50WEBCAM_NO_AUTORUN:-}" ] && return 0 2>/dev/null

case "$1" in
	start)
		start
		;;
	stop)
		stop
		;;
	restart)
		stop
		start
		;;
	status)
		status
		;;
	__supervise)
		# Internal re-exec target for start-stop-daemon above - not a
		# public command.
		supervise
		;;
	*)
		echo "Usage: $0 {start|stop|restart|status}"
		exit 1
		;;
esac

exit 0
