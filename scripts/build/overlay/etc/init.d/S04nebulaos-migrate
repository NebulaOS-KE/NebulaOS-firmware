#!/bin/sh
#
# NebulaOS Clean-Update + Virgin Baseline mission, Phase 3 (2026-08-08):
# versioned migration for the persistent /usr/data application tree.
#
# S04nebulaos-factory-seed (runs immediately before this, same S04 slot -
# see that script's own header) only ever asks "does $APPS/klipper/.git
# exist at all?" - once seeded, it never checks again, on any later boot,
# with any later image. That is exactly correct for what IT is for (a
# fresh/wiped namespace's very first boot must not depend on network at
# all), but it leaves a real gap this script closes: a device that was
# ALREADY provisioned, then later reflashed with an image whose pinned
# Klipper/Moonraker/GuppyScreen commits moved forward, never gets those
# new commits into its persistent application tree - the squashfs's own
# factory-seed archive is correct, but nothing ever re-seeds an
# already-populated $APPS from it. (This is the exact class of gap
# documented live in docs/NEBULAOS_CANONICAL_DEPLOYMENT_QUALIFICATION.md's
# "persistent-data Klipper content was not touched by this reflash"
# finding.)
#
# File-classification model this script relies on (see
# docs/NEBULAOS_PERSISTENT_LIFECYCLE.md for the full writeup):
#   IMAGE OWNED  - $APPS/klipper, $APPS/nebulaos-klipper-extensions,
#                  $APPS/moonraker (git checkouts; entirely replaced by this
#                  script when the image expects a newer version - there is
#                  nothing user-authored inside them)
#
# Phase 1 no-fork migration (2026-08-17): apps/nebulaos-klipper-extensions
# joins that class as an ordinary third component. Two consequences worth
# stating explicitly rather than leaving to be rediscovered:
#
#   1. Klipper and its extensions migrate as ONE PAIR. If either fails, the
#      generation is not recorded, so the whole migration retries next boot
#      - the existing per-component-success rule, extended rather than
#      replaced. A device must never run new Klipper against old extensions
#      (that is where the c_helper.so staleness and the
#      register_response -> register_serial_response API rename both land)
#      or the reverse.
#
#   2. Replacing $APPS/klipper wholesale DESTROYS the composed symlinks that
#      activate the extension modules - they live inside the tree this
#      script renames away. That is fine and by design, but it makes the
#      S04 -> S05 ordering load-bearing in a new way: S05nebulaos-activate
#      rebuilds the composition in the same boot, before Klipper starts.
#      Covered explicitly by tests/app-migration-tests.sh.
#
# A firmware update therefore DOES override a user's separately-updated
# Klipper or extensions - deliberately, with a full backup under
# $SYSTEM/migration-backups/, and only when the image's migration_version
# differs. That is the correct behaviour for an appliance and matches how
# Klipper and Moonraker have always been treated here. It is documented in
# docs/NEBULAOS_UPDATE_OWNERSHIP.md rather than hidden, because "I updated
# Klipper in Mainsail and the firmware update reverted it" reads as a bug
# to anyone who has not been told.
#   USER OWNED   - $NEBULAOS_ROOT/printer_data/config (printer.cfg,
#                  macros, moonraker.conf) - a SEPARATE directory tree
#                  from $APPS. Safety here comes from directory separation,
#                  not per-file logic.
#                  Phase 1 no-fork migration added a NebulaOS-managed
#                  island inside this tree (printer_data/config/nebulaos/)
#                  to hold movable Klipper-stack update pins. Phase 1.5
#                  RETIRES that island: the pins now live at the
#                  image-owned, read-only /etc/nebulaos/moonraker/
#                  klipper-pin.conf instead, which is automatically
#                  correct for whichever A/B slot is active - see
#                  migrate_moonraker_pin_include() and
#                  migrate_printer_cfg() below for the two small,
#                  idempotent, one-time rewrites this script still performs
#                  on an existing user-owned moonraker.conf/printer.cfg to
#                  point them at that new location.
#   GENERATED    - $NEBULAOS_ROOT/{envs,database,printer_data/{gcodes,
#                  logs,database}} - regenerated/repopulated naturally by
#                  the application itself; also untouched here. Venv
#                  migration (envs/klipper, envs/moonraker) is explicitly
#                  OUT OF SCOPE for this script - they are derived from
#                  the Buildroot/kernel pin, not the Klipper/Moonraker
#                  source pin, and change far less often; a future mission
#                  can extend this the same way if that ever needs it.
#
# Overridable for tests, same convention as S04/flash-spare-slot.sh.
SEEDS="${SEEDS:-/opt/nebulaos-seeds}"
APPS="${APPS:-/usr/data/nebulaos/apps}"
SYSTEM="${SYSTEM:-/usr/data/nebulaos/system}"
LOCKDIR="${LOCKDIR:-/usr/data/nebulaos/updates/locks}"
GENERATION_FILE="$SYSTEM/app-generation.json"
# Records the in-progress migration attempt: which target version it is for,
# and which backup directory it already created. Its whole purpose is to make
# a RETRY reuse that directory instead of minting a new timestamped one, so a
# persistent failure cannot grow one backup per boot. Cleared once the
# generation is recorded. See ensure_backup_dir().
ATTEMPT_FILE="$SYSTEM/migration-attempt.json"
# The user-owned config tree this script performs its two narrow,
# idempotent config migrations against. Overridable for tests like every
# other path here.
PRINTER_DATA_CONFIG="${PRINTER_DATA_CONFIG:-/usr/data/nebulaos/printer_data/config}"
BACKUP_ROOT="$SYSTEM/migration-backups"
# Phase 2 calibration-framework mission - see migrate_config_ownership()
# below. Bare /usr/bin/python3 by design: this tool has zero third-party
# dependencies (stdlib only) and must not depend on Klipper's or
# Moonraker's own venvs, which this same boot may not have provisioned
# yet - same convention S04nebulaos-factory-seed already uses for its own
# early python3 -m venv call.
PYTHON3="${PYTHON3:-/usr/bin/python3}"
MIGRATE_CONFIG_OWNERSHIP_TOOL="${MIGRATE_CONFIG_OWNERSHIP_TOOL:-/opt/nebulaos/tools/migrate_config_ownership.py}"
# Overridable for tests (points fixtures at the same real, tracked shared
# gate this script actually ships - see that file's own header).
GATE_LIB="${GATE_LIB:-/etc/nebulaos-maintenance-gate.sh}"
# Phase 2 final software closure mission, 2026-09-09 - see
# config-materialize.sh's own header for what this provides
# (materialize_config_tree, config_materialization_needed).
CONFIG_MATERIALIZE_LIB="${CONFIG_MATERIALIZE_LIB:-/etc/nebulaos/config-materialize.sh}"

echo 500 > "/proc/self/oom_score_adj" 2>/dev/null

export GIT_CONFIG_COUNT=4
export GIT_CONFIG_KEY_0=pack.threads GIT_CONFIG_VALUE_0=1
export GIT_CONFIG_KEY_1=core.packedGitWindowSize GIT_CONFIG_VALUE_1=1m
export GIT_CONFIG_KEY_2=core.deltaBaseCacheLimit GIT_CONFIG_VALUE_2=8m
export GIT_CONFIG_KEY_3=gc.auto GIT_CONFIG_VALUE_3=0

DIAG_DIR="${SYSTEM}/diagnostics"
DIAG_LOG="${DIAG_DIR}/migration.log"
DIAG_STATE="${DIAG_DIR}/migration-state.json"
DIAG_MAX_SIZE=65536

_diag_init() {
	mkdir -p "$DIAG_DIR" 2>/dev/null || true
	if [ -f "$DIAG_LOG" ]; then
		_sz=$(wc -c < "$DIAG_LOG" 2>/dev/null || echo 0)
		if [ "$_sz" -gt "$DIAG_MAX_SIZE" ]; then
			tail -c "$DIAG_MAX_SIZE" "$DIAG_LOG" > "$DIAG_LOG.tmp" 2>/dev/null
			mv "$DIAG_LOG.tmp" "$DIAG_LOG" 2>/dev/null || true
		fi
	fi
}

log() {
	echo "S04nebulaos-migrate: $1"
	_ts=$(date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || echo "unknown")
	echo "$_ts $1" >> "$DIAG_LOG" 2>/dev/null || true
}

_diag_write_state() {
	mkdir -p "$DIAG_DIR" 2>/dev/null || true
	_now=$(date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || echo "unknown")
	cat > "$DIAG_STATE" <<DIAGEOF
{
  "timestamp": "$_now",
  "image_migration_version": "${_expected_version:-unknown}",
  "installed_migration_version": "${_installed_version:-unknown}",
  "migration_action": "${_migration_action:-unknown}",
  "klipper_before": "${_klipper_before:-unknown}",
  "klipper_after": "${_klipper_after:-unknown}",
  "extensions_before": "${_extensions_before:-unknown}",
  "extensions_after": "${_extensions_after:-unknown}",
  "moonraker_before": "${_moonraker_before:-unknown}",
  "moonraker_after": "${_moonraker_after:-unknown}",
  "klipper_reseed": "${_klipper_reseed_result:-not_attempted}",
  "extensions_reseed": "${_extensions_reseed_result:-not_attempted}",
  "moonraker_reseed": "${_moonraker_reseed_result:-not_attempted}",
  "generation_recorded": "${_generation_recorded:-no}",
  "gate_result": "${_gate_result:-not_checked}",
  "error": "${_last_error:-none}"
}
DIAGEOF
}

# Minimal flat-JSON field extractor - this project's own established
# no-jq convention (see flash-spare-slot.sh's get_field() for the
# key=value equivalent). Only handles "key": "string value" and
# "key": bareword/number - sufficient for the flat fields this script
# actually reads; never asked to parse nested objects/arrays.
json_get() {
	file="$1"; key="$2"
	grep -o "\"$key\"[[:space:]]*:[[:space:]]*\"[^\"]*\"" "$file" 2>/dev/null | \
		sed -E "s/.*\"$key\"[[:space:]]*:[[:space:]]*\"([^\"]*)\"/\1/" | head -1
}

# Same maintenance-safety gate as S04nebulaos-factory-seed - migration is
# just as memory/IO-heavy as first-boot seeding (same tar extraction, same
# git verification), and must never run while a print is active or an
# update transaction is in flight. maintenance_gate_ok() itself now lives
# in the shared $GATE_LIB (Final Baseline Closure mission, 2026-08-08) -
# previously duplicated independently in both S04 scripts, which is
# exactly how a real stale-lock bug ended up needing the identical fix in
# two places; extracted into one file instead. Uses this script's own
# log()/$APPS/$LOCKDIR directly.
. "$GATE_LIB"

# Shared seed-manifest reader (F-06) - see the same note in
# S04nebulaos-factory-seed.
SEED_MANIFEST_LIB="${SEED_MANIFEST_LIB:-/etc/nebulaos-seed-manifest.sh}"
# Sourced tolerantly. On a real device the overlay always ships it; if it
# is ever absent, seed_manifest_branch() is simply undefined, the call
# sites get an empty branch and REFUSE to seed with a named error, which
# is the correct fail-closed outcome. Sourcing it unconditionally would
# instead abort the whole script before any of that reasoning runs.
if [ -f "$SEED_MANIFEST_LIB" ]; then
	. "$SEED_MANIFEST_LIB"
fi

# Re-seed one component from its archive, unconditionally (no "already
# exists, skip" short-circuit - that check is the caller's job, done once
# up front by comparing generations, not per-component here). Otherwise
# identical to S04nebulaos-factory-seed's own seed_git_app(): same
# .partial-then-atomic-mv pattern, same branch/origin/dirty-tree
# verification before anything is considered trustworthy, so a failure
# here can never leave a half-replaced application tree - either the new
# checkout is fully verified and swapped in, or the OLD one is still
# sitting untouched at $dest.
# Zero-write precondition gate.
#
# Every check here is a pure read. Nothing below it may mutate $APPS or create
# a backup directory, which is the whole point: the deterministic, image-wide
# failure class (no seed archive, no seed manifest, no
# /etc/nebulaos-seed-manifest.sh, therefore no derivable branch) repeats
# identically on every boot of every device flashed with a bad image. Catching
# it here makes that class STORAGE-NEUTRAL - it costs nothing per boot and
# retries for free once the image is fixed.
#
# Note what the component guards below do and do not skip. klipper and
# moonraker are only ever RESEEDED, so an absent checkout means there is
# nothing to do and their archives are not needed. The extensions checkout is
# different: when it is absent the migration PROVISIONS it, so its archive and
# its branch are required either way. An earlier version of this gate skipped
# both for an absent extensions checkout, and a pre-Phase-1 device therefore
# bypassed the gate entirely and cut klipper over against extensions that
# could never arrive.
#
# This does not cover failures that can only be detected after extraction
# (corrupt archive, wrong branch/origin, dirty tree) or after cutover. Those
# are bounded by ensure_backup_dir()'s attempt-record reuse instead.
migration_preconditions_ok() {
	_mp_ok=1

	for _mp_c in klipper nebulaos-klipper-extensions moonraker; do
		# klipper and moonraker are only reseeded when they already exist, so
		# an absent checkout means "nothing to do" and its archive is not
		# needed. nebulaos-klipper-extensions is different: when it is ABSENT
		# the migration PROVISIONS it via seed_missing_extensions(), which
		# needs the archive just as much. Skipping the check for it here is
		# how a pre-Phase-1 device bypassed this gate entirely and cut klipper
		# over against extensions that could never be provisioned.
		if [ "$_mp_c" != "nebulaos-klipper-extensions" ]; then
			[ -e "$APPS/$_mp_c/.git" ] || continue
		fi
		if [ ! -f "$SEEDS/$_mp_c.tar.gz" ]; then
			log "PRECONDITION FAILED: seed archive missing ($SEEDS/$_mp_c.tar.gz) - refusing to start a migration that cannot complete"
			_mp_ok=0
		fi
	done

	# The extensions branch must be derivable BEFORE anything is touched.
	# seed_manifest_branch() is undefined when $SEED_MANIFEST_LIB is missing
	# from the image (the scripts source it tolerantly on purpose), so this
	# also covers the missing-library case: an undefined command yields no
	# output and the emptiness test below catches it.
	# Unconditional, deliberately: both arms need it. The reseed arm asserts
	# the branch on an existing checkout, and seed_missing_extensions()
	# refuses to provision without it, so "extensions absent" is not a reason
	# to skip this - it was the gap that let an absent-extensions device
	# through.
	if [ -z "$(seed_manifest_branch "$SEEDS/seed-manifest.json" nebulaos-klipper-extensions 2>/dev/null)" ]; then
		log "PRECONDITION FAILED: cannot determine the expected extensions branch from $SEEDS/seed-manifest.json (is $SEED_MANIFEST_LIB present in the image?) - refusing to start a migration that cannot complete"
		_mp_ok=0
	fi

	[ "$_mp_ok" = "1" ]
}

# Create the backup directory LAZILY - on the first cutover that is actually
# about to happen - and reuse the one a previous failed attempt at this SAME
# target version already created.
#
# Both halves matter. Lazy creation means a run that never reaches a cutover
# leaves no empty directory behind. Reuse means a run that DOES reach a
# cutover and then fails later (pair validation, record_generation, power loss
# between the two) does not mint a second directory on the next boot. Together
# they bound growth at one directory per target migration version, regardless
# of how many times that version fails - which is the invariant. The previous
# code created "$BACKUP_ROOT/<UTC timestamp to the second>" eagerly, before
# any component was attempted, so every retry produced another one forever.
ensure_backup_dir() {
	[ -n "${BACKUP_DIR:-}" ] && [ -d "$BACKUP_DIR" ] && return 0

	_ebd_prev=$(json_get "$ATTEMPT_FILE" backup_dir)
	_ebd_ver=$(json_get "$ATTEMPT_FILE" target_version)
	if [ -n "$_ebd_prev" ] && [ "$_ebd_ver" = "$_expected_version" ] && [ -d "$_ebd_prev" ]; then
		BACKUP_DIR="$_ebd_prev"
		log "reusing the backup directory from a previous failed attempt at $_expected_version: $BACKUP_DIR (not creating another one)"
		return 0
	fi

	BACKUP_DIR="$BACKUP_ROOT/$(date -u +%Y%m%dT%H%M%SZ)"
	if ! mkdir -p "$BACKUP_DIR"; then
		log "ERROR: cannot create backup directory $BACKUP_DIR"
		BACKUP_DIR=""
		return 1
	fi
	mkdir -p "$SYSTEM" 2>/dev/null || true
	# Checked, because this one write IS the retry bound. If it fails - a
	# full or read-only /usr/data, which is precisely the condition an
	# unbounded amplifier produces - the next boot finds no record, mints a
	# new timestamped directory, and boot-proportional growth silently
	# resumes. Do not fail the migration for it (the backup directory exists
	# and the cutover is about to be correct), but never let it pass in
	# silence.
	# Deliberately a plain heredoc followed by an explicit $? test, NOT
	# `if ! cat <<EOF ... EOF then`. The latter is valid POSIX and passes
	# ShellCheck, but it would be the only heredoc-inside-if in the entire
	# shipped overlay, so it has no precedent on this device's BusyBox ash -
	# and the cost of being wrong is not a bad log line, it is this script
	# failing to parse and the device never migrating again. The boring shape
	# has precedent everywhere.
	cat > "$ATTEMPT_FILE" <<ATTEMPTEOF
{
  "target_version": "$_expected_version",
  "backup_dir": "$BACKUP_DIR",
  "started_at": "$(date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || echo unknown)"
}
ATTEMPTEOF
	# Checking $? directly is deliberate here, not an oversight: the
	# alternative ShellCheck suggests is `if ! cat <<EOF ... EOF then`, which
	# is exactly the construct avoided above for BusyBox-precedent reasons.
	# shellcheck disable=SC2181
	if [ $? -ne 0 ]; then
		log "ERROR: could not write the migration attempt record $ATTEMPT_FILE - a retry will not be able to reuse $BACKUP_DIR and may create another backup directory. Check free space and the writability of $SYSTEM."
	fi
	log "backing up the current application tree to $BACKUP_DIR before the first cutover"
	if [ -n "$_ebd_prev" ] && [ "$_ebd_ver" = "$_expected_version" ]; then
		# The previous attempt's directory is gone - retention reclaimed it.
		# What gets moved in from here is that attempt's REPLACEMENT trees,
		# not the original pre-migration ones, and the line above would
		# otherwise imply it was.
		log "NOTE: the previous attempt at $_expected_version recorded $_ebd_prev, which no longer exists (reclaimed by retention). The trees preserved in $BACKUP_DIR are that attempt's replacements, not the original pre-migration tree."
	fi
	return 0
}

reseed_git_app() {
	name="$1"; archive="$SEEDS/$name.tar.gz"; dest="$APPS/$name"
	branch="$2"; origin="$3"; dirty_exclude="${4:-}"

	if [ ! -f "$archive" ]; then
		log "ERROR: seed archive missing ($archive) - cannot migrate $name, leaving existing installation untouched"
		return 1
	fi

	log "migrating $name from $archive"
	rm -rf "$dest.migrate-partial"
	mkdir -p "$dest.migrate-partial"
	if ! sh -c "gzip -dc '$archive' | tar -xo -C '$dest.migrate-partial'"; then
		log "ERROR: tar extraction failed for $name - leaving existing installation untouched"
		rm -rf "$dest.migrate-partial"
		return 1
	fi
	sync

	actual_branch=$(git -C "$dest.migrate-partial" symbolic-ref --short HEAD 2>/dev/null)
	if [ "$actual_branch" != "$branch" ]; then
		log "ERROR: $name migrated checkout is on branch '$actual_branch', expected '$branch' - rejecting, leaving existing installation untouched"
		rm -rf "$dest.migrate-partial"
		return 1
	fi
	actual_origin=$(git -C "$dest.migrate-partial" remote get-url origin 2>/dev/null)
	if [ "$actual_origin" != "$origin" ]; then
		log "ERROR: $name migrated checkout has origin '$actual_origin', expected '$origin' - rejecting, leaving existing installation untouched"
		rm -rf "$dest.migrate-partial"
		return 1
	fi
	if [ -n "$dirty_exclude" ]; then
		dirty_status=$(git -C "$dest.migrate-partial" status --porcelain -- . ":!$dirty_exclude" 2>/dev/null)
	else
		dirty_status=$(git -C "$dest.migrate-partial" status --porcelain 2>/dev/null)
	fi
	if [ -n "$dirty_status" ]; then
		log "ERROR: $name migrated checkout has an unexpectedly dirty working tree - rejecting, leaving existing installation untouched"
		rm -rf "$dest.migrate-partial"
		return 1
	fi

	# Only reached once the new checkout is fully verified - the actual
	# cutover is a single rename, minimizing the window where neither the
	# old nor new tree is fully in place. $APPS and $SYSTEM are on one
	# partition, so this is rename(2): it moves directory entries and
	# consumes no data blocks.
	#
	# The backup directory is created HERE, at the first cutover that is
	# actually going to happen, not up front - see ensure_backup_dir().
	if ! ensure_backup_dir; then
		log "ERROR: cannot prepare a backup directory for $name - refusing to cut over, leaving existing installation untouched"
		rm -rf "$dest.migrate-partial"
		return 1
	fi
	if [ -e "$BACKUP_DIR/$name" ]; then
		# A previous attempt at this same target version already preserved
		# this component's genuine pre-migration tree here, and moving the
		# current tree on top would nest inside it or destroy it.
		#
		# The current tree is USUALLY that previous attempt's own
		# replacement, which is reproducible from the seed archive and worth
		# nothing. But not always, and the difference is user data:
		# $APPS/nebulaos-klipper-extensions is a Moonraker update_manager
		# git_repo (see /etc/nebulaos/moonraker/klipper-pin.conf) and
		# $APPS/klipper is a reserved update_manager slot on channel dev with
		# no pinned_commit, so between a failed attempt and its retry - a
		# normal printer session, possibly days - the user can legitimately
		# update or commit in either. Discarding unconditionally would
		# destroy work that exists in no backup, which is exactly what
		# docs/NEBULAOS_UPDATE_OWNERSHIP.md promises never happens.
		#
		# So prove reproducibility instead of assuming it: identical HEAD to
		# the replacement about to be installed, and a clean tree.
		_cut_live=$(git -C "$dest" rev-parse HEAD 2>/dev/null)
		_cut_new=$(git -C "$dest.migrate-partial" rev-parse HEAD 2>/dev/null)
		if [ -n "$dirty_exclude" ]; then
			_cut_dirty=$(git -C "$dest" status --porcelain -- . ":!$dirty_exclude" 2>/dev/null)
		else
			_cut_dirty=$(git -C "$dest" status --porcelain 2>/dev/null)
		fi
		if [ -n "$_cut_live" ] && [ "$_cut_live" = "$_cut_new" ] && [ -z "$_cut_dirty" ]; then
			log "$name: the interim tree ($_cut_live) is identical to the incoming seed and clean - discarding it and keeping the pre-migration backup already at $BACKUP_DIR/$name"
			rm -rf "$dest"
		else
			# Do not destroy it. Preserve it alongside the pre-migration
			# backup, inside the SAME reused directory, so the retry bound is
			# untouched.
			# The duplicate check applies the SAME two-part proof the
			# discard branch above requires - identifiable HEAD and a clean
			# tree - because it ends in the same rm -rf. Keying on HEAD alone
			# would destroy uncommitted edits sitting on an already-preserved
			# commit, and would make docs/NEBULAOS_UPDATE_OWNERSHIP.md's
			# "only removed when provably identical AND clean" false. The
			# -n guard matters too: without it, a $dest that is not a git
			# repository compares equal to a preserved copy that is also not
			# one, and "I cannot identify either tree" would be treated as
			# "they are the same tree".
			_cut_dup=0
			if [ -n "$_cut_live" ] && [ -z "$_cut_dirty" ]; then
				for _cut_prev in "$BACKUP_DIR/$name".diverged-*; do
					[ -d "$_cut_prev" ] || continue
					if [ "$(git -C "$_cut_prev" rev-parse HEAD 2>/dev/null)" = "$_cut_live" ]; then
						_cut_dup=1
						break
					fi
				done
			fi
			if [ "$_cut_dup" = "1" ]; then
				log "WARNING: $name: the tree on disk (HEAD ${_cut_live:-unknown}) does not match the incoming seed, but an identical copy is already preserved in $BACKUP_DIR - discarding this duplicate rather than accumulating copies"
				rm -rf "$dest"
			else
				# Per-second stamps can collide, and `mv` onto an existing
				# directory nests inside it instead of failing - which would
				# produce a layout neither the docs nor retention's shape
				# model describe. Uniquify rather than nest.
				_cut_stamp=$(date -u +%Y%m%dT%H%M%SZ 2>/dev/null || echo unknown)
				_cut_keep="$BACKUP_DIR/$name.diverged-$_cut_stamp"
				_cut_n=0
				while [ -e "$_cut_keep" ]; do
					_cut_n=$((_cut_n + 1))
					_cut_keep="$BACKUP_DIR/$name.diverged-$_cut_stamp.$_cut_n"
				done
				log "WARNING: $name: the tree on disk (HEAD ${_cut_live:-unknown}${_cut_dirty:+, with uncommitted changes}) does NOT match the incoming seed - it may hold your own commits or local edits, made between the failed attempt and this retry. Preserving it at $_cut_keep instead of discarding it."
				mv "$dest" "$_cut_keep"
			fi
		fi
	else
		mv "$dest" "$BACKUP_DIR/$name"
	fi
	mv "$dest.migrate-partial" "$dest"
	log "$name migrated successfully (branch $branch, $(git -C "$dest" rev-parse HEAD))"
	return 0
}

# First-time provisioning of a component this device has never had, used
# only for the pre-Phase-1 -> Phase-1 upgrade path. Deliberately NOT
# reseed_git_app: that function's cutover does `mv "$dest" "$BACKUP_DIR/..."`
# and there is no existing tree to move aside here, so it would fail on a
# device that is in a perfectly legitimate state. Same verification rules
# either way - branch, origin, clean tree, no synthetic wrapper commit - so
# this path is no more trusting than the normal one.
seed_missing_extensions() {
	name="nebulaos-klipper-extensions"
	archive="$SEEDS/$name.tar.gz"
	dest="$APPS/$name"
	# F-06: derived from the shipped seed manifest, never a literal.
	# See /etc/nebulaos-seed-manifest.sh. Origin stays literal on purpose.
	branch=$(seed_manifest_branch "$SEEDS/seed-manifest.json" "$name")
	if [ -z "$branch" ]; then
		log "ERROR: cannot determine the expected branch for $name from $SEEDS/seed-manifest.json - refusing to provision rather than guessing a branch name (is $SEED_MANIFEST_LIB present?)"
		return 1
	fi
	origin="https://github.com/coreflake1/NebulaOS-klipper-extensions.git"

	if [ ! -f "$archive" ]; then
		log "ERROR: seed archive missing ($archive) - cannot provision $name"
		return 1
	fi
	rm -rf "$dest.migrate-partial"
	mkdir -p "$dest.migrate-partial"
	if ! sh -c "gzip -dc '$archive' | tar -xo -C '$dest.migrate-partial'"; then
		log "ERROR: tar extraction failed for $name"
		rm -rf "$dest.migrate-partial"
		return 1
	fi
	sync
	actual_branch=$(git -C "$dest.migrate-partial" symbolic-ref --short HEAD 2>/dev/null)
	if [ "$actual_branch" != "$branch" ]; then
		log "ERROR: $name checkout is on branch '$actual_branch', expected '$branch' - rejecting"
		rm -rf "$dest.migrate-partial"
		return 1
	fi
	actual_origin=$(git -C "$dest.migrate-partial" remote get-url origin 2>/dev/null)
	if [ "$actual_origin" != "$origin" ]; then
		log "ERROR: $name checkout has origin '$actual_origin', expected '$origin' - rejecting"
		rm -rf "$dest.migrate-partial"
		return 1
	fi
	if [ -n "$(git -C "$dest.migrate-partial" status --porcelain 2>/dev/null)" ]; then
		log "ERROR: $name checkout has an unexpectedly dirty working tree - rejecting"
		rm -rf "$dest.migrate-partial"
		return 1
	fi
	# $dest may exist as the empty directory S02nebulaos-namespace creates;
	# `mv src dst` would then nest rather than replace (a real bug this
	# project has already been bitten by - see S04nebulaos-factory-seed's
	# own note on it).
	rm -rf "$dest"
	mv "$dest.migrate-partial" "$dest"
	log "$name provisioned successfully (branch $branch, $(git -C "$dest" rev-parse HEAD))"
	return 0
}

# Phase 1.5 persistent-namespace mission (2026-08): the Klipper-stack
# update-pin island this section used to describe
# (printer_data/config/nebulaos/, synced here from
# /opt/nebulaos-seeds/printer_data-config/nebulaos/) is RETIRED. The pins
# now live at the image-owned, read-only /etc/nebulaos/moonraker/
# klipper-pin.conf, which is correct automatically for whichever slot is
# active - no persistent-tree sync needed, no "kept in sync by this
# script" step to run on every boot, and (the actual bug this closes) no
# more risk of a device rolled back to an older A/B slot still reading a
# newer slot's persistent copy of the pin. See git history for the
# retired sync_managed_config_includes() this replaced, and
# docs/NEBULAOS_PERSISTENT_NAMESPACE.md for the full ownership model.
#
# Two things a pre-Phase-1.5 device's persistent tree can still have that
# this mission must not silently ignore, both handled below, both
# idempotent, both run unconditionally on every boot (cheap text-file
# checks, not gated behind a generation bump):
#
#   1. moonraker.conf may still carry the OLD relative-glob include line,
#      `[include nebulaos/*.conf]`, which now resolves to nothing (the
#      seed directory it pointed at no longer exists) and would make
#      Moonraker refuse to start ("No files matching include directive").
#      migrate_moonraker_pin_include() rewrites ONLY that one recognized
#      line, in place, to the new absolute-path include - the file
#      remains USER OWNED and every other line is untouched.
#
#   2. printer.cfg may still be the old monolithic form (the entire
#      machine/PRTouch/platform definition inline) rather than the new
#      small entrypoint that includes /etc/nebulaos/klipper/*.cfg.
#      migrate_printer_cfg() performs the one-time, bounded migration
#      documented in docs/NEBULAOS_PRINTER_CFG_MIGRATION.md: back up
#      first, recognize the known old shape precisely, preserve any
#      SAVE_CONFIG block and any trailing user content verbatim, and
#      REFUSE (leaving the original untouched, backed up, and logged)
#      rather than guess if the file does not match a recognized shape.
migrate_moonraker_pin_include() {
	f="$PRINTER_DATA_CONFIG/moonraker.conf"
	[ -f "$f" ] || return 0
	grep -qxF '[include /etc/nebulaos/moonraker/klipper-pin.conf]' "$f" && return 0

	# CASE B: the OLD relative-glob include line - rewrite that one line only.
	if grep -qxF '[include nebulaos/*.conf]' "$f"; then
		tmp="$f.migrate-tmp.$$"
		if ! sed 's#^\[include nebulaos/\*\.conf\]$#[include /etc/nebulaos/moonraker/klipper-pin.conf]#' "$f" > "$tmp"; then
			log "ERROR: could not rewrite moonraker.conf's managed-pin include line"
			rm -f "$tmp"
			return 1
		fi
		if ! grep -qxF '[include /etc/nebulaos/moonraker/klipper-pin.conf]' "$tmp"; then
			log "ERROR: moonraker.conf include-line migration did not produce the expected result - leaving the original untouched"
			rm -f "$tmp"
			return 1
		fi
		mv "$tmp" "$f"
		log "moonraker.conf: migrated the managed Klipper-stack pin include to /etc/nebulaos/moonraker/klipper-pin.conf"
		return 0
	fi

	migrate_moonraker_legacy_sections "$f"
	return $?
}

# CASE C/D (Phase 1.5 hardware closure, 2026-08-19): a device that predates
# even the OLD glob-include mechanism - real device found live carries
# [update_manager klipper]\nchannel: dev directly in moonraker.conf, with no
# include of any kind. Left as-is, this means Moonraker compares official
# Klipper against real upstream master (no pinned_commit at all), reports it
# as behind, and Mainsail can offer an unrestricted update that silently
# moves the device off its qualified pin - a real safety issue, not merely
# cosmetic (see this mission's own "Moonraker qualified update invariant").
#
# The ONLY sections this migration is allowed to touch are the two
# /etc/nebulaos/moonraker/klipper-pin.conf itself defines (see that file's
# own [update_manager klipper]/[update_manager nebulaos_klipper_extensions]
# headers) - nothing else. [update_manager moonraker], [update_manager
# mainsail], and the top-level default [update_manager] section are none of
# this migration's business and are always left completely untouched
# (confirmed against real device evidence: the actual golden printer's own
# legacy moonraker.conf carried [update_manager moonraker] right alongside
# [update_manager klipper] - only the latter two are managed by the pin
# file, so only those two are ever candidates for removal here).
_MIGRATE_MRC_LEGACY_SECTIONS='update_manager klipper
update_manager nebulaos_klipper_extensions'

# 0 if every occurrence of a legacy-target section in $1 is narrow enough to
# be recognized as this project's own known shape (only blank lines,
# comments, and a bare `channel: <value>` option - the shape found live);
# 1 if a target section exists but contains ANYTHING else this migration
# does not know is safe to discard (an explicit pinned_commit already set
# to something else, an unrelated option, etc.) - the caller treats that as
# CASE D: refuse rather than guess.
_moonraker_legacy_sections_are_narrow() {
	awk -v targets="$_MIGRATE_MRC_LEGACY_SECTIONS" '
		BEGIN {
			n = split(targets, arr, "\n")
			for (i = 1; i <= n; i++) is_target["[" arr[i] "]"] = 1
			bad = 0
		}
		/^\[.*\]$/ { in_target = ($0 in is_target); next }
		in_target && $0 !~ /^[ \t]*(#.*)?$/ && $0 !~ /^[ \t]*channel[ \t]*:/ { bad = 1 }
		END { exit bad ? 1 : 0 }
	' "$1"
}

# True (0) if $1 contains at least one of the legacy-target section headers
# as a real (non-comment) section - i.e. there is something for CASE C/D to
# act on at all. A file with none of them is simply not this migration's
# concern (no include needed, nothing to refuse either).
_moonraker_has_legacy_target_section() {
	awk -v targets="$_MIGRATE_MRC_LEGACY_SECTIONS" '
		BEGIN {
			n = split(targets, arr, "\n")
			for (i = 1; i <= n; i++) is_target["[" arr[i] "]"] = 1
		}
		($0 in is_target) { found = 1 }
		END { exit found ? 0 : 1 }
	' "$1"
}

migrate_moonraker_legacy_sections() {
	f="$1"

	_moonraker_has_legacy_target_section "$f" || return 0

	if ! _moonraker_legacy_sections_are_narrow "$f"; then
		ts=$(date -u +%Y%m%dT%H%M%SZ)
		# KNOWN, DEFERRED (recorded 2026-09-23, D-01 review): this refusal backup
		# is written on EVERY boot. It is reached unconditionally, before the
		# generation comparison, and an unrecognized shape never becomes
		# recognized by itself, so a permanently-unrecognized file produces one
		# new timestamped copy per boot. That is the same defect shape D-01
		# removed from the component backups, bounded only by
		# nebulaos-retention.sh's shape-2 pass (-mtime +7, keep 2). Deliberately
		# NOT fixed in the D-01 change: these are small text files - steady state
		# is (boots in the trailing 7 days) copies, order of hundreds of KB -
		# against the ~1.6GB class D-01 addressed. An idempotence check (skip when
		# an identical backup already exists) would close it.
		mkdir -p "$BACKUP_ROOT/moonraker-conf-migration-refused"
		cp -a "$f" "$BACKUP_ROOT/moonraker-conf-migration-refused/moonraker.conf.$ts" 2>/dev/null
		log "ERROR: moonraker.conf has an [update_manager klipper] or [update_manager nebulaos_klipper_extensions] section that does not match the known legacy shape (channel-only) - refusing to guess which parts are NebulaOS-managed and which are the user's own. Backed up to $BACKUP_ROOT/moonraker-conf-migration-refused/moonraker.conf.$ts, LEFT UNTOUCHED. Manual migration required."
		return 1
	fi

	ts=$(date -u +%Y%m%dT%H%M%SZ)
	mkdir -p "$BACKUP_ROOT/moonraker-conf-migration"
	backup="$BACKUP_ROOT/moonraker-conf-migration/moonraker.conf.pre-migration.$ts"
	if ! cp -a "$f" "$backup"; then
		log "ERROR: could not create pre-migration backup of moonraker.conf - refusing to migrate without one"
		return 1
	fi
	if ! cmp -s "$f" "$backup"; then
		log "ERROR: pre-migration backup of moonraker.conf does not match the original - refusing to proceed"
		return 1
	fi

	tmp="$f.migrate-tmp.$$"
	if ! awk -v targets="$_MIGRATE_MRC_LEGACY_SECTIONS" \
		-v inc='[include /etc/nebulaos/moonraker/klipper-pin.conf]' '
		BEGIN {
			n = split(targets, arr, "\n")
			for (i = 1; i <= n; i++) is_target["[" arr[i] "]"] = 1
			inserted = 0
		}
		/^\[.*\]$/ {
			in_target = ($0 in is_target)
			if (in_target) {
				if (!inserted) { print inc; print ""; inserted = 1 }
				next
			}
		}
		in_target { next }
		{ print }
		END { if (!inserted) print inc }
	' "$f" > "$tmp"; then
		log "ERROR: could not rewrite moonraker.conf's legacy update_manager sections"
		rm -f "$tmp"
		return 1
	fi

	# Validate the resolved config: the new include is present exactly once, and
	# neither legacy target header survives as a real section any more - the same
	# basic sanity discipline migrate_printer_cfg() applies to its own rewrite.
	inc_count=$(grep -cxF '[include /etc/nebulaos/moonraker/klipper-pin.conf]' "$tmp")
	if [ "$inc_count" -ne 1 ] || grep -qxF '[update_manager klipper]' "$tmp" \
		|| grep -qxF '[update_manager nebulaos_klipper_extensions]' "$tmp"; then
		log "ERROR: migrated moonraker.conf failed a basic sanity check - leaving the original untouched (backup at $backup)"
		rm -f "$tmp"
		return 1
	fi

	mv "$tmp" "$f"
	log "moonraker.conf: replaced legacy [update_manager klipper]/[update_manager nebulaos_klipper_extensions] sections with the qualified /etc/nebulaos/moonraker/klipper-pin.conf include (original backed up at $backup)"
	return 0
}

# Phase 2 overnight convergence mission (2026-09-09): commit cddf41b
# ("Phase 2 core convergence: seeder, configs, MCU CLI, recovery tool,
# managed gate") flipped this project's own shipped moonraker.conf default
# from channel: dev (moonraker) / channel: beta (mainsail) to the final
# frozen policy of channel: stable for both (Klipper stays dev/upstream -
# see _project/missions/final-core-convergence/DECISIONS.md's "Runtime
# Updaters" section). A device provisioned from an image built before that
# commit still has the old dev/beta values baked into its persistent
# moonraker.conf, which nothing else here ever revisits (moonraker.conf is
# USER OWNED - see this file's own header - so no other migration touches
# its update_manager sections at all). Live evidence (Phase 2 RC4 overnight
# qualification, 2026-09-09): a real device carried exactly this narrow old
# shape unchanged.
#
# Deliberately narrow and value-exact, same discipline as
# _moonraker_legacy_sections_are_narrow() above: only rewrites the literal
# `channel: dev` / `channel: beta` values, and only when the surrounding
# section contains nothing this migration does not already recognize as
# this project's own known shape (type/repo/path/channel/blank/comment). A
# section with an explicit pinned_commit, a different channel a user chose
# on purpose, or any other unrecognized option is left completely
# untouched - this migration cannot distinguish "the old shipped default,
# never revisited" from "a user deliberately chose dev/beta and that
# happens to match the old default", so touching anything outside this
# exact narrow shape would risk silently overriding a real user choice
# rather than a same known default.
_UPDATER_CHANNEL_MIGRATIONS='update_manager moonraker:dev
update_manager mainsail:beta'

# 0 if the named section in $1 contains only blank lines, comments, and
# options from the allowed set for that section (channel always allowed;
# mainsail's section additionally allows type:/repo:/path: - its own known
# shape, see the shipped seed moonraker.conf) - 1 if anything else is
# present. A section that does not exist at all is trivially narrow (exit
# 0) - the caller separately checks the channel value itself before ever
# treating a section as a migration candidate.
_updater_section_is_narrow() {
	sec="$1"; file="$2"
	awk -v want="[$sec]" '
		BEGIN { extra = (want == "[update_manager mainsail]") }
		/^\[.*\]$/ { in_sec = ($0 == want); next }
		in_sec && $0 ~ /^[ \t]*(#.*)?$/ { next }
		in_sec && $0 ~ /^[ \t]*channel[ \t]*:/ { next }
		in_sec && extra && $0 ~ /^[ \t]*(type|repo|path)[ \t]*:/ { next }
		in_sec { bad = 1 }
		END { exit bad ? 1 : 0 }
	' "$file"
}

# Rewrites the `channel:` value inside exactly one named section, in place
# in $2, from $3 to $4. Only ever called after _updater_section_is_narrow
# has already confirmed the section has no other content, and after the
# caller has confirmed the current value is exactly $3 - so this never
# needs to re-validate, only rewrite.
_updater_rewrite_channel() {
	sec="$1"; file="$2"; from="$3"; to="$4"
	awk -v want="[$sec]" -v from="$from" -v to="$to" '
		/^\[.*\]$/ { in_sec = ($0 == want); print; next }
		in_sec && $0 ~ ("^[ \t]*channel[ \t]*:[ \t]*" from "[ \t]*$") {
			sub(from, to)
		}
		{ print }
	' "$file"
}

migrate_updater_channels() {
	f="$PRINTER_DATA_CONFIG/moonraker.conf"
	[ -f "$f" ] || return 0

	changed=0
	work="$f"
	tmp="$f.migrate-tmp.$$"

	old_ifs="$IFS"
	IFS='
'
	for entry in $_UPDATER_CHANNEL_MIGRATIONS; do
		IFS="$old_ifs"
		sec="${entry%%:*}"
		old_val="${entry##*:}"

		cur=$(awk -v want="[$sec]" '
			/^\[.*\]$/ { in_sec = ($0 == want); next }
			in_sec && $0 ~ /^[ \t]*channel[ \t]*:/ {
				sub(/^[ \t]*channel[ \t]*:[ \t]*/, "")
				gsub(/[ \t]+$/, "")
				print
				exit
			}
		' "$work")

		if [ "$cur" != "$old_val" ]; then
			IFS='
'
			continue
		fi
		if ! _updater_section_is_narrow "$sec" "$work"; then
			log "updater-channel migration: [$sec] has channel: $old_val but also unrecognized content - leaving untouched (manual review, not a known-safe shape)"
			IFS='
'
			continue
		fi

		if ! _updater_rewrite_channel "$sec" "$work" "$old_val" "stable" > "$tmp"; then
			log "ERROR: could not rewrite [$sec] channel for updater-channel migration"
			rm -f "$tmp"
			IFS='
'
			continue
		fi
		mv "$tmp" "$work"
		changed=1
		log "moonraker.conf: [$sec] channel migrated from the old shipped default ($old_val) to stable"
		IFS='
'
	done
	IFS="$old_ifs"

	[ "$changed" = "1" ] || return 0
	return 0
}

# The one anchor line this mission's own printer.cfg (both the old
# monolithic shape and the new split entrypoint) has always carried
# unchanged, in the same relative position - the last of the SimpleAF
# includes, immediately before any user content and any SAVE_CONFIG
# block. Used to locate the boundary between "known NebulaOS-authored
# content" and "everything after it is the user's" without needing a real
# Klipper config parser.
_MIGRATE_PCFG_ANCHOR='[include simpleaf/bltouch_macro.cfg]'

# The exact, literal include lines this project's own post-7b4a2ec/
# pre-8889ef0 generation shipped between calibration.cfg's include and the
# anchor line - see migrate_printer_cfg()'s case-3 comment for why this
# region must be checked narrowly rather than assumed safe to discard.
_PCFG_GEN3_KNOWN_MIDDLE_INCLUDES='[include GuppyScreen/guppy_cmd.cfg]
[include camera-quality.cfg]
[include simpleaf/homing.cfg]
[include simpleaf/useful_macros.cfg]
[include simpleaf/fan_control.cfg]
[include simpleaf/client.cfg]
[include simpleaf/start_end.cfg]
[include simpleaf/Line_Purge.cfg]
[include simpleaf/Smart_Park.cfg]'

# Real path to the DEPLOYED, immutable klipper config directory on THIS
# device - overridable for tests, same convention as every other path in
# this script.
NEBULAOS_KLIPPER_CFG_DIR="${NEBULAOS_KLIPPER_CFG_DIR:-/etc/nebulaos/klipper}"

# The exact historical live-qualification safety override (Phase 2 final
# live convergence mission, 2026-09-09): a real device found live had
#   [axis_twist_compensation]
#   calibrate_end_y: 190
# sitting in the gen3 middle region, overriding machine.cfg's own
# axis_twist_compensation default at the time - see machine.cfg's own
# comment on calibrate_end_y for the full physical-safety derivation
# (probe-frame Y must stay under stepper_y's position_max once
# [bltouch]'s y_offset is added; 190 gives a deliberate 6mm margin, the
# pre-correction default of 200 exceeded real Y travel by 4mm).
#
# Recognizing these two lines as redundant (safe to discard) is only
# correct if THIS DEVICE's own deployed machine.cfg - not merely the
# fixed source tree the migration script itself was staged from - has
# already been rebuilt with the corrected 190 default. A real device
# found live (this same mission, same day): the migration script can be
# fixed and staged onto a device ahead of an actual image rebuild (e.g.
# to prove/apply a fix without a full flash), which discarded this
# override while the device's OWN machine.cfg still shipped the unsafe
# 200 - the printer was left with NO override and an unsafe EFFECTIVE
# calibrate_end_y of 200 until caught and manually restored. Fixed by
# reading the actual deployed machine.cfg's own calibrate_end_y at
# migration time (_pcfg_deployed_calibrate_end_y_is_190 below) and only
# ever treating the override as redundant when that real, current value
# already matches - never assumed from source alone. When it does not yet
# match, the region is correctly NOT narrow, and migration safely REFUSES
# (backs up, logs, leaves the file untouched) rather than silently
# dropping a still-load-bearing safety override - the same "refuse rather
# than guess" outcome as any other genuine customization in this region.
#
# Deliberately narrow, per-line otherwise: a device with calibrate_end_y
# set to anything else, or with additional axis_twist_compensation options
# beyond this one, has at least one line that does NOT match - that still
# correctly fails _pcfg_gen3_middle_region_is_narrow below and falls
# through to refusal, exactly like any other real customization. Only a
# bare [axis_twist_compensation] section containing EXACTLY this one
# recognized option, AND matching the device's own live default, is
# treated as redundant-with-canonical.
_PCFG_GEN3_AXIS_TWIST_OVERRIDE_LINES='[axis_twist_compensation]
calibrate_end_y: 190'

# 0 if $NEBULAOS_KLIPPER_CFG_DIR/machine.cfg's own [axis_twist_compensation]
# calibrate_end_y is exactly 190 (i.e. this device has actually been
# rebuilt with the corrected default, so the printer.cfg override above is
# genuinely redundant); 1 otherwise (missing file, different value, or
# anything else this check cannot confidently confirm - refuse rather than
# guess, same as every other check in this file).
_pcfg_deployed_calibrate_end_y_is_190() {
	_mcfg="$NEBULAOS_KLIPPER_CFG_DIR/machine.cfg"
	[ -f "$_mcfg" ] || return 1
	awk '
		/^\[axis_twist_compensation\]/ { in_section = 1; next }
		/^\[/ { in_section = 0 }
		in_section && $0 ~ /^calibrate_end_y[ \t]*:[ \t]*190([ \t]|$)/ { found = 1 }
		END { exit found ? 0 : 1 }
	' "$_mcfg"
}

# 0 if the region of $1 strictly between calibration.cfg's include line and
# the anchor line contains only blank lines, comments, and the exact known
# lines listed above (in any order/count - a technician may have commented
# one out, which still counts as "recognized", just inert); 1 if anything
# else is present (a real option, a section header, an include this
# generation never shipped). Klipper's own include resolution doesn't care
# about surrounding blank lines/comments, so those are always safe to
# discard either way - this only guards against discarding a real
# configuration change.
_pcfg_gen3_middle_region_is_narrow() {
	_known="$_PCFG_GEN3_KNOWN_MIDDLE_INCLUDES"
	if _pcfg_deployed_calibrate_end_y_is_190; then
		_known="$_known
$_PCFG_GEN3_AXIS_TWIST_OVERRIDE_LINES"
	fi
	awk -v known="$_known" -v calib='[include /etc/nebulaos/klipper/calibration.cfg]' -v anchor="$_MIGRATE_PCFG_ANCHOR" '
		BEGIN {
			n = split(known, arr, "\n")
			for (i = 1; i <= n; i++) is_known[arr[i]] = 1
			in_region = 0
			bad = 0
		}
		$0 == calib { in_region = 1; next }
		$0 == anchor { in_region = 0; next }
		in_region && $0 ~ /^[ \t]*(#.*)?$/ { next }
		in_region && ($0 in is_known) { next }
		in_region { bad = 1 }
		END { exit bad ? 1 : 0 }
	' "$1"
}

migrate_printer_cfg() {
	f="$PRINTER_DATA_CONFIG/printer.cfg"
	[ -f "$f" ] || return 0

	# Case D: already migrated - detectable, idempotent, no-op. Requires
	# the FULL current include set, not just platform.cfg: Phase 2
	# overnight convergence mission (2026-09-09) found a real device live
	# whose printer.cfg had platform.cfg/machine.cfg/z_offset_probe.cfg/
	# calibration.cfg (added by the earlier Phase 1.5 split, commit
	# 7b4a2ec) but predated commit 8889ef0 ("Phase 2 upstream-first config
	# refactor: remove SimpleAF/GuppyScreen deps"), which is what actually
	# added homing.cfg/print.cfg/filament.cfg/beeper.cfg and removed the
	# direct GuppyScreen/guppy_cmd.cfg + simpleaf/*.cfg includes. Checking
	# only platform.cfg let that device's printer.cfg short-circuit here
	# forever, silently running the old SimpleAF/GuppyScreen print,
	# filament-runout, and homing implementations instead of the Phase 2
	# ones - and, on that specific device, with no [filament_switch_sensor]
	# object loaded at all (filament.cfg was never included), a genuine
	# runout-detection gap. filament.cfg is the last of the four files that
	# commit added, so its presence is what "fully migrated" now means.
	grep -qxF '[include /etc/nebulaos/klipper/platform.cfg]' "$f" \
		&& grep -qxF '[include /etc/nebulaos/klipper/filament.cfg]' "$f" \
		&& return 0

	# BOOT-07 (2026-10-05): the generation after Case D is the managed tree
	# migrate_printer_cfg_to_managed_tree() writes - the same includes made
	# relative ([include nebulaos/*.cfg]). It is newer than anything this
	# function migrates, so it is "already migrated" by the same two-line
	# test. Without this, every managed-tree device (the shipped steady
	# state) fell through to the refusal below: a false ERROR and a fresh
	# timestamped backup of printer.cfg on every boot. Whether the
	# nebulaos/*.cfg files exist is materialize_active_config()'s business,
	# which runs right after this.
	grep -qxF '[include nebulaos/platform.cfg]' "$f" \
		&& grep -qxF '[include nebulaos/filament.cfg]' "$f" \
		&& return 0

	# Only a file that looks like one of this mission's own known old
	# shapes is migrated automatically. Recognized by: it does NOT yet
	# have the full new include set (checked above), the anchor line
	# appears exactly once, and it carries this project's own authorship
	# markers - ANY of:
	#   1. [nebulaos_compat] as a real (non-included) section (every
	#      generation from the no-fork migration onward)
	#   2. for a device that predates that section entirely, [tmcstatus]
	#      AND [nebulaos_version] both present as real sections - this
	#      project's own extension modules, defined inline in every
	#      generation of this project's printer.cfg since the Virgin-
	#      Baseline Fix + Rebuild mission (2026-08-08), well before
	#      [nebulaos_compat] was introduced. Real device found live (Phase
	#      1.5 hardware qualification, 2026-08-19): a device provisioned in
	#      that earlier window has neither marker, so the original
	#      (narrower) check refused it - correctly safe, but it meant the
	#      device could never migrate off the un-migrated shape at all,
	#      silently, forever.
	#   3. the post-7b4a2ec/pre-8889ef0 intermediate shape described above:
	#      already has the platform/machine/z_offset_probe/calibration
	#      includes (case D's own markers, just not the newer four) - this
	#      is ALSO this project's own known, documented shape from an
	#      identifiable commit range, not a guess.
	# Anything with NONE of these markers is still refused rather than
	# guessed at.
	anchor_count=$(grep -cxF "$_MIGRATE_PCFG_ANCHOR" "$f")
	known_shape=0
	if grep -qE '^\[nebulaos_compat\]' "$f"; then
		known_shape=1
	elif grep -qE '^\[tmcstatus\]' "$f" && grep -qE '^\[nebulaos_version\]' "$f"; then
		known_shape=1
	elif grep -qxF '[include /etc/nebulaos/klipper/platform.cfg]' "$f" \
		&& grep -qxF '[include /etc/nebulaos/klipper/machine.cfg]' "$f" \
		&& grep -qxF '[include /etc/nebulaos/klipper/z_offset_probe.cfg]' "$f" \
		&& grep -qxF '[include /etc/nebulaos/klipper/calibration.cfg]' "$f"; then
		# Case 3's own extra guard: the anchor-cut below discards
		# EVERYTHING from the top of the file through the anchor line,
		# unconditionally - it has no way to preserve content a
		# technician inserted BETWEEN calibration.cfg's include and the
		# anchor (as opposed to genuine trailing content AFTER the
		# anchor, which the cut already preserves correctly). Real
		# device found live (Phase 2 RC4 overnight qualification,
		# 2026-09-09): exactly this happened - a documented,
		# safety-critical live-qualification override
		# ([axis_twist_compensation] calibrate_end_y, preventing the
		# probe frame from exceeding the real Y-axis travel by 4mm) had
		# been inserted right after calibration.cfg's include, and a
		# first version of this fix silently discarded it. Rather than
		# try to relocate arbitrary mid-block insertions correctly (a
		# technician could put anything there, in any order), this
		# region must contain ONLY the exact known GuppyScreen/
		# camera-quality/simpleaf include lines this generation shipped
		# (plus blank lines and comments) for case 3 to apply at all -
		# anything else falls through to "unrecognized shape" (refused,
		# backed up, logged) rather than risk deleting something a human
		# added for a real reason.
		if _pcfg_gen3_middle_region_is_narrow "$f"; then
			known_shape=1
		fi
	fi
	if [ "$known_shape" -ne 1 ] || [ "$anchor_count" -ne 1 ]; then
		ts=$(date -u +%Y%m%dT%H%M%SZ)
		# KNOWN, DEFERRED (recorded 2026-09-23, D-01 review): this refusal backup
		# is written on EVERY boot. It is reached unconditionally, before the
		# generation comparison, and an unrecognized shape never becomes
		# recognized by itself, so a permanently-unrecognized file produces one
		# new timestamped copy per boot. That is the same defect shape D-01
		# removed from the component backups, bounded only by
		# nebulaos-retention.sh's shape-2 pass (-mtime +7, keep 2). Deliberately
		# NOT fixed in the D-01 change: these are small text files - steady state
		# is (boots in the trailing 7 days) copies, order of hundreds of KB -
		# against the ~1.6GB class D-01 addressed. An idempotence check (skip when
		# an identical backup already exists) would close it.
		mkdir -p "$BACKUP_ROOT/printer-cfg-migration-refused"
		cp -a "$f" "$BACKUP_ROOT/printer-cfg-migration-refused/printer.cfg.$ts" 2>/dev/null
		log "ERROR: printer.cfg does not match a recognized shape for automatic migration to the split /etc/nebulaos/klipper/ layout (known shape: $([ "$known_shape" -eq 1 ] && echo yes || echo no), anchor line count: $anchor_count) - backed up to $BACKUP_ROOT/printer-cfg-migration-refused/printer.cfg.$ts, LEFT UNTOUCHED. Manual migration required - see docs/NEBULAOS_PRINTER_CFG_MIGRATION.md"
		return 1
	fi

	ts=$(date -u +%Y%m%dT%H%M%SZ)
	mkdir -p "$BACKUP_ROOT/printer-cfg-migration"
	backup="$BACKUP_ROOT/printer-cfg-migration/printer.cfg.pre-migration.$ts"
	if ! cp -a "$f" "$backup"; then
		log "ERROR: could not create pre-migration backup of printer.cfg - refusing to migrate without one"
		return 1
	fi
	if ! cmp -s "$f" "$backup"; then
		log "ERROR: pre-migration backup of printer.cfg does not match the original - refusing to proceed"
		return 1
	fi

	# Everything from the line AFTER the anchor to EOF is "trailing
	# content": the user's own additional includes/macros, and/or
	# Klipper's own SAVE_CONFIG block, preserved byte-for-byte in the same
	# relative position the new template already reserves for exactly
	# this ("Your own additional includes/macros go below this line").
	trailing="$f.migrate-trailing.$$"
	awk -v anchor="$_MIGRATE_PCFG_ANCHOR" '
		found { print; next }
		$0 == anchor { found = 1 }
	' "$f" > "$trailing"

	new_seed="$SEEDS/printer_data-config/printer.cfg"
	if [ ! -f "$new_seed" ]; then
		log "ERROR: immutable seed $new_seed missing - cannot migrate printer.cfg, leaving the original untouched"
		rm -f "$trailing"
		return 1
	fi

	tmp="$f.migrate-tmp.$$"
	# The seed ships its own placeholder SAVE_CONFIG autosave block (see
	# docs/NEBULAOS_CALIBRATION_CONFIG_OWNERSHIP.md and the marker comment
	# in the seed itself) so a genuinely virgin device has one to start
	# from. A device migrated here, though, almost always already has its
	# own REAL SAVE_CONFIG block as part of "trailing" (preserved above,
	# verbatim, from the file being migrated) - concatenating both would
	# put two "#*# <----SAVE_CONFIG---->" markers in one file. Klipper's
	# own autosave parser (klippy/configfile.py _find_autosave_data) only
	# ever honors the FIRST such marker via data.find(); it then treats
	# any non-"#*#"-prefixed line found before reaching a second marker
	# (here, this project's own [z_compensate]/[resonance_tester] trailing
	# sections, which sit BETWEEN the two blocks) as "modifications after
	# header" and silently discards the ENTIRE autosave block - real,
	# hardware-calibrated data (BLTouch z_offset, PID, load-cell
	# calibration, input shaper) included, with no error, just a warning.
	# Reproduced live (Phase 2 final live convergence mission, 2026-09-09):
	# an already-calibrated device migrated straight through with two
	# markers in the output. Fix: when trailing already contains a real
	# marker, drop the seed's own placeholder block (and the explanatory
	# comment introducing it) entirely, keeping only the seed's includes/
	# header - so exactly one marker, the device's own real one, survives.
	if grep -qxF '#*# <---------------------- SAVE_CONFIG ---------------------->' "$trailing"; then
		awk '
			/^# NEBULAOS_SEED_PLACEHOLDER_AUTOSAVE_BLOCK_BEGIN/ { exit }
			{ print }
		' "$new_seed" > "$tmp"
	else
		cp -a "$new_seed" "$tmp"
	fi
	cat "$trailing" >> "$tmp"
	rm -f "$trailing"

	# Final safety net: whatever path built $tmp above, never write a file
	# with more than one real SAVE_CONFIG marker - Klipper would silently
	# discard all autosave data in that case (see the comment above).
	save_config_marker_count=$(grep -cxF '#*# <---------------------- SAVE_CONFIG ---------------------->' "$tmp")
	if [ "$save_config_marker_count" -gt 1 ]; then
		log "ERROR: migrated printer.cfg would contain more than one SAVE_CONFIG autosave block ($save_config_marker_count found) - refusing to write it (backup at $backup, original untouched)"
		rm -f "$tmp"
		return 1
	fi

	if ! grep -qxF '[include /etc/nebulaos/klipper/platform.cfg]' "$tmp"; then
		log "ERROR: migrated printer.cfg failed a basic sanity check - leaving the original untouched (backup at $backup)"
		rm -f "$tmp"
		return 1
	fi

	mv "$tmp" "$f"
	log "printer.cfg: migrated from the monolithic machine-definition form to the new /etc/nebulaos/klipper/*.cfg split entrypoint (original backed up at $backup)"
	return 0
}

# Phase 2 calibration-framework mission: BLTouch z_offset, extruder
# rotation_distance, and extruder/bed PID used to have literal factory-
# default values in the immutable machine.cfg, which made
# _disallow_include_conflicts (klippy/configfile.py) refuse SAVE_CONFIG for
# any of them forever - see docs/NEBULAOS_CALIBRATION_CONFIG_OWNERSHIP.md.
# machine.cfg no longer defines them at all; the tracked printer.cfg seed
# now ships a pre-baked SAVE_CONFIG autosave block with the same factory
# values instead. A genuinely fresh device gets this for free from the
# seed. A device provisioned by an OLDER image still has a printer.cfg
# that relies on the now-removed machine.cfg literals and has none of
# these 4 sections/options in its OWN autosave block yet - this one-time,
# idempotent step closes that gap by delegating to the dedicated,
# independently-tested tool (see that file's own docstring for the full
# safety reasoning: never touches a section that already has real user
# data, refuses-and-backs-up rather than guessing on anything it cannot
# confidently parse).
# Sources config-materialize.sh (if present - an older image predating
# this mission simply has no such file, and this function is a correct
# no-op in that case) and materializes /etc/nebulaos/klipper/*.cfg onto
# persistent storage at $PRINTER_DATA_CONFIG/nebulaos/ ONLY when the
# currently-booted image's own config generation differs from what is
# already materialized there (ordinary reboot on the same image: no-op,
# by design - see config-materialize.sh's own header). MUST run before
# migrate_printer_cfg_to_managed_tree() below, which rewrites printer.cfg
# to include files from exactly this materialized tree.
materialize_active_config() {
	[ -f "$CONFIG_MATERIALIZE_LIB" ] || return 0
	NEBULAOS_KLIPPER_CFG_DIR="${NEBULAOS_KLIPPER_CFG_DIR:-/etc/nebulaos/klipper}" \
		. "$CONFIG_MATERIALIZE_LIB"
	if ! config_materialization_needed; then
		config_tree_backfill          # S1: README + per-file hashes for an older tree
		return 0
	fi
	if materialize_config_tree "boot-materialization"; then
		return 0
	fi
	log "ERROR: materialize_active_config: materialize_config_tree failed - printer.cfg's managed-tree migration (if applicable) will be skipped this boot, retried next boot"
	return 1
}

# The exact, literal include lines this project's printer.cfg has shipped
# since the Phase 2 upstream-first config refactor (commit 8889ef0) through
# tonight's own live convergence missions - the CURRENT final generation,
# pointing directly at the immutable squashfs. Phase 2 final software
# closure mission (2026-09-09) introduces one more generation: these same
# ten files, materialized onto persistent storage at
# $PRINTER_DATA_CONFIG/nebulaos/ (see config-materialize.sh), included by
# RELATIVE path instead, plus a permanently user-owned macros/ directory.
_PCFG_MANAGED_TREE_OLD_INCLUDES='[include /etc/nebulaos/klipper/platform.cfg]
[include /etc/nebulaos/klipper/machine.cfg]
[include /etc/nebulaos/klipper/prtouch.cfg]
[include /etc/nebulaos/klipper/z_offset_probe.cfg]
[include /etc/nebulaos/klipper/calibration.cfg]
[include /etc/nebulaos/klipper/homing.cfg]
[include /etc/nebulaos/klipper/print.cfg]
[include /etc/nebulaos/klipper/filament.cfg]
[include /etc/nebulaos/klipper/camera.cfg]
[include /etc/nebulaos/klipper/beeper.cfg]'

_PCFG_MANAGED_TREE_NEW_INCLUDES='[include nebulaos/platform.cfg]
[include nebulaos/machine.cfg]
[include nebulaos/prtouch.cfg]
[include nebulaos/z_offset_probe.cfg]
[include nebulaos/calibration.cfg]
[include nebulaos/homing.cfg]
[include nebulaos/print.cfg]
[include nebulaos/filament.cfg]
[include nebulaos/camera.cfg]
[include nebulaos/beeper.cfg]

[include macros/*.cfg]'

# One-time, idempotent: rewrites printer.cfg's ten direct
# /etc/nebulaos/klipper/*.cfg includes to point at the materialized
# nebulaos/*.cfg copy instead (see materialize_active_config() below,
# which MUST have already run this same boot - Klipper would fail to find
# nebulaos/*.cfg otherwise), and adds [include macros/*.cfg] for the new
# permanently-user-owned macros directory. Deliberately narrow: only
# recognizes the file as a match when ALL TEN old include lines are
# present, contiguous, and in the exact known order - anything else
# (a technician's own reordering, an extra include spliced in between,
# a partially-hand-migrated file) falls through to a safe refusal
# (backed up, logged) rather than guessing, same discipline as
# migrate_printer_cfg() above.
migrate_printer_cfg_to_managed_tree() {
	f="$PRINTER_DATA_CONFIG/printer.cfg"
	[ -f "$f" ] || return 0

	# Idempotent: already on the new managed-tree shape.
	grep -qxF '[include nebulaos/platform.cfg]' "$f" && return 0

	# Never rewrite printer.cfg to include files that do not actually
	# exist yet - materialize_active_config() must have already
	# successfully materialized $PRINTER_DATA_CONFIG/nebulaos/ this same
	# boot (or an earlier one) before this function may proceed. If it
	# hasn't (materialization failed, or this image predates
	# config-materialize.sh entirely), retry next boot rather than break
	# Klipper's config load now.
	for _managed_f in platform.cfg machine.cfg prtouch.cfg z_offset_probe.cfg calibration.cfg homing.cfg print.cfg filament.cfg camera.cfg beeper.cfg; do
		if [ ! -f "$PRINTER_DATA_CONFIG/nebulaos/$_managed_f" ]; then
			log "printer.cfg managed-tree migration: $PRINTER_DATA_CONFIG/nebulaos/$_managed_f does not exist yet - skipping this boot, will retry once materialization has completed"
			return 0
		fi
	done

	# Only proceed if the exact ten old includes are present, contiguous,
	# in order - located as one literal block via awk rather than ten
	# separate greps, so "contiguous and in order" is actually enforced,
	# not just "all ten present somewhere".
	if ! awk -v want="$_PCFG_MANAGED_TREE_OLD_INCLUDES" '
		BEGIN { n = split(want, arr, "\n"); i = 0 }
		{
			if (i < n && $0 == arr[i + 1]) {
				i++
				if (i == n) { found = 1; exit }
			} else if (i > 0 && $0 != arr[i + 1]) {
				i = ($0 == arr[1]) ? 1 : 0
			}
		}
		END { exit found ? 0 : 1 }
	' "$f"; then
		ts=$(date -u +%Y%m%dT%H%M%SZ)
		mkdir -p "$BACKUP_ROOT/printer-cfg-managed-tree-migration-refused"
		cp -a "$f" "$BACKUP_ROOT/printer-cfg-managed-tree-migration-refused/printer.cfg.$ts" 2>/dev/null
		log "ERROR: printer.cfg does not contain the expected ten contiguous /etc/nebulaos/klipper/*.cfg includes in order - refusing to migrate to the managed-tree layout, backed up to $BACKUP_ROOT/printer-cfg-managed-tree-migration-refused/printer.cfg.$ts, LEFT UNTOUCHED. Manual migration required."
		return 1
	fi

	ts=$(date -u +%Y%m%dT%H%M%SZ)
	mkdir -p "$BACKUP_ROOT/printer-cfg-managed-tree-migration"
	backup="$BACKUP_ROOT/printer-cfg-managed-tree-migration/printer.cfg.pre-migration.$ts"
	if ! cp -a "$f" "$backup"; then
		log "ERROR: could not create pre-migration backup of printer.cfg - refusing to migrate without one"
		return 1
	fi
	if ! cmp -s "$f" "$backup"; then
		log "ERROR: pre-migration backup of printer.cfg does not match the original - refusing to proceed"
		return 1
	fi

	tmp="$f.migrate-managed-tree-tmp.$$"
	awk -v old="$_PCFG_MANAGED_TREE_OLD_INCLUDES" -v new="$_PCFG_MANAGED_TREE_NEW_INCLUDES" '
		BEGIN { n = split(old, arr, "\n"); i = 0 }
		{
			if (i < n && $0 == arr[i + 1]) {
				i++
				if (i == n) { print new; next }
				next
			} else if (i > 0) {
				i = ($0 == arr[1]) ? 1 : 0
			}
			print
		}
	' "$f" > "$tmp"

	if ! grep -qxF '[include nebulaos/platform.cfg]' "$tmp" || ! grep -qxF '[include macros/*.cfg]' "$tmp"; then
		log "ERROR: managed-tree rewrite of printer.cfg failed a basic sanity check - leaving the original untouched (backup at $backup)"
		rm -f "$tmp"
		return 1
	fi
	if grep -qxF '[include /etc/nebulaos/klipper/platform.cfg]' "$tmp"; then
		log "ERROR: managed-tree rewrite of printer.cfg still contains an old absolute include after rewrite - leaving the original untouched (backup at $backup)"
		rm -f "$tmp"
		return 1
	fi

	mkdir -p "$PRINTER_DATA_CONFIG/macros"

	mv "$tmp" "$f"
	log "printer.cfg: migrated from direct /etc/nebulaos/klipper/*.cfg includes to the materialized nebulaos/*.cfg managed tree, plus [include macros/*.cfg] (original backed up at $backup)"
	return 0
}

migrate_config_ownership() {
	f="$PRINTER_DATA_CONFIG/printer.cfg"
	[ -f "$f" ] || return 0
	if [ ! -x "$PYTHON3" ] && ! command -v "$PYTHON3" >/dev/null 2>&1; then
		log "ERROR: $PYTHON3 not available - cannot run migrate_config_ownership, leaving printer.cfg untouched (will retry next boot)"
		return 1
	fi
	if [ ! -f "$MIGRATE_CONFIG_OWNERSHIP_TOOL" ]; then
		log "ERROR: $MIGRATE_CONFIG_OWNERSHIP_TOOL missing - cannot run migrate_config_ownership, leaving printer.cfg untouched (will retry next boot)"
		return 1
	fi
	out=$("$PYTHON3" "$MIGRATE_CONFIG_OWNERSHIP_TOOL" "$f" "$BACKUP_ROOT" 2>&1)
	rc=$?
	log "migrate_config_ownership: $out"
	return $rc
}

# GuppyScreen's upstream guppy_cmd.cfg ships [guppy_module_loader] and
# [guppy_config_helper] sections that require the Guppy fork of Klipper.
# NebulaOS runs upstream pristine Klipper, which has no such modules, so
# these sections cause an immediate config error on startup. A device
# provisioned before NebulaOS (or one that inherited GuppyScreen config
# from a prior install) may still have these in its persistent config.
# This migration comments them out, idempotently, so the include is not
# broken. The rest of guppy_cmd.cfg (shell commands, macros, beeper) is
# valid upstream Klipper and left untouched.
migrate_guppy_stale_modules() {
	f="$PRINTER_DATA_CONFIG/GuppyScreen/guppy_cmd.cfg"
	[ -f "$f" ] || return 0

	if ! grep -q '^\[guppy_module_loader\]\|^\[guppy_config_helper\]' "$f"; then
		return 0
	fi

	tmp="$f.migrate-tmp.$$"
	if ! sed \
		-e 's/^\[guppy_module_loader\]$/# [guppy_module_loader]  # removed by NebulaOS migration: not in upstream Klipper/' \
		-e 's/^\[guppy_config_helper\]$/# [guppy_config_helper]  # removed by NebulaOS migration: not in upstream Klipper/' \
		"$f" > "$tmp"; then
		log "ERROR: could not rewrite GuppyScreen/guppy_cmd.cfg to remove stale Guppy-fork sections"
		rm -f "$tmp"
		return 1
	fi

	if grep -q '^\[guppy_module_loader\]\|^\[guppy_config_helper\]' "$tmp"; then
		log "ERROR: GuppyScreen/guppy_cmd.cfg migration did not remove all stale sections - leaving the original untouched"
		rm -f "$tmp"
		return 1
	fi

	mv "$tmp" "$f"
	log "GuppyScreen/guppy_cmd.cfg: commented out [guppy_module_loader] and [guppy_config_helper] (Guppy-fork modules not present in upstream Klipper)"
	return 0
}

# G63 (2026-10-16): leftovers in the config folder that nothing reads any
# more, retired here (this replaces audit F-11's migrate_static_ip_state,
# which copied the two static-IP files INTO config from the retired
# /usr/data/printer_data alias):
#   - static_ip.json, static_ip_dhcp_snapshot.json: GuppyScreen's retired
#     static_ip.py state; network settings live in network/osconfig.json.
#     Moved (never deleted) to system/migration-backups/retired-config/.
#   - GuppyScreen/scripts/static_ip.py: removed only when it is byte-for-byte
#     a version NebulaOS shipped (sha256 of each, from git history); any
#     other file stays. Empty folders are removed.
RETIRED_STATIC_IP_PY_SHA256="b3e7a0dae3f86343a4d205effed240b971ff6e2977ded547f39767fe0da6aa72 c131017c03b61e225a46f1cd3b70a0a5f602c6fe994bc761dd9f58bd23bc2b20 c95ca46e97a4f41a02d0ef89d07cc8188cc143b93a8841cfffc87a2c92c25e6a e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"
retire_config_leftovers() {
	[ -n "$PRINTER_DATA_CONFIG" ] && [ -d "$PRINTER_DATA_CONFIG" ] || return 0
	_rcl_dir="$BACKUP_ROOT/retired-config"
	for _rcl_name in static_ip.json static_ip_dhcp_snapshot.json; do
		_rcl_f="$PRINTER_DATA_CONFIG/$_rcl_name"
		[ -f "$_rcl_f" ] && [ ! -L "$_rcl_f" ] || continue
		mkdir -p "$_rcl_dir" 2>/dev/null
		if mv "$_rcl_f" "$_rcl_dir/$_rcl_name.$(date -u +%Y%m%dT%H%M%SZ)"; then
			log "config: retired $_rcl_f (unused since the network settings moved) -> $_rcl_dir"
		fi
	done
	_rcl_py="$PRINTER_DATA_CONFIG/GuppyScreen/scripts/static_ip.py"
	if [ -f "$_rcl_py" ] && [ ! -L "$_rcl_py" ]; then
		_rcl_sum=$(sha256sum "$_rcl_py" 2>/dev/null | cut -c1-64)
		case " $RETIRED_STATIC_IP_PY_SHA256 " in
			*" $_rcl_sum "*) rm -f "$_rcl_py" && log "config: removed the retired $_rcl_py (a version NebulaOS shipped)" ;;
			*) log "config: $_rcl_py is not a version NebulaOS shipped - left in place" ;;
		esac
	fi
	rmdir "$PRINTER_DATA_CONFIG/GuppyScreen/scripts" "$PRINTER_DATA_CONFIG/GuppyScreen" 2>/dev/null
	return 0
}

# G65 (2026-10-16): a copy of the user's settings at the first boot of every
# new or rolled-back system - before migrate_moonraker_pin_include and the
# rest rewrite moonraker.conf/printer.cfg or materialization replaces
# config/nebulaos. Keyed on the image's seed manifest (any change, including
# a downgrade). Moonraker is not running yet (S56), so its database file is
# copied directly. A failed snapshot never blocks the boot.
OSCONFIG="${OSCONFIG:-/usr/libexec/nebulaos/nebulaos-osconfig}"
SETTINGS_SNAPSHOT_MARK="${SETTINGS_SNAPSHOT_MARK:-$SYSTEM/settings-snapshot.system}"
settings_snapshot_on_new_system() {
	[ -f "$SEEDS/seed-manifest.json" ] && [ -x "$OSCONFIG" ] || return 0
	_ss_id=$(sha256sum "$SEEDS/seed-manifest.json" 2>/dev/null | cut -c1-64)
	[ -n "$_ss_id" ] || return 0
	[ "$(cat "$SETTINGS_SNAPSHOT_MARK" 2>/dev/null)" = "$_ss_id" ] && return 0
	if _ss_out=$("$OSCONFIG" settings snapshot --reason new-system --db file 2>&1); then
		mkdir -p "$(dirname "$SETTINGS_SNAPSHOT_MARK")" 2>/dev/null
		echo "$_ss_id" > "$SETTINGS_SNAPSHOT_MARK"
		log "settings: snapshot taken before this system's first start ($_ss_out)"
	else
		log "ERROR: settings: snapshot before this system's first start failed - continuing ($_ss_out)"
	fi
	return 0
}

# G62/G63 (2026-10-16): files handed to NebulaOS live in
# printer_data/config/uploads (G63: inside the config root - Mainsail's upload
# button only uploads there; G62's separate root printer_data/uploads is
# retired). Moves anything in the old places - including files put there
# while an older NebulaOS ran from the other slot - into the new folders.
# Never overwrites ("name (2).ext" instead); old folders are removed when
# empty. Idempotent, every boot.
UPLOADS_ROOT="${UPLOADS_ROOT:-/usr/data/nebulaos/printer_data/config/uploads}"
G62_UPLOADS_ROOT="${G62_UPLOADS_ROOT:-/usr/data/nebulaos/printer_data/uploads}"
OLD_BOOT_UPLOADS="${OLD_BOOT_UPLOADS:-/usr/data/nebulaos/boot/uploads}"

_mu_move_all() {
	_mu_from="$1"; _mu_to="$2"
	[ -d "$_mu_from" ] && [ ! -L "$_mu_from" ] || return 0
	mkdir -p "$_mu_to" 2>/dev/null
	for _mu_f in "$_mu_from"/* "$_mu_from"/.[!.]*; do
		[ -f "$_mu_f" ] && [ ! -L "$_mu_f" ] || continue
		_mu_name=$(basename "$_mu_f")
		_mu_dst="$_mu_to/$_mu_name"
		_mu_n=1
		while [ -e "$_mu_dst" ]; do
			if cmp -s "$_mu_f" "$_mu_dst"; then break; fi
			_mu_n=$((_mu_n + 1))
			case "$_mu_name" in
				*.*) _mu_dst="$_mu_to/${_mu_name%.*} ($_mu_n).${_mu_name##*.}" ;;
				*) _mu_dst="$_mu_to/$_mu_name ($_mu_n)" ;;
			esac
		done
		if [ -e "$_mu_dst" ]; then
			rm -f "$_mu_f" && log "uploads: $_mu_f already in $_mu_to - old copy removed"
		elif mv "$_mu_f" "$_mu_dst"; then
			log "uploads: moved $_mu_f -> $_mu_dst"
		else
			log "ERROR: uploads: could not move $_mu_f - left in place"
		fi
	done
	rmdir "$_mu_from" 2>/dev/null
	return 0
}

migrate_user_uploads() {
	_mu_move_all "$PRINTER_DATA_CONFIG/firmware/mcu" "$UPLOADS_ROOT/mainboard-firmware"
	_mu_move_all "$PRINTER_DATA_CONFIG/firmware/os" "$UPLOADS_ROOT/system-image"
	rmdir "$PRINTER_DATA_CONFIG/firmware" 2>/dev/null
	_mu_move_all "$OLD_BOOT_UPLOADS" "$UPLOADS_ROOT/boot-logo"
	# G63: the G62 root, and a boot logo uploaded through Mainsail into
	# config/boot-logo while that root existed (Mainsail uploads into config).
	for _mu_sub in boot-logo mainboard-firmware system-image; do
		_mu_move_all "$G62_UPLOADS_ROOT/$_mu_sub" "$UPLOADS_ROOT/$_mu_sub"
	done
	rmdir "$G62_UPLOADS_ROOT" 2>/dev/null
	_mu_move_all "$PRINTER_DATA_CONFIG/boot-logo" "$UPLOADS_ROOT/boot-logo"
	return 0
}

start() {
	_diag_init
	_expected_version=""
	_installed_version=""
	_migration_action="starting"
	_klipper_before="unknown"
	_extensions_before="unknown"
	_moonraker_before="unknown"
	_klipper_after="unknown"
	_extensions_after="unknown"
	_moonraker_after="unknown"
	_klipper_reseed_result="not_attempted"
	_extensions_reseed_result="not_attempted"
	_moonraker_reseed_result="not_attempted"
	_generation_recorded="no"
	_gate_result="not_checked"
	_last_error="none"

	log "--- migration pass starting ---"
	# G65: first, before anything below rewrites a setting.
	settings_snapshot_on_new_system

	_klipper_before=$( [ -d "$APPS/klipper/.git" ] && git -C "$APPS/klipper" rev-parse HEAD 2>/dev/null || echo "absent")
	_extensions_before=$( [ -d "$APPS/nebulaos-klipper-extensions/.git" ] && git -C "$APPS/nebulaos-klipper-extensions" rev-parse HEAD 2>/dev/null || echo "absent")
	_moonraker_before=$( [ -d "$APPS/moonraker/.git" ] && git -C "$APPS/moonraker" rev-parse HEAD 2>/dev/null || echo "absent")
	log "current persistent state: klipper=$_klipper_before extensions=$_extensions_before moonraker=$_moonraker_before"

	# Deliberately before the generation comparison and before the
	# maintenance gate: these are small, idempotent text-file rewrites, not
	# the memory-heavy tar/git work the gate exists to hold back, and a
	# device on an old config shape must recover on the very next boot
	# rather than only when a generation happens to change.
	migrate_moonraker_pin_include
	migrate_updater_channels
	migrate_printer_cfg
	materialize_active_config
	migrate_printer_cfg_to_managed_tree
	migrate_config_ownership
	migrate_guppy_stale_modules
	retire_config_leftovers
	migrate_user_uploads

	if [ ! -f "$SEEDS/seed-manifest.json" ]; then
		_migration_action="skipped:no_manifest"
		_last_error="no seed-manifest.json"
		log "no seed manifest ($SEEDS/seed-manifest.json missing) - nothing to compare against, skipping"
		_diag_write_state
		return 0
	fi

	_expected_version=$(json_get "$SEEDS/seed-manifest.json" migration_version)
	if [ -z "$_expected_version" ]; then
		_migration_action="skipped:no_version"
		_last_error="seed-manifest.json has no migration_version"
		log "ERROR: seed-manifest.json has no migration_version field - skipping (image predates this feature, or manifest is malformed)"
		_diag_write_state
		return 0
	fi

	_installed_version=""
	[ -f "$GENERATION_FILE" ] && _installed_version=$(json_get "$GENERATION_FILE" migration_version)
	log "version comparison: installed='$_installed_version' expected='$_expected_version'"

	if [ "$_installed_version" = "$_expected_version" ]; then
		_migration_action="skipped:version_match"
		log "installed generation ($_installed_version) already matches this image - nothing to do"
		_diag_write_state
		return 0
	fi

	# Genuinely fresh namespace, first-ever boot: S04nebulaos-factory-seed
	# (runs immediately before this) just seeded everything for the first
	# time, from the SAME archives this script would otherwise migrate to -
	# there is nothing to back up or replace, just record the baseline
	# generation so future boots have something to compare against.
	if [ ! -e "$APPS/klipper/.git" ]; then
		_migration_action="baseline_only"
		log "no existing klipper checkout - nothing to migrate (factory-seed will handle first-time provisioning); recording baseline generation only"
		record_generation "$_expected_version"
		_generation_recorded="yes"
		_diag_write_state
		return 0
	fi

	log "generation mismatch: installed='$_installed_version' expected='$_expected_version' - migration needed"
	if ! maintenance_gate_ok; then
		_migration_action="blocked:maintenance_gate"
		_gate_result="blocked"
		_last_error="maintenance gate refused (see gate log for details: print active, stale lock, or no swap)"
		log "migration BLOCKED by maintenance gate - this is a diagnosed failure, not a silent skip. See persistent diagnostic at $DIAG_STATE"
		_diag_write_state
		return 0
	fi
	_gate_result="passed"

	# Nothing below may mutate anything until the zero-write preconditions
	# hold. A deterministic, image-wide failure must cost zero storage per
	# boot, not one backup directory per boot.
	if ! migration_preconditions_ok; then
		_migration_action="incomplete:preconditions"
		_last_error="migration preconditions not met"
		log "migration NOT STARTED - preconditions failed (see errors above). Nothing was moved, no backup directory was created, and the generation was not advanced, so this retries next boot at no storage cost."
		_diag_write_state
		return 0
	fi

	_migration_action="migrating"
	# Deliberately NOT created here. ensure_backup_dir() creates it at the
	# first real cutover, and reuses a previous failed attempt's directory.
	BACKUP_DIR=""

	klipper_ok=1
	extensions_ok=1
	moonraker_ok=1
	# Phase 1 no-fork migration: official Klipper, and the
	# klippy/chelper/c_helper.so dirty-tree exception is gone - upstream's
	# own .gitignore contains "*.so", so the prebuilt artifact never made
	# the tree dirty in the first place. See S04nebulaos-factory-seed's
	# matching note.
	if [ -e "$APPS/klipper/.git" ]; then
		if reseed_git_app klipper master "https://github.com/Klipper3d/klipper.git"; then
			_klipper_reseed_result="success"
		else
			klipper_ok=0
			_klipper_reseed_result="failed"
			_last_error="klipper reseed failed"
		fi
	fi
	# A device seeded by a pre-Phase-1 image has no extensions checkout at
	# all, so there is nothing to reseed and nothing to back up - but the
	# component still has to arrive, or the pair is incomplete. Seed it
	# directly from the archive in that case rather than skipping it and
	# recording a generation that claims a component this device does not
	# have.
	if [ -e "$APPS/nebulaos-klipper-extensions/.git" ]; then
		# F-06: derived, not a literal. See /etc/nebulaos-seed-manifest.sh.
		_ext_branch=$(seed_manifest_branch "$SEEDS/seed-manifest.json" \
			nebulaos-klipper-extensions)
		if [ -z "$_ext_branch" ]; then
			# MUST set the same failure state the reseed-failed arm below
			# sets. A bare `false` here would be read by nothing:
			# extensions_ok stays 1, the pair guard does not fire,
			# record_generation runs, and the boot reports "completed"
			# while the extensions half was never reseeded - then the next
			# boot takes the version-match early return and never retries.
			# That is a silent, permanent new-Klipper-against-old-extensions
			# divergence. Note what the pair guard below can and cannot do
			# about it: klipper was already cut over at its own reseed call
			# above, so the guard cannot un-promote it - it withholds the
			# generation record, which is what makes the next boot retry.
			# A distinct result string, because _diag_write_state is the
			# only forensic record a field device leaves and "manifest or
			# library unreadable" is a different diagnosis from "the reseed
			# itself failed".
			extensions_ok=0
			_extensions_reseed_result="branch_undeterminable"
			_last_error="extensions branch undeterminable"
			log "ERROR: cannot determine the expected extensions branch from $SEEDS/seed-manifest.json - refusing to reseed rather than guessing a branch name (is $SEED_MANIFEST_LIB present?)"
		elif reseed_git_app nebulaos-klipper-extensions "$_ext_branch" \
			"https://github.com/coreflake1/NebulaOS-klipper-extensions.git"; then
			_extensions_reseed_result="success"
		else
			extensions_ok=0
			_extensions_reseed_result="failed"
			_last_error="extensions reseed failed"
		fi
	else
		log "no existing extensions checkout (device predates the no-fork architecture) - provisioning it from this image's archive as part of this migration"
		if seed_missing_extensions; then
			_extensions_reseed_result="provisioned"
		else
			extensions_ok=0
			_extensions_reseed_result="provision_failed"
			_last_error="extensions provision failed"
		fi
	fi
	if [ -e "$APPS/moonraker/.git" ]; then
		if reseed_git_app moonraker master "https://github.com/Arksine/moonraker.git"; then
			_moonraker_reseed_result="success"
		else
			moonraker_ok=0
			_moonraker_reseed_result="failed"
			_last_error="moonraker reseed failed"
		fi
	fi

	_klipper_after=$( [ -d "$APPS/klipper/.git" ] && git -C "$APPS/klipper" rev-parse HEAD 2>/dev/null || echo "absent")
	_extensions_after=$( [ -d "$APPS/nebulaos-klipper-extensions/.git" ] && git -C "$APPS/nebulaos-klipper-extensions" rev-parse HEAD 2>/dev/null || echo "absent")
	_moonraker_after=$( [ -d "$APPS/moonraker/.git" ] && git -C "$APPS/moonraker" rev-parse HEAD 2>/dev/null || echo "absent")

	# The Klipper stack is validated as a pair. Report it as one, so a
	# reader of the boot log sees "the pair failed", not two independent
	# component lines they have to correlate themselves.
	# This is a GENERATION-RECORDING guard, not a promotion guard, and the
	# distinction matters to whoever reads this line at 2am. reseed_git_app()
	# cuts each component over individually (the mv pair above), and klipper
	# is reseeded before the extensions branch is even derived - so by the
	# time we get here the half that succeeded is ALREADY live on disk. What
	# is withheld is the generation record, which is what makes the next boot
	# retry instead of taking the version-match early return. The log said
	# "NEITHER half is promoted" until 2026-09-22; that was simply false.
	if [ "$klipper_ok" != "1" ] || [ "$extensions_ok" != "1" ]; then
		log "ERROR: the Klipper stack did not migrate as a complete pair (klipper ok=$klipper_ok, extensions ok=$extensions_ok). Running new Klipper against old extensions, or the reverse, is exactly the mismatch this pairing exists to prevent. The generation is NOT advanced, so the next boot retries - but note the half that did succeed has already been cut over on disk, and the previous tree for it is in $(backup_dir_desc). The next boot retries and REUSES that same directory rather than creating another one."
	fi

	if [ "$klipper_ok" = "1" ] && [ "$extensions_ok" = "1" ] && [ "$moonraker_ok" = "1" ]; then
		record_generation "$_expected_version"
		_generation_recorded="yes"
		_migration_action="completed"
		# The attempt is over; the next migration must start a fresh backup
		# directory rather than reusing this one.
		rm -f "$ATTEMPT_FILE"
		log "migration complete - generation now $_expected_version. Previous application tree preserved at $(backup_dir_desc) (not deleted automatically - safe to remove by hand once the new generation is confirmed working)."
		log "result: klipper=$_klipper_after extensions=$_extensions_after moonraker=$_moonraker_after"
	else
		_migration_action="incomplete"
		log "migration INCOMPLETE - at least one component failed and was left at its previous version (see errors above). Generation NOT advanced, so this will retry next boot. Nothing was destroyed: any component that failed still has its pre-migration tree in place at $APPS, and $(backup_dir_desc) holds whatever was successfully backed up before the failure. A retry reuses that directory, so repeated failures do not accumulate backups."
	fi
	# G85 (Run 15): Moonraker's update manager keeps the replaced trees'
	# versions in its database until a refresh, so Mainsail and the screen
	# showed the pre-install Klipper/Moonraker/extensions after an image
	# install (ke-dev, 2026-10-19). Tell the update supervisor, for this boot
	# only (/run is tmpfs); it asks for a refresh once Moonraker is up.
	mkdir -p "${NEBULAOS_RUN_DIR:-/run/nebulaos}" 2>/dev/null \
		&& : > "${NEBULAOS_RUN_DIR:-/run/nebulaos}/apps-migrated" 2>/dev/null || true
	_diag_write_state
}

# Describes the backup directory for a log line. It can legitimately be empty
# now: a run that fails before any cutover never creates one.
backup_dir_desc() {
	if [ -n "${BACKUP_DIR:-}" ] && [ -d "$BACKUP_DIR" ]; then
		printf '%s' "$BACKUP_DIR"
	else
		printf '%s' "(none created - no component reached cutover)"
	fi
}

record_generation() {
	version="$1"
	mkdir -p "$SYSTEM"
	klipper_commit=$( [ -d "$APPS/klipper/.git" ] && git -C "$APPS/klipper" rev-parse HEAD 2>/dev/null || echo "unseeded")
	extensions_commit=$( [ -d "$APPS/nebulaos-klipper-extensions/.git" ] && git -C "$APPS/nebulaos-klipper-extensions" rev-parse HEAD 2>/dev/null || echo "unseeded")
	moonraker_commit=$( [ -d "$APPS/moonraker/.git" ] && git -C "$APPS/moonraker" rev-parse HEAD 2>/dev/null || echo "unseeded")
	now=$(date -u +%Y-%m-%dT%H:%M:%SZ)
	cat > "$GENERATION_FILE" <<EOF
{
  "migration_version": "$version",
  "recorded_at": "$now",
  "klipper_commit": "$klipper_commit",
  "extensions_commit": "$extensions_commit",
  "moonraker_commit": "$moonraker_commit"
}
EOF
	log "recorded generation $version to $GENERATION_FILE"
}

if [ -z "${S04NEBULAOS_MIGRATE_NO_AUTORUN:-}" ]; then
	case "$1" in
		start)
			start
			;;
		*)
			;;
	esac
	exit 0
fi
