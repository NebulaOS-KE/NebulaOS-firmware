#!/bin/sh
#
# NebulaOS mutable-runtime mission, Phase 5: the one authoritative
# activation manager. Decides, for each mutable app (Klipper, the Klipper
# extension set, Moonraker, Mainsail) and for printer_data/shared-gcode,
# whether the persistent /usr/data/nebulaos copy is valid enough to
# bind-mount over the immutable /opt/*|/usr/share/mainsail path - or whether
# to leave the immutable squashfs content in place untouched.
#
# Phase 1 no-fork migration (2026-08-17): this script also composes the
# Klipper stack. NebulaOS runs official, unmodified Klipper, and the modules
# this project owns are activated by symlinking them from
# apps/nebulaos-klipper-extensions into apps/klipper/klippy/extras and
# listing them in that clone's .git/info/exclude - see
# /etc/nebulaos-klipper-compose.sh for the mechanism and why it is the only
# one that works.
#
# This is the correct slot for it and no new ordering is needed: S04nebulaos-
# migrate replaces the whole apps/klipper tree on a generation bump, which
# destroys the composed symlinks, and S55klipper must not start before they
# are back. S04 -> S05 -> S55 already gives exactly that, which makes the
# ordering load-bearing in a way it was not before. tests/app-migration-
# tests.sh covers it explicitly rather than leaving it to be assumed.
#
# Composition runs BEFORE the bind mount, deliberately. If it fails - a
# collision with an upstream file, a dangling link, a stale c_helper.so -
# the persistent Klipper is simply not activated and the immutable copy
# stays in place, which is this script's existing and well-proven "doing
# nothing at all is always safe" default rather than a new failure mode.
#
# SAFETY DEFAULT: doing nothing at all is always safe. Every service in
# this image was built to run directly against its immutable /opt/*
# path - that is this system's real default state, not a fallback bolted
# on afterward. Activation only ever ADDS a bind mount on top when a
# persistent copy has positively proven itself; it never removes or
# breaks the immutable content underneath, and any check that fails just
# means "skip this one app, leave it on immutable" rather than aborting
# the whole boot.
#
# Must run after S02nebulaos-namespace, S03nebulaos-diskswap, and
# S04nebulaos-factory-seed (needs the layout, swap resilience, and a
# seeded copy to all exist), and BEFORE S50webcam/S55klipper/
# S56moonraker/S58guppyscreen - no service may start against a path that
# might still change under it. S01wifi (renumbered from S39, see that
# script's own header) is a deliberate exception - it has no dependency
# on this activation step at all, only on S01persistent-datastore's real
# storage mount, so it now correctly runs before this script rather than
# after it.

NEBULAOS_ROOT="${NEBULAOS_ROOT:-/usr/data/nebulaos}"
STATE_FILE="$NEBULAOS_ROOT/system/activation-state.json"
LOCKDIR="${LOCKDIR:-$NEBULAOS_ROOT/updates/locks}"

# Shared libraries, overridable for tests exactly like S04's GATE_LIB.
COMPOSE_LIB="${COMPOSE_LIB:-/etc/nebulaos-klipper-compose.sh}"
CHELPER_LIB="${CHELPER_LIB:-/etc/nebulaos-chelper-preflight.sh}"

# Every app directory on a real device is root-owned; anything else means
# something outside this project's control has been writing there. Overridable
# ONLY so the offline tests can exercise the checks that come after it - real
# boot never sets it, so ":-" always resolves to 0:0, exactly like SEEDS/APPS/
# LOCKDIR in the S04 scripts.
EXPECTED_APP_OWNER="${EXPECTED_APP_OWNER:-0:0}"

# One lock covers BOTH halves of the Klipper stack. The pair is the unit
# that gets validated and rolled back, so a mid-flight update of either half
# must hold activation off both - a lock per component would let this script
# activate a Klipper whose extensions are being rewritten underneath it.
KLIPPER_STACK_LOCK="klipper-stack"

[ -f "$COMPOSE_LIB" ] && . "$COMPOSE_LIB"
[ -f "$CHELPER_LIB" ] && . "$CHELPER_LIB"

DIAG_DIR="${NEBULAOS_ROOT}/system/diagnostics"
DIAG_LOG="${DIAG_DIR}/activation.log"
DIAG_MAX_SIZE=65536

_diag_init() {
	mkdir -p "$DIAG_DIR" 2>/dev/null || true
	if [ -f "$DIAG_LOG" ]; then
		_sz=$(wc -c < "$DIAG_LOG" 2>/dev/null || echo 0)
		if [ "$_sz" -gt "$DIAG_MAX_SIZE" ]; then
			tail -c "$DIAG_MAX_SIZE" "$DIAG_LOG" > "$DIAG_LOG.tmp" 2>/dev/null
			mv "$DIAG_LOG.tmp" "$DIAG_LOG" 2>/dev/null || true
		fi
	fi
}

log() {
	echo "S05nebulaos-activate: $1"
	_ts=$(date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || echo "unknown")
	echo "$_ts $1" >> "$DIAG_LOG" 2>/dev/null || true
}

# Shared persistent-venv predicate - see /usr/libexec/nebulaos-venv-lib.sh.
# Sourced AFTER log() so the library's messages go to this script's own log.
# Non-fatal if absent: S05's other work (bind mounts for apps, config) must
# still happen, and the one call site below fails closed on its own.
# Locate the shared persistent-venv helpers.
#
# The same expression has to work in two places. On the device this script is
# /etc/init.d/S04nebulaos-factory-seed and the library is
# /usr/libexec/nebulaos-venv-lib.sh. In the overlay source tree - which is what
# every test harness runs against - they are <overlay>/etc/init.d/... and
# <overlay>/usr/libexec/... So `<dir of this script>/../../usr/libexec/...`
# resolves correctly in BOTH, and an absolute /usr/libexec path resolves only
# on the device.
#
# An earlier revision hardcoded the absolute path and hard-failed when it was
# missing. That was fail-closed in the right direction but it broke seven test
# suites that stage the init script without a full rootfs - the script aborted
# before doing any of its real work. Try the override, then the device path,
# then the script-relative path; fail closed only if none exists.
# $0 is not reliable here: the test harnesses source this script inside
# `sh -c ". <path>"`, where $0 is empty and `dirname ""` errors out. Guard it.
if [ -n "${0:-}" ]; then _venv_lib_dir=$(dirname "$0"); else _venv_lib_dir=.; fi
for _cand in \
	"${NEBULAOS_VENV_LIB:-}" \
	/usr/libexec/nebulaos-venv-lib.sh \
	"$_venv_lib_dir/../../usr/libexec/nebulaos-venv-lib.sh"; do
	[ -n "$_cand" ] && [ -r "$_cand" ] || continue
	NEBULAOS_VENV_LIB=$_cand
	break
done
if [ -n "${NEBULAOS_VENV_LIB:-}" ] && [ -r "$NEBULAOS_VENV_LIB" ]; then
	. "$NEBULAOS_VENV_LIB"
else
	log "WARNING: nebulaos-venv-lib.sh not found - treating the klipper venv as unusable"
	venv_is_usable() { return 1; }
	venv_validated_usable() { return 1; }
fi

# Records one app's activation decision. Appended as simple key=value lines
# to a working file, assembled into JSON at the end of start() - avoids
# needing a JSON-aware tool in a BusyBox ash environment.
record() {
	echo "$1=$2" >> "$NEBULAOS_ROOT/system/.activation-decisions"
}

# Resolve a path and confirm the result still lives under $NEBULAOS_ROOT -
# rejects '..' traversal and symlinks that escape the namespace. Empty
# output means "reject."
safe_realpath_under_namespace() {
	target="$1"
	resolved=$(readlink -f "$target" 2>/dev/null) || return 1
	case "$resolved" in
		"$NEBULAOS_ROOT"/*|"$NEBULAOS_ROOT")
			echo "$resolved"
			return 0
			;;
		*)
			return 1
			;;
	esac
}

# $1=app name, $2=persistent source dir, $3=required marker file (relative
# to $2, proves the copy is real/complete), $4=immutable-fallback reason
# label used only in logs/state.
validate_app() {
	name="$1"; src="$2"; marker="$3"

	if [ ! -d "$src" ]; then
		log "$name: no persistent copy at $src - staying on immutable"
		record "$name" "immutable:not_present"
		return 1
	fi

	resolved=$(safe_realpath_under_namespace "$src")
	if [ -z "$resolved" ]; then
		log "$name: $src resolves outside $NEBULAOS_ROOT (traversal/escaping symlink) - REJECTING, staying on immutable"
		record "$name" "immutable:path_escape_rejected"
		return 1
	fi

	# $marker may be a space-separated list of required relative paths -
	# real bug found live (auto-updates-camera-complete mission addendum,
	# 2026-07-28): printer_data's own marker was just the literal string
	# "config", which S02nebulaos-namespace's own create_layout() always
	# recreates as an empty directory on every boot regardless of whether
	# the real required files inside it (printer.cfg, moonraker.conf) are
	# present - so this check always passed even when a wiped persistent
	# copy had neither file, activating an empty config over the real
	# immutable defaults and leaving Klipper/Moonraker in a permanent
	# FileNotFoundError crash loop. Checking the actual required files
	# individually is what catches this.
	for m in $marker; do
		if [ ! -e "$src/$m" ]; then
			log "$name: missing expected marker ($m) - incomplete/invalid copy, staying on immutable"
			record "$name" "immutable:incomplete_or_invalid"
			return 1
		fi
	done

	# BusyBox's build here has no `stat` applet at all (confirmed live,
	# "stat: not found") - `ls -ldn` (numeric UID/GID, a BusyBox ls
	# extension) is the portable alternative.
	owner=$(ls -ldn "$src" 2>/dev/null | awk '{print $3":"$4}')
	if [ "$owner" != "$EXPECTED_APP_OWNER" ]; then
		log "$name: unexpected ownership ($owner, expected $EXPECTED_APP_OWNER) - staying on immutable"
		record "$name" "immutable:unexpected_ownership"
		return 1
	fi

	if [ -e "$LOCKDIR/$name.lock" ]; then
		log "$name: an update transaction lock is present - an update is mid-flight, staying on immutable until it resolves"
		record "$name" "immutable:update_in_progress"
		return 1
	fi

	# $4, when given, names a shared transaction lock this component takes
	# part in as well as its own. Used for the Klipper stack, where klipper
	# and nebulaos-klipper-extensions are updated and rolled back together
	# and neither may be activated while that transaction is unresolved.
	if [ -n "${4:-}" ] && [ -e "$LOCKDIR/$4.lock" ]; then
		log "$name: the shared '$4' update transaction lock is present - staying on immutable until the whole stack resolves"
		record "$name" "immutable:stack_update_in_progress"
		return 1
	fi

	log "$name: persistent copy at $src validated OK"
	record "$name" "persistent"
	return 0
}

# $1=already-mounted target check, $2=source, $3=target
# GUI/service readiness mission (2026-10-09): compose the [nebulaos] Moonraker
# component into the persistent checkout (also done by S56moonraker on every
# start, so a Moonraker update/rollback/re-clone can never lose it).
NEBULAOS_MOONRAKER_COMPOSE_LIB="${NEBULAOS_MOONRAKER_COMPOSE_LIB:-/etc/nebulaos-moonraker-compose.sh}"
[ -f "$NEBULAOS_MOONRAKER_COMPOSE_LIB" ] && . "$NEBULAOS_MOONRAKER_COMPOSE_LIB"
command -v compose_moonraker_component >/dev/null 2>&1 || compose_moonraker_component() { return 0; }

bind_if_not_already() {
	src="$1"; dst="$2"
	# awk match on the exact target field (2nd column of /proc/mounts) -
	# avoids a duplicate/stacked bind mount if this script is somehow
	# invoked twice in one boot (it shouldn't be, but mount stacking from a
	# double-invocation would be genuinely hard to reason about later).
	if awk -v t="$dst" '$2==t {found=1} END{exit !found}' /proc/mounts; then
		log "already mounted at $dst - not re-mounting"
		return 0
	fi
	mount --bind "$src" "$dst"
	log "bind-mounted $src -> $dst"
}

# Compose the Klipper stack and prove it, or refuse.
#
# compose_ensure() rebuilds only when the recorded generation no longer
# matches reality, but verifies on EVERY call - which is what catches the
# silent case: upstream Klipper shipping a regular file at a path this
# project manages replaces the symlink with no error anywhere, and the
# extension is shadowed while the printer believes it is running ours.
#
# chelper_write_verdict() then re-checks the c_helper.so mtime invariant
# against the tree that is actually about to run and publishes the result
# where extras/nebulaos_compat.py reads it, so a stale prebuilt library
# surfaces as a named preflight refusal instead of a gcc crash part-way
# through boot on a device with no toolchain.
activate_klipper_stack() {
	kdir="$NEBULAOS_ROOT/apps/klipper"
	edir="$NEBULAOS_ROOT/apps/nebulaos-klipper-extensions"

	if ! command -v compose_ensure >/dev/null 2>&1; then
		log "klipper-stack: $COMPOSE_LIB is missing - cannot compose the extension set, refusing to activate an incomplete Klipper"
		record "klipper_stack" "immutable:compose_lib_missing"
		return 1
	fi

	if ! compose_ensure "$kdir" "$edir"; then
		log "klipper-stack: composition FAILED - see the errors above. The persistent Klipper is not activated."
		record "klipper_stack" "immutable:composition_failed"
		return 1
	fi

	if ! command -v chelper_write_verdict >/dev/null 2>&1; then
		log "klipper-stack: $CHELPER_LIB is missing - cannot verify the c_helper.so mtime invariant, refusing rather than letting Klippy attempt an on-device gcc build"
		record "klipper_stack" "immutable:chelper_lib_missing"
		return 1
	fi

	# G72: a library matching the sources, from the local cache only - no
	# network at this point of the boot (no Wi-Fi/DNS/NTP yet). The
	# supervisor fetches from the package index later.
	if command -v chelper_make_ready >/dev/null 2>&1; then
		chelper_cache_seed_image
		chelper_make_ready "$kdir" cache || log "klipper-stack: no matching c_helper.so in the local cache"
	fi

	if ! chelper_write_verdict "$kdir"; then
		log "klipper-stack: the c_helper.so mtime invariant does NOT hold - Klipper would try to rebuild its C library with gcc, which this device does not have. The persistent Klipper is not activated."
		record "klipper_stack" "immutable:chelper_stale"
		return 1
	fi

	command -v chelper_cache_current >/dev/null 2>&1 && chelper_cache_current "$kdir" >/dev/null 2>&1
	record "klipper_stack" "composed"
	return 0
}

start() {
	_diag_init
	log "--- activation pass starting ---"

	# /usr/data must be a real, writable mount before anything else here
	# is meaningful - S01persistent-datastore already mounted it, but
	# re-confirm rather than assume, since this script's own correctness
	# depends on it.
	if ! awk '$2=="/usr/data" {found=1} END{exit !found}' /proc/mounts; then
		log "/usr/data is not mounted - cannot activate anything, staying fully immutable"
		return 0
	fi
	testfile="/usr/data/.nebulaos-rw-test-$$"
	if ! ( : > "$testfile" ) 2>/dev/null; then
		log "/usr/data is not writable - cannot activate anything, staying fully immutable"
		return 0
	fi
	rm -f "$testfile"

	if [ ! -e "$NEBULAOS_ROOT/system/layout-manifest.json" ]; then
		log "no layout manifest - namespace not ready, staying fully immutable"
		return 0
	fi

	rm -f "$NEBULAOS_ROOT/system/.activation-decisions"
	mkdir -p "$LOCKDIR"

	# --- Klipper stack: official Klipper + the NebulaOS extension set -----
	#
	# Both halves must validate, the composition must build and verify, and
	# the c_helper.so mtime invariant must hold, before either is activated.
	# Any failure leaves /opt/klipper on the immutable squashfs copy, which
	# ships the extension modules as real files precisely so this fallback
	# remains a complete Klipper install.
	#
	# The extensions marker is nebulaos-extensions.json - a real, required
	# FILE, not a directory. That is a direct lesson from the printer_data
	# marker bug documented at validate_app() above, where a marker that
	# happened to be a directory S02 recreates every boot made the check
	# pass against an empty tree.
	if validate_app klipper "$NEBULAOS_ROOT/apps/klipper" "klippy/klippy.py" "$KLIPPER_STACK_LOCK" && \
	   validate_app nebulaos-klipper-extensions \
		"$NEBULAOS_ROOT/apps/nebulaos-klipper-extensions" \
		"nebulaos-extensions.json extras" "$KLIPPER_STACK_LOCK"; then
		if activate_klipper_stack; then
			bind_if_not_already "$NEBULAOS_ROOT/apps/klipper" /opt/klipper
		else
			log "klipper: composition or chelper preflight failed - NOT activating the persistent copy, leaving the immutable /opt/klipper in place"
		fi
	fi

	if validate_app moonraker "$NEBULAOS_ROOT/apps/moonraker" "moonraker/server.py"; then
		compose_moonraker_component "$NEBULAOS_ROOT/apps/moonraker"
		bind_if_not_already "$NEBULAOS_ROOT/apps/moonraker" /opt/moonraker
	fi

	# Closure mission (2026-07-27): bind the real Klipper venv onto the
	# exact path ("~/klippy-env", i.e. /root/klippy-env since moonraker
	# runs as root) Moonraker's update_manager hardcodes as its bootstrap
	# default for the klipper slot - not a mutable "app" with its own
	# rollback lifecycle like klipper/moonraker/mainsail above, so no
	# validate_app dance (ownership/marker/lock checks) needed, just a
	# plain existence check + bind. Real bug this fixes, confirmed live:
	# without this, update_manager crashes on every Moonraker startup that
	# hasn't already had a lucky prior boot persist Klipper's real
	# executable path into Moonraker's own database - i.e. always, on a
	# genuinely fresh device.
	# Same predicate S04nebulaos-factory-seed uses, from the same file - a
	# bare `-x bin/python3` is true for a venv built against an interpreter
	# this image no longer ships (persistent envs survive an A/B slot change
	# in BOTH directions), and bind-mounting such a venv onto /root/klippy-env
	# is worse than leaving it unmounted: Moonraker's update_manager would
	# then infer a klipper venv that cannot execute.
	# BOOT-04: the same stamp S04 maintains - this boot's S04 normally just
	# validated (or stamp-matched) this exact environment, so the 2.6 s import
	# check runs again only if its identity changed or no passing check is on
	# record.
	if venv_validated_usable "$NEBULAOS_ROOT/envs/klipper" "import greenlet, cffi, jinja2, serial, can"; then
		bind_if_not_already "$NEBULAOS_ROOT/envs/klipper" /root/klippy-env
	else
		log "klipper venv at $NEBULAOS_ROOT/envs/klipper is absent or not usable by this image's python - leaving /root/klippy-env unmounted (S04nebulaos-factory-seed provisions/replaces it on the next seeding pass)"
	fi

	if validate_app mainsail "$NEBULAOS_ROOT/apps/mainsail" "index.html"; then
		bind_if_not_already "$NEBULAOS_ROOT/apps/mainsail" /usr/share/mainsail
	fi

	# printer_data: private NebulaOS state first, then the shared stock
	# gcode tree bind-mounted INSIDE it - order matters (mission
	# requirement), each step independently guarded.
	if validate_app printer_data "$NEBULAOS_ROOT/printer_data" "config/printer.cfg config/moonraker.conf"; then
		bind_if_not_already "$NEBULAOS_ROOT/printer_data" /opt/printer_data

		# The shared stock gcode tree is outside the NebulaOS namespace by
		# design (docs/NEBULAOS_PERSISTENT_NAMESPACE.md) - validated
		# separately, not through validate_app's namespace check.
		shared_gcodes=/usr/data/printer_data/gcodes
		# Phase 1.5 persistent-namespace mission (2026-08): previously this
		# branch silently left /opt/printer_data/gcodes as whatever
		# printer_data's own private bind already provided whenever
		# $shared_gcodes didn't exist yet - which used to be masked by
		# S01persistent-datastore's own top-level /usr/data/printer_data
		# symlink into that same private tree (removed this mission, see
		# that script's own history). With the symlink gone, a genuinely
		# virgin device (no prior stock content at /usr/data/printer_data at
		# all) would otherwise never get a real shared gcode directory.
		# Creating it here is within NebulaOS's documented, narrow
		# exception to touch this one path
		# (docs/NEBULAOS_PERSISTENT_NAMESPACE.md sec "shared exceptions") -
		# it creates ONLY the gcodes subdirectory (and whatever parent
		# directories mkdir -p needs to reach it), never touches any other
		# content that may already exist under /usr/data/printer_data, and
		# is a no-op if the directory - stock's own or NebulaOS's earlier
		# creation - already exists.
		mkdir -p "$shared_gcodes"
		if [ -d "$shared_gcodes" ]; then
			# Phase 3.4 finding: NebulaOS's own USB mount target must exist
			# INSIDE the shared tree once it's what's actually visible at
			# /opt/printer_data/gcodes - idempotent, harmless if already there.
			mkdir -p "$shared_gcodes/USB"
			bind_if_not_already "$shared_gcodes" /opt/printer_data/gcodes
			record "shared_gcode" "persistent"
		else
			log "shared gcode path $shared_gcodes could not be created - leaving /opt/printer_data/gcodes as whatever printer_data's own mount already provided"
			record "shared_gcode" "immutable:not_present"
		fi
	fi

	# Assemble the human/machine-readable activation state record.
	now=$(date -u +%Y-%m-%dT%H:%M:%SZ)
	_act_klipper_sha=$( [ -d "$NEBULAOS_ROOT/apps/klipper/.git" ] && git -C "$NEBULAOS_ROOT/apps/klipper" rev-parse HEAD 2>/dev/null || echo "absent")
	_act_extensions_sha=$( [ -d "$NEBULAOS_ROOT/apps/nebulaos-klipper-extensions/.git" ] && git -C "$NEBULAOS_ROOT/apps/nebulaos-klipper-extensions" rev-parse HEAD 2>/dev/null || echo "absent")
	_act_moonraker_sha=$( [ -d "$NEBULAOS_ROOT/apps/moonraker/.git" ] && git -C "$NEBULAOS_ROOT/apps/moonraker" rev-parse HEAD 2>/dev/null || echo "absent")
	_act_gen=$( [ -f "$NEBULAOS_ROOT/system/app-generation.json" ] && grep -o '"migration_version"[[:space:]]*:[[:space:]]*"[^"]*"' "$NEBULAOS_ROOT/system/app-generation.json" 2>/dev/null | sed -E 's/.*"([^"]*)"$/\1/' | head -1 || echo "absent")
	_act_bind_klipper="no"
	awk '$2=="/opt/klipper" {found=1} END{exit !found}' /proc/mounts 2>/dev/null && _act_bind_klipper="yes"
	_act_compose_count=0
	if [ -d "$NEBULAOS_ROOT/apps/klipper/klippy/extras" ]; then
		_act_compose_count=$(find "$NEBULAOS_ROOT/apps/klipper/klippy/extras" -maxdepth 1 -type l 2>/dev/null | wc -l)
	fi
	{
		echo "{"
		echo "  \"activated_at\": \"$now\","
		echo "  \"active_klipper_sha\": \"$_act_klipper_sha\","
		echo "  \"active_extensions_sha\": \"$_act_extensions_sha\","
		echo "  \"active_moonraker_sha\": \"$_act_moonraker_sha\","
		echo "  \"active_generation\": \"$_act_gen\","
		echo "  \"klipper_bind_active\": \"$_act_bind_klipper\","
		echo "  \"composition_symlink_count\": $_act_compose_count,"
		echo "  \"decisions\": {"
		first=1
		if [ -e "$NEBULAOS_ROOT/system/.activation-decisions" ]; then
			while IFS='=' read -r k v; do
				[ -z "$k" ] && continue
				[ "$first" = 1 ] || echo ","
				first=0
				printf '    "%s": "%s"' "$k" "$v"
			done < "$NEBULAOS_ROOT/system/.activation-decisions"
		fi
		echo ""
		echo "  }"
		echo "}"
	} > "$STATE_FILE"
	log "activation complete - state recorded at $STATE_FILE"
	log "active SHAs: klipper=$_act_klipper_sha extensions=$_act_extensions_sha bind=$_act_bind_klipper compose_links=$_act_compose_count gen=$_act_gen"
}

# S05NEBULAOS_ACTIVATE_NO_AUTORUN=1 lets tests source this script to call
# validate_app()/activate_klipper_stack() directly against fixture
# directories - the same seam convention as S02's
# S02NEBULAOS_NAMESPACE_NO_AUTORUN and S04's own NO_AUTORUN variables.
if [ -z "${S05NEBULAOS_ACTIVATE_NO_AUTORUN:-}" ]; then
	case "$1" in
		start)
			start
			;;
		*)
			;;
	esac
	exit 0
fi
