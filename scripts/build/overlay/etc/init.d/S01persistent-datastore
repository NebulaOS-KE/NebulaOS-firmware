#!/bin/sh
#
# Real, persistent writable storage for this build, replacing the tmpfs
# stand-in from FIRMWARE.md sec 24 (S01tmpfs-datastore). That script was a
# deliberate, temporary safety choice for an untested custom image: /usr/data
# (mmcblk0p10) is a real ext4 partition physically shared with stock (not
# duplicated per A/B slot), so it mounted plain tmpfs over it instead, at the
# cost of losing all state - WiFi credentials, printer.cfg SAVE_CONFIG,
# GuppyScreen touch calibration - on every single reboot.
#
# Now that the kernel side is a tagged, proven production baseline
# (functional-production-baseline-2026-07-23) with working A/B fallback, this
# mounts the real partition - but everything this build writes lives under
# the single authoritative NebulaOS namespace, /usr/data/nebulaos, never
# touching whatever else already exists on that shared partition from stock.
# First-boot-only seeding (checked via existence, not reseeded every boot
# like the tmpfs version had to be) means real user state - WiFi creds,
# calibration, SAVE_CONFIG - survives reboots from here on.
#
# NebulaOS mutable-runtime closure mission (2026-07-27): DATA_ROOT used to be
# /usr/data/openke, a separate legacy path this project's own S02 namespace
# script had to migrate data OUT of. That path has been fully retired - there
# is no deployed OpenKE user base, so no migration compatibility is needed
# for any future device. This script now writes directly into
# /usr/data/nebulaos, the same authoritative root S02nebulaos-namespace/
# S05nebulaos-activate use. PDATA in particular intentionally uses the exact
# same path S05 later validates and (re-)binds - this makes S01's own bind
# mount here a genuine, always-available fallback: if S05's own validation
# ever fails (namespace missing/invalid), /opt/printer_data still ends up
# bound to this same real, writable directory rather than falling through to
# the read-only squashfs, where klippy.log/moonraker.log writes would fail
# outright. S05's bind_if_not_already() already no-ops cleanly when its
# target is already mounted, so having both scripts bind the identical
# source directory is deliberate, not a redundant double-mount.
#
# Runs after S00revert-safety, before anything that needs to read/write these
# paths - webcam/klipper/moonraker/guppyscreen (S50+) all come later, and
# before S02nebulaos-namespace (this script's own mkdir -p calls below only
# ever create the specific subdirectories it needs; S02's own layout
# creation is a superset and is unaffected by running second).
#
# /usr/data itself must exist as a real (if empty) directory baked into the
# image - scripts/build/overlay/usr/data/.keep is what guarantees that. The
# root filesystem is squashfs (read-only), so mkdir -p /usr/data below can
# only ever succeed if that directory already exists on disk to mount over;
# a genuinely brand-new top-level directory can never be created here at
# runtime. Found for real: an earlier overlay cleanup pass removed the only
# file that used to live under usr/data/ in the overlay source (moved to its
# correct /opt/printer_data location), which silently stopped baking in the
# usr/data directory itself as a side effect - this whole script then failed
# every mkdir/mount/cp call in sequence, and GuppyScreen never even started.

DATA_ROOT=/usr/data/nebulaos
PDATA=$DATA_ROOT/printer_data
GUPPY_STATE=$DATA_ROOT/guppyscreen

seed_once() {
	src="$1"
	dst="$2"
	[ -e "$dst" ] && return 0
	mkdir -p "$(dirname "$dst")"
	cp -a "$src" "$dst"
}

# G9 phase 1 (2026-10-07): boot check policy and clean shutdown for
# /usr/data - see /usr/libexec/nebulaos-datafs.sh. Without the library the
# mount is exactly the old one.
NEBULAOS_DATAFS_LIB="${NEBULAOS_DATAFS_LIB:-/usr/libexec/nebulaos-datafs.sh}"
# shellcheck disable=SC1090
[ -r "$NEBULAOS_DATAFS_LIB" ] && . "$NEBULAOS_DATAFS_LIB"

start() {
	mkdir -p /usr/data
	if command -v ndf_precheck >/dev/null 2>&1; then
		ndf_precheck
		ndf_mount
		ndf_record
	else
		mount -t ext4 /dev/mmcblk0p10 /usr/data
	fi

	mkdir -p "$DATA_ROOT"

	# Seed real defaults from the squashfs's baked-in copies, once ever -
	# a real device's SAVE_CONFIG/calibration/credentials must never be
	# clobbered by a later boot just because this script runs again.
	seed_once /opt/printer_data "$PDATA"
	mkdir -p "$PDATA/config/GuppyScreen/scripts"
	seed_once /opt/guppyscreen/guppyconfig.json "$GUPPY_STATE/guppyconfig.json"
	# GuppyScreen's shipped thumbnail_path is /opt/guppyscreen/thumbnails, on
	# the read-only squashfs: the image ships it as a symlink to this
	# persistent directory, so thumbnail downloads work without touching any
	# device's saved config (GUI readiness work, 2026-10-10).
	mkdir -p "$GUPPY_STATE/thumbnails"
	# Phase 2 final software closure mission (2026-09-09): user MCU
	# application-firmware upload area, browsable through Mainsail's
	# ordinary Config Files view (nebulaos-mcu flash resolves a bare
	# filename against this same directory) - see
	# docs/NEBULAOS_CONFIG_MATERIALIZATION.md. Deliberately just an empty
	# directory here; nothing seeds content into it.
	mkdir -p "$PDATA/config/firmware/mcu"

	# /opt/printer_data ships baked-in defaults on the read-only squashfs
	# (printer.cfg, moonraker.conf) for the seed step above - bind-mounting
	# the real persistent copy over it is what makes Klipper/Moonraker's
	# hardcoded /opt/printer_data paths (S55klipper, S56moonraker) actually
	# writable and persistent, without changing either service's config.
	mount --bind "$PDATA" /opt/printer_data

	# GuppyScreen hardcodes its own config path as
	# /proc/self/exe's-directory/guppyconfig.json (main.cpp) - i.e.
	# /opt/guppyscreen/guppyconfig.json, on the read-only squashfs, not
	# reachable via any override flag. A single-file bind mount is the only
	# way to make just this one file persistent without also having to
	# duplicate the guppyscreen/guppybeep binaries or themes/ into real
	# storage. Without this, touch_calibrated (sysinfo_panel.cpp) can never
	# actually save - not just "resets every boot," writes fail outright,
	# which is why GuppyScreen was stuck showing the recalibration wizard.
	mount --bind "$GUPPY_STATE/guppyconfig.json" /opt/guppyscreen/guppyconfig.json

	# Phase 2 final software closure mission (2026-09-09): the SAME real
	# file, bind-mounted a second time onto printer_data/config/
	# guppyscreen/guppyconfig.json, so it is also visible and editable
	# through Mainsail's ordinary Config Files browser - both paths are
	# the identical persistent inode at $GUPPY_STATE/guppyconfig.json, so
	# an edit through either one is immediately visible through the
	# other. Deliberately only this one file, never the guppyscreen/
	# guppybeep binaries or themes/ - those are image-owned, not user
	# config, and do not belong under printer_data/config/ at all (see
	# docs/NEBULAOS_CONFIG_MATERIALIZATION.md's ownership model).
	mkdir -p "$PDATA/config/guppyscreen"
	[ -e "$PDATA/config/guppyscreen/guppyconfig.json" ] || touch "$PDATA/config/guppyscreen/guppyconfig.json"
	mount --bind "$GUPPY_STATE/guppyconfig.json" "$PDATA/config/guppyscreen/guppyconfig.json"

	# Persistent root password (D7, 2026-10-10): seed /etc/shadow once into
	# the data partition and bind it over the read-only image copy, so
	# nebulaos-passwd / passwd over SSH can change it. Best effort: on any
	# doubt the image's default password stays (see the library).
	NEBULAOS_SHADOW_LIB="${NEBULAOS_SHADOW_LIB:-/etc/nebulaos-shadow.sh}"
	# shellcheck disable=SC1090
	[ -r "$NEBULAOS_SHADOW_LIB" ] && ( . "$NEBULAOS_SHADOW_LIB" && nsh_boot )

	# Phase 1.5 persistent-namespace mission (2026-08): the two top-level
	# compatibility symlinks that used to live here
	# (/usr/data/printer_data -> /opt/printer_data,
	# /usr/data/guppyscreen -> /opt/guppyscreen) are REMOVED, not just
	# guarded more carefully. Full history and why they were never safe:
	#
	# They existed only because GuppyScreen's own compiled binary hardcoded
	# a handful of /usr/data/printer_data/... and /usr/data/guppyscreen/...
	# paths instead of the already-correct /opt/printer_data/... and
	# /opt/guppyscreen/... bind-mount paths this script sets up two lines
	# above. That GuppyScreen-side fix has now landed (see
	# NebulaOS-guppyscreen's phase1.5/persistent-namespace branch) - nothing
	# left in the shipped image reads either top-level alias.
	#
	# The symlinks were also a genuine namespace-ownership defect even
	# guarded: /usr/data/printer_data aliased NebulaOS's ENTIRE private
	# printer_data tree (config/logs/database/certs/comms/timelapse/misc)
	# under a path this project does not own and that stock and the shared
	# G-code tree also use - S05nebulaos-activate separately, and more
	# carefully, bind-mounts ONLY the genuinely shared
	# /usr/data/printer_data/gcodes into /opt/printer_data/gcodes, and this
	# script's own whole-tree symlink ran first and silently defeated that
	# on any device where it succeeded (see S05nebulaos-activate's own
	# comments on the shared-gcode bind for the current, sole mechanism).
	#
	# CRITICAL, kept here as forensic history rather than deleted outright:
	# real incident, found live testing on this project's actual test
	# device: /usr/data (mmcblk0p10) is the SAME physical partition stock
	# uses, and this device already had a real, previously-installed
	# GuppyScreen there from real prior use (themes, calibration, backups,
	# and a real ~6MB guppyscreen binary). `ln -sf SRC DST` treats an
	# existing DST *directory* as "create the link inside it using SRC's
	# basename" instead of replacing DST - so `ln -sf /opt/guppyscreen
	# /usr/data/guppyscreen` did not create /usr/data/guppyscreen as a
	# symlink (it already existed as a real directory); it silently landed
	# inside it and overwrote the real guppyscreen binary with a symlink to
	# a path that only exists on the custom image, breaking stock's own
	# GuppyScreen outright. Recovered by hand from a real backup the device
	# owner had made. The guard added afterwards (only create if nothing
	# already exists there) prevented a repeat, but "sometimes silently
	# aliases NebulaOS's private tree under a shared path, sometimes
	# silently does nothing and lets NebulaOS state land inside stock's own
	# directory instead" was never actually safe either way - removing the
	# need for the symlink at the source is the real fix.
}

case "$1" in
	start)
		start
		;;
	stop)
		# Runs last in rcK (S01persistent-datastore sorts after every other
		# S01-S99 script in reverse order), after all services are stopped.
		command -v ndf_shutdown >/dev/null 2>&1 && ndf_shutdown
		;;
	*)
		;;
esac
exit 0
