#!/bin/sh
#
# Post-boot, health-gated apply of the live-qualified display configuration
# (/usr/data/nebulaos/display-qualified.conf - see
# /etc/nebulaos-display-qualified.sh for the format, validator, and apply
# logic this script is a thin init.d wrapper around).
#
# SAFETY DEFAULT, stated once here and never violated below: both kernel
# drivers this script can touch already boot in an independently-safe
# state on their own (touch: poll-only, always, regardless of Kconfig -
# CONFIG_TOUCHSCREEN_NS2009_FINAL_QUALIFICATION's own Kconfig text;
# backlight: boot-preserve, zero hardware claims, bootloader's own state
# left untouched - CONFIG_NEBULAOS_BACKLIGHT_FINAL_CONTROLLER's own file
# header). This script only ever ADDS an explicit, qualified transition on
# top of that; if ANYTHING here is uncertain, missing, malformed, or
# fails, the correct action is to do nothing further and let those
# already-safe kernel defaults stand - never a best-guess partial
# application. This script running at all, or being entirely absent, or
# failing outright, must never be able to make the display worse than
# doing nothing.
#
# INIT.D POSITION (S97) AND WHY: this project's own numbering has
# Klipper=S55, Moonraker=S56, GuppyScreen=S58, and two existing terminal
# gates - S95mcu-boot-recovery (bounded one-shot MCU-shutdown recovery)
# and S99confirm-good (the final OTA-marker "was this boot actually good"
# gate, see that script's own header). This script deliberately sits
# BETWEEN those two: after S95 has had its own chance to clear a stuck-MCU
# condition (which would otherwise make this script's own Klipper-health
# poll below wait out its full timeout for nothing), and before S99 so
# that a slow-to-report-healthy boot still gets the same generous,
# independent retry window S99 itself uses, without artificially forcing
# this script to depend on S99's own marker-flip decision (S99's job is
# OTA rollback bookkeeping, a different concern from "is it safe to touch
# the display now" - this script does its own health polling rather than
# reading S99's result, since BusyBox's plain numeric init.d ordering
# (S00-S99, sorted as strings) has no room for a script number after S99
# anyway - "S100" would sort BEFORE "S99" as a string, not after).
#
# HEALTH GATES, in the order the mission spec lists them - reusing this
# project's own established checks rather than reinventing them:
#   - Klipper + Moonraker reachable: /etc/nebulaos-healthcheck.sh's own
#     `stage2` mode (unmodified, invoked exactly as its own "Usage:
#     nebulaos-healthcheck.sh stage2" header documents, never sourced -
#     see ndq_stage2_stack() below for why) - the exact same Moonraker
#     /server/info klippy_state=ready + klippy_connected=true check
#     S99confirm-good and S95mcu-boot-recovery both already rely on.
#   - NebulaScreen running: its own S58nebulascreen PIDFILE
#     (/var/run/nebulascreen.pid), checked the same way S58 itself manages
#     it (start-stop-daemon's pidfile convention) - `kill -0` against the
#     recorded PID.
#   - the display itself: the backlight-final-controller driver's own
#     debugfs status file exists and a read of it actually succeeds (see
#     display_healthy() below) - proves the kernel driver this script is
#     about to issue commands to is really loaded and responding, without
#     attempting to interpret display CONTENT (out of scope, and not
#     meaningful from here anyway).
#   - networking up: a non-loopback interface holding an IPv4 address,
#     via the real iproute2 `ip` binary this image ships (BR2_PACKAGE_IPROUTE2 -
#     see halley5-nebulaos-fragment.config's own comment on why BusyBox's
#     minimal `ip` applet was replaced with the real package). Klipper/
#     Moonraker's own health check above only ever talks to 127.0.0.1 and
#     would pass even with networking fully down, so this is a genuinely
#     separate check, not redundant with the ones above.
#
# Runs at most once per real boot (belt-and-suspenders /run/ marker,
# same pattern S95mcu-boot-recovery already uses - /run/ is tmpfs, so the
# marker cannot itself survive a reboot).

# Library paths are overridable so the offline test suite
# (tests/nebulaos-display-qualified-tests.sh) can exercise this entire
# script, unmodified, against fakes - there is no live init system or
# running kernel to test against from this environment. Every default
# below matches this system's real, established paths exactly.
: "${NDQ_LIB:=/etc/nebulaos-display-qualified.sh}"
: "${NDQ_HEALTHCHECK_LIB:=/etc/nebulaos-healthcheck.sh}"
. "$NDQ_LIB"
# Deliberately NOT sourced (unlike NDQ_LIB above): nebulaos-healthcheck.sh
# ends in its own top-level `case "$1" in ... esac` dispatcher (stage1/
# stage2/stage2-mainsail) that runs unconditionally, including an
# `exit 2` on its own unrecognized-argument path - sourcing it with `.`
# would splice that dispatcher into THIS script's shell, inheriting THIS
# script's own "$1" ("start"/"stop"/"restart"), which does not match any
# of its cases and would exit this whole script with code 2 before
# start() ever ran. Invoking it as the separate process its own "Usage:
# nebulaos-healthcheck.sh stage2" header already documents avoids that
# entirely and is how every other caller of this file is meant to use it.
ndq_stage2_stack() {
	"$NDQ_HEALTHCHECK_LIB" stage2
}

: "${MARKER:=/run/nebulaos-display-qualified-apply-attempted}"
: "${NEBULASCREEN_PIDFILE:=/var/run/nebulascreen.pid}"
: "${HEALTH_RETRIES:=20}"
: "${HEALTH_DELAY:=3}"

log() {
	echo "S97nebulaos-display-qualified-apply: $1"
}

nebulascreen_running() {
	[ -f "$NEBULASCREEN_PIDFILE" ] || return 1
	pid=$(cat "$NEBULASCREEN_PIDFILE" 2>/dev/null)
	[ -n "$pid" ] || return 1
	kill -0 "$pid" 2>/dev/null
}

networking_up() {
	# Any non-loopback interface with an assigned IPv4 address counts as
	# "networking up" - deliberately not a default-route check, since a
	# printer on an isolated LAN segment with no gateway is still a
	# legitimate, healthy "networking up" state for everything this
	# mission cares about (SSH access for the human operator, LAN-only
	# Mainsail/Moonraker access).
	ip -4 -o addr show scope global 2>/dev/null | grep -qv '^$'
}

# "The display" itself, as its own explicit health gate (the mission spec
# lists it alongside Klipper/Moonraker/GuppyScreen/networking) - a cheap,
# meaningful "is the backlight-final-controller driver actually loaded and
# responding" check: the debugfs status file must exist and a read of it
# must actually succeed. Deliberately does NOT try to interpret display
# CONTENT (there is no way to do that from here, and it is not what this
# gate is for) - it only proves the kernel driver this script is about to
# issue commands to is really there, the same spirit as
# ndq_apply_backlight()'s own "not present or not writable" refusal, just
# checked earlier, before any apply is attempted at all.
display_healthy() {
	[ -r "$NDQ_BACKLIGHT_STATUS_FILE" ] || return 1
	cat "$NDQ_BACKLIGHT_STATUS_FILE" >/dev/null 2>&1
}

wait_for_health() {
	i=0
	while [ "$i" -lt "$HEALTH_RETRIES" ]; do
		if ndq_stage2_stack >/dev/null 2>&1 && nebulascreen_running && networking_up && display_healthy; then
			return 0
		fi
		i=$((i + 1))
		sleep "$HEALTH_DELAY"
	done
	return 1
}

start() {
	if [ -f "$MARKER" ]; then
		log "already ran this boot, skipping"
		exit 0
	fi
	touch "$MARKER"

	# S2 (2026-10-05): nothing to apply without a qualification_complete=1
	# configuration - exit before the health wait instead of polling for
	# HEALTH_RETRIES * HEALTH_DELAY (65 s on every boot of every device that
	# has never been display-qualified, live-measured on ke-dev). The
	# qualified path below is unchanged; ndq_apply_all still validates the
	# whole file before touching anything.
	if [ ! -f "$NDQ_CONFIG_FILE" ]; then
		log "no display-qualified configuration ($NDQ_CONFIG_FILE) - nothing to apply"
		exit 0
	fi
	if [ "$(ndq_get_field "$NDQ_CONFIG_FILE" qualification_complete 2>/dev/null)" != "1" ]; then
		log "$NDQ_CONFIG_FILE is not qualification_complete=1 - nothing to apply"
		exit 0
	fi

	if ! wait_for_health; then
		log "printer stack (Klipper/Moonraker), NebulaScreen, networking, or the display itself never confirmed healthy after $((HEALTH_RETRIES * HEALTH_DELAY))s - doing nothing, both drivers remain at their own safe boot defaults"
		exit 0
	fi
	log "health gates passed (Klipper/Moonraker ready, NebulaScreen running, networking up, display driver responding)"

	if ndq_apply_all "$NDQ_CONFIG_FILE"; then
		log "qualified display configuration applied"
		exit 0
	else
		log "qualified display configuration NOT applied (see the reason logged above) - both drivers remain at their own safe boot defaults, this is the correct, safe outcome"
		exit 0
	fi
}

case "$1" in
	start)
		start
		;;
	stop)
		: # nothing to stop - this script performs a one-shot apply, not a daemon
		;;
	restart)
		start
		;;
	*)
		echo "Usage: $0 {start|stop|restart}"
		exit 1
		;;
esac

exit 0
