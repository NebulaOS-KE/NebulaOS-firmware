#!/bin/sh
#
# NebulaOS mutable-runtime mission, Phase 8: launches the update-rollback
# supervisor (/etc/nebulaos-update-supervisor.sh) as a persistent background
# poller. Must start after S55klipper/S56moonraker/S58guppyscreen - it
# queries Moonraker's HTTP API and needs the real service topology (and any
# already-bind-mounted persistent apps from S05) to be up first, and its own
# restart actions target those same services.
#
# NebulaOS Memory Resilience Gate: this is an update/maintenance-class
# helper, the most expendable class in the project's own OOM priority
# table (docs/NEBULAOS_MEMORY_RESILIENCE.md sec 3.3) - 500, same as the
# factory-seed shell.

SUPERVISOR=/etc/nebulaos-update-supervisor.sh
PIDFILE=/var/run/nebulaos-update-supervisor.pid

# OOM priority policy (MEM-T07); without it, services still start, unadjusted.
NEBULAOS_OOM_POLICY="${NEBULAOS_OOM_POLICY:-/etc/nebulaos-oom-policy.sh}"
if [ -r "$NEBULAOS_OOM_POLICY" ]; then . "$NEBULAOS_OOM_POLICY"; else nebulaos_start_with_adj() { shift; "$@"; }; fi

start() {
	echo "Starting nebulaos-update-supervisor"
	# OOM priority at birth (MEM-T07): update work is expendable.
	nebulaos_start_with_adj "$NEBULAOS_ADJ_UPDATE_SUPERVISOR" \
		start-stop-daemon -S -b -m -p "$PIDFILE" -N 15 \
		-x /bin/sh -- "$SUPERVISOR" loop
}

stop() {
	echo "Stopping nebulaos-update-supervisor"
	start-stop-daemon -K -p "$PIDFILE" && rm -f "$PIDFILE"
}

case "$1" in
	start)
		start
		;;
	stop)
		stop
		;;
	restart)
		stop
		start
		;;
	*)
		echo "Usage: $0 {start|stop|restart}"
		exit 1
		;;
esac

exit 0
