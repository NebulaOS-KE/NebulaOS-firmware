#!/bin/sh
#
# Boot health check (FIRMWARE.md sec 21/22). Runs last (S99), well after
# klipper/moonraker/guppyscreen/nginx have been started by their own S5x
# scripts. Polls Moonraker's HTTP API for real Klipper readiness rather
# than assuming "started" means "healthy."
#
# USB/webcam+MCU-recovery mission (2026-07-26): the original version of
# this check only confirmed that /server/info returned *some* "result" -
# true the instant Moonraker's HTTP listener is up, regardless of whether
# Klipper ever actually connected to the real MCU. A real, found-live gap:
# this would have happily flipped the marker forward on a boot where the
# MCU was stuck in its own shutdown state (see S95mcu-boot-recovery),
# since Moonraker itself was always healthy in that case - only Klipper's
# own connection to the *printer* was not. /server/info's own
# "klippy_state" field is Moonraker's real, live answer to "is Klipper
# actually ready," confirmed live (returns "ready" only once Klipper has
# loaded config and connected the MCU) - checking that instead is a
# strictly more correct version of the exact same intent this script
# always had.
#
# PHASE 1.8B CHANGE: this script NO LONGER writes the OTA marker on any
# path (success or failure). The marker stays on "ota:kernel2" (NebulaOS)
# regardless. The automatic stock fallback was removed because booting the
# stock Creality slot auto-flashes the MCU with old Creality firmware,
# destroying the qualified native GD32F303 MCU build. If Klipper fails to
# reach "ready", the device stays on NebulaOS and requires MANUAL recovery
# (see docs/DEVELOPER_RECOVERY.md).
#
# The health check is retained for its diagnostic value: the log messages
# tell you whether Klipper came up healthy, which is critical information
# for debugging a boot that "worked" but left the printer non-functional.
#
# wget here is BusyBox's applet (no full wget/curl in this rootfs) - confirmed
# CONFIG_FEATURE_WGET_LONG_OPTIONS + CONFIG_FEATURE_WGET_TIMEOUT are both
# enabled in this build, and this is plain local HTTP (no TLS involved), so
# the HTTPS-support gap that bit an earlier fetch in this project doesn't
# apply here.

. /etc/ota_marker.sh

RETRIES=30
DELAY=5

check_moonraker() {
	state=$(wget -q -O - --timeout=3 "http://127.0.0.1:7125/server/info" 2>/dev/null | \
		sed -n 's/.*"klippy_state":"\([^"]*\)".*/\1/p')
	[ "$state" = "ready" ]
}

# G103 P4 (Run 21): diagnostic only (it writes nothing), so it waits in the
# background and the boot finishes without waiting for Klippy.
# NEBULAOS_CONFIRM_GOOD_FOREGROUND=1 keeps the old order (tests).
confirm() {
	i=0
	while [ "$i" -lt "$RETRIES" ]; do
		if check_moonraker; then
			echo "S99confirm-good: Moonraker confirmed healthy (klippy_state=ready). OTA marker unchanged (stays on NebulaOS)."
			return 0
		fi
		i=$((i + 1))
		sleep "$DELAY"
	done
	echo "S99confirm-good: WARNING - Moonraker never confirmed healthy after $((RETRIES * DELAY))s. OTA marker unchanged (stays on NebulaOS). Manual recovery required if printer is non-functional. See docs/DEVELOPER_RECOVERY.md" 1>&2
	return 1
}

case "$1" in
	start)
		if [ "${NEBULAOS_CONFIRM_GOOD_FOREGROUND:-0}" = 1 ]; then
			confirm
			exit $?
		fi
		confirm &
		;;
	*)
		;;
esac
exit 0
