#!/bin/sh
#
# NebulaOS production optimization mission, Phase 5 (2026-07-30): persist
# Dropbear's SSH host keys across ordinary reboots. Buildroot's stock
# S50dropbear always passes -R (create hostkeys as required) and, with no
# -r override, dropbear falls back to its compiled-in defaults under
# /etc/dropbear - which lives on this project's read-only squashfs, so a
# fresh host key was silently generated on every single boot until now
# (the exact "REMOTE HOST IDENTIFICATION HAS CHANGED" warning seen after
# every reboot in this project's own live-testing sessions - see
# reference_device_access notes). Fixed here by pointing dropbear's -r
# host-key paths at $NEBULAOS_ROOT/system/dropbear (persistent ext4,
# bind-mounted well before this script runs) via /etc/default/dropbear,
# which S50dropbear already sources if present - no change to S50dropbear
# itself needed.
#
# Must run after S02nebulaos-namespace (needs $NEBULAOS_ROOT/system to
# exist) and before S50dropbear. /etc/default/dropbear is baked into the
# overlay as a symlink to /var/run/dropbear.conf (tmpfs, writable, fresh
# every boot) - this script is what actually populates that file; if it
# never runs (or fails before writing), /etc/default/dropbear's target
# simply won't exist yet, `test -r` in S50dropbear fails silently, and
# dropbear falls back to exactly its original ephemeral-per-boot behavior -
# a safe, already-proven fallback, not a new failure mode.

NEBULAOS_ROOT="${NEBULAOS_ROOT:-/usr/data/nebulaos}"
PERSISTENT_KEY_DIR="$NEBULAOS_ROOT/system/dropbear"
FALLBACK_KEY_DIR="${NEBULAOS_DROPBEAR_FALLBACK_DIR:-/var/run/nebulaos-dropbear-fallback}"
DROPBEAR_ENV_FILE="${NEBULAOS_DROPBEAR_ENV_FILE:-/var/run/dropbear.conf}"
# G77 (Run 12, 2026-10-18): dropbear reads its host keys from copies in RAM.
# It re-reads them per connection, and with -R it makes a NEW key when the
# file is gone - on ke-dev a supervised repair unmounted /usr/data and every
# later connection showed another host key (refused by pinned clients).
RUN_KEY_DIR="${NEBULAOS_DROPBEAR_RUN_DIR:-/var/run/nebulaos-dropbear-keys}"

log() {
	echo "S46nebulaos-dropbear-keys: $1"
}

# Never exposed through nginx or Moonraker either way: nginx only reverse-
# proxies specific Moonraker/webcam paths, and Moonraker's file_manager only
# ever registers config/logs/gcodes/config_examples/docs - $NEBULAOS_ROOT/
# system was never reachable through either.
persistent_storage_writable() {
	[ -d "$NEBULAOS_ROOT/system" ] || return 1
	probe="$NEBULAOS_ROOT/system/.dropbear-write-probe"
	( : > "$probe" ) 2>/dev/null || return 1
	rm -f "$probe" 2>/dev/null
	return 0
}

# dropbear's own "-R" (create hostkeys as required) does NOT persist a key
# to a custom -r path on this BR2_PACKAGE_DROPBEAR_SMALL build - confirmed
# live: pointing a second dropbear instance at -r <nonexistent file> -R
# completed a real SSH handshake but never wrote anything to that path,
# with or without an actual client connection. dropbearkey itself does
# write real, persistent key files - generate explicitly here instead of
# relying on -R for anything beyond its own compiled-in default paths
# (still harmless/unused, since we always pass an explicit -r for both
# types we manage).
ensure_key() {
	type="$1"
	path="$2"
	[ -s "$path" ] && return 0
	dropbearkey -t "$type" -f "$path" >/dev/null 2>&1
}

# 2026-10-15 (ke-dev did not boot, the data partition never mounted
# read-write): the device's own keys are what the Hardware Agent pins
# (strict, no TOFU), so a boot with broken storage must still present them.
# Keys that are readable but not writable (data partition mounted read-only)
# are used in place. With no data partition mounted at all, they are copied
# from a short read-only mount into the boot-local directory.
DATA_DEV="${NEBULAOS_DATA_DEV:-/dev/mmcblk0p10}"
KEYS_RO_MNT="${NEBULAOS_KEYS_RO_MNT:-/run/nebulaos/keys-ro}"
MOUNT_CMD="${NEBULAOS_MOUNT:-mount}"
UMOUNT_CMD="${NEBULAOS_UMOUNT:-umount}"

persistent_keys_readable() {
	[ -s "$PERSISTENT_KEY_DIR/dropbear_rsa_host_key" ] || [ -s "$PERSISTENT_KEY_DIR/dropbear_ed25519_host_key" ]
}

copy_keys_from_data_partition() {
	mkdir -p "$KEYS_RO_MNT" "$FALLBACK_KEY_DIR" 2>/dev/null || return 1
	chmod 700 "$FALLBACK_KEY_DIR" 2>/dev/null
	"$MOUNT_CMD" -t ext4 -o ro "$DATA_DEV" "$KEYS_RO_MNT" 2>/dev/null || return 1
	_src="$KEYS_RO_MNT/nebulaos/system/dropbear"
	_ok=1
	for _k in dropbear_rsa_host_key dropbear_ed25519_host_key; do
		[ -s "$_src/$_k" ] && cp "$_src/$_k" "$FALLBACK_KEY_DIR/$_k" 2>/dev/null && chmod 600 "$FALLBACK_KEY_DIR/$_k" && _ok=0
	done
	"$UMOUNT_CMD" "$KEYS_RO_MNT" 2>/dev/null
	return $_ok
}

start() {
	if persistent_storage_writable; then
		key_dir="$PERSISTENT_KEY_DIR"
		log "using persistent host keys at $key_dir"
	elif persistent_keys_readable; then
		key_dir="$PERSISTENT_KEY_DIR"
		log "persistent storage is read-only - using the device's host keys in place at $key_dir"
		write_env "$key_dir"
		return 0
	elif copy_keys_from_data_partition; then
		key_dir="$FALLBACK_KEY_DIR"
		log "data partition not mounted - copied the device's host keys from a read-only mount of $DATA_DEV"
	else
		key_dir="$FALLBACK_KEY_DIR"
		log "persistent storage unavailable - falling back to boot-local host keys at $key_dir (new keys will be generated this boot)"
	fi

	if ! mkdir -p "$key_dir" 2>/dev/null; then
		log "ERROR: could not create $key_dir - leaving /etc/default/dropbear unpopulated, dropbear will use its own compiled-in ephemeral defaults"
		return 0
	fi
	chmod 700 "$key_dir" 2>/dev/null

	ensure_key rsa "$key_dir/dropbear_rsa_host_key" || log "WARNING: rsa host key generation failed at $key_dir"
	ensure_key ed25519 "$key_dir/dropbear_ed25519_host_key" || log "WARNING: ed25519 host key generation failed at $key_dir"

	if [ ! -s "$key_dir/dropbear_rsa_host_key" ] && [ ! -s "$key_dir/dropbear_ed25519_host_key" ]; then
		log "ERROR: no host key could be generated at $key_dir - leaving /etc/default/dropbear unpopulated, dropbear will use its own compiled-in ephemeral defaults"
		return 0
	fi

	write_env "$key_dir"
}

write_env() {
	_args=
	_dir="$1"
	if mkdir -p "$RUN_KEY_DIR" 2>/dev/null && chmod 700 "$RUN_KEY_DIR" 2>/dev/null; then
		for _k in dropbear_rsa_host_key dropbear_ed25519_host_key; do
			[ -s "$1/$_k" ] || continue
			cp "$1/$_k" "$RUN_KEY_DIR/$_k.tmp" 2>/dev/null && chmod 600 "$RUN_KEY_DIR/$_k.tmp" \
				&& mv -f "$RUN_KEY_DIR/$_k.tmp" "$RUN_KEY_DIR/$_k" || { _dir="$1"; break; }
			_dir="$RUN_KEY_DIR"
		done
	fi
	for _k in dropbear_rsa_host_key dropbear_ed25519_host_key; do
		[ -s "$_dir/$_k" ] && _args="$_args -r $_dir/$_k"
	done
	cat > "$DROPBEAR_ENV_FILE" <<EOF
DROPBEAR_ARGS="${_args# }"
EOF
}

case "$1" in
	start)
		start
		;;
	*)
		;;
esac
exit 0
