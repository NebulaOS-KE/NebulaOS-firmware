#!/bin/sh
#
# NebulaOS camera idle-pause qualification controller (C2, pre-
# qualification mission Phase A7, 2026-07-31). See /etc/nebulaos-camera-
# idle-controller.sh's own header for the full design rationale.
#
# Numbered S51 - right after S50webcam (which this depends on being
# already started) and well before S55klipper/S56moonraker, so this
# controller is up before either application stack. C2 is the default
# (CAM-04); a C0 marker makes its start a true no-op. It never delays or
# blocks anything after it either way.
#
# Deliberately a completely separate process/supervisor from S50webcam's
# own - a crash or bug in this experimental controller can never affect
# S50webcam's already-hardware-proven ustreamer crash recovery, since this
# script only ever calls ustreamer's existing local /pause and /resume
# HTTP endpoints, never touches the ustreamer process itself.

PIDFILE=/var/run/nebulaos-camera-idle-controller.pid

[ -f /etc/nebulaos-camera-idle-controller.sh ] && . /etc/nebulaos-camera-idle-controller.sh

start() {
	if ! command -v nebulaos_camera_idle_requested_mode >/dev/null 2>&1; then
		echo "S51nebulaos-camera-idle-controller: /etc/nebulaos-camera-idle-controller.sh not available, skipping"
		return 0
	fi
	mode=$(nebulaos_camera_idle_requested_mode)
	if [ "$mode" != "C2" ]; then
		echo "S51nebulaos-camera-idle-controller: C0 requested by marker, not starting (camera stays always-active)"
		return 0
	fi
	if ! command -v curl >/dev/null 2>&1; then
		echo "S51nebulaos-camera-idle-controller: curl not available, cannot safely control ustreamer - not starting" >&2
		return 0
	fi
	echo "Starting S51nebulaos-camera-idle-controller (C2 idle-pause mode)"
	start-stop-daemon -S -b -m -p "$PIDFILE" -x /bin/sh -- "$0" __run
}

stop() {
	echo "Stopping S51nebulaos-camera-idle-controller"
	start-stop-daemon -K -p "$PIDFILE" 2>/dev/null
	rm -f "$PIDFILE"
	# Always try to resume on the way out, so stopping this controller
	# (or a production disable via marker removal) never leaves the
	# camera stuck paused.
	command -v nebulaos_camera_resume_with_retry >/dev/null 2>&1 && nebulaos_camera_resume_with_retry >/dev/null 2>&1
	:
}

case "$1" in
	start)
		start
		;;
	stop)
		stop
		;;
	restart)
		stop
		start
		;;
	__run)
		# Internal re-exec target for start-stop-daemon above - not a
		# public command.
		nebulaos_camera_idle_run_loop
		;;
	*)
		echo "Usage: $0 {start|stop|restart}"
		exit 1
		;;
esac

exit 0
