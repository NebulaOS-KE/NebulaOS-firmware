#!/bin/sh
#
# NebulaOS git wrapper (MEM-T08). First on Moonraker's PATH (S56moonraker), so
# update_manager's git runs through it; nothing else uses this directory.
#   - every git it runs starts at oom_score_adj 800: index-pack is the heaviest
#     transient on this system and must be the first OOM victim;
#   - while a print is active, a network fetch is a no-op success (the repo
#     stays valid with its last known refs) and pull/clone are refused;
#   - under memory pressure (memguard P1+) fetch/pull/clone are refused;
#   - G91 step 7 (design v2.4/v3.4): every repo-changing command (pull, clone,
#     checkout, reset, merge, rebase, clean) asks the shared busy check under
#     the `git` profile (printing, paused, heating/moving, calibrating, an
#     image/MCU job, low memory, a live Klippy whose state cannot be read; not
#     Moonraker's own update) and is refused while busy: the reason on stderr
#     (Moonraker shows it in the update dialog for pull/clone), in syslog, and
#     as a "!! NebulaOS refused: ..." line in Mainsail's console. This covers
#     /machine/update/full and paused prints, which Moonraker does not check.
#     G107: the console line at most once per minute per reason (below).
#     fetch only downloads: it stays a no-op under a print, as before.
# /usr/bin/git itself is untouched.

NEBULAOS_GIT_REAL="${NEBULAOS_GIT_REAL:-/usr/bin/git}"
NEBULAOS_RUN_DIR="${NEBULAOS_RUN_DIR:-/run/nebulaos}"
NEBULAOS_BUSY_CLI="${NEBULAOS_BUSY_CLI:-/usr/libexec/nebulaos/nebulaos-busy}"
NB_MOONRAKER="${NB_MOONRAKER:-http://127.0.0.1:7125}"

# G107 (Run 19): ONE visible refusal per update attempt. Moonraker runs
# several git commands per update and retries a refused one; every command is
# still refused (stderr for Moonraker's dialog, syslog), but the console line
# (notify_refused -> "!! NebulaOS refused: ..." in Mainsail, and the screen's
# popup that follows it) goes out at most once per NB_NOTIFY_WINDOW seconds
# per reason. The last notify time per reason lives in a small tmpfs file.
NB_NOTIFY_WINDOW="${NB_NOTIFY_WINDOW:-60}"
notify_due() { # KEY - true (and stamped) when no notify for KEY in the window
	_nd_dir="$NEBULAOS_RUN_DIR/refusal-notify"
	_nd_file="$_nd_dir/$1"
	_nd_now=$(date +%s 2>/dev/null) || return 0
	_nd_last=$(cat "$_nd_file" 2>/dev/null)
	case "$_nd_last" in '' | *[!0-9]*) _nd_last=0 ;; esac
	# a clock that went backwards never silences notifies
	if [ "$_nd_last" -le "$_nd_now" ] && [ $((_nd_now - _nd_last)) -lt "$NB_NOTIFY_WINDOW" ]; then
		return 1
	fi
	mkdir -p "$_nd_dir" 2>/dev/null
	echo "$_nd_now" > "$_nd_file.$$" 2>/dev/null && mv -f "$_nd_file.$$" "$_nd_file" 2>/dev/null
	return 0
}

# The reason code a refusal text ends with: "... (PAUSED)" -> PAUSED.
reason_key() { # TEXT
	_rk=${1##*(}
	_rk=${_rk%)}
	case "$_rk" in '' | *[!A-Z0-9_]*) _rk=OTHER ;; esac
	echo "$_rk"
}

refuse() { # SUB TEXT
	echo "NebulaOS refused: git $1 - $2" >&2
	logger -t nebulaos-git "refused: git $1 - $2" 2>/dev/null
	if notify_due "git-$(reason_key "$2")"; then
		wget -q -T 1 -O /dev/null --header "Content-Type: application/json" \
			--post-data "{\"message\": \"update (git $1) - $2\"}" \
			"$NB_MOONRAKER/machine/nebulaos/system/notify_refused" </dev/null >/dev/null 2>&1
	fi
	exit 1
}

echo 800 > /proc/self/oom_score_adj 2>/dev/null

# The subcommand is the first argument that is not an option or the value of a
# global option that takes one (git -C <path> -c <k=v> fetch ...).
sub=""
skip=""
for a in "$@"; do
	if [ -n "$skip" ]; then
		skip=""
		continue
	fi
	case "$a" in
	-C | -c | --git-dir | --work-tree | --namespace | --super-prefix | --config-env) skip=1 ;;
	-*) ;;
	*) sub="$a"; break ;;
	esac
done

case "$sub" in
fetch | pull | clone | checkout | reset | merge | rebase | clean)
	if [ -e "$NEBULAOS_RUN_DIR/print-active" ]; then
		if [ "$sub" = fetch ]; then
			logger -t nebulaos-git "print active: fetch skipped (no-op success): $*" 2>/dev/null
			exit 0
		fi
		refuse "$sub" "Not possible while a print is running. (PRINTING)"
	fi
	if [ -e "$NEBULAOS_RUN_DIR/memguard/deny-maintenance" ]; then
		refuse "$sub" "Not possible right now: the printer is low on memory. (LOW_MEMORY)"
	fi
	[ "$sub" = fetch ] && exec "$NEBULAOS_GIT_REAL" "$@"
	if [ -x "$NEBULAOS_BUSY_CLI" ]; then
		_why=$("$NEBULAOS_BUSY_CLI" --profile git --refuse 2>&1 >/dev/null)
		[ $? = 3 ] && refuse "$sub" "${_why#NebulaOS refused: }"
	fi
	;;
esac
exec "$NEBULAOS_GIT_REAL" "$@"
