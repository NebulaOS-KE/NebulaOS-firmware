#!/bin/sh
#
# nebulaos-boot-display - userspace boot display (GUI/service readiness
# mission, 2026-10-09). Shell only: Python never runs on the boot path.
#
#   boot     S01splash: show the configured mode (logo | blank)
#
# The "console" mode (a text boot log on the LCD) was removed (D10,
# 2026-10-11): once the framebuffer console had taken over the display,
# GuppyScreen's start deadlocked in the kernel. A saved "console" shows the
# logo. The kernel no longer has a framebuffer console at all.
#
# Every step is best effort and bounded; any doubt means "do nothing" and the
# screen stays as the boot loader left it. The backlight is never touched here (the
# display-qualification/backlight layer owns it).

NBD_BOOT_DIR="${NBD_BOOT_DIR:-/usr/data/nebulaos/boot}"
NBD_ENV="${NBD_ENV:-$NBD_BOOT_DIR/display.env}"
NBD_RAW="${NBD_RAW:-$NBD_BOOT_DIR/cache/splash.raw}"
NBD_META="${NBD_META:-$NBD_BOOT_DIR/cache/splash.meta}"
NBD_FB="${NBD_FB:-/dev/fb0}"
NBD_FB_SYSFS="${NBD_FB_SYSFS:-/sys/class/graphics/fb0}"
NBD_RENDER_DELAY="${NBD_RENDER_DELAY:-120}"
NBD_OSCONFIG="${NBD_OSCONFIG:-/usr/libexec/nebulaos/nebulaos-osconfig}"

nbd_log() {
	echo "nebulaos-boot-display: $*"
	command -v logger >/dev/null 2>&1 && logger -t nebulaos-boot-display -- "$*" 2>/dev/null
	return 0
}

nbd_mode() {
	_m=$(sed -n 's/^MODE="\{0,1\}\([a-z]*\)"\{0,1\}$/\1/p' "$NBD_ENV" 2>/dev/null | head -n1)
	case "$_m" in
		logo|blank) echo "$_m" ;;
		*) echo logo ;;
	esac
}

nbd_meta() {
	sed -n "s/^$1=\"\{0,1\}\([^\"]*\)\"\{0,1\}\$/\1/p" "$NBD_META" 2>/dev/null | head -n1
}

nbd_is_uint() {
	case "$1" in ''|*[!0-9]*) return 1 ;; esac
	return 0
}

# Live geometry: XRES YRES BPP STRIDE YOFF, or nothing.
nbd_geometry() {
	_vs=$(cat "$NBD_FB_SYSFS/virtual_size" 2>/dev/null)
	_bpp=$(cat "$NBD_FB_SYSFS/bits_per_pixel" 2>/dev/null)
	_stride=$(cat "$NBD_FB_SYSFS/stride" 2>/dev/null)
	_pan=$(cat "$NBD_FB_SYSFS/pan" 2>/dev/null)
	_yoff=${_pan#*,}
	nbd_is_uint "$_bpp" && nbd_is_uint "$_stride" && nbd_is_uint "$_yoff" || return 1
	case "$_vs" in *,*) ;; *) return 1 ;; esac
	nbd_is_uint "${_vs%,*}" || return 1
	echo "$_bpp $_stride $_yoff"
}

nbd_logo() {
	[ -f "$NBD_RAW" ] && [ -f "$NBD_META" ] || { nbd_log "logo: no rendered image yet - nothing drawn"; return 0; }
	_g=$(nbd_geometry) || { nbd_log "logo: framebuffer geometry unreadable - nothing drawn"; return 0; }
	# shellcheck disable=SC2086
	set -- $_g
	_bpp=$1; _stride=$2; _yoff=$3
	_yres=$(nbd_meta YRES)
	_size=$(nbd_meta SIZE)
	nbd_is_uint "$_yres" && nbd_is_uint "$_size" || { nbd_log "logo: render metadata malformed - nothing drawn"; return 0; }
	if [ "$(nbd_meta BPP)" != "$_bpp" ] || [ "$(nbd_meta STRIDE)" != "$_stride" ]; then
		nbd_log "logo: render geometry differs from the framebuffer - nothing drawn (re-rendered later)"
		return 0
	fi
	_actual=$(wc -c < "$NBD_RAW" 2>/dev/null)
	if [ "$_actual" != "$_size" ] || [ "$_size" -ne $((_stride * _yres)) ]; then
		nbd_log "logo: rendered image size mismatch - nothing drawn"
		return 0
	fi
	dd if="$NBD_RAW" of="$NBD_FB" bs="$_stride" seek="$_yoff" count="$_yres" conv=notrunc 2>/dev/null \
		&& nbd_log "logo: $(nbd_meta KIND) image shown" \
		|| nbd_log "logo: framebuffer write failed"
}

nbd_blank() {
	_g=$(nbd_geometry) || return 0
	# shellcheck disable=SC2086
	set -- $_g
	# Clear every buffer of the virtual framebuffer (virtual_size rows x
	# stride): correct whichever one is displayed, and needs no visible-mode
	# height - sysfs "mode" is empty on the KE panel (hardware acceptance,
	# 2026-10-09), which left blank mode doing nothing.
	_vs=$(cat "$NBD_FB_SYSFS/virtual_size" 2>/dev/null)
	_vy=${_vs#*,}
	nbd_is_uint "$_vy" && [ "$_vy" -gt 0 ] || return 0
	dd if=/dev/zero of="$NBD_FB" bs="$2" count="$_vy" conv=notrunc 2>/dev/null \
		&& nbd_log "blank: screen cleared"
}

case "${1:-}" in
	boot)
		case "$(nbd_mode)" in
			logo) nbd_logo ;;
			blank) nbd_blank ;;
		esac
		# Refresh a missing/stale render long after boot, at the lowest priority.
		if [ -x "$NBD_OSCONFIG" ]; then
			( sleep "$NBD_RENDER_DELAY"; nice -n 19 "$NBD_OSCONFIG" boot-display render --if-stale ) \
				>/dev/null 2>&1 &
		fi
		exit 0 ;;
esac
echo "usage: nebulaos-boot-display boot" >&2
exit 64
