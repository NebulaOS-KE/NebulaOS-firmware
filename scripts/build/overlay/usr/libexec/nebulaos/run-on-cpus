#!/usr/bin/python3
# run-on-cpus SETTING_FILE STATE_FILE PROGRAM [ARGS...]
#
# #27 (2026-11-21, test build 2): start PROGRAM pinned to a set of CPUs, then
# exec it (same pid, same executable), so every thread it creates later
# (klippy's serialqueue/steppersync C threads) inherits the set.
#
# Why klippy: with interrupt migration off (kernel 778154d) every device
# interrupt - USB camera, SDIO Wi-Fi, eMMC - is handled on CPU0. A klippy that
# lands on CPU0 under load stalls (WizardKnight: "Timer too close" twice in
# 5 prints). CPU1 only takes timer/IPI interrupts.
#
# SETTING_FILE holds a CPU list ("1", "0-1", "1,0") or "none" (no pinning;
# the A/B switch). Missing or empty means the default, "1". Anything wrong
# (bad list, CPU not present, setaffinity failing) never stops the program:
# it then starts unpinned and STATE_FILE says why.
import os
import sys

DEFAULT = "1"


def parse(text):
    cpus = set()
    for part in text.split(","):
        part = part.strip()
        if not part:
            continue
        lo, sep, hi = part.partition("-")
        lo = int(lo)
        hi = int(hi) if sep else lo
        if lo < 0 or hi < lo or hi > 63:
            raise ValueError(part)
        cpus.update(range(lo, hi + 1))
    if not cpus:
        raise ValueError(text)
    return cpus


def decide(setting_path):
    """(cpu set or None, state line)."""
    try:
        with open(setting_path) as handle:
            text = handle.read().strip()
    except OSError:
        text = ""
    text = text or DEFAULT
    if text == "none":
        return None, "requested=none applied=none"
    try:
        want = parse(text)
    except ValueError:
        return None, "requested=%s applied=none error=bad-setting" % text
    have = os.sched_getaffinity(0)
    if not want <= have:
        return None, "requested=%s applied=none error=cpu-not-present" % text
    return want, "requested=%s" % text


def main(argv):
    if len(argv) < 4:
        sys.stderr.write("usage: run-on-cpus SETTING_FILE STATE_FILE PROGRAM [ARGS...]\n")
        return 64
    setting, state, prog = argv[1], argv[2], argv[3:]
    cpus, line = decide(setting)
    if cpus is not None:
        try:
            os.sched_setaffinity(0, cpus)
            line += " applied=%s" % ",".join(str(c) for c in sorted(os.sched_getaffinity(0)))
        except OSError as exc:
            line += " applied=none error=%s" % exc.__class__.__name__
    try:
        os.makedirs(os.path.dirname(state), exist_ok=True)
        with open(state, "w") as handle:
            handle.write(line + "\n")
    except OSError:
        pass
    os.execv(prog[0], prog)


if __name__ == "__main__":
    sys.exit(main(sys.argv))
