#!/bin/sh
#
# nebulaos-backlight - CLI over /etc/nebulaos-backlight.sh (GUI/service
# readiness mission, 2026-10-09). Called by nebulaos-osconfig's display domain
# with argv only. See the library header for ownership and safety rules.
#
#   status | set <25|50|75|100> | sleep | wake | restore
#
# Exit codes follow the library: 0 ok, 1 invalid, 2 failed, 3 off (set: level
# stored, applied on wake), 4 sleep refused (no touch-wake path).

NBL_LIB="${NBL_LIB:-/etc/nebulaos-backlight.sh}"
. "$NBL_LIB" || exit 2

case "${1:-}" in
	status)
		nbl_status_kv
		exit 0 ;;
	set)
		nbl_set_level "${2:-}"
		exit $? ;;
	sleep)
		nbl_sleep
		exit $? ;;
	wake)
		nbl_wake
		exit $? ;;
	restore)
		nbl_boot_restore
		exit $? ;;
esac
echo "usage: nebulaos-backlight status|set <25|50|75|100>|sleep|wake|restore" >&2
exit 64
