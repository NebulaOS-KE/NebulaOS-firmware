#!/bin/sh
#
# nebulaos-memguard - bounded memory-pressure supervisor (MEM-T12).
#
# Keeps the printer-critical processes (klipper_mcu, klippy) away from the
# kernel OOM killer: optional work is refused or shed first, and the global
# OOM killer is the last resort, not the control mechanism.
#
# This file is the core: it tracks memory state and print/maintenance state,
# publishes markers under /run/nebulaos for other components, enforces the OOM
# priority table (/etc/nebulaos-oom-policy.sh) every 5 s as a backstop to the
# birth-time values, and logs. klippy and klipper_mcu are never acted on.
#
# BusyBox ash. /proc and /sys files are read with the `read` builtin, so the
# 1 s tick forks nothing; only the 5 s Moonraker queries fork (wget).
#
# Signals (1 s tick unless noted):
#   MA      MemAvailable, kB                         /proc/meminfo
#   ZU ZL   zram mem_used_total, mem_limit, bytes    /sys/block/zram0/mm_stat 3,4
#   SOME10 FULL10  PSI memory avg10 (integer %; 0 without CONFIG_PSI)
#   PRINT   Moonraker print_stats.state printing|paused (5 s; a failed query
#           keeps the previous value - a dead Moonraker never reads "idle")
#   MAINT   update lock present, or Moonraker update_manager busy (5 s)
#
# Markers (/run/nebulaos):
#   print-active, maintenance-active, memguard/state
#
# Test seam: NEBULAOS_MEMGUARD_NO_AUTORUN=1 sources the functions without
# running; MG_PROC/MG_SYS/MG_RUN/MG_LOCKS/MG_LOG redirect every path.

MG_PROC="${MG_PROC:-/proc}"
MG_SYS="${MG_SYS:-/sys}"
MG_RUN="${MG_RUN:-/run/nebulaos}"
MG_PIDDIR="${MG_PIDDIR:-/var/run}"
MG_LOCKS="${MG_LOCKS:-/usr/data/nebulaos/updates/locks}"
MG_LOG="${MG_LOG:-/usr/data/nebulaos/logs/memguard.log}"
MG_LOG_MAX=262144
MG_MOONRAKER="${MG_MOONRAKER:-http://127.0.0.1:7125}"
MG_TICK="${MG_TICK:-1}"
MG_SLOW_EVERY=5
MG_SNAPSHOT_EVERY=60
MG_MCU_RSS_ALERT_KB=8192
MG_LOCKED_ALERT_KB=65536
MG_LOCKED_REARM_KB=8192

# MEM-T14: pressure levels. Thresholds in MiB of MemAvailable; HWDP-MEM-8
# recalibrates them without code edits. MG_ACTIONS=0 is tracker-only mode.
MG_ACTIONS="${MG_ACTIONS:-1}"
MG_P1_ENTER_MB=56 MG_P1_EXIT_MB=72
MG_P2_ENTER_MB=40 MG_P2_EXIT_MB=56
MG_P3_ENTER_MB=30 MG_P3_EXIT_MB=46
MG_P4_ENTER_MB=22 MG_P4_EXIT_MB=38
MG_ESCALATE_SPACING=10
MG_EXIT_DWELL=60
MG_P4_EXHAUSTED_AFTER=120
MG_MOONRAKER_RESTART_RSS_KB=65536
MG_MOONRAKER_RESTART_SPACING=1800
MG_S56="${MG_S56:-/etc/init.d/S56moonraker}"
MG_S58="${MG_S58:-/etc/init.d/S58guppyscreen}"

# MEM-T13: the eMMC swapfile (S03nebulaos-diskswap) is a maintenance-only tier.
# maintenance (default): on only while MAINT=1, off in IDLE and PRINTING.
# always: today's behaviour (the tier stays on) - the rollback setting.
MG_DISKSWAP_POLICY="${MG_DISKSWAP_POLICY:-maintenance}"
MG_SWAPFILE="${MG_SWAPFILE:-/usr/data/nebulaos/system/swapfile}"
MG_SWAP_PRIORITY=10
MG_SWAPOFF_TIMEOUT=120
MG_SWAPOFF_COOLDOWN=600
MG_SWAPON="${MG_SWAPON:-swapon}"
MG_SWAPOFF="${MG_SWAPOFF:-swapoff}"

NEBULAOS_OOM_POLICY="${NEBULAOS_OOM_POLICY:-/etc/nebulaos-oom-policy.sh}"
# shellcheck disable=SC1090
[ -r "$NEBULAOS_OOM_POLICY" ] && . "$NEBULAOS_OOM_POLICY"

MA=0 ZU=0 ZL=0 SOME10=0 FULL10=0 PRINT=0 MAINT=0 STATE=NORMAL NOW=0
LEVEL=0 ENTER_CNT=0 EXIT_SINCE= LAST_ESCALATE=-1000 P4_SINCE= EXHAUSTED_LOGGED=0

mg_log() {
	_line="$(date '+%Y-%m-%d %H:%M:%S' 2>/dev/null) $*"
	logger -t memguard "$*" 2>/dev/null
	[ -n "$MG_LOG" ] || return 0
	if [ ! -d "${MG_LOG%/*}" ]; then
		mkdir -p "${MG_LOG%/*}" 2>/dev/null || return 0
	fi
	echo "$_line" >> "$MG_LOG" 2>/dev/null || return 0
	_sz=$(wc -c < "$MG_LOG" 2>/dev/null)
	[ "${_sz:-0}" -gt "$MG_LOG_MAX" ] && mv -f "$MG_LOG" "$MG_LOG.1" 2>/dev/null
	return 0
}

mg_now() {
	read -r _up _ < "$MG_PROC/uptime" 2>/dev/null || _up=0
	NOW=${_up%%.*}
}

mg_read_meminfo() {
	MA=0 MLOCKED=
	while read -r _k _v _; do
		case "$_k" in
		MemAvailable:) MA=$_v ;;
		Mlocked:) MLOCKED=$_v; return 0 ;;
		esac
	done < "$MG_PROC/meminfo"
}

mg_read_zram() {
	ZU=0 ZL=0
	[ -r "$MG_SYS/block/zram0/mm_stat" ] || return 0
	read -r _ _ ZU ZL _ < "$MG_SYS/block/zram0/mm_stat" 2>/dev/null || { ZU=0 ZL=0; }
}

# avg10 as an integer percentage, from "some avg10=1.23 ..." / "full avg10=..."
mg_read_psi() {
	SOME10=0 FULL10=0
	[ -r "$MG_PROC/pressure/memory" ] || return 0
	while read -r _kind _a10 _; do
		_v=${_a10#avg10=}
		_v=${_v%%.*}
		case "$_kind" in some) SOME10=$_v ;; full) FULL10=$_v ;; esac
	done < "$MG_PROC/pressure/memory"
}

# Overridden by the tests.
mg_http() {
	wget -q -T 2 -O - "$MG_MOONRAKER$1" 2>/dev/null
}

mg_poll_print_state() {
	_r=$(mg_http "/printer/objects/query?print_stats=state") || return 0
	case "$_r" in
	*'"state":"printing"'* | *'"state": "printing"'* | *'"state":"paused"'* | *'"state": "paused"'*) PRINT=1 ;;
	*'"state"'*) PRINT=0 ;;
	*) ;;  # no usable answer: keep the previous value (sticky)
	esac
}

mg_poll_maint_state() {
	MAINT=0
	for _l in "$MG_LOCKS"/* "$MG_LOCKS"/.[!.]*; do
		[ -e "$_l" ] && { MAINT=1; return 0; }
	done
	[ "$PRINT" = 1 ] && return 0
	_r=$(mg_http "/machine/update/status") || return 0
	case "$_r" in *'"busy":true'* | *'"busy": true'*) MAINT=1 ;; esac
}

mg_marker() { # name 0|1
	if [ "$2" = 1 ]; then
		[ -e "$MG_RUN/$1" ] || : > "$MG_RUN/$1"
	else
		rm -f "$MG_RUN/$1"
	fi
}

mg_publish() {
	mg_marker print-active "$PRINT"
	mg_marker maintenance-active "$MAINT"
	echo "$STATE" > "$MG_RUN/memguard/state.tmp" && mv -f "$MG_RUN/memguard/state.tmp" "$MG_RUN/memguard/state"
}

mg_pid_of() { # pidfile basename -> pid (empty if absent or dead)
	_p=
	[ -r "$MG_PIDDIR/$1" ] || return 0
	read -r _p < "$MG_PIDDIR/$1" || { _p=; return 0; }
	[ -d "$MG_PROC/$_p" ] || _p=
}

mg_set_adj() { # pid value
	read -r _cur < "$MG_PROC/$1/oom_score_adj" 2>/dev/null || return 0
	[ "$_cur" = "$2" ] && return 0
	echo "$2" > "$MG_PROC/$1/oom_score_adj" 2>/dev/null \
		&& mg_log "adj $1 ($(cat "$MG_PROC/$1/comm" 2>/dev/null)) $_cur -> $2"
}

# D4 table: pidfile members are re-asserted; nginx/dropbear by comm (workers
# and per-connection children); any other process with a negative adj that
# is not protected gets NEBULAOS_ADJ_UNLISTED. udevd keeps its own -1000.
mg_enforce_adj() {
	_protected=" "
	for _e in klipper_mcu.pid:$NEBULAOS_ADJ_KLIPPER_MCU klippy.pid:$NEBULAOS_ADJ_KLIPPY \
		nebulaos-memguard.pid:$NEBULAOS_ADJ_MEMGUARD wpa_supplicant-wlan0.pid:$NEBULAOS_ADJ_WPA_SUPPLICANT \
		moonraker.pid:$NEBULAOS_ADJ_MOONRAKER guppyscreen.pid:$NEBULAOS_ADJ_GUPPYSCREEN \
		ustreamer.pid:$NEBULAOS_ADJ_USTREAMER nebulaos-update-supervisor.pid:$NEBULAOS_ADJ_UPDATE_SUPERVISOR; do
		mg_pid_of "${_e%%:*}"
		[ -n "$_p" ] || continue
		_protected="$_protected$_p "
		mg_set_adj "$_p" "${_e#*:}"
	done
	for _d in "$MG_PROC"/[0-9]*; do
		_pid=${_d##*/}
		case "$_protected" in *" $_pid "*) continue ;; esac
		read -r _comm < "$_d/comm" 2>/dev/null || continue
		case "$_comm" in
		nginx) mg_set_adj "$_pid" "$NEBULAOS_ADJ_NGINX"; continue ;;
		dropbear) mg_set_adj "$_pid" "$NEBULAOS_ADJ_DROPBEAR"; continue ;;
		udevd | systemd-udevd) continue ;;
		esac
		read -r _adj < "$_d/oom_score_adj" 2>/dev/null || continue
		[ "$_adj" -lt 0 ] 2>/dev/null && mg_set_adj "$_pid" "$NEBULAOS_ADJ_UNLISTED"
	done
}

mg_rss_kb() { # pid -> _rss (kB, 0 if unknown)
	_rss=0
	while read -r _k _v _; do
		case "$_k" in VmRSS:) _rss=$_v; return 0 ;; esac
	done < "$MG_PROC/$1/status" 2>/dev/null
}

mg_check_mcu_rss() {
	mg_pid_of klipper_mcu.pid
	[ -n "$_p" ] || return 0
	mg_rss_kb "$_p"
	if [ "$_rss" -gt "$MG_MCU_RSS_ALERT_KB" ]; then
		[ "${MG_MCU_ALERTED:-0}" = 1 ] || mg_log "ALERT klipper_mcu VmRSS ${_rss} kB > ${MG_MCU_RSS_ALERT_KB} kB (leak?)"
		MG_MCU_ALERTED=1
	fi
}

# HWDP-MEM-5 alert on klippy's mlock growth. klippy locks with
# mlockall(MCL_CURRENT|MCL_FUTURE|MCL_ONFAULT), so its VmLck is the whole
# locked virtual range (~128 MiB measured) while only faulted-in pages are
# resident (~30 MiB). The resident figure is /proc/meminfo Mlocked (klippy
# plus klipper_mcu's ~2 MiB); per-process smaps is not built
# (PROC_PAGE_MONITOR off). Read from the meminfo pass this tick already did:
# no extra file, nothing that can block. Unknown or malformed -> no alert.
mg_check_locked() {
	case "${MLOCKED:-}" in ""|*[!0-9]*) return 0 ;; esac
	if [ "$MLOCKED" -gt "$MG_LOCKED_ALERT_KB" ]; then
		[ "${MG_LOCKED_ALERTED:-0}" = 1 ] || mg_log "ALERT resident locked memory Mlocked ${MLOCKED} kB > ${MG_LOCKED_ALERT_KB} kB (klippy mlock growth?)"
		MG_LOCKED_ALERTED=1
	elif [ "$MLOCKED" -lt $((MG_LOCKED_ALERT_KB - MG_LOCKED_REARM_KB)) ]; then
		MG_LOCKED_ALERTED=0
	fi
}

mg_snapshot() {
	_s="snapshot MA=${MA}kB ML=${MLOCKED:-?}kB ZU=$ZU ZL=$ZL SOME10=$SOME10 FULL10=$FULL10 PRINT=$PRINT MAINT=$MAINT state=$STATE"
	for _e in klippy.pid moonraker.pid guppyscreen.pid ustreamer.pid; do
		mg_pid_of "$_e"
		[ -n "$_p" ] || continue
		mg_rss_kb "$_p"
		_s="$_s ${_e%.pid}=${_rss}kB"
	done
	mg_log "$_s"
}

# MEM-T14 conditions. "zram nearly full" only counts when a limit is set.
mg_enter_cond() { # level
	_ma=$((MA / 1024))
	case "$1" in
	1) [ "$_ma" -lt "$MG_P1_ENTER_MB" ] || [ "$SOME10" -ge 10 ] ;;
	2) [ "$_ma" -lt "$MG_P2_ENTER_MB" ] || [ "$FULL10" -ge 5 ] || { [ "$ZL" -gt 0 ] && [ $((ZU * 10)) -ge $((ZL * 9)) ]; } ;;
	3) [ "$_ma" -lt "$MG_P3_ENTER_MB" ] || [ "$FULL10" -ge 10 ] ;;
	4) [ "$_ma" -lt "$MG_P4_ENTER_MB" ] || [ "$FULL10" -ge 20 ] ;;
	*) return 1 ;;
	esac
}

mg_exit_cond() { # level
	_ma=$((MA / 1024))
	case "$1" in
	1) [ "$_ma" -gt "$MG_P1_EXIT_MB" ] && [ "$SOME10" -lt 5 ] ;;
	2) [ "$_ma" -gt "$MG_P2_EXIT_MB" ] && [ "$FULL10" -lt 1 ] && { [ "$ZL" -eq 0 ] || [ $((ZU * 4)) -lt $((ZL * 3)) ]; } ;;
	3) [ "$_ma" -gt "$MG_P3_EXIT_MB" ] && [ "$FULL10" -lt 1 ] ;;
	4) [ "$_ma" -gt "$MG_P4_EXIT_MB" ] && [ "$FULL10" -lt 1 ] ;;
	*) return 1 ;;
	esac
}

# P4: restart Moonraker only if it is clearly bloated (2x its measured idle
# RSS) and memguard has not restarted it in the last 30 min. klippy keeps
# printing from virtual_sdcard; the git wrapper keeps the refresh after the
# restart network-free. Runs in the background so the tracker keeps ticking.
mg_p4_action() {
	mg_pid_of moonraker.pid
	[ -n "$_p" ] || return 0
	mg_rss_kb "$_p"
	if [ "$_rss" -lt "$MG_MOONRAKER_RESTART_RSS_KB" ]; then
		mg_log "P4: Moonraker RSS ${_rss} kB below ${MG_MOONRAKER_RESTART_RSS_KB} kB - no action"
		return 0
	fi
	if [ $((NOW - ${MG_LAST_MR_RESTART:--100000})) -lt "$MG_MOONRAKER_RESTART_SPACING" ]; then
		mg_log "P4: Moonraker restarted by memguard less than ${MG_MOONRAKER_RESTART_SPACING}s ago - no action"
		return 0
	fi
	MG_LAST_MR_RESTART=$NOW
	mg_log "P4: restarting Moonraker (RSS ${_rss} kB)"
	(
		: > "$MG_RUN/shed/moonraker-restarting"
		"$MG_S56" stop >/dev/null 2>&1
		_i=0
		while [ "$_i" -lt 20 ] && [ -d "$MG_PROC/$_p" ]; do sleep 1; _i=$((_i + 1)); done
		"$MG_S56" start >/dev/null 2>&1
		rm -f "$MG_RUN/shed/moonraker-restarting"
	) &
}

mg_enter() { # new level
	mg_log "enter P$1 (MA=${MA}kB ZU=$ZU ZL=$ZL SOME10=$SOME10 FULL10=$FULL10 print=$PRINT)"
	[ "$MG_ACTIONS" = 1 ] || return 0
	case "$1" in
	1) : > "$MG_RUN/memguard/deny-maintenance" ;;
	2) : > "$MG_RUN/shed/camera" ;;
	3) : > "$MG_RUN/shed/guppyscreen"; "$MG_S58" stop >/dev/null 2>&1 ;;
	4) mg_p4_action ;;
	esac
}

mg_exit() { # level being left
	mg_log "leave P$1 (MA=${MA}kB)"
	[ "$MG_ACTIONS" = 1 ] || return 0
	case "$1" in
	1) rm -f "$MG_RUN/memguard/deny-maintenance" ;;
	2) rm -f "$MG_RUN/shed/camera" ;;
	3) rm -f "$MG_RUN/shed/guppyscreen"; "$MG_S58" start >/dev/null 2>&1 ;;
	esac
}

# MEM-T14 state machine: escalate one level at a time, only after a higher
# level's condition held for 2 consecutive samples and at least 10 s after
# the previous escalation; de-escalate one level per 60 s of continuous exit
# condition. klippy and klipper_mcu are never acted on; every action is
# marker-guarded and idempotent.
mg_target_level() {
	_t=4
	while [ "$_t" -gt 0 ]; do
		mg_enter_cond "$_t" && return 0
		_t=$((_t - 1))
	done
}

mg_evaluate() {
	# Step toward the highest level whose entry condition holds: zram filling
	# up or PSI "full" stalls can call for P2+ while MemAvailable alone would
	# not even reach P1.
	mg_target_level
	_next=$((LEVEL + 1))
	if [ "$LEVEL" -lt 4 ] && [ "$_t" -gt "$LEVEL" ]; then
		ENTER_CNT=$((ENTER_CNT + 1))
		if [ "$ENTER_CNT" -ge 2 ] && [ $((NOW - LAST_ESCALATE)) -ge "$MG_ESCALATE_SPACING" ]; then
			LEVEL=$_next ENTER_CNT=0 LAST_ESCALATE=$NOW EXIT_SINCE=
			[ "$LEVEL" = 4 ] && P4_SINCE=$NOW EXHAUSTED_LOGGED=0
			mg_enter "$LEVEL"
		fi
	else
		ENTER_CNT=0
	fi
	if [ "$LEVEL" -gt 0 ] && mg_exit_cond "$LEVEL"; then
		[ -n "$EXIT_SINCE" ] || EXIT_SINCE=$NOW
		if [ $((NOW - EXIT_SINCE)) -ge "$MG_EXIT_DWELL" ]; then
			mg_exit "$LEVEL"
			LEVEL=$((LEVEL - 1)) EXIT_SINCE=$NOW
			[ "$LEVEL" -eq 3 ] && P4_SINCE=
		fi
	elif [ "$LEVEL" -gt 0 ]; then
		EXIT_SINCE=
	fi
	if [ "$LEVEL" = 4 ] && [ $((NOW - ${P4_SINCE:-$NOW})) -ge "$MG_P4_EXHAUSTED_AFTER" ]; then
		STATE=P4_EXHAUSTED
		if [ "$EXHAUSTED_LOGGED" = 0 ]; then
			EXHAUSTED_LOGGED=1
			mg_log "SUPPORTED WORKLOAD EXCEEDED: P4 for ${MG_P4_EXHAUSTED_AFTER}s; the kernel OOM killer now chooses by the D4 table"
		fi
	elif [ "$LEVEL" = 0 ]; then
		STATE=NORMAL
	else
		STATE=P$LEVEL
	fi
}

# A restarted memguard starts at NORMAL: clear what a previous instance left,
# restarting GuppyScreen if it had shed it.
mg_reset_markers() {
	rm -f "$MG_RUN/memguard/deny-maintenance" "$MG_RUN/shed/camera" "$MG_RUN/shed/moonraker-restarting"
	if [ -e "$MG_RUN/shed/guppyscreen" ]; then
		rm -f "$MG_RUN/shed/guppyscreen"
		[ "$MG_ACTIONS" = 1 ] && "$MG_S58" start >/dev/null 2>&1
		mg_log "cleared a GuppyScreen shed left by a previous instance"
	fi
}

# Used kB of the swapfile from /proc/swaps; empty when it is not active.
mg_swapfile_used() {
	_used=
	[ -r "$MG_PROC/swaps" ] || return 0
	while read -r _f _t _sz _u _; do
		[ "$_f" = "$MG_SWAPFILE" ] && { _used=$_u; return 0; }
	done < "$MG_PROC/swaps"
}

# MEM-T13. Reaching the disk tier means zram is full - a thrash regime - and
# writeback can stall any allocating task (klippy included) on the same eMMC
# that serves virtual_sdcard. So the tier exists only during maintenance
# (updates, seeding). Turning it off is guarded: only when the swapped pages
# fit back comfortably (or none are used), never at P2 or above, and swapoff
# runs in the background with a watchdog so the tracker keeps ticking.
# PRINTING never waits for it.
mg_diskswap_reconcile() {
	[ "$MG_DISKSWAP_POLICY" = always ] && return 0
	[ -e "$MG_SWAPFILE" ] || return 0
	if [ -n "${MG_SWAPOFF_PID:-}" ]; then
		if kill -0 "$MG_SWAPOFF_PID" 2>/dev/null; then
			if [ $((NOW - MG_SWAPOFF_STARTED)) -ge "$MG_SWAPOFF_TIMEOUT" ]; then
				kill "$MG_SWAPOFF_PID" 2>/dev/null
				mg_log "DISKSWAP_OFF_TIMEOUT swapoff ran > ${MG_SWAPOFF_TIMEOUT}s - aborted, retry in ${MG_SWAPOFF_COOLDOWN}s"
				MG_SWAPOFF_PID= MG_SWAPOFF_HOLD=$((NOW + MG_SWAPOFF_COOLDOWN))
			fi
			return 0
		fi
		wait "$MG_SWAPOFF_PID" 2>/dev/null
		mg_log "disk swap off ($(($NOW - MG_SWAPOFF_STARTED))s)"
		MG_SWAPOFF_PID=
	fi
	mg_swapfile_used
	if [ "$MAINT" = 1 ]; then
		if [ -z "$_used" ]; then
			"$MG_SWAPON" -p "$MG_SWAP_PRIORITY" "$MG_SWAPFILE" 2>/dev/null \
				&& mg_log "disk swap on (maintenance)" || mg_log "ERROR: swapon $MG_SWAPFILE failed"
		fi
		return 0
	fi
	[ -n "$_used" ] || return 0
	[ "$NOW" -lt "${MG_SWAPOFF_HOLD:-0}" ] && return 0
	case "$STATE" in P2 | P3 | P4 | P4_EXHAUSTED) _ok=0 ;; *) _ok=1 ;; esac
	if [ "$_ok" = 1 ] && [ "$_used" -gt 0 ]; then
		# the swapped pages must fit: 64 MiB headroom in MemAvailable, and
		# zram room for them at a 2:1 compression ratio
		if [ $((_used + 65536)) -ge "$MA" ] || [ $((ZL - ZU)) -le $((_used * 1024 / 2)) ]; then
			_ok=0
		fi
	fi
	if [ "$_ok" = 1 ]; then
		"$MG_SWAPOFF" "$MG_SWAPFILE" 2>/dev/null &
		MG_SWAPOFF_PID=$! MG_SWAPOFF_STARTED=$NOW
		mg_log "disk swap off requested (used=${_used}kB)"
	elif [ $((NOW - ${MG_DEFER_LOGGED:--1000})) -ge 60 ]; then
		MG_DEFER_LOGGED=$NOW
		mg_log "DISKSWAP_OFF_DEFERRED used=${_used}kB MA=${MA}kB state=$STATE print=$PRINT"
	fi
}

mg_tick() {
	mg_now
	mg_read_meminfo
	mg_read_zram
	mg_read_psi
	if [ $((NOW - ${MG_LAST_SLOW:--1000})) -ge "$MG_SLOW_EVERY" ]; then
		MG_LAST_SLOW=$NOW
		_prev_print=$PRINT _prev_maint=$MAINT
		mg_poll_print_state
		mg_poll_maint_state
		[ "$PRINT" = "$_prev_print" ] || mg_log "print-active=$PRINT"
		[ "$MAINT" = "$_prev_maint" ] || mg_log "maintenance-active=$MAINT"
		mg_enforce_adj
		mg_check_mcu_rss
		mg_check_locked
		mg_diskswap_reconcile
	fi
	mg_evaluate
	mg_publish
	if [ $((NOW - ${MG_LAST_SNAPSHOT:--1000})) -ge "$MG_SNAPSHOT_EVERY" ]; then
		MG_LAST_SNAPSHOT=$NOW
		mg_snapshot
	fi
}

mg_loop() {
	mkdir -p "$MG_RUN/memguard" "$MG_RUN/shed"
	mg_reset_markers
	mg_log "started (pid $$) actions=$MG_ACTIONS diskswap=$MG_DISKSWAP_POLICY"
	while :; do
		mg_tick
		sleep "$MG_TICK"
	done
}

if [ -z "${NEBULAOS_MEMGUARD_NO_AUTORUN:-}" ]; then
	mg_loop
fi
