#!/bin/sh
#
# nebulaos-blackbox (Run 24, 2026-11-06): why did the printer last restart,
# and what was it doing just before.
#
# The 2026-10-26 and 2026-11-06 freezes left nothing behind: the system
# stopped dead, the hardware watchdog reset it ~60 s later and the last
# minute of every log never reached the eMMC. The kernel now keeps three
# things in 1 MB of RAM that survives a watchdog or panic reset (pstore/
# ramoops, kernel halley5_v30.dts): its own log (console-ramoops-0), any
# panic/oops dump (dmesg-ramoops-N) and the heartbeat below (pmsg-ramoops-0).
#
#   collect     once at boot (S03nebulaos-blackbox): read pstore and the SoC
#               reset status, decide why the last boot ended, keep the
#               evidence under logs/, empty pstore, show a notice after a
#               freeze or crash.
#   heartbeat   forever, from S03nebulaos-blackbox: every 10 s one line into
#               /dev/pmsg0 (RAM, no eMMC wear) with load, memory and the
#               processes that used the most CPU since the last line,
#               real-time tasks included. SCHED_OTHER at nice 19, the lowest
#               (never takes CPU from Klippy), and never above Klipper's real-time work
#               (klipper_mcu FIFO 49, the IRQ threads): RT throttling keeps
#               it running beside a runaway real-time task, which its lines
#               then name (without PREEMPT_RT, hard-IRQ and softirq time is
#               counted to the task they interrupted, not to irq/N threads).
#               In a kernel stall nothing runs; then the time of
#               the last line is the evidence.
#   shutdown    from S03nebulaos-blackbox stop (rcK): one "shutdown clean"
#               line into /dev/pmsg0 - a synchronous RAM write, so the next
#               boot knows this was an orderly restart.
#
# The reasons (REASON= in /run/nebulaos/last-reset and reset-history.log),
# checked in this order:
#   FREEZE       (first) a panic dump from the watchdog pre-timeout handler
#                ("nebulaos-freeze:", 1.0.2): the printer froze and the
#                kernel dumped its state 40 s later
#   CRASH        a kernel panic or oops dump is in pstore
#   RESTART      the heartbeat log ends in "shutdown clean" (rcK), or the
#                SoC scratch word holds the kernel's reboot signature 0x3535
#                (every software restart writes it, also `reboot -f`; a
#                watchdog fire never does), or the kernel log ends in
#                "reboot: Restarting system" (secondary: on PREEMPT_RT,
#                used before 1.0.2, that line could miss pstore)
#   POWER_OFF    the kernel log ends in "reboot: Power down"/"System halted"
#   UNKNOWN      no reset status from the kernel (an image without the black
#                box), or no evidence either way
#   FREEZE       the previous boot's kernel log is in pstore, none of the
#                above, and the SoC says watchdog reset
#   POWER_ON     nothing in pstore and a power-on reset (RAM lost: switched
#                on, or a power cut)
#
# Never fails the boot: every step is best effort.

PSTORE_DIR="${NEBULAOS_PSTORE_DIR:-/sys/fs/pstore}"
WDT_PARAMS="${NEBULAOS_WDT_PARAMS:-/sys/module/ingenic_wdt/parameters}"
NEBULAOS_ROOT="${NEBULAOS_ROOT:-/usr/data/nebulaos}"
LOG_DIR="${NEBULAOS_BLACKBOX_LOG_DIR:-$NEBULAOS_ROOT/logs}"
CRASH_DIR="$LOG_DIR/crash"
HISTORY="$LOG_DIR/reset-history.log"
PREVIOUS="$LOG_DIR/previous-boot-kernel.log"
PREVIOUS_HB="$LOG_DIR/previous-boot-heartbeat.log"
NOTICES_DIR="${NEBULAOS_NOTICES_DIR:-$NEBULAOS_ROOT/system/notices}"
NOTICE="$NOTICES_DIR/printer-restarted.txt"
RUN_DIR="${NEBULAOS_BLACKBOX_RUN_DIR:-/run/nebulaos}"
STATE="$RUN_DIR/last-reset"
PMSG="${NEBULAOS_PMSG:-/dev/pmsg0}"
PROC="${NEBULAOS_PROC:-/proc}"
KEEP_CRASHES=5
KEEP_HISTORY=100
INTERVAL="${NEBULAOS_HEARTBEAT_INTERVAL:-10}"

kmsg() {
	echo "nebulaos-blackbox: $*" > /dev/kmsg 2>/dev/null || true
}

param() {
	v=$(cat "$WDT_PARAMS/$1" 2>/dev/null)
	case "$v" in ''|*[!0-9]*) echo "" ;; *) echo "$v" ;; esac
}

hex() {
	[ -n "$1" ] && printf '0x%08x' "$1" || echo "unknown"
}

REBOOT_SIGNATURE=13621    # 0x3535, soc-x2000/reset.c jz_wdt_restart

# reason <console file or empty> <dump 0/1> <rsr decimal or empty>
#        <cppsr decimal or empty> <pmsg file or empty>
reason() {
	console="$1"; dump="$2"; rsr="$3"; cppsr="${4:-}"; pmsg="${5:-}"
	# dump 2: the panic came from the watchdog pre-timeout handler
	# (ingenic_wdt.c, "nebulaos-freeze:") - a freeze that left its state.
	if [ "$dump" = 2 ]; then echo FREEZE; return; fi
	if [ "$dump" = 1 ]; then echo CRASH; return; fi
	if [ -n "$pmsg" ] && [ -s "$pmsg" ] && grep -v '^$' "$pmsg" 2>/dev/null | tail -n 1 | grep -q '^shutdown clean'; then
		echo RESTART; return
	fi
	if [ -n "$cppsr" ] && [ $((cppsr & 65535)) -eq $REBOOT_SIGNATURE ]; then echo RESTART; return; fi
	if [ -n "$console" ] && [ -s "$console" ]; then
		tail_txt=$(tail -n 40 "$console" 2>/dev/null)
		case "$tail_txt" in
			*"reboot: Restarting system"*) echo RESTART; return ;;
			*"reboot: Power down"*|*"System halted"*) echo POWER_OFF; return ;;
		esac
	fi
	if [ -z "$rsr" ]; then echo UNKNOWN; return; fi
	if [ $((rsr & 2)) -ne 0 ]; then
		# Watchdog reset: a freeze if the previous boot left its kernel
		# log; with RAM lost we cannot tell.
		if [ -n "$console" ] && [ -s "$console" ]; then echo FREEZE; else echo UNKNOWN; fi
		return
	fi
	# RSR_PR (bit 0) is the power-on reset - seen on ke-dev as 0x1 after
	# switching on. RSR_P0R (bit 2) and 0 (no bit set) count as well. Only
	# with RAM lost: a previous kernel log that survived means the power
	# never went, so that stays UNKNOWN (and its evidence is kept).
	if [ $((rsr & 5)) -ne 0 ] || [ "$rsr" = 0 ]; then
		if [ -n "$console" ] && [ -s "$console" ]; then echo UNKNOWN; else echo POWER_ON; fi
		return
	fi
	echo UNKNOWN
}

keep_newest() {
	# keep_newest <dir> <n>: one stamp = several files with the same prefix
	ls "$1" 2>/dev/null | sed -n 's/^\([0-9TZ]*-[A-Z_]*\)-.*/\1/p' | sort -u | sort -r \
		| tail -n +$(($2 + 1)) | while read -r old; do rm -f "$1/$old"-*; done
}

collect() {
	# Once per boot: /run is a tmpfs, so last-reset exists only if this
	# boot already decided (a second run would see an emptied pstore).
	if [ -e "$STATE" ]; then echo "nebulaos-blackbox: already collected this boot"; return 0; fi
	mkdir -p "$RUN_DIR" "$LOG_DIR" 2>/dev/null
	if [ "$PSTORE_DIR" = /sys/fs/pstore ] && ! grep -q " /sys/fs/pstore " /proc/mounts 2>/dev/null; then
		mount -t pstore pstore /sys/fs/pstore 2>/dev/null
	fi
	console=""; dump=0; pmsg=""
	for f in "$PSTORE_DIR"/*; do
		[ -f "$f" ] || continue
		case "${f##*/}" in
			console-ramoops*) console="$f" ;;
			dmesg-ramoops*) if grep -q 'nebulaos-freeze:' "$f" 2>/dev/null; then dump=2; elif [ "$dump" = 0 ]; then dump=1; fi ;;
			pmsg-ramoops*) pmsg="$f" ;;
		esac
	done
	rsr=$(param nebulaos_reset_rsr)
	cppsr=$(param nebulaos_reset_cppsr)
	why=$(reason "$console" "$dump" "$rsr" "$cppsr" "$pmsg")
	# Read before pstore is emptied below.
	last_hb=""
	[ -n "$pmsg" ] && last_hb=$(grep '^hb ' "$pmsg" 2>/dev/null | tail -n 1 | cut -c1-200)
	stamp=$(date -u +%Y%m%dT%H%M%SZ)
	uptime_s=$(cut -d' ' -f1 "$PROC/uptime" 2>/dev/null)

	# The previous boot's kernel log, whatever the reason (one file,
	# replaced every boot).
	if [ -n "$console" ]; then
		cp "$console" "$PREVIOUS.tmp" 2>/dev/null && mv "$PREVIOUS.tmp" "$PREVIOUS"
	else
		rm -f "$PREVIOUS"
	fi
	# ... and its heartbeat, so a partial hang that ended in a restart from
	# the screen (no FREEZE, no crash copy) still leaves the evidence.
	if [ -n "$pmsg" ]; then
		cp "$pmsg" "$PREVIOUS_HB.tmp" 2>/dev/null && mv "$PREVIOUS_HB.tmp" "$PREVIOUS_HB"
	else
		rm -f "$PREVIOUS_HB"
	fi

	# The evidence of a freeze, a crash or an unexplained reset is kept.
	case "$why" in
		CRASH|FREEZE|UNKNOWN)
			if ls "$PSTORE_DIR"/* >/dev/null 2>&1; then
				mkdir -p "$CRASH_DIR"
				for f in "$PSTORE_DIR"/*; do
					[ -f "$f" ] && cp "$f" "$CRASH_DIR/$stamp-$why-${f##*/}.txt" 2>/dev/null
				done
				keep_newest "$CRASH_DIR" "$KEEP_CRASHES"
			fi ;;
	esac

	# Free the panic dumps and the old heartbeat log, so the next boot sees
	# only its own predecessor. Not the console record: erasing it also
	# wipes this boot's kernel log written so far (ramoops zaps the live
	# zone), and the next boot replaces it anyway.
	if [ "$PSTORE_DIR" = /sys/fs/pstore ] || [ -n "${NEBULAOS_PSTORE_ERASE:-}" ]; then
		rm -f "$PSTORE_DIR"/dmesg-* "$PSTORE_DIR"/pmsg-* 2>/dev/null
	fi

	{
		echo "REASON=$why"
		echo "RESET_STATUS=$(hex "$rsr")"
		echo "CPPSR=$(hex "$cppsr")"
		echo "PSTORE_CONSOLE=$([ -n "$console" ] && echo yes || echo no)"
		echo "PSTORE_DUMP=$([ "$dump" = 1 ] && echo yes || { [ "$dump" = 2 ] && echo freeze || echo no; })"
		echo "PSTORE_HEARTBEAT=$([ -n "$pmsg" ] && echo yes || echo no)"
		[ -n "$pmsg" ] && echo "LAST_HEARTBEAT=$last_hb"
		echo "CHECKED_AT=$stamp UPTIME=$uptime_s"
	} > "$STATE.tmp" 2>/dev/null && mv "$STATE.tmp" "$STATE"

	line="$stamp boot after $why reset_status=$(hex "$rsr")"
	last=$(echo "$last_hb" | cut -d' ' -f2)
	[ -n "$last" ] && line="$line last_heartbeat=$last"
	echo "$line" >> "$HISTORY" 2>/dev/null
	if [ "$(wc -l < "$HISTORY" 2>/dev/null)" -gt "$KEEP_HISTORY" ] 2>/dev/null; then
		tail -n "$KEEP_HISTORY" "$HISTORY" > "$HISTORY.tmp" && mv "$HISTORY.tmp" "$HISTORY"
	fi

	case "$why" in
		CRASH|FREEZE)
			mkdir -p "$NOTICES_DIR" 2>/dev/null
			printf '%s\n' "The printer restarted by itself because its system stopped responding. If a print was running, check whether the screen offers to resume it. To help us find the cause: Settings > System > Report a problem > Save logs to USB, and send us the file." \
				> "$NOTICE" 2>/dev/null ;;
	esac
	sync
	kmsg "$line"
	echo "nebulaos-blackbox: last boot ended: $why (reset status $(hex "$rsr"))"
}

# One heartbeat line: hb <utc> up=<s> load=<1 5 15> run=<n> memavail=<kB>
#   wifi=<dBm>/b<missed beacons>|none
#   top=<comm>/<pid>/<policy><rtprio>:<cpu%>,...   (the 4 busiest since the
#   previous line; policy f = FIFO, r = RR, o = other)
#   blocked=<n>[:<comm>/<pid>,...]   tasks in uninterruptible sleep (D) now,
#   up to 4 named - a process stuck on the eMMC or a driver shows here.
heartbeat_line() {
	prev="$1"; now="$2"; dt="$3"
	# cat, not awk on the files: a process that exits mid-read makes awk
	# stop at the missing file; cat skips it and goes on (one line each).
	cat "$PROC"/[0-9]*/stat 2>/dev/null | awk -v prev="$prev" -v now="$now" -v dt="$dt" -v hz=100 '
	BEGIN {
		while ((getline l < prev) > 0) { split(l, a, " "); p[a[1]] = a[2] }
		close(prev)
	}
	{
		s = $0; o = index(s, "("); c = 0
		for (i = length(s); i > 0; i--) if (substr(s, i, 1) == ")") { c = i; break }
		if (o == 0 || c == 0) next
		pid = substr(s, 1, o - 2); comm = substr(s, o + 1, c - o - 1)
		n = split(substr(s, c + 2), r, " ")
		if (n < 39) next
		if (r[1] == "D") { nd++; if (nd <= 4) dl = dl (dl == "" ? "" : ",") comm "/" pid }
		t = r[12] + r[13]
		print pid, t > now
		if (pid in p) {
			d = t - p[pid]
			if (d > 0) {
				pol = (r[39] == 1) ? "f" : (r[39] == 2) ? "r" : "o"
				k++; dd[k] = d; nm[k] = comm "/" pid "/" pol r[38]
			}
		}
	}
	END {
		out = ""
		for (j = 1; j <= 4; j++) {
			best = 0
			for (i = 1; i <= k; i++) if (dd[i] > 0 && (best == 0 || dd[i] > dd[best])) best = i
			if (best == 0) break
			pct = (dt > 0) ? int(dd[best] * 100 / (dt * hz) + 0.5) : 0
			out = out (out == "" ? "" : ",") nm[best] ":" pct "%"
			dd[best] = 0
		}
		print out " blocked=" (nd + 0) (dl == "" ? "" : ":" dl)
	}'
}

# wifi=<signal dBm>/b<missed beacons since boot>, or "none" without an
# associated interface (/proc/net/wireless, no fork): a printer that drops
# off the network shows whether its Wi-Fi went first.
wifi_state() {
	awk 'NR > 2 && $1 ~ /:$/ { l = $4; sub(/\.$/, "", l); printf "%s/b%s", l, $NF; f = 1; exit }
		END { if (!f) printf "none" }' "$PROC/net/wireless" 2>/dev/null || echo none
}

heartbeat() {
	mkdir -p "$RUN_DIR" 2>/dev/null
	prev="$RUN_DIR/heartbeat.prev"; next="$RUN_DIR/heartbeat.next"
	: > "$prev"
	t0=$(cut -d. -f1 "$PROC/uptime")
	while :; do
		# A failing sleep (no memory to fork) must not become a busy loop.
		sleep "$INTERVAL" || exit 1
		t1=$(cut -d. -f1 "$PROC/uptime")
		top=$(heartbeat_line "$prev" "$next" $((t1 - t0)))
		mv -f "$next" "$prev" 2>/dev/null
		t0=$t1
		load=$(cut -d' ' -f1-3 "$PROC/loadavg")
		run=$(cut -d' ' -f4 "$PROC/loadavg" | cut -d/ -f1)
		mem=$(awk '/^MemAvailable:/ {print $2}' "$PROC/meminfo")
		wifi=$(wifi_state)
		echo "hb $(date -u +%Y-%m-%dT%H:%M:%SZ) up=$t1 load=$load run=$run memavail=$mem wifi=$wifi top=$top" > "$PMSG" 2>/dev/null
	done
}

shutdown_mark() {
	echo "shutdown clean $(date -u +%Y-%m-%dT%H:%M:%SZ) up=$(cut -d' ' -f1 "$PROC/uptime")" > "$PMSG" 2>/dev/null
}

case "$1" in
	collect) collect ;;
	heartbeat) heartbeat ;;
	shutdown) shutdown_mark ;;
	reason) shift; reason "$@" ;;
	heartbeat-line) shift; heartbeat_line "$@" ;;
	wifi-state) wifi_state ;;
	*) echo "usage: $0 collect|heartbeat" >&2; exit 2 ;;
esac
exit 0
