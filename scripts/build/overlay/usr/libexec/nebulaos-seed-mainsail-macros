#!/usr/bin/env python3
#
# NebulaOS Phase 2 macro-cleanup/Mainsail-grouping mission (2026-09-04,
# extended 2026-09-06 - RC2 overnight closure).
#
# Seeds NebulaOS's own default Mainsail macro groups (Moonraker database
# namespace "mainsail", key "macros.macrogroups.<id>") the first time
# Moonraker is confirmed reachable, migrates any pre-existing groups from
# their old underscore-style IDs to the current hyphenated ones, and
# defaults a genuinely untouched install's macros.mode to "expert" - same
# never-block-boot, never-trust-HTTP-2xx-alone, verify-after-write,
# atomic-marker conventions as nebulaos-seed-camera (see that script's own
# header for the fuller rationale; this one is deliberately structured
# identically).
#
# Why database keys, not Mainsail's own ".../default.json" fresh-install
# mechanism: that mechanism is real (Mainsail's own `gui/initDb` fetches
# GET /server/files/config/<X>/default.json on a genuinely fresh
# install), but (a) it only ever runs once, on an install where the
# `mainsail` namespace does not exist AT ALL yet - it cannot add a new
# NebulaOS group to an ALREADY-INITIALIZED existing install, which is
# exactly the safe-migration case this mission also requires, and
# (b) the exact config-subdirectory path segment Mainsail's own minified
# bundle uses for <X> could not be confirmed with confidence from static
# analysis of the vendored dist (see the Phase 2 overnight research
# report). Posting directly to Moonraker's own, already-documented
# `/server/database/item` API - the same mechanism Mainsail's own code
# uses internally for every group edit a user makes by hand - works
# identically for a genuinely fresh install and an existing one, with no
# unconfirmed path dependency, and is exactly the same pattern this
# project already uses for the default webcam (nebulaos-seed-camera).
#
# 2026-09-06 RC2 finding (read straight from the pinned Mainsail v2.18.2
# vendored dist, vendor/mainsail-dist/dist/assets/index-*.js - not
# guessed): dashboard-layout seeding is NOT needed and was never missing.
# Mainsail's own `gui/getPanels` getter auto-synthesizes a
# `{name: "macrogroup_<id>", visible: true}` entry for every id returned
# by `macros/getAllMacrogroups` whenever `macros.mode === "expert"` - the
# very first render after a group exists and mode is expert is enough for
# the panel to appear on every viewport's first layout slot. The 2026-09-04
# caution about "the exact object shape ... could not be confirmed" was
# reasonable at the time but is superseded by this direct source read: no
# separate dashboard.desktopLayout1/mobileLayout write is required, or
# implemented here.
#
# 2026-09-06 RC2 finding, the real (narrower) blast radius of the
# underscore-ID bug: `getPanelName()` in that same bundle resolves a
# panel's display title via `panelName.split("_")[1]` - for
# "macrogroup_nebulaos_calibration" that yields "nebulaos" (not
# "nebulaos_calibration"), which fails `macrogroups.find(g => g.id ===
# "nebulaos")` and falls back to a generic "Macrogroup" label in the
# Settings > Dashboard "hide panels" list and the icon lookup. The panel's
# own card header text still reads correctly (it renders `group.name`
# directly, e.g. "Calibration"), and the panel-visibility filter uses a
# different, correct `name.slice(11)` extraction - so underscore IDs do
# not actually stop the six group panels from appearing or working; they
# only mislabel one secondary settings-list entry per group. Renaming to
# hyphenated IDs, as the mission requires regardless, removes this defect
# entirely (an id with no further "_" makes `split("_")[1]` recover the
# same string `slice(11)` does).
#
# Scope deliberately does NOT include dashboard-layout seeding for the
# reason given above (it is unnecessary, not merely deferred).
#
# Testable in full offline: see tests/nebulaos-seed-mainsail-macros-tests.py.

from __future__ import annotations

import json
import os
import sys
import time
import urllib.error
import urllib.request

MOONRAKER_BASE = os.environ.get("NEBULAOS_MOONRAKER_BASE", "http://127.0.0.1:7125")
NEBULAOS_ROOT = os.environ.get("NEBULAOS_ROOT", "/usr/data/nebulaos")
MARKER_PATH = os.environ.get(
    "NEBULAOS_MAINSAIL_MACRO_MARKER",
    os.path.join(NEBULAOS_ROOT, "system", "default-mainsail-macros-seeded.json"),
)

RETRY_ATTEMPTS = int(os.environ.get("NEBULAOS_MAINSAIL_SEED_RETRIES", "30"))
RETRY_DELAY_S = float(os.environ.get("NEBULAOS_MAINSAIL_SEED_RETRY_DELAY", "2"))

# NebulaOS-owned macro groups (Phase 2 upstream-first config refactor,
# 2026-09-05; renamed to hyphenated stable IDs, RC2 overnight closure,
# 2026-09-06 - Mainsail's own Dashboard.vue lineage parses a panel name
# as `"macrogroup_" + name.split("_")[1]`, so any further underscore in
# the id itself is unsafe; hyphens are not split on). Stable IDs (the DB
# key suffix) are owned by NebulaOS and must never change again once
# shipped in this hyphenated form - a later firmware version adding/
# editing a group's own CONTENTS re-seeds nothing for a group that
# already exists (never overwrite a user-modified group), but a brand
# new stable ID from a later version will still seed correctly into an
# existing install on next boot, which is exactly the "add only when
# missing" behavior.
#
# Every group carries explicit metadata (mission requirement): name,
# color, and the three state-visibility flags, in addition to its macro
# list - `color` is a Mainsail group accent, not a per-macro state gate;
# per-macro `showInStandby`/`showInPrinting`/`showInPause` (see _macro())
# are the real state restrictions and are deliberately NOT all opened up
# just because the containing panel is visible while printing (calibration/
# PID macros stay hidden mid-print even though the Calibration panel itself
# is visible in every state).
#
# Macro `name` values below are real [gcode_macro] names. NEBULAOS_*
# macros are public wrappers calling private _NEBULAOS_* Python backends
# (see calibration.cfg). Upstream UI adapters (AXIS_TWIST_X/Y, PID_BED/
# PID_HOTEND) expose upstream commands as one-click Mainsail buttons.
def _macro(pos, name, show_in_standby=True, show_in_printing=False, show_in_pause=False):
    return {
        "pos": pos,
        "name": name,
        "color": "",
        "showInStandby": show_in_standby,
        "showInPrinting": show_in_printing,
        "showInPause": show_in_pause,
    }


def _group(name, macros, show_in_standby=True, show_in_printing=True, show_in_pause=True):
    return {
        "name": name,
        "color": "primary",
        "showInStandby": show_in_standby,
        "showInPause": show_in_pause,
        "showInPrinting": show_in_printing,
        "macros": macros,
    }


