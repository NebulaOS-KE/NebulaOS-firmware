MODE_KEY = "macros.mode"
DEFAULT_MODE = "expert"


class TransportError(Exception):
    """Raised for any failure to reach Moonraker or parse its response -
    callers must always treat this as "unknown," never "safe to
    proceed." Deliberately does NOT distinguish "key not found" as a
    TransportError - see get_item(), which treats a 404 as a normal,
    expected "not seeded yet" result."""


def real_http_get(path: str) -> str:
    with urllib.request.urlopen(MOONRAKER_BASE + path, timeout=5) as resp:
        return resp.read().decode("utf-8")


def real_http_get_status(path: str):
    """Like real_http_get, but returns (status_or_None, body) instead of
    raising on a 404 - callers need to tell "key genuinely absent" apart
    from "transport failure," which a bare exception can't do cleanly
    across the fake/real boundary this module tests against."""
    try:
        with urllib.request.urlopen(MOONRAKER_BASE + path, timeout=5) as resp:
            return resp.status, resp.read().decode("utf-8")
    except urllib.error.HTTPError as exc:
        if exc.code == 404:
            return 404, None
        raise


def real_http_post_json(path: str, payload: dict) -> str:
    data = json.dumps(payload).encode("utf-8")
    req = urllib.request.Request(
        MOONRAKER_BASE + path,
        data=data,
        headers={"Content-Type": "application/json"},
        method="POST",
    )
    with urllib.request.urlopen(req, timeout=8) as resp:
        return resp.read().decode("utf-8")


def real_http_delete_status(path: str):
    """Same (status_or_None, body) contract as real_http_get_status,
    for DELETE /server/database/item - a 404 (key already gone) is a
    normal, expected outcome for an idempotent second run, never an
    error."""
    req = urllib.request.Request(MOONRAKER_BASE + path, method="DELETE")
    try:
        with urllib.request.urlopen(req, timeout=8) as resp:
            return resp.status, resp.read().decode("utf-8")
    except urllib.error.HTTPError as exc:
        if exc.code == 404:
            return 404, None
        raise


class NamespaceSnapshot:
    """G16 (2026-10-15): every lookup of a key that does not exist yet was a
    GET that Moonraker answered 404 - and logged, at every start. This wraps
    the transports: one read of the whole "mainsail" namespace (or none when
    the namespace does not exist) answers key lookups locally, an absent key
    is never deleted remotely, and every write drops the snapshot so the
    next lookup (e.g. the verification after a create) reads fresh. The
    seeding logic and its 404 contract are unchanged. Any failure here falls
    back to the plain per-key request."""

    PREFIX = "/server/database/item?namespace=mainsail&key="

    def __init__(self, get_status, post, delete):
        self._get, self._post, self._delete = get_status, post, delete
        self._ns = None

    def _load(self):
        if self._ns is None:
            status, body = self._get("/server/database/list")
            names = json.loads(body)["result"]["namespaces"] if status == 200 else None
            if names is None:
                raise TransportError("namespace list unavailable")
            if "mainsail" not in names:
                self._ns = {}
            else:
                status, body = self._get("/server/database/item?namespace=mainsail")
                if status != 200 or body is None:
                    raise TransportError("namespace read failed")
                value = json.loads(body)["result"]["value"]
                self._ns = value if isinstance(value, dict) else {}
        return self._ns

    def _lookup(self, key):
        node = self._load()
        for part in key.split("."):
            if not isinstance(node, dict) or part not in node:
                return False, None
            node = node[part]
        return True, node

    def get_status(self, path):
        if not path.startswith(self.PREFIX):
            return self._get(path)
        key = path[len(self.PREFIX):]
        try:
            found, value = self._lookup(key)
        except Exception:  # noqa: BLE001 - fall back to the per-key read
            return self._get(path)
        if not found:
            return 404, None
        return 200, json.dumps({"result": {"namespace": "mainsail", "key": key, "value": value}})

    def post(self, path, payload):
        self._ns = None
        return self._post(path, payload)

    def delete(self, path):
        if path.startswith(self.PREFIX):
            try:
                found, _ = self._lookup(path[len(self.PREFIX):])
                if not found:
                    return 404, None
            except Exception:  # noqa: BLE001 - let the real delete decide
                pass
        self._ns = None
        return self._delete(path)


def wait_for_moonraker(get_status, log, retry_attempts=RETRY_ATTEMPTS,
                        retry_delay=RETRY_DELAY_S, sleep=time.sleep) -> bool:
    """Polls a cheap, always-present database key (this project's own
    calibration-journal path is arbitrary; any namespace works, we only
    need "does Moonraker answer database requests at all") - bounded
    backoff, never raises."""
    # G67 (2026-10-16): Moonraker normally needs a few attempts at boot - one
    # line for the outcome, not one per attempt (was ~100 lines per boot).
    last_err = None
    for attempt in range(1, retry_attempts + 1):
        try:
            get_status("/server/database/list")
            if attempt > 1:
                log(f"Moonraker database API available after {attempt} attempts")
            return True
        except Exception as exc:  # noqa: BLE001
            last_err = exc
            if attempt < retry_attempts:
                sleep(retry_delay)
    log(f"Moonraker database API never became available after "
        f"{retry_attempts} attempts ({last_err})")
    return False


def get_item(get_status, key: str):
    """Returns the existing item's stored value, or None if the key
    genuinely does not exist yet. Raises TransportError for any other
    failure - a caller must never treat an ambiguous failure as "safe to
    create," since that could silently clobber something a real
    transport error merely hid from view."""
    path = f"/server/database/item?namespace=mainsail&key={key}"
    try:
        status, body = get_status(path)
    except Exception as exc:  # noqa: BLE001
        raise TransportError(str(exc)) from exc
    if status == 404:
        return None
    if body is None:
        raise TransportError("no response")
    try:
        parsed = json.loads(body)
    except Exception as exc:  # noqa: BLE001
        raise TransportError(f"malformed JSON: {exc}") from exc
    return parsed.get("result", {}).get("value")


def get_group(get_status, group_id: str):
    return get_item(get_status, f"macros.macrogroups.{group_id}")


def delete_item(delete, key: str) -> None:
    """Raises TransportError on anything but a clean delete or an
    already-absent key (404 - fine, idempotent)."""
    path = f"/server/database/item?namespace=mainsail&key={key}"
    try:
        status, _body = delete(path)
    except Exception as exc:  # noqa: BLE001
        raise TransportError(str(exc)) from exc
    if status not in (200, 404):
        raise TransportError(f"unexpected delete status {status}")


def migrate_legacy_group_ids(get_status, post, delete, log,
                              legacy_map: dict | None = None) -> dict:
    """Idempotent rename of every old underscore-style group ID to its
    hyphenated replacement, preserving the exact stored value (including
    any user edits to that group's macros/name/metadata) and touching
    nothing else - unrelated user-created groups are never enumerated or
    matched here at all, only the fixed, known legacy IDs.

    For each (old_id, new_id) pair:
      - old absent                          -> nothing to do (never
                                                shipped, or already
                                                migrated on a prior run)
      - old present, new absent             -> create new = old's value,
                                                verify, then delete old,
                                                verify deletion
      - old present, new present, equal     -> finish an interrupted
                                                prior migration: delete
                                                the now-redundant old key
      - old present, new present, different -> ambiguous (a real
                                                collision would mean
                                                something else wrote the
                                                new id first with
                                                different content) -
                                                touch neither, log it,
                                                let a human resolve it

    Returns a dict of old_id -> one of "migrated", "already_migrated",
    "not_present", "finished_interrupted", "ambiguous_left_untouched",
    "failed".
    """
    legacy_map = legacy_map if legacy_map is not None else LEGACY_GROUP_ID_MAP
    results = {}
    for old_id, new_id in legacy_map.items():
        try:
            old_value = get_group(get_status, old_id)
        except TransportError as exc:
            log(f"migration: could not check legacy group {old_id!r} ({exc}) - skipping")
            results[old_id] = "failed"
            continue

        if old_value is None:
            results[old_id] = "not_present"
            continue

        try:
            new_value = get_group(get_status, new_id)
        except TransportError as exc:
            log(f"migration: could not check target group {new_id!r} ({exc}) - "
                f"leaving legacy group {old_id!r} untouched this run")
            results[old_id] = "failed"
            continue

        if new_value is not None and new_value != old_value:
            log(f"migration: {new_id!r} already exists with content different "
                f"from legacy {old_id!r} - leaving both untouched (ambiguous, "
                "needs manual resolution)")
            results[old_id] = "ambiguous_left_untouched"
            continue

        if new_value is None:
            log(f"migration: renaming legacy group {old_id!r} -> {new_id!r}")
            try:
                post("/server/database/item", {
                    "namespace": "mainsail",
                    "key": f"macros.macrogroups.{new_id}",
                    "value": old_value,
                })
            except Exception as exc:  # noqa: BLE001
                log(f"migration: creating {new_id!r} failed ({exc}) - not "
                    f"deleting legacy {old_id!r}")
                results[old_id] = "failed"
                continue
            try:
                verify = get_group(get_status, new_id)
            except TransportError as exc:
                log(f"migration: could not verify {new_id!r} after creation "
                    f"({exc}) - not deleting legacy {old_id!r}")
                results[old_id] = "failed"
                continue
            if verify != old_value:
                log(f"migration: {new_id!r} verification mismatch after "
                    f"creation - not deleting legacy {old_id!r}")
                results[old_id] = "failed"
                continue

        # Either we just created new_id (verified equal to old_value), or
        # new_id already existed and was already equal to old_value
        # (interrupted prior run) - either way, old_id is now fully
        # redundant and safe to delete.
        try:
            delete_item(delete, f"macros.macrogroups.{old_id}")
        except TransportError as exc:
            log(f"migration: {new_id!r} is correct, but deleting legacy "
                f"{old_id!r} failed ({exc}) - will retry next run")
            results[old_id] = "failed"
            continue

        if old_value == new_value:
            log(f"migration: legacy group {old_id!r} was already migrated to "
                f"{new_id!r} on a prior, interrupted run - cleanup finished")
            results[old_id] = "finished_interrupted"
        else:
            log(f"migration: legacy group {old_id!r} fully migrated to {new_id!r}")
            results[old_id] = "migrated"

    return results


def migrate_rc3_to_final(get_status, post, delete, log,
                          rc3_groups: dict | None = None,
                          final_groups: dict | None = None) -> dict:
    """Migrates macro groups from the RC3 six-group schema to the final
    five-group schema. For each RC3 group:
    - Unchanged between RC3 and final (camera, maintenance): skip
    - Removed in final (input-shaper): delete if DB matches RC3 exactly
    - Changed in final (calibration, extruder, recovery): replace if DB
      matches RC3 exactly
    User-modified groups are never touched.

    Returns a dict of group_id -> one of "migrated", "removed",
    "already_final", "not_present", "unchanged",
    "user_modified_left_untouched", "failed".
    """
    rc3_groups = rc3_groups if rc3_groups is not None else RC3_GROUPS
    final_groups = final_groups if final_groups is not None else DEFAULT_GROUPS
    results = {}

    for group_id, rc3_def in rc3_groups.items():
        final_def = final_groups.get(group_id)

        if final_def is not None and final_def == rc3_def:
            results[group_id] = "unchanged"
            continue

        try:
            existing = get_group(get_status, group_id)
        except TransportError as exc:
            log(f"rc3 migration: could not check {group_id!r} ({exc}) - skipping")
            results[group_id] = "failed"
            continue

        if existing is None:
            results[group_id] = "not_present"
            continue

        if existing != rc3_def:
            if final_def is not None and existing == final_def:
                log(f"rc3 migration: {group_id!r} already matches final schema")
                results[group_id] = "already_final"
            else:
                log(f"rc3 migration: {group_id!r} differs from RC3 default — "
                    "user-modified, leaving untouched")
                results[group_id] = "user_modified_left_untouched"
            continue

        if final_def is None:
            log(f"rc3 migration: removing obsolete group {group_id!r}")
            try:
                delete_item(delete, f"macros.macrogroups.{group_id}")
            except TransportError as exc:
                log(f"rc3 migration: deleting {group_id!r} failed ({exc})")
                results[group_id] = "failed"
                continue
            results[group_id] = "removed"
        else:
            log(f"rc3 migration: updating {group_id!r} from RC3 to final schema")
            try:
                post("/server/database/item", {
                    "namespace": "mainsail",
                    "key": f"macros.macrogroups.{group_id}",
                    "value": final_def,
                })
            except Exception as exc:  # noqa: BLE001
                log(f"rc3 migration: updating {group_id!r} failed ({exc})")
                results[group_id] = "failed"
                continue
            try:
                verify = get_group(get_status, group_id)
            except TransportError as exc:
                log(f"rc3 migration: could not verify {group_id!r} after update ({exc})")
                results[group_id] = "failed"
                continue
            if verify != final_def:
                log(f"rc3 migration: {group_id!r} verification mismatch after update")
                results[group_id] = "failed"
                continue
            results[group_id] = "migrated"

    return results


def seed_default_mode(get_status, post, log,
                       mode_key: str = MODE_KEY, default_mode: str = DEFAULT_MODE) -> str:
    """Sets macros.mode to `default_mode` ONLY if the key does not exist
    in the database at all yet. Mainsail's own Settings > Macros tab
    writes this key exclusively in response to an explicit user toggle
    (`gui/macros/saveSetting`, confirmed by reading the pinned v2.18.2
    bundle directly) - it is never written as a side effect of merely
    opening the app or a getter default. A missing key therefore reliably
    means "no one, ever, has touched this setting" - whether this is a
    brand new install or an existing one that predates NebulaOS shipping
    an opinion on it at all (this key was never seeded before 2026-09-06).
    Once any value is present, it is left alone forever - this is a
    one-time default, never a persistent "force expert" mechanism; a user
    who later chooses Simple in Settings stays on Simple across reboots
    and updates.

    Returns one of "seeded", "already_set", "failed".
    """
    try:
        existing = get_item(get_status, mode_key)
    except TransportError as exc:
        log(f"mode default: could not check {mode_key!r} ({exc}) - skipping this run")
        return "failed"

    if existing is not None:
        log(f"mode default: {mode_key!r} already set to {existing!r} - leaving it untouched")
        return "already_set"

    log(f"mode default: {mode_key!r} not set - seeding default {default_mode!r}")
    try:
        post("/server/database/item", {
            "namespace": "mainsail",
            "key": mode_key,
            "value": default_mode,
        })
    except Exception as exc:  # noqa: BLE001
        log(f"mode default: seeding {mode_key!r} failed ({exc})")
        return "failed"

    try:
        verify = get_item(get_status, mode_key)
    except TransportError as exc:
        log(f"mode default: could not verify {mode_key!r} after seeding ({exc})")
        return "failed"

    if verify != default_mode:
        log(f"mode default: {mode_key!r} verification mismatch after seeding "
            f"(got {verify!r}, expected {default_mode!r})")
        return "failed"

    log(f"mode default: {mode_key!r} seeded and verified as {default_mode!r}")
    return "seeded"


def reset_to_defaults(get_status, post, delete, log,
                       groups: dict | None = None,
                       obsolete_ids: set | None = None,
                       mode_key: str = MODE_KEY,
                       default_mode: str = DEFAULT_MODE) -> dict:
    """Phase 2 final live convergence mission (2026-09-09): the explicit,
    user-invoked counterpart to run() above. run() is boot-time seeding -
    it NEVER overwrites an existing group, by design, so a user's own
    customization always survives. This function is the opposite: it
    unconditionally deletes and recreates every canonical NebulaOS group
    plus `mode_key`, discarding whatever currently exists there. It must
    only ever be called in response to an explicit user request
    (`nebulaos-recover mainsail --reset-state`) - never from boot-time
    seeding, never as a side effect of anything else.

    Scope is deliberately narrow: only the known group keys
    (`macros.macrogroups.<id>` for each id in `groups`) and `mode_key`
    are touched. Every other key in the `mainsail` namespace - dashboard
    panel layout, gcodeViewer/gcodehistory settings, initVersion, or a
    user's own custom group under an id NebulaOS doesn't own - is never
    read, written, or deleted by this function. A user's own additional
    group (an id not in `groups`) is left completely alone; only the
    five canonical NebulaOS ids are ever touched here.

    `obsolete_ids` are known NebulaOS-owned group ids that existed in an
    earlier schema generation but are not part of the current `groups` -
    the standalone "nebulaos-input-shaper" RC3 group is the only one that
    has ever existed. A reset deletes these too (if present) so the
    result is genuinely exactly five groups even starting from a stale
    six-group RC3 install, not "five plus whatever obsolete groups
    happened to survive." Unlike the canonical groups, obsolete ids are
    only ever deleted, never recreated. Defaults to the one real
    historical case; explicit override exists for testing.

    Returns {"groups": {group_id: "reset"|"failed"}, "mode": "reset"|"failed"}.
    Never raises - every failure is caught, logged, and reflected in the
    returned dict so a caller can report exactly what did and did not
    succeed rather than inferring it from an exit code alone.
    """
    groups = groups if groups is not None else DEFAULT_GROUPS
    obsolete_ids = obsolete_ids if obsolete_ids is not None else {"nebulaos-input-shaper"}
    group_results = {}

    for obsolete_id in obsolete_ids:
        if obsolete_id in groups:
            continue  # never obsolete if it's also a current canonical id
        try:
            delete_item(delete, f"macros.macrogroups.{obsolete_id}")
            log(f"reset: removed obsolete group {obsolete_id!r} (not part of the current five-group schema)")
        except TransportError as exc:
            log(f"reset: could not remove obsolete group {obsolete_id!r} ({exc}) - it may still be present")
            group_results[obsolete_id] = "failed"

    for group_id, definition in groups.items():
        try:
            delete_item(delete, f"macros.macrogroups.{group_id}")
        except TransportError as exc:
            log(f"reset: could not delete existing group {group_id!r} ({exc}) - leaving it untouched, not reset")
            group_results[group_id] = "failed"
            continue

        try:
            post("/server/database/item", {
                "namespace": "mainsail",
                "key": f"macros.macrogroups.{group_id}",
                "value": definition,
            })
        except Exception as exc:  # noqa: BLE001
            log(f"reset: creating canonical group {group_id!r} failed ({exc}) - group is now DELETED, not recreated (retry the reset)")
            group_results[group_id] = "failed"
            continue

        try:
            verify = get_group(get_status, group_id)
        except TransportError as exc:
            log(f"reset: could not verify group {group_id!r} after reset ({exc})")
            group_results[group_id] = "failed"
            continue

        if verify != definition:
            log(f"reset: group {group_id!r} verification mismatch after reset (creation reported success but stored content differs)")
            group_results[group_id] = "failed"
            continue

        log(f"reset: group {group_id!r} reset to canonical default ({definition['name']!r}, {len(definition['macros'])} macros) and verified")
        group_results[group_id] = "reset"

    try:
        delete_item(delete, mode_key)
    except TransportError as exc:
        log(f"reset: could not delete existing {mode_key!r} ({exc}) - mode not reset")
        mode_result = "failed"
    else:
        # Reuse seed_default_mode() rather than a parallel post+verify -
        # having just deleted the key, its own "only set if absent" check
        # is now exactly the "set to the canonical default" behavior this
        # reset needs, so there's only one code path that ever writes
        # macros.mode across the whole seeder.
        mode_seed_result = seed_default_mode(get_status, post, log, mode_key, default_mode)
        mode_result = "reset" if mode_seed_result == "seeded" else "failed"

    return {"groups": group_results, "mode": mode_result}


def read_marker(path: str):
    if not os.path.exists(path):
        return None
    try:
        with open(path) as f:
            return json.load(f)
    except Exception:  # noqa: BLE001
        return None


def write_marker_atomic(path: str, data: dict) -> None:
    d = os.path.dirname(path)
    os.makedirs(d, exist_ok=True)
    tmp = path + ".partial"
    with open(tmp, "w") as f:
        json.dump(data, f, indent=2)
        f.write("\n")
        f.flush()
        os.fsync(f.fileno())
    os.replace(tmp, path)


def _now() -> str:
    return time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())


def run(
    get_status=real_http_get_status,
    post=real_http_post_json,
    delete=real_http_delete_status,
    marker_path: str | None = None,
    log=print,
    groups: dict | None = None,
    legacy_map: dict | None = None,
    rc3_groups: dict | None = None,
    mode_key: str = MODE_KEY,
    default_mode: str = DEFAULT_MODE,
    retry_attempts: int = RETRY_ATTEMPTS,
    retry_delay: float = RETRY_DELAY_S,
    sleep=time.sleep,
) -> int:
    """Returns 0 on success (including "nothing new to do") or 1 on a
    safe, logged, non-fatal failure. Never raises. Idempotent by
    construction: every group is independently checked via its own
    stable DB key before any write, and an existing key (whether
    NebulaOS-seeded before or user-edited) is NEVER overwritten - a
    second run makes no changes once every group already exists, every
    legacy ID is already migrated, and macros.mode is already set."""
    marker_path = marker_path or MARKER_PATH
    groups = groups if groups is not None else DEFAULT_GROUPS

    if not wait_for_moonraker(get_status, log, retry_attempts, retry_delay, sleep):
        return 1

    migration_results = migrate_legacy_group_ids(get_status, post, delete, log, legacy_map)

    rc3_results = migrate_rc3_to_final(get_status, post, delete, log, rc3_groups, groups)
    if groups is DEFAULT_GROUPS:
        # Later defaults (G83a, G87, Run 21, G101): same exact-match upgrade,
        # newest fixture last.
        for fixture in (PRE_G83A_GROUPS, PRE_G87_GROUPS, PRE_RUN21_GROUPS, PRE_G101_GROUPS):
            for group_id, result in migrate_rc3_to_final(
                    get_status, post, delete, log, fixture, groups).items():
                if result in ("migrated", "failed", "already_final"):
                    rc3_results[group_id] = result

    created = []
    already_present = []
    failed = []

    for group_id, definition in groups.items():
        try:
            existing = get_group(get_status, group_id)
        except TransportError as exc:
            log(f"could not check group {group_id!r} ({exc}) - skipping this "
                "group this run, not writing marker for it")
            failed.append(group_id)
            continue

        if existing is not None:
            log(f"group {group_id!r} already present in the mainsail namespace "
                "- leaving it untouched")
            already_present.append(group_id)
            continue

        log(f"group {group_id!r} not present - seeding default "
            f"({definition['name']!r}, {len(definition['macros'])} macros)")
        try:
            post("/server/database/item", {
                "namespace": "mainsail",
                "key": f"macros.macrogroups.{group_id}",
                "value": definition,
            })
        except Exception as exc:  # noqa: BLE001
            log(f"seeding group {group_id!r} failed ({exc}) - not marking it seeded")
            failed.append(group_id)
            continue

        try:
            verify = get_group(get_status, group_id)
        except TransportError as exc:
            log(f"could not re-verify group {group_id!r} after seeding ({exc}) - "
                "not marking it seeded (creation may or may not have actually "
                "succeeded; never trust HTTP status alone)")
            failed.append(group_id)
            continue

        if verify != definition:
            log(f"group {group_id!r} seeding POST reported success but "
                "verification found different content afterward - not "
                "marking it seeded")
            failed.append(group_id)
            continue

        log(f"group {group_id!r} created and verified")
        created.append(group_id)

    mode_result = seed_default_mode(get_status, post, log, mode_key, default_mode)

    migration_failed = [k for k, v in migration_results.items()
                        if v in ("failed", "ambiguous_left_untouched")]
    rc3_failed = [k for k, v in rc3_results.items() if v == "failed"]

    write_marker_atomic(marker_path, {
        "schema_version": SCHEMA_VERSION,
        "checked_at": _now(),
        "created": created,
        "already_present": already_present,
        "failed": failed,
        "migration": migration_results,
        "rc3_migration": rc3_results,
        "mode_default": mode_result,
    })
    log(f"marker written ({marker_path}): schema_version={SCHEMA_VERSION} "
        f"created={created} already_present={already_present} failed={failed} "
        f"migration={migration_results} rc3_migration={rc3_results} "
        f"mode_default={mode_result}")

    return 1 if (failed or migration_failed or rc3_failed or mode_result == "failed") else 0


def run_reset(
    get_status=real_http_get_status,
    post=real_http_post_json,
    delete=real_http_delete_status,
    log=print,
    groups: dict | None = None,
    mode_key: str = MODE_KEY,
    default_mode: str = DEFAULT_MODE,
    retry_attempts: int = RETRY_ATTEMPTS,
    retry_delay: float = RETRY_DELAY_S,
    sleep=time.sleep,
) -> int:
    """CLI entry point for `nebulaos-seed-mainsail-macros --reset`, called
    by `nebulaos-recover mainsail --reset-state` (scripts/build/overlay/
    usr/bin/nebulaos-recover) after it has already backed up the mainsail
    namespace and restored the Mainsail frontend from the immutable
    baseline. Returns 0 only if every group and the mode key were reset
    and verified; 1 on any failure, with per-item detail already logged
    by reset_to_defaults() itself."""
    if not wait_for_moonraker(get_status, log, retry_attempts, retry_delay, sleep):
        return 1
    # Keyword args only past the first 4: reset_to_defaults()'s positional
    # order is (groups, obsolete_ids, mode_key, default_mode) - a prior
    # positional call here (groups, mode_key, default_mode) silently
    # shifted mode_key into the obsolete_ids slot and default_mode into
    # the mode_key slot. Never caught by unit tests, since every existing
    # test called reset_to_defaults() directly with keyword args, never
    # through run_reset() itself. Reproduced live (Phase 2 final live
    # convergence mission, 2026-09-09): a real --reset-state run tried to
    # delete obsolete groups named 'm', 'a', 'c', ... - iterating the
    # characters of the string "macros.mode" passed in place of the
    # obsolete_ids set.
    result = reset_to_defaults(get_status, post, delete, log,
                                groups=groups, mode_key=mode_key,
                                default_mode=default_mode)
    log(f"reset complete: groups={result['groups']} mode={result['mode']}")
    failed_groups = [g for g, r in result["groups"].items() if r == "failed"]
    return 1 if (failed_groups or result["mode"] == "failed") else 0


if __name__ == "__main__":
    _t = NamespaceSnapshot(real_http_get_status, real_http_post_json, real_http_delete_status)
    if len(sys.argv) > 1 and sys.argv[1] == "--reset":
        sys.exit(run_reset(get_status=_t.get_status, post=_t.post, delete=_t.delete))
    sys.exit(run(get_status=_t.get_status, post=_t.post, delete=_t.delete))
