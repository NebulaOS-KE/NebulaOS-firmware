#!/bin/sh
#
# nebulaos-recover - offline recovery tool for NebulaOS runtime components
#
# Restores a mutable runtime component from the immutable baked copy on the
# read-only squashfs. Manual only, works offline, no automatic rollback.
#
# Subcommands:
#   status              Show activation state of all components
#   klipper             Restore Klipper from its immutable seed tarball
#   moonraker           Restore Moonraker from its immutable seed tarball
#   mainsail            Restore Mainsail from the immutable squashfs copy
#   klipper-extensions  Restore extensions from immutable squashfs
#
# The immutable squashfs is the source of truth. Each recovery replaces the
# mutable /usr/data/nebulaos/apps/<component> with a fresh, verified copy,
# then requires a reboot for S05nebulaos-activate to re-bind.
#
# Phase 2 overnight convergence mission (2026-09-09): klipper/moonraker
# recovery deliberately does NOT read through /opt/klipper or
# /opt/moonraker any more, even though those paths are commonly described
# elsewhere as "the immutable copy" - on a device where
# S05nebulaos-activate has already bound a persistent copy over them
# (the normal, common case, exactly when recovery is actually needed),
# they resolve to the very persistent copy being recovered, not the
# read-only squashfs underneath. Proven live: deliberately corrupting the
# persistent klipper checkout, then running the previous implementation
# (`cp -a /opt/klipper/. "$dst"/`), produced a "Recovery complete"
# message while silently copying the corruption onto itself. Recovery for
# these two now extracts directly from $SEEDS/<component>.tar.gz (real,
# non-bundled git history, always present on the squashfs, never bind-
# mounted), verified with the same branch/origin/clean-tree discipline
# S04nebulaos-migrate's reseed_git_app() already established, before ever
# promoting it over the current persistent copy. Mainsail has no such
# tarball (it is a plain static release tree, not a git repo - see
# S04nebulaos-factory-seed's own comment on why) and unmounts its own
# bind point first instead, to reveal the same real squashfs content the
# git-based approach reads from a tarball.

set -eu

NEBULAOS_ROOT="${NEBULAOS_ROOT:-/usr/data/nebulaos}"
APPS_DIR="$NEBULAOS_ROOT/apps"
ACTIVATION_STATE="$NEBULAOS_ROOT/system/activation-state.json"
SEEDS="${SEEDS:-/opt/nebulaos-seeds}"
MOUNT_BIN="${MOUNT_BIN:-mount}"
UMOUNT_BIN="${UMOUNT_BIN:-umount}"
PROC_MOUNTS="${PROC_MOUNTS:-/proc/mounts}"
MOONRAKER_URL="${MOONRAKER_URL:-http://127.0.0.1:7125}"
CURL_BIN="${CURL_BIN:-curl}"
PYTHON3="${PYTHON3:-/usr/bin/python3}"
MAINSAIL_SEEDER="${MAINSAIL_SEEDER:-/usr/libexec/nebulaos-seed-mainsail-macros}"
MAINSAIL_NAMESPACE_BACKUP_DIR="${MAINSAIL_NAMESPACE_BACKUP_DIR:-$NEBULAOS_ROOT/system/mainsail-namespace-backups}"
# Phase 2 final software closure mission, 2026-09-09 - see
# config-materialize.sh's own header.
SYSTEM="${SYSTEM:-$NEBULAOS_ROOT/system}"
BACKUP_ROOT="${BACKUP_ROOT:-$SYSTEM/migration-backups}"
PRINTER_DATA_CONFIG="${PRINTER_DATA_CONFIG:-$NEBULAOS_ROOT/printer_data/config}"
NEBULAOS_KLIPPER_CFG_DIR="${NEBULAOS_KLIPPER_CFG_DIR:-/etc/nebulaos/klipper}"
CONFIG_MATERIALIZE_LIB="${CONFIG_MATERIALIZE_LIB:-/etc/nebulaos/config-materialize.sh}"

# Immutable source paths (on the read-only squashfs). Used ONLY by
# cmd_status's bind-mount display and by cmd_mainsail (see its own
# comment for why Mainsail alone has no seed tarball and must instead
# unmount to reach its real immutable copy) - klipper/moonraker recovery
# below deliberately does NOT read through these paths any more (see
# recover_git_component()'s own comment for the real-device bug that
# forced this).
IMMUTABLE_KLIPPER="${IMMUTABLE_KLIPPER:-/opt/klipper}"
IMMUTABLE_MOONRAKER="${IMMUTABLE_MOONRAKER:-/opt/moonraker}"
IMMUTABLE_MAINSAIL="${IMMUTABLE_MAINSAIL:-/usr/share/mainsail}"

die() { echo "nebulaos-recover: error: $1" >&2; exit 1; }
warn() { echo "nebulaos-recover: warning: $1" >&2; }
# config-materialize.sh's own functions call log() - this script doesn't
# otherwise need one, but must define it before sourcing that library.
log() { echo "$1"; }

# ---------- status ----------

cmd_status() {
    echo "NebulaOS Component Recovery Status"
    echo "==================================="
    echo ""

    if [ -f "$ACTIVATION_STATE" ]; then
        echo "Activation state file: $ACTIVATION_STATE"
        echo ""
    else
        echo "No activation state file found."
        echo "(Components may be running from immutable squashfs.)"
        echo ""
    fi

    for component in klipper moonraker mainsail nebulaos-klipper-extensions; do
        _persistent="$APPS_DIR/$component"
        _immutable=""

        case "$component" in
            klipper)              _immutable="$IMMUTABLE_KLIPPER" ;;
            moonraker)            _immutable="$IMMUTABLE_MOONRAKER" ;;
            mainsail)             _immutable="$IMMUTABLE_MAINSAIL" ;;
            nebulaos-klipper-extensions) _immutable="(composed into klipper)" ;;
        esac

        printf "  %-30s" "$component:"
        if [ -d "$_persistent" ]; then
            echo "persistent copy present"
        else
            echo "no persistent copy (using immutable)"
        fi
    done

    echo ""

    # Check bind mount status (only meaningful on device, not dev host)
    if [ -f /proc/mounts ]; then
        echo "Active bind mounts:"
        for mount_target in /opt/klipper /opt/moonraker /usr/share/mainsail; do
            if awk -v t="$mount_target" '$2==t {found=1} END{exit !found}' /proc/mounts 2>/dev/null; then
                printf "  %-30s%s\n" "$mount_target:" "bind-mounted (persistent)"
            else
                printf "  %-30s%s\n" "$mount_target:" "immutable squashfs"
            fi
        done
    fi
}

# ---------- recover helpers ----------

stop_services() {
    _component="$1"
    case "$_component" in
        klipper|klipper-extensions)
            echo "Stopping Klipper..."
            /etc/init.d/S55klipper stop 2>/dev/null || true
            if [ -f /etc/init.d/S54nebulaos-host-mcu ]; then
                /etc/init.d/S54nebulaos-host-mcu stop 2>/dev/null || true
            fi
            ;;
        moonraker)
            echo "Stopping Moonraker..."
            /etc/init.d/S56moonraker stop 2>/dev/null || true
            ;;
        mainsail)
            echo "Mainsail is static files; no service to stop."
            ;;
    esac
}

# Phase 2 overnight convergence mission (2026-09-09): the original
# do_recover() this replaced did `cp -a "$IMMUTABLE_*"/. "$dst"/`, where
# IMMUTABLE_KLIPPER/MOONRAKER are "/opt/klipper"/"/opt/moonraker" - the
# BIND MOUNT TARGETS S05nebulaos-activate points at the very persistent
# copy being recovered, not the true read-only squashfs content. Proven
# live: deliberately deleting klippy/klippy.py from the persistent copy,
# then running the old `nebulaos-recover klipper`, produced a "Recovery
# complete" message while the restored copy was BYTE-FOR-BYTE IDENTICAL
# to the corrupted one (same 405 files, klippy.py still missing) -
# because /opt/klipper's bind mount kept resolving to the same
# underlying (just-renamed-but-still-mounted) inode throughout the whole
# operation, so the tool copied the corruption onto itself and reported
# success. The bug is structural, not a one-off: the exact same
# do_recover() call sites existed for moonraker (identical code path)
# and mainsail (same "/opt-style path doubles as both the live bind
# mount and the claimed immutable source" pattern) - so it was never
# just a klipper defect.
#
# Fix for klipper/moonraker: never read through the (possibly
# bind-mounted) /opt/* path at all. Extract directly from this project's
# own seed tarballs at $SEEDS/<component>.tar.gz - real, non-bundled git
# history, always present on the read-only squashfs, never touched by
# any bind mount - using the exact same verify-before-trust discipline
# S04nebulaos-migrate's reseed_git_app() already established (branch,
# origin, and clean-working-tree checks on the EXTRACTED copy before it
# is ever considered good enough to promote), reused here rather than
# reimplemented independently. A failure at any verification step
# leaves the current persistent copy completely untouched - the
# component keeps running on whatever it had, corrupted or not, rather
# than risk an unverified swap.
recover_git_component() {
    _component="$1"
    _branch="$2"
    _origin="$3"
    _archive="$SEEDS/$_component.tar.gz"
    _persistent_dst="$APPS_DIR/$_component"
    _backup_dst="${_persistent_dst}.pre-recovery.$(date +%Y%m%d-%H%M%S)"
    _partial="${_persistent_dst}.recover-partial"

    if [ ! -f "$_archive" ]; then
        die "seed archive not found at $_archive (not running on a NebulaOS device?) - cannot recover $_component, persistent copy left untouched"
    fi

    echo "Recovering $_component from $_archive"
    echo ""

    stop_services "$_component"

    rm -rf "$_partial"
    mkdir -p "$_partial"
    if ! sh -c "gzip -dc '$_archive' | tar -xo -C '$_partial'"; then
        rm -rf "$_partial"
        die "tar extraction failed for $_component - persistent copy left untouched"
    fi

    _actual_branch=$(git -C "$_partial" symbolic-ref --short HEAD 2>/dev/null || true)
    if [ "$_actual_branch" != "$_branch" ]; then
        rm -rf "$_partial"
        die "$_component extracted checkout is on branch '$_actual_branch', expected '$_branch' - refusing rather than promoting an unverified copy, persistent copy left untouched"
    fi
    _actual_origin=$(git -C "$_partial" remote get-url origin 2>/dev/null || true)
    if [ "$_actual_origin" != "$_origin" ]; then
        rm -rf "$_partial"
        die "$_component extracted checkout has origin '$_actual_origin', expected '$_origin' - refusing rather than promoting an unverified copy, persistent copy left untouched"
    fi
    if [ -n "$(git -C "$_partial" status --porcelain 2>/dev/null || true)" ]; then
        rm -rf "$_partial"
        die "$_component extracted checkout has an unexpectedly dirty working tree - refusing rather than promoting an unverified copy, persistent copy left untouched"
    fi

    if [ -d "$_persistent_dst" ]; then
        echo "Moving existing persistent copy to $_backup_dst"
        mv "$_persistent_dst" "$_backup_dst"
    fi
    mv "$_partial" "$_persistent_dst"

    echo ""
    echo "Recovery complete for $_component (verified: branch $_branch, $(git -C "$_persistent_dst" rev-parse HEAD))."
    echo "A reboot is required for S05nebulaos-activate to re-bind."
    echo ""
    echo "If recovering klipper, also recover klipper-extensions to"
    echo "ensure the composed symlinks are consistent."
}

# ---------- individual component commands ----------

cmd_klipper() {
    recover_git_component "klipper" "master" "https://github.com/Klipper3d/klipper.git"
}

cmd_moonraker() {
    recover_git_component "moonraker" "master" "https://github.com/Arksine/moonraker.git"
}

# Mainsail has no seed tarball (S04nebulaos-factory-seed's own header:
# "Mainsail needs no seed archive - it is already a plain static release
# tree, not a git repo ... the existing /usr/share/mainsail copy IS its
# own offline seed") - it is a plain directory the image ships directly
# at /usr/share/mainsail on the squashfs. The same bind-mount bug applies
# though: once S05nebulaos-activate has bound a persistent copy over
# that path, /usr/share/mainsail no longer shows the immutable content,
# it shows the persistent copy - reading through it "recovers" nothing.
# Unmounting the bind (if one is active) reveals the real squashfs
# content at that same path - what a plain bind mount always does - so
# recovery here does that first, copies from the now-genuine immutable
# path, then re-binds the fresh persistent copy so Mainsail keeps
# serving for the remainder of this boot (a reboot re-does this anyway
# via S05, matching every other component here).
# Phase 2 final live convergence mission (2026-09-09) - frozen product
# semantics, see docs/NEBULAOS_MAINSAIL_RESET.md (or this function's own
# comment if that doc does not exist yet):
#
#   nebulaos-recover mainsail                repair/restore the immutable
#                                             Mainsail FRONTEND FILES only.
#                                             PRESERVES the user's
#                                             Moonraker `mainsail` DB
#                                             namespace (macro groups,
#                                             mode, dashboard layout,
#                                             everything) - never touches
#                                             it, exactly like every other
#                                             `nebulaos-recover` component
#                                             recovery never touches
#                                             runtime data belonging to
#                                             the component it restores.
#
#   nebulaos-recover mainsail --reset-state  the above, PLUS an explicit,
#                                             intentionally destructive
#                                             reset of Mainsail's
#                                             NebulaOS-owned database
#                                             state (the five macro groups
#                                             and macros.mode) back to the
#                                             shipped qualified defaults.
#                                             Only ever runs because the
#                                             user explicitly asked for
#                                             it via this flag - never a
#                                             side effect of plain
#                                             recovery, never automatic.
#
# This distinction exists because "restore Mainsail's code from the
# immutable image" and "reset Mainsail's user data to factory defaults"
# are two different operations that happen to share a frontend-restore
# step - conflating them would mean a user recovering a corrupted
# Mainsail install after, say, a failed self-update also loses every
# macro-panel customization they ever made, which nothing about "my
# frontend files got corrupted" implies they wanted.
cmd_mainsail() {
    _reset_state=0
    case "${1:-}" in
        --reset-state) _reset_state=1 ;;
        "") ;;
        *) die "unknown option '$1' for mainsail. Usage: nebulaos-recover mainsail [--reset-state]" ;;
    esac

    _target="$IMMUTABLE_MAINSAIL"
    _persistent_dst="$APPS_DIR/mainsail"
    _backup_dst="${_persistent_dst}.pre-recovery.$(date +%Y%m%d-%H%M%S)"
    _was_bind_mounted=0

    if [ "$_reset_state" = "1" ]; then
        echo "Recovering mainsail (frontend + explicit --reset-state) from the immutable squashfs at $_target"
    else
        echo "Recovering mainsail from the immutable squashfs at $_target"
    fi
    echo ""

    # --reset-state's namespace backup happens BEFORE anything else is
    # touched, frontend restore included - "if backup fails: do not
    # mutate" applies to the whole operation, not just the DB half of it.
    if [ "$_reset_state" = "1" ]; then
        _namespace_backup_path=$(mainsail_backup_namespace) || die "mainsail --reset-state: namespace backup failed - refusing to proceed, nothing has been touched"
        echo "Mainsail namespace backed up to $_namespace_backup_path before any change"
        echo ""
    fi

    if awk -v t="$_target" '$2==t {found=1} END{exit !found}' "$PROC_MOUNTS" 2>/dev/null; then
        echo "Unmounting the persistent bind mount at $_target to reveal the immutable copy underneath..."
        if ! "$UMOUNT_BIN" "$_target"; then
            die "could not unmount $_target - refusing to guess, persistent copy left untouched"
        fi
        _was_bind_mounted=1
    fi

    if [ -d "$_persistent_dst" ]; then
        echo "Moving existing persistent copy to $_backup_dst"
        mv "$_persistent_dst" "$_backup_dst"
    fi

    echo "Copying immutable source to $_persistent_dst..."
    mkdir -p "$_persistent_dst"
    cp -a "$_target"/. "$_persistent_dst"/

    if [ "$_was_bind_mounted" = "1" ]; then
        echo "Re-binding the fresh persistent copy over $_target for the remainder of this boot..."
        "$MOUNT_BIN" --bind "$_persistent_dst" "$_target" \
            || warn "could not re-bind $_target - a reboot will fix this (S05nebulaos-activate re-binds on every boot)"
    fi

    if [ "$_reset_state" = "1" ]; then
        echo ""
        echo "Resetting Mainsail's NebulaOS-owned database state (macro groups + mode) to shipped defaults..."
        if [ ! -f "$MAINSAIL_SEEDER" ]; then
            die "mainsail --reset-state: seeder not found at $MAINSAIL_SEEDER - frontend was restored, but the namespace was NOT reset. Backup remains at $_namespace_backup_path"
        fi
        if ! NEBULAOS_MOONRAKER_BASE="$MOONRAKER_URL" "$PYTHON3" "$MAINSAIL_SEEDER" --reset; then
            die "mainsail --reset-state: namespace reset reported failure - see output above for exactly which group(s) or the mode key failed. Frontend was restored; namespace may be PARTIALLY reset. Backup remains at $_namespace_backup_path - do not assume success"
        fi
        echo "Namespace reset reported success for all five groups and macros.mode."
        echo "Backup of the pre-reset namespace remains at $_namespace_backup_path"
    fi

    echo ""
    echo "Recovery complete for mainsail."
    echo "A reboot is required for S05nebulaos-activate to re-bind."
}

# Backs up ONLY the `mainsail` Moonraker database namespace (never the
# whole database) to a timestamped JSON file under
# $MAINSAIL_NAMESPACE_BACKUP_DIR, verifies the write by reading it back
# and confirming it round-trips as valid, non-empty JSON, and prints the
# backup's path on success. Any failure - Moonraker unreachable, empty/
# malformed response, write failure, readback mismatch - is a hard
# failure (non-zero exit, nothing printed to stdout) so a caller using
# `path=$(mainsail_backup_namespace) || die ...` never mistakes a failed
# backup for a real one.
mainsail_backup_namespace() {
    if ! "$CURL_BIN" -sf "${MOONRAKER_URL}/server/database/list" >/dev/null 2>&1; then
        echo "mainsail_backup_namespace: Moonraker unreachable at $MOONRAKER_URL" >&2
        return 1
    fi

    _body=$("$CURL_BIN" -sf "${MOONRAKER_URL}/server/database/item?namespace=mainsail" 2>/dev/null)
    if [ -z "$_body" ]; then
        echo "mainsail_backup_namespace: empty response reading the mainsail namespace" >&2
        return 1
    fi
    if ! echo "$_body" | "$PYTHON3" -c 'import json,sys; d=json.load(sys.stdin); assert "result" in d and "value" in d["result"]' 2>/dev/null; then
        echo "mainsail_backup_namespace: response did not parse as a valid namespace item" >&2
        return 1
    fi

    mkdir -p "$MAINSAIL_NAMESPACE_BACKUP_DIR"
    _ts=$(date -u +%Y%m%dT%H%M%SZ)
    _out="$MAINSAIL_NAMESPACE_BACKUP_DIR/mainsail-namespace.$_ts.json"
    _tmp="$_out.partial"
    echo "$_body" > "$_tmp"
    sync

    if [ ! -s "$_tmp" ]; then
        echo "mainsail_backup_namespace: backup file empty after write" >&2
        rm -f "$_tmp"
        return 1
    fi
    if ! "$PYTHON3" -c "import json; json.load(open('$_tmp'))" 2>/dev/null; then
        echo "mainsail_backup_namespace: backup file failed readback verification (not valid JSON)" >&2
        rm -f "$_tmp"
        return 1
    fi

    mv "$_tmp" "$_out"
    echo "$_out"
    return 0
}

cmd_klipper_extensions() {
    _immutable_ext=""
    _persistent_dst="$APPS_DIR/nebulaos-klipper-extensions"
    _backup_dst="${_persistent_dst}.pre-recovery.$(date +%Y%m%d-%H%M%S)"

    # Extensions on the immutable squashfs are baked directly into
    # /opt/klipper/klippy/extras/ as real files (not symlinks). The
    # separate persistent extensions repo is at
    # /usr/data/nebulaos/apps/nebulaos-klipper-extensions.
    #
    # Recovery means removing the persistent extensions copy so that
    # S05nebulaos-activate falls back to immutable Klipper (which
    # already has the baked extensions).

    echo "Recovering klipper-extensions"
    echo ""

    stop_services "klipper-extensions"

    if [ -d "$_persistent_dst" ]; then
        echo "Moving existing persistent extensions to $_backup_dst"
        mv "$_persistent_dst" "$_backup_dst"
        echo ""
        echo "Recovery complete for klipper-extensions."
        echo "The persistent extensions copy has been moved aside."
        echo "On reboot, S05nebulaos-activate will skip activation and"
        echo "Klipper will run with the immutable baked extensions."
    else
        echo "No persistent extensions copy found."
        echo "Already running from immutable squashfs extensions."
    fi

    echo ""
    echo "A reboot is required for changes to take effect."
}

# ---------- config (Phase 2 final software closure mission, 2026-09-09) --

# Restores ONLY the NebulaOS-managed active config tree
# ($PRINTER_DATA_CONFIG/nebulaos/) from the immutable /etc/nebulaos/klipper/
# source, via the same materialize_config_tree() both this command and
# S04nebulaos-migrate's own boot-time materialization use - see
# config-materialize.sh's own header and
# docs/NEBULAOS_CONFIG_MATERIALIZATION.md.
#
# Deliberately narrow: this is a reset of the managed tree ONLY. It must
# NEVER touch printer.cfg's own user-owned region, SAVE_CONFIG, moonraker.conf,
# macros/, guppyscreen/, the Moonraker database, Mainsail's
# layout, PLR state, or MCU state - materialize_config_tree()'s own inputs
# and outputs are exactly $NEBULAOS_KLIPPER_CFG_DIR (read) and
# $PRINTER_DATA_CONFIG/nebulaos (the only thing written), so this command
# has no way to reach any of those even by accident.
#
# Unlike boot-time materialization (which is a no-op when the generation
# already matches - an ordinary reboot must not rewrite anything), this
# command always rematerializes when invoked: it exists specifically for a
# technician to recover from LOCAL corruption of the managed tree itself,
# which config_materialization_needed()'s generation comparison alone
# cannot detect (the generation marker can still say "correct" even if a
# file underneath has since been corrupted or deleted).
cmd_config() {
    if [ ! -f "$CONFIG_MATERIALIZE_LIB" ]; then
        die "config materialization library not found at $CONFIG_MATERIALIZE_LIB - cannot recover config"
    fi

    echo "Recovering the NebulaOS-managed config tree from $NEBULAOS_KLIPPER_CFG_DIR"
    echo ""

    # shellcheck disable=SC1090
    . "$CONFIG_MATERIALIZE_LIB"

    if materialize_config_tree "recover-config"; then
        echo ""
        echo "Recovery complete for config."
        echo "printer.cfg's own user-owned region, SAVE_CONFIG, macros/,"
        echo "guppyscreen/, uploads/ and moonraker.conf are all untouched."
        echo "No reboot is required - Klipper reads the managed tree fresh on its"
        echo "next restart; run FIRMWARE_RESTART if you want it to pick this up now."
    else
        die "materialize_config_tree failed - see the log lines above for exactly why. The existing managed tree (if any) was left untouched."
    fi
}

# ---------- main ----------

usage() {
    echo "Usage: nebulaos-recover <command> [options]"
    echo ""
    echo "Commands:"
    echo "  status                    Show activation state of all components"
    echo "  klipper                   Restore Klipper from immutable copy"
    echo "  moonraker                 Restore Moonraker from immutable copy"
    echo "  mainsail                  Restore Mainsail frontend from immutable copy"
    echo "                            (preserves the user's macro/mode DB state)"
    echo "  mainsail --reset-state    The above, PLUS reset Mainsail's macro groups"
    echo "                            and mode to the shipped defaults (destructive"
    echo "                            to that state only - backed up automatically"
    echo "                            first; other Mainsail/Moonraker settings and"
    echo "                            any of the user's own custom groups untouched)"
    echo "  klipper-extensions        Restore extensions (remove persistent copy)"
    echo "  config                    Restore the NebulaOS-managed config tree"
    echo "                            (printer_data/config/nebulaos/) from the"
    echo "                            immutable image - never touches printer.cfg's"
    echo "                            own user-owned region, SAVE_CONFIG, macros/,"
    echo "                            guppyscreen/, uploads/ or moonraker.conf"
    exit 1
}

if [ $# -eq 0 ]; then
    usage
fi

command="$1"
shift

case "$command" in
    status)             cmd_status ;;
    klipper)            cmd_klipper ;;
    moonraker)          cmd_moonraker ;;
    mainsail)           cmd_mainsail "$@" ;;
    klipper-extensions) cmd_klipper_extensions ;;
    config)              cmd_config ;;
    -h|--help|help)     usage ;;
    *) die "unknown command '$command'. Run 'nebulaos-recover help' for usage." ;;
esac
