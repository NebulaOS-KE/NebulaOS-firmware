#!/bin/sh
# NebulaOS: root's password lives in a persistent copy of /etc/shadow (the
# image's file is read-only), so `passwd` / `passwd root` run nebulaos-passwd.
# Anything else is BusyBox passwd as before.
case "$*" in
	""|root) [ "$(id -u)" = 0 ] && exec /usr/sbin/nebulaos-passwd ;;
esac
exec busybox passwd "$@"
