#!/bin/sh
# supervisorctl shim - by destinal
# this is a fake supervisorctl that provides just enough information for moonraker to think it's the real thing.
# good enough to list the names of services in moonraker.conf, to say whether they're running or not (with false pids and times)
# and to start and stop them by name, finding and calling the matching init scripts.
# installing: put this in in /usr/bin/supervisorctl and then in moonraker.conf in [machine] section, set  "provider: supervisord_cli"
#
# OpenKE addition (FIRMWARE.md sec 13): pulled byte-for-byte from the real,
# working install on this exact physical device's stock firmware
# (/usr/data/helper-script/files/fixes/supervisorctl, part of the
# open-source Guilouz/Creality-Helper-Script project - GPLv3). Stock uses
# this same shim (via moonraker.conf's [machine] provider: supervisord_cli)
# to let Moonraker's machine component work without systemd or a real
# supervisord daemon, neither of which exist on this Buildroot/BusyBox
# image either - this shim just drives our own /etc/init.d/S* scripts
# directly, the same as it does on stock. Confirmed compatible with this
# build's own init script naming (S55klipper, S56moonraker, etc.) and pid
# file convention (/var/run/klippy.pid for the "klipper" service).

if [ -t 1 ]; then  # colorize only if we're on a terminal
  GREEN='\033[32m'
  RED='\033[31m'
  ENDCOLOR='\033[0m'
fi

get_services() {
  moonraker_pid="$(cat /var/run/moonraker.pid)"
  # if moonraker is running, get its config directory from its command line
  if [ -f /var/run/moonraker.pid ] && [ -d /proc/"$moonraker_pid" ] ; then
    cmdline="$(tr '\0' '\n' < /proc/"$moonraker_pid"/cmdline)"
    moonraker_dir="$(echo $cmdline | awk -F'-d ' '{print $2}' | awk '{print $1}')"
    moonraker_conf="$moonraker_dir/config/moonraker.conf"
    # services="klipper moonraker $(awk '/managed_services:/ {print $2}' $moonraker_conf | sed 's/://')"
    # services=`(printf 'klipper\nmoonraker\n'; awk '/managed_services:/ {print $2}' $moonraker_conf | sed 's/://') | sort|uniq`
    services=$(ls -1 /etc/init.d/S*|sed 's/.*\/S..//;s/_service$//')
    echo $services
  else
    echo "Error: Invalid or missing PID file /var/run/moonraker.pid" >&2
    exit 1
  fi
}

get_pid_file() {
  service="$1"
  [ $service == "klipper" ] && service="klippy"
  pid_file="/var/run/$service.pid"
  echo $pid_file
}

is_running() {
  service="$1"
  pid_file="$(get_pid_file "$service")"

  # Check for PID file
  if [ -f "$pid_file" ] && [ -d "/proc/$(cat $pid_file)" ]; then
      return 0  # Running
  fi

  # Fallback to using pidof in case the service doesn't use pid files
  if pidof "$service" &>/dev/null; then
      return 0  # Running
  fi
  return 1  # Not running
}

print_process_status() {
  # NebulaOS fix (Display Baseline Cleanup mission, 2026-08-03): the
  # original %-33s field width silently produced NO separator at all for
  # any service name >= 33 chars (printf doesn't truncate/pad a string
  # already longer than the field width) - moonraker's own
  # _get_process_info() then split()s "<name>RUNNING" as a single token
  # and crashed with IndexError on parts[1], which broke Moonraker's
  # machine component (and, transitively, the whole klippy_connection
  # ready-registration flow - see the real live incident this mission
  # traced this back to) the first time a service name this long
  # (nebulaos-display-sleep-wake-controller, 39 chars) was ever added.
  # Printing the name and state as two explicitly space-separated printf
  # calls guarantees a real separator regardless of name length, so no
  # future service name can silently reintroduce this exact bug.
  if is_running "$service"; then
    printf "%s " "$service"; printf "$GREEN""RUNNING$ENDCOLOR\n"
  else
    printf "%s " "$service"; printf "$RED""STOPPED$ENDCOLOR\n"
  fi
}

print_usage() {
  echo "supervisorctl shim - provide minimal support for moonraker so CrealityOS moonraker can start/stop without systemd"
  echo "Usage: $0 [command] <service>"
  echo "commands include status stop start restart"
}

get_script_path() {
  service="$1"
  initd="${SUPERVISORCTL_INITD:-/etc/init.d}"  # NebulaOS: test seam
  script_path="$(ls -1 $initd/S[0-9][0-9]${service}_service $initd/S[0-9][0-9]${service}* 2>/dev/null|head -1)"
  echo "$script_path"
}

stop() {
  service="$1"
  script_path="$(get_script_path $service)"
  # Check if the script exists and stop the service
  if [[ -f "$script_path" ]]; then
    "$script_path" stop
  fi
}

start() {
  service="$1"
  script_path="$(get_script_path $service)"
  # Check if the script exists and start the service
  if [[ -f "$script_path" ]]; then
    "$script_path" start
  fi
}

restart() {
  service="$1"
  script_path="$(get_script_path $service)"
  # Check if the script exists and restart the service
  if [[ -f "$script_path" ]]; then
    "$script_path" restart
  fi
}

# G91 step 4 (design v3.1/v3.6): Moonraker's update_manager restarts Klipper
# through this shim after a pull (pip may take minutes in between), and
# Mainsail's service "restart klipper" lands here too. Neither may cut a
# print: restart/stop of `klipper` - and ONLY klipper; nebulascreen and the
# rest are never gated - is refused while the shared busy check
# (/etc/nebulaos-busy.sh, restart profile) POSITIVELY says printing, paused,
# heating or moving (G95, Tim 2026-10-22: a live Klippy answered so, or the
# memguard print marker is set while Klippy answers). A Klippy that is not
# running, not ready, or does not answer (hung, timeout, error) can ALWAYS be
# restarted (S19, G95): the check reads klippy_state and the Klippy pid
# first. Shell only, before `stop`, well inside Moonraker's 6 s budget for
# this command. The reason goes to stderr, exit 1, and (G98) a
# "!! NebulaOS refused: ..." line to Mainsail's console through the
# [nebulaos] component (best effort, 1 s, never delays or changes the
# refusal). A user who really needs Klipper back during a print uses
# FIRMWARE_RESTART or the emergency stop, which do not come through here.
NEBULAOS_BUSY_LIB="${NEBULAOS_BUSY_LIB:-/etc/nebulaos-busy.sh}"

refuse_if_klipper_busy() {
  [ "$2" = "klipper" ] || return 0
  [ -r "$NEBULAOS_BUSY_LIB" ] || return 0
  NB_TIMEOUT="${NB_TIMEOUT:-1}" NB_SOCKET_TIMEOUT="${NB_SOCKET_TIMEOUT:-0.5}"
  # shellcheck disable=SC1090
  . "$NEBULAOS_BUSY_LIB"
  reason=$(nebulaos_busy_fast restart) || return 0
  case "$reason" in
    PRINTING) text="Not possible while a print is running." ;;
    PAUSED) text="Not possible while a print is paused." ;;
    ACTIVE) text="Not possible while the printer is moving or heating." ;;
    *) text="Printer state unknown - not possible right now." ;;
  esac
  echo "NebulaOS refused: $1 klipper - $text ($reason)" >&2
  logger -t supervisorctl "NebulaOS refused: $1 klipper ($reason)" 2>/dev/null
  notify_refused "$1 klipper - $text"
  exit 1
}

# G98: the refusal as a "!! NebulaOS refused: ..." line in Mainsail's console
# (the [nebulaos] component relays it as a gcode response). Best effort: 1 s,
# output discarded, the result never changes the refusal. Moonraker runs this
# shim asynchronously, so it can answer while it waits for us.
notify_refused() {
  wget -q -T "${NB_NOTIFY_TIMEOUT:-1}" -O /dev/null \
    --header "Content-Type: application/json" \
    --post-data "{\"message\": \"$1\"}" \
    "${NB_MOONRAKER:-http://127.0.0.1:7125}/machine/nebulaos/system/notify_refused" \
    </dev/null >/dev/null 2>&1 || true
}

main() {
  # echo "$0 $@" >> /tmp/supervisorctl.log
  action="$1"; shift
  case "$action" in
    status)
      if [ "$#" -lt 1 ]; then  # just status, no arguments
        for service in $(get_services); do
          print_process_status $service
        done
      else
        for service in "$@"; do # loop through the arguments provided
          print_process_status $service
        done
      fi
      ;;
    start)
      start "$1"
      ;;
    stop)
      refuse_if_klipper_busy stop "$1"
      stop "$1"
      ;;
    restart)
      refuse_if_klipper_busy restart "$1"
      restart "$1"
      ;;
    *)
      print_usage
      exit 1
  esac
}

main "$@"
