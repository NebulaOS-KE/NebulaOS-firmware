#!/bin/sh
# Change the root password persistently (decision D7). Run over SSH as root:
#   nebulaos-passwd        (also what `passwd` / `passwd root` run)
# The password is asked twice and never echoed. See /etc/nebulaos-shadow.sh.
NSH_LIB="${NSH_LIB:-/etc/nebulaos-shadow.sh}"
. "$NSH_LIB" || exit 2
[ "$(id -u)" = 0 ] || { echo "nebulaos-passwd: run as root" >&2; exit 1; }
if [ -t 0 ]; then
	stty -echo 2>/dev/null; trap 'stty echo 2>/dev/null' EXIT INT TERM
	printf 'New root password: '; IFS= read -r p1; echo
	printf 'Retype new root password: '; IFS= read -r p2; echo
	stty echo 2>/dev/null
	[ "$p1" = "$p2" ] || { echo "nebulaos-passwd: passwords do not match - unchanged" >&2; exit 1; }
	printf '%s\n' "$p1" | nsh_set_root_password; rc=$?
	unset p1 p2
else
	nsh_set_root_password; rc=$?
fi
case $rc in
	0) echo "nebulaos-passwd: root password changed (kept across reboots and updates)" ;;
	*) echo "nebulaos-passwd: password NOT changed" >&2 ;;
esac
exit $rc
