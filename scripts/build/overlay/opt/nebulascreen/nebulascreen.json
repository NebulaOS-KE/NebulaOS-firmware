{
  "default_printer": "default_printer",
  "display_rotate": 2,
  "log_path": "/opt/printer_data/logs/nebulascreen.log",
  "printers": {
    "default_printer": {
      "default_macros": {
        "cooldown": "SET_HEATER_TEMPERATURE HEATER=extruder TARGET=0\nSET_HEATER_TEMPERATURE HEATER=heater_bed TARGET=0",
        "load_filament": "LOAD_FILAMENT",
        "unload_filament": "UNLOAD_FILAMENT"
      },
      "display_sleep_sec": 600,
      "fans": [],
      "log_level": "info",
      "monitored_sensors": [
        { "id": "extruder", "display_name": "Extruder", "controllable": true, "color": "red" },
        { "id": "heater_bed", "display_name": "Bed", "controllable": true, "color": "purple" },
        { "id": "temperature_sensor mcu_temp", "display_name": "MCU Temp", "controllable": false, "color": "blue" }
      ],
      "moonraker_api_key": false,
      "moonraker_host": "127.0.0.1",
      "moonraker_port": 7125
    }
  },
  "nebulascreen_init_script": "/etc/init.d/S58nebulascreen",
  "thumbnail_path": "/opt/nebulascreen/thumbnails"
}
