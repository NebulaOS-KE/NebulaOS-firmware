+  // Real-world observation: right after a write completes, the device's
+  // control endpoint can be briefly unresponsive (still committing the
+  // write to eMMC) and a control transfer sent too soon comes back
+  // LIBUSB_ERROR_TIMEOUT (-7), not a real protocol error. Retry a few times
+  // with a short, increasing delay before giving up - only for this
+  // specific transient error, any other failure still dies immediately.
+  int attempt;
+  int ret = 0;
+  for (attempt = 0; attempt < 5; attempt++) {
+    verbose("Issue 0x%x (attempt %d)", op, attempt + 1);
+    ret = libusb_control_transfer(g_usb_dev,
+				  LIBUSB_ENDPOINT_OUT|LIBUSB_REQUEST_TYPE_VENDOR|LIBUSB_RECIPIENT_DEVICE,
+				  op, param >> 16, param & 0xffff, data, len, 10000);
+    if (ret == len)
+      return;
+    if (ret != LIBUSB_ERROR_TIMEOUT)
+      break;
+    usleep(200000 * (attempt + 1));
+  }
+  die("Request 0x%x failed, only transfered: %d", op, ret);
 }
 
