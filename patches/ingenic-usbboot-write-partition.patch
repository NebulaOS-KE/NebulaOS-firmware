+// Mirrors mmc_read_partition()'s chunking exactly (same 2mb chunk size), but
+// adds what a write needs that a read never did: an immediate read-back
+// verification of every single chunk, right after writing it - not just a
+// check at the very end. If something goes wrong partway through a large
+// write (a dropped USB transfer, a bad block), this catches it at the exact
+// offset it happened, rather than writing the whole thing blind and finding
+// out only afterward. Refuses to proceed past the first mismatch - a
+// half-written, unverified partition is worse than stopping early with a
+// clear error.
+void mmc_write_partition(uint32_t offset, uint32_t length, const char* fname) {
+  enable_mmc();
+  if(length == 0)
+    die("invalid partition length: %d", length);
+
+  FILE* f = fopen(fname, "rb");
+  if(f == NULL)
+    die("Can't open file '%s' for reading", fname);
+
+  // The file must be exactly the requested length - never write a
+  // truncated or oversized buffer to a fixed device offset/length.
+  fseek(f, 0, SEEK_END);
+  long fsize = ftell(f);
+  fseek(f, 0, SEEK_SET);
+  if (fsize != (long)length) {
+    fclose(f);
+    die("File '%s' is %ld bytes, does not match requested length %u - refusing to write", fname, fsize, length);
+  }
+
+  printf("writing partition at offset 0x%x, size 0x%x (with per-chunk read-back verification)\n", offset, length);
+
+  // 1 MB, not 2: each chunk is written to eMMC (~0.5 s) before the device
+  // takes the next command. With 2 MB chunks and 1 s control timeouts the
+  // next request timed out on ke-dev (2026-10-15) and left the device stuck.
+  uint32_t chunk_size = 1024 * 1024;
+  unsigned char *write_chunk = malloc(chunk_size);
+  unsigned char *verify_chunk = malloc(chunk_size);
+  if (write_chunk == NULL || verify_chunk == NULL)
+    die("out of memory allocating chunk buffers");
+
+  uint32_t cursor = offset;
+  uint32_t end = offset + length;
+  while (cursor < end) {
+    uint32_t this_size = (end - cursor) >= chunk_size ? chunk_size : (end - cursor);
+
+    size_t got = fread(write_chunk, 1, this_size, f);
+    if (got != this_size)
+      die("Failed to read %u bytes from %s (got %zu)", this_size, fname, got);
+
+    uint32_t start = (uint32_t)time(NULL);
+    mmc_write(cursor, this_size, write_chunk);
+    uint32_t duration = (uint32_t)time(NULL) - start;
+
+    // Let the eMMC write actually commit before reading it back - a bulk
+    // transfer completing just means the device's RAM buffer got the data,
+    // not that the flash write finished. Real-world testing hit control-
+    // transfer timeouts on the immediate verify-read without this.
+    usleep(150000);
+
+    memset(verify_chunk, 0, chunk_size);
+    mmc_read(cursor, this_size, verify_chunk);
+    if (memcmp(write_chunk, verify_chunk, this_size) != 0)
+      die("VERIFICATION FAILED at offset 0x%x: written data does not match "
+          "what was read back immediately after - device may be in an "
+          "inconsistent state at this offset, do not trust this write", cursor);
+
+    cursor += this_size;
+
+    printf("%.2f%% completed (%.2fMB/s), verified OK\n",
+	   (cursor - offset) / (float)length * 100,
+	   (this_size / 1024.0 / 1024.0) / (float)(duration > 0 ? duration : 1));
+  }
+
+  fclose(f);
+  free(write_chunk);
+  free(verify_chunk);
+
+  printf("write complete and verified: all %u bytes at offset 0x%x match source file exactly\n", length, offset);
+}
